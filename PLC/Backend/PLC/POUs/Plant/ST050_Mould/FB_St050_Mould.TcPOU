{attribute 'object_name' := 'Reset'}
METHOD Reset
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// base logic run
SUPER^.Reset();

// reset objects
//diContinuesNok := 0;

//IF fbCamAs.bError OR NOT RunCycle THEN
	fbCamAs.M_Reset();
	fbCamBs.M_Reset();
	fbLedAs.M_Reset();
	fbLedBs.M_Reset();
//END_IF

//stSt060.bEnable := FALSE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>