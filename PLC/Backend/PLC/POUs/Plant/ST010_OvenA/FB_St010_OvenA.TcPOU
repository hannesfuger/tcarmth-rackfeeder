    <Property Name="PosWork" Id="{9fe02ebe-83fe-4e58-a204-b0de733e6026}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY INTERNAL PosWork : LREAL]]></Declaration>
      <Get Name="Get" Id="{dbf627f0-06bf-40a9-8ae8-f0eb3f5461e3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PosWork := stLocalSettings.stDynStationSettings[E_St010_Settings.eSt010_Settings_PosWork].fValue + // 1. Mitnehmerpos.
	  (OvenSegmentHeight * 
		TRUNC(((P_Plant.TrolleyRackDivision * stSt010IOvenA.iConfirmPosition) + 
		(OvenSegmentHeight - OvenFixPartHeight - 50))/OvenSegmentHeight)); // -50 => height axis z]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PosWorkCh" Id="{3fde38ed-ba5a-4c2b-b47d-9ce6c9846729}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY INTERNAL PosWorkCh : LREAL]]></Declaration>
      <Get Name="Get" Id="{7ce4e5d2-ae05-497c-a73e-e5bd7c0c4e74}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PosWorkCh := stLocalSettings.stDynStationSettings[E_St010_Settings.eSt010_Settings_PosWorkCh].fValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PosWorkOpn" Id="{d1cae6f5-e294-4b28-9373-1fd2287bda8b}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY INTERNAL PosWorkOpn : LREAL]]></Declaration>
      <Get Name="Get" Id="{a709c0df-97c7-4ccc-bf9e-d848c1a5e45b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PosWorkOpn := PosWork + 

			  LMOD(((P_Plant.TrolleyRackDivision * stSt010IOvenA.iConfirmPosition) + (P_Plant.TrolleyRackOriginX - OvenFixPartHeight - 50)), 
					OvenSegmentHeight) + 
					50 + // -50 => height axis z
			  P_Plant.TrolleyRackDivision; // ( + TrolleyDevisionY --> safety distance)]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{6b6e2838-893c-4982-8c84-5282829b3068}" FolderPath="Internal\">
      <Declaration><![CDATA[/// Reset station logic
{attribute 'object_name' := 'Reset'}
METHOD Reset
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// base logic run
SUPER^.Reset();

// reset objects
//diContinuesNok := 0;

IF fbAxis.bError OR NOT RunCycle THEN
	fbAxis.Reset();
END_IF
IF fbAxisCh1.bError OR NOT RunCycle THEN
	fbAxisCh1.Reset();
END_IF
IF fbAxisCh2.bError OR NOT RunCycle THEN
	fbAxisCh2.Reset();
END_IF
]]></ST>
      </Implementation>
    </Method>
