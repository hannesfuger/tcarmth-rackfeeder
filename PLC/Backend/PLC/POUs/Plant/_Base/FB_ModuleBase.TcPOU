    <Method Name="M_OpModeChanged" Id="{0de467a2-1f6b-4340-a6cd-bdf757ca6c70}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED M_OpModeChanged : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// to be subclassed]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Run" Id="{8926414c-8159-4766-90ee-9570f9509af5}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC M_Run : BOOL
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_Run := TRUE;

// call component run
SUPER^.Run();

// loop stations of this module
FOR ii := 0 TO E_Station.eStation_nMaxIdx DO
	IF aIStaton[ii] = 0 THEN
		CONTINUE;
	END_IF
	
	aIStaton[ii].EmergencyStopOk := EmergencyStopOk;
	// specific safety area handled in module -> aIStaton[ii].SafetyOk := SafetyOk;
	M_Run := M_Run AND aIStaton[ii].M_Run(); // call station run
END_FOR

// Safety OP-Mode
rtirgSafetyOpMode_Auto(CLK := stHmiToModule.eSafetyOpMode = E_Opmode.eOpMode_auto);
rtirgSafetyOpMode_Hand(CLK := stHmiToModule.eSafetyOpMode = E_Opmode.eOpMode_manual);
rtirgSafetyOpMode_Aus(CLK := stHmiToModule.eSafetyOpMode = E_Opmode.eOpMode_off);

// reset (all or this station)
IF stHmiToModule.bReset THEN
	Reset();
END_IF

// step (all or this station)
// step -> ist bei Auto über die Property immer TRUE
bRunStep := stHmiToModule.bStep;

// start (all or this station)
IF stHmiToModule.bStart OR stHmiToModule.bStep THEN		
	IF NOT bEnable THEN
		ModuleWarning.ArgSbAppendRaise('Kein Enable Signal bei Start');
	ELSIF NOT bSafetyOk THEN
		ModuleWarning.ArgSbAppendRaise('Safety nicht ok bei Start');
		
	// Fehler steht noch an
	ELSIF bAutoStop_Error THEN
		ModuleWarning.ArgSbAppendRaise('Station in Fehlerstatus --> Reset');
		
	// Safety muss in Auto sein
	ELSIF stHmiToModule.eSafetyOpMode <> E_Opmode.eOpMode_auto AND Const.bEnSafetyOpMode THEN
		ModuleWarning.ArgSbAppendRaise('Safety Betriebsart nicht AUTO');
		
	// START
	ELSIF (OpMode = E_Opmode.eOpMode_auto OR OpMode = E_Opmode.eOpMode_step) THEN
		//bRunStep := FALSE;
		bRunCycle := TRUE;
	END_IF
END_IF

// cycle stop (all or this module)
IF stHmiToModule.bStop OR P_Supervision.bCycleStop THEN
	bRunCycle := bRunHoming := FALSE;
END_IF

// fast stop (all or this module)
IF stHmiToModule.bFastStop OR P_Supervision.bFastStop THEN 
	bRunCycle := bRunStep := bRunHoming := FALSE;
END_IF

// set op mode (all or this module)
tonOpModeOff(IN := stHmiToModule.bStop OR stHmiToModule.bFastStop, PT := T#10S);
IF stHmiToModule.bOpModeManual OR stHmiToModule.bOpModeManual OR rtirgSafetyOpMode_Hand.Q THEN
	bRunStep := FALSE;
	bRunCycle := FALSE;
	bRunHoming := FALSE;
	eOpMode := E_OpMode.eOpMode_manual;
ELSIF stHmiToModule.bOpModeAuto OR stHmiToModule.bOpModeAuto OR rtirgSafetyOpMode_Auto.Q THEN
	bRunStep := FALSE;
	bRunCycle := FALSE;
	bRunHoming := FALSE;
	eOpMode := E_OpMode.eOpMode_auto;
ELSIF stHmiToModule.bOpModeStep THEN
	bRunStep := FALSE;
	bRunCycle := FALSE;
	bRunHoming := FALSE;
	eOpMode := E_OpMode.eOpMode_step;
ELSIF tonOpModeOff.Q THEN
	eOpMode := E_OpMode.eOpMode_off;
END_IF
	
IF NOT bEmergencyStopOk THEN
	sqHome.InHome := FALSE;
	sqHome.Step := 0;
	sqAuto.Step := 0;
END_IF

// homing (all or this station)
IF stHmiToModule.bHome OR (stHmiToModule.bStart AND bAutoHome AND NOT sqHome.InHome AND sqHome.Step = 0 AND sqAuto.Step = 0) THEN
	IF NOT bEnable THEN
		ModuleWarning.ArgSbAppendRaise('Kein Enable Signal bei Start Grundstellung');
	ELSIF NOT bSafetyOk THEN
		ModuleWarning.ArgSbAppendRaise('Safety nicht ok bei Start Grundstellung');
		
	// Fehler steht noch an
	ELSIF bAutoStop_Error THEN
		ModuleWarning.ArgSbAppendRaise('Station in Fehlerstatus --> Reset');
	ELSE		
		sqHome.Step := 0;
		sqHome.InHome		:= FALSE;
		bRunCycle			:= FALSE;
		bRunHoming 			:= TRUE;
	END_IF
END_IF

/// Set Module State Color
IF State = eComponentState_error THEN
	nStateColor := STATICS.stColor.Red;
ELSIF bInHome AND (eOpMode = eOpMode_Auto OR eOpMode = eOpMode_Step) THEN	
	nStateColor := STATICS.stColor.LightBlue;
ELSIF bStopped AND (eOpMode = eOpMode_Auto OR eOpMode = eOpMode_Step) THEN
	nStateColor := STATICS.stColor.Blue;									
ELSIF State = eComponentState_running AND (eOpMode = eOpMode_Auto OR eOpMode = eOpMode_Step) THEN
	nStateColor := STATICS.stColor.LimeGreen;					
ELSIF State = eComponentState_running AND eOpMode = eOpMode_manual THEN
	nStateColor := STATICS.stColor.Orange;		
ELSE
	nStateColor := STATICS.stColor.White;
END_IF

//StepChainTextMapping
//stTextAuto := arraSTextAuto[iStepChainIndex];
IF iStepChainIndex >= 0 AND iStepChainIndex <= CONST.iMaxIdxLocalStepChain THEN
	stTextAuto.nNameId := sqAuto.InfoTextId;
	stTextAuto.wsName := WConcat3(TO_WSTRING(sqAuto.Step),": ", sqAuto.Info.ToWString());
	stTextAuto.wsNameId := WConcat3(TO_WSTRING(sqAuto.Step),": ", sqAuto.InfoTextWsId);	
	
	//stTextHome := arraSTextHome[iStepChainIndex];
	stTextHome.nNameId := sqHome.InfoTextId;
	stTextHome.wsName := WConcat3(TO_WSTRING(sqHome.Step), ": ", sqHome.Info.ToWString());
	stTextHome.wsNameId := WConcat3(TO_WSTRING(sqHome.Step),": ", sqHome.InfoTextWsId);	
END_IF

rtrigOpModeChanged(CLK := eOpModeOld <> eOpMode);
IF rtrigOpModeChanged.Q THEN
	eOpModeOld := eOpMode;
	M_OpModeChanged();
END_IF

//call methodes
sqHome.EnableStep := RunStep;
sqHome();
sqAuto.EnableStep := RunStep;
sqAuto();

M_CallObjects();
M_Homing();
M_Sequence();
M_Manual();
M_Supervision();
]]></ST>
      </Implementation>
    </Method>
