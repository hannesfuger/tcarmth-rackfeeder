    <Property Name="HasEmptySlot" Id="{a0c73a31-77c1-4173-93f1-fdc82074e409}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC HasEmptySlot : BOOL]]></Declaration>
      <Get Name="Get" Id="{561bc891-724c-4d36-943a-e6e85b19ebd2}">
        <Declaration><![CDATA[VAR
	_i : INT;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasEmptySlot:= FALSE;
	
FOR _i:= 0 TO MAX_CARRIERPLACES DO

	THIS^._TemplateCarrier.Data := _data.CarriersData[_i];
	
	IF NOT _TemplateCarrier.CarrierPresent THEN
		HasEmptySlot:= TRUE;
		RETURN;
	END_IF

END_FOR]]></ST>
        </Implementation>
      </Get>
    </Property>
