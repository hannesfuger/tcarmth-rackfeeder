    <Method Name="M_OpModeChanged" Id="{78264e7c-3b2e-4bf7-8226-a0400a0094f3}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED M_OpModeChanged : BOOL
VAR_INPUT
