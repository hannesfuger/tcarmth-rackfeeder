    <Method Name="FB_init" Id="{afedea7a-7512-43e6-b175-acf863c0af2e}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
	bInCopyCode : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eTyp := E_ComponentType.eComponentType_Furnace;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Heating" Id="{9b0dde32-d804-4570-8f87-05316dffcd6e}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY Heating : E_HeatingState]]></Declaration>
      <Get Name="Get" Id="{c66180d6-e3e0-4818-9735-f9d76c4719b7}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Heating := E_HeatingState.eHeatingState_none;

IF Mode = eFurnaceSeq_Auto AND ((NOT SelPointAutoTwo AND SetPointAuto <> 0) OR (SelPointAutoTwo AND SetPointAutoTwo <> 0)) THEN
	Heating := E_HeatingState.eHeatingState_on;	
ELSIF  Mode = eFurnaceSeq_Hand AND SetPointManual <> 0 THEN
	Heating := E_HeatingState.eHeatingState_on;
ELSE
	Heating := E_HeatingState.eHeatingState_off;	
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="HeatingMode" Id="{7b25d03b-c3d7-447b-9181-1229edcf64ee}">
      <Declaration><![CDATA[METHOD HeatingMode
VAR_INPUT
	eMode				: E_FurnaceSeq;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eSequenceId := eMode;
nStep := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="LoadCtrlParam" Id="{36310657-5d69-4ef5-8e68-4a1c21c01233}" FolderPath="Factory\">
      <Declaration><![CDATA[METHOD LoadCtrlParam
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//stCtrlParameter	:= CtrlParameter;
	
(* general parameters ***************************************************************)
stCtrlParameter.iMode					:= 1										;	(* 1=heating, 2=cooling, 3=heating&cooling *)
stCtrlParameter.iReactionOnFailure		:= eCTRL_ReactionOnFailure_NoFailure	;	(* 0=controller off, 1=manual op, 2=yMin, 3=yMax *)

stCtrlParameter.bSelCtrlParameterSet	:= FALSE									;	(* FALSE = internal set, TRUE = external set *)
	                                                                                
stCtrlParameter.dwAlarmSupp				:= 16#0000EFFF								;	(* alarm suppression *)
stCtrlParameter.tCtrlCycleTime			:= T#1000MS									;	(* controller cycle time *)
stCtrlParameter.tTaskCycleTime			:= T#10MS									;	(* plc task cycle time *)
		                                                                            
(* tuning parameters ****************************************************************)         
stCtrlParameter.iTuningMode				:= 1										;	(* only heating, only cooling, first heating then cooling or vice versa *)
	                                                                                
stCtrlParameter.tTuneStabilisation		:= T#20S									;	(* wait for a stable system *)
	                                                                                
stCtrlParameter.fEndTunePercentHeating	:= 80.0										;	(* switch to closed loop control when X > 0.8*W *)
stCtrlParameter.fYTuneHeating			:= 100.0									;	(* step change while tuning operation *)
stCtrlParameter.fYStableHeating			:= 0.0										;	(* tuning operation *)
	                                                                                
stCtrlParameter.fEndTunePercentCooling	:= 20.0										;	(* switch to closed loop control when X < 0.2*W *)
stCtrlParameter.fYTuneCooling			:= 0.0										;	(* step change while tuning operation *)
stCtrlParameter.fYStableCooling			:= 0.0										;	(* tuning operation *)
stCtrlParameter.fScalingFactor			:= 1.0										;	(* Scaling factor for KP heating/cooling *)
		                                                                            
(* setpoint parameters **************************************************************)         
stCtrlParameter.fWMin					:= 0.0										;	(* lower limit *)
stCtrlParameter.fWMax					:= 200.0									;	(* upper limit *)
	                                                                                
(* start up *************************************************************************)                                                                      
stCtrlParameter.bEnableSoftStart		:= FALSE									;	(* FALSE = no soft start, TRUE = soft start *)
stCtrlParameter.bEnableRamping			:= FALSE									;	(* FALSE = no ramping, TRUE = ramping *)
	                                                                                
stCtrlParameter.fWStartUp				:= 0.0										;	(* soft start plateau setpoint *)
stCtrlParameter.tStartUp				:= T#0MS									;	(* soft start waiting time*)
stCtrlParameter.bStartUpRamping			:= FALSE									;	(* enable ramping while start up phase *)
stCtrlParameter.fWStartUpVeloPos		:= 1.0										;	(* max gradient for increasing setpoint in start up phase*)
stCtrlParameter.fWStartUpVeloNeg		:= 1.0										;	(* max gradient for decreasing setpoint in start up phase *)
	                                                                                
stCtrlParameter.fWVeloPos				:= 1.0										;	(* max gradient for increasing setpoint *)
stCtrlParameter.fWVeloNeg				:= 1.0										;	(* max gradient for decreasing setpoint *)	
	                                                                                
(* actual value parameters **********************************************************)         
stCtrlParameter.bFilter 				:= FALSE                                    ;
stCtrlParameter.tFilter					:= T#0S                                     ;
		                                                                            
(* deadband parameters **************************************************************)         
stCtrlParameter.bDeadband				:= FALSE                                    ;
stCtrlParameter.fEDeadband				:= 0.0										;	
		                                                                            
(* control value parameters *********************************************************)         
stCtrlParameter.fYMin					:= 0.0										;	(* lower limit *)
stCtrlParameter.fYMax					:= 100.0									;	(* upper limit *)
stCtrlParameter.fYManual				:= 0.0									 	;	(* manual operation*)
stCtrlParameter.fYOnFailure				:= 0.0										;	(* control value on failure *)
	                                                                                ;
stCtrlParameter.tPWMCycleTime			:= T#5S										;	(* PWM: period *)
stCtrlParameter.tPWMMinOffTime			:= T#0S										;	(* PWM: min off time *)
stCtrlParameter.tPWMMinOnTime			:= T#0S										;	(* PWM: min on time *)
stCtrlParameter.tPWMWaitingTime			:= T#0S										;	(* PWM: min waiting time *) (* not yet implemented !!!!*)
	                                                                                
stCtrlParameter.fYThresholdOff			:= 0.0										;	(* 3-Point: Off threshold *)
stCtrlParameter.fYThresholdOn			:= 0.0										;	(* 3-Point: On threshold *)
	                                                                                
stCtrlParameter.nCyclesForSwitchOver	:= 100                                      ;
	                                                                                
(* controller settings **************************************************************)         
stCtrlParameter.bEnablePreController 	:= FALSE									;	(* enable precontroller *)
stCtrlParameter.bEnableZones 			:= FALSE									;	(* enable zone around setpoint with open loop control *)
stCtrlParameter.bEnableCVFilter 		:= FALSE									;	(* enable filter for CV (type see iFilterType) *)
stCtrlParameter.iFilterType 			:= eCTRL_FilterType_FIRSTORDER			 	;	(* filtertype of CV filter *)
stCtrlParameter.iControllerType 		:= eCTRL_ControllerType_PID					;	(* used controller normally PID *)
			
(* min max temperatures	*************************************************************)
stCtrlParameter.TempLow					:= -5.0										;
stCtrlParameter.TempLowLow				:= -10.0                                    ;
stCtrlParameter.TempHigh				:= 5.0                                      ;
stCtrlParameter.TempHighHigh			:= 10.0                                     ;
stCtrlParameter.TempAbsoluteHigh		:= 200.0                                    ;
stCtrlParameter.TempAbsoluteLow			:= 0.0	                                    ;
		                                                                            
(* internal tuning parameters *******************************************************)                                                    
stCtrlParameter.fTuneKp					:= 0.5                                      ;
stCtrlParameter.fTuneTn					:= 3                                     	;
stCtrlParameter.fTuneTv					:= 1                                     	;
stCtrlParameter.fTuneTd					:= 0.25                                     ;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Mode" Id="{d1d0fda5-3119-4d21-9105-8b426f4f5217}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY Mode : E_FurnaceSeq]]></Declaration>
      <Get Name="Get" Id="{f0985339-f217-4881-9c24-7a63cea563ff}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF  (nStep = 99) THEN
	Mode := eSequenceId;
ELSE
	Mode := E_FurnaceSeq.eFurnaceSeq_none;
END_IF]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PIDParameter" Id="{5df29ac3-88ec-4af3-afec-7b49438d8c63}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY PIDParameter : REFERENCE TO ST_CTRL_ParaController]]></Declaration>
      <Get Name="Get" Id="{2500007c-e491-49c2-a4d5-ee1d7a389d95}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PIDParameter REF= stPIDParameter;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{76d9b48f-c9ed-4f25-b3fb-594629381c17}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[stPIDParameter := PIDParameter;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Reset" Id="{0d22e609-bfd7-4238-9163-b44359003fb7}">
      <Declaration><![CDATA[/// Reset component logic
{attribute '' := ''}
{attribute 'object_name' := 'Reset'}
METHOD Reset

VAR
	eOldMode			: E_FurnaceSeq;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// base logic run
SUPER^.Reset();

eSequenceId := E_FurnaceSeq.eFurnaceSeq_none;
nStep := 0;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Run" Id="{2a2498bd-0a6e-4bf4-9d40-11c6b3021309}">
      <Declaration><![CDATA[/// Run component logic
{attribute 'object_name' := 'Run'}
METHOD Run : E_ComponentState
VAR
	CtrlParameter			: ST_CTRL_TempCtrlParameter;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// base logic run
Run := SUPER^.Run();

// Sequencer 
SeqRun();

// convert Temperature
fTemperature := fSlope * INT_TO_LREAL(stIn.nTemperature) + fInitial;

// TemperatureCtrl
fbTmpCtrl(
		eCtrlMode				:= eCTRL_Mode, 
		//bSelSetpoint			:= FALSE, 
		//fW1						:= 120, 
		//fW2						:= 120, 
		fX						:= fTemperature, 
		//fYManual				:= , 
		bOpenThermocouple		:= FALSE, 
		bReverseThermocouple	:= FALSE, 
		bBackVoltage			:= FALSE, 
		bLeakage				:= FALSE, 
		bShortCircuit			:= FALSE, 
		bOpenCircuit			:= FALSE, 
		sParaControllerExternal	:= stPIDParameter, 
		sControllerParameter	:= stCTRLParameter, 
		);

// Analog output		
stOut.bPWMSignal := fbTmpCtrl.bYPWMPos;

// Choose set of controller parameters
//IF fbTmpCtrl.eCtrlState = eCTRL_STATE_TUNED THEN
//	eCTRL_Mode := eCTRL_MODE_ACTIVE;	
//END_IF

IF fbTmpCtrl.eCtrlState = e_Ctrl_state.eCTRL_STATE_ERROR THEN
	// todo: error
END_IF

rtOverheat.CLK := NOT stin.bOverheat;
rtOverheat();		

IF rtOverheat.Q THEN
//	WriteError(E_Event.eEvent_none, CONCAT(sName, ': Überhitzungsschutz'));
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Property Name="SelPointAutoTwo" Id="{14d02790-22eb-4c2d-af42-80c405abf856}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY SelPointAutoTwo : BOOL]]></Declaration>
      <Get Name="Get" Id="{aad6a56b-837f-4928-af7c-a81b4fb3d20e}">
