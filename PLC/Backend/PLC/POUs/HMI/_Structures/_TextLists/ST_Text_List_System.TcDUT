												wsName:= "Link error");
	stText_EC_IoLockedAfterLinkErr			: ST_Text := (
												wsNameId:= "EC_IoLockedAfterLinkErr",
												wsName:= "I/O locked after link error (I/O reset required)");
	stText_EC_LinkErrRedAdapter				: ST_Text := (
												wsNameId:= "EC_LinkErrRedAdapter",
												wsName:= "Link error (redundancy adapter)");
	stText_EC_MissingFrame					: ST_Text := (
												wsNameId:= "EC_MissingFrame",
												wsName:= "Missing one frame (redundancy mode)");
	stText_EC_OutOfSendResources			: ST_Text := (
												wsNameId:= "EC_OutOfSendResources",
												wsName:= "Out of send resources (I/O reset required)");												
