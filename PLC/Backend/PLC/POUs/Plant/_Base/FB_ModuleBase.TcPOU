    <Method Name="CycleEnd" Id="{7eb8f801-dc4e-4a84-aaca-a316a42660d2}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PROTECTED CycleEnd
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[diCycles := diCycles + 1;
diTotalCycles := diTotalCycles + 1;
diLastCycleTime := TIME_TO_UDINT(sqAuto.SeqTime);
sqAuto.StopSequence();
bBusy := FALSE;
//bStopped := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CycleStart" Id="{d25d1c4b-c9a2-4fe0-ad30-353102c7c756}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PROTECTED CycleStart
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[sqAuto.StartSequence();
bBusy := TRUE;
bStopped := FALSE;]]></ST>
      </Implementation>
    </Method>
