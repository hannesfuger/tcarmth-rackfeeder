//aSClearText := F_GetTranslatedTxtLib('engine constant velocity', eLanguage);				
IF NOT fbMovVel1.Busy THEN
	fbMovVel1(Axis := fbAxisRef, Execute := TRUE);
	eCommandExecute := E_MotionCommand.eMotionCommand_none;
ELSIF NOT fbMovVel2.Busy THEN
	fbMovVel2(Axis := fbAxisRef, Execute := TRUE);
	eCommandExecute := E_MotionCommand.eMotionCommand_none;
ELSE
	nErrorId := 0;
	M_SetLocalError(F_CreateDynText("engine constant velocity. No Component ready", 0));
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfPower" Id="{89f6e08f-f041-4ec3-b3a3-ac969b04b675}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow power axis

tonAutoPowerOff(IN := bEnable AND bEnableAutoPowerOff AND fbAxisRef.Status.NotMoving AND NOT fbAxisRef.Status.Error AND 
					  (eCommandRequest = eMotionCommand_none OR eCommandRequest = eMotionCommand_reset OR eCommandRequest = eMotionCommand_setPos) AND
					  (eCommandExecute = eMotionCommand_none OR eCommandExecute = eMotionCommand_reset OR eCommandExecute = eMotionCommand_setPos),
				PT := stDefaultPrm.stGeneralPrm.tAutoPowerOffDelay);

tonEnable(IN:=bEnable,PT := tEnableTime);
				
fbPower.Enable := tonEnable.Q AND NOT tonAutoPowerOff.Q;
fbPower.Enable_Negative := bEnableNeg;
fbPower.Enable_Positive := bEnablePos;
fbPower.Override := SEL(bHoldActiv,fSetOverride,0);
fbPower(BufferMode := MC_Aborting, Axis := fbAxisRef);

// ext. fan control
IF stIn.iMotorTemperature >= stDefaultPrm.stGeneralPrm.iExtFanThreshold THEN
	stOut.bExternalFan := TRUE;
ELSIF stIn.iMotorTemperature < (stDefaultPrm.stGeneralPrm.iExtFanThreshold - 50) THEN // hysteresis 5°C
	stOut.bExternalFan := FALSE;
END_IF

posPowerError(CLK := eState <> E_ComponentState.eComponentState_error AND fbPower.Error);
IF posPowerError.Q THEN
	nErrorId := fbPower.ErrorID;
	M_SetLocalErrorS('Axis power error: ErrId: ', TO_STRING(nErrorId));
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfReset" Id="{3852638f-12c1-48db-bb8b-a921aa83bb42}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow resetting

// call FB cyclic
fbReset(Axis:= fbAxisRef);

// FB diagnostic and reset 
IF fbReset.Execute AND NOT fbReset.Busy THEN
	IF fbReset.Error THEN			
		nErrorId := fbReset.ErrorID;
		M_SetLocalErrorS('Error on engine reset: ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbReset.Execute := FALSE;
END_IF

// force MC reset
IF eCommandExecute = eMotionCommand_resetMc THEN
	//aSClearText[0] := 'Start Antrieb MC Reset';
	//aSClearText := F_GetTranslatedTxtEx("Start engine MC reset", eLanguage);
	IF NOT fbReset.Busy THEN
		fbReset(Axis := fbAxisRef, Execute := TRUE);
		eCommandExecute := E_MotionCommand.eMotionCommand_none;
	END_IF
END_IF

// return if other command active
IF eCommandExecute <> E_MotionCommand.eMotionCommand_reset THEN
	RETURN;
END_IF

IF eAxisType = E_AxisType.AX5xxx THEN
	// reset ax5000
	//aSClearText := F_GetTranslatedTxtEx("Start engine reset", eLanguage);
	IF NOT fbAX5xxxDiag.Busy THEN
		fbAX5xxxDiag.Reset := fbAxisRef.Status.Error;
		eCommandExecute := E_MotionCommand.eMotionCommand_none;
		eState := E_ComponentState.eComponentState_ready;
	END_IF

// Bosch Indradrive
ELSIF eAxisType = E_AxisType.Bosch_IndradriveEc THEN
	// reset indradrive
	//aSClearText := F_GetTranslatedTxtEx("Start engine reset", eLanguage);
	IF NOT fbIndraDrvDiag.bBusy THEN
		fbIndraDrvDiag.bReset := fbAxisRef.Status.Error;
		eCommandExecute := E_MotionCommand.eMotionCommand_none;
		eState := E_ComponentState.eComponentState_ready;
	END_IF

ELSE
	// reset sequence of default axis types
	//aSClearText := F_GetTranslatedTxtEx("Start engine reset", eLanguage);
	IF NOT fbReset.Busy THEN
		fbReset(Axis := fbAxisRef, Execute := fbAxisRef.Status.Error);
		eCommandExecute := E_MotionCommand.eMotionCommand_none;
		eState := E_ComponentState.eComponentState_ready;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfSetPos" Id="{0e8a873e-b41a-4147-8890-e8da47c7bad1}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow set position

// call fb cyclic
fbSetPos.Position := stSetPosPrm.fPosition;
fbSetPos.Mode := stSetPosPrm.bMode;
fbSetPos.Options := stSetPosPrm.stOptions;
fbSetPos(Axis := fbAxisRef);

// FB diagnostic and reset 
IF fbSetPos.Execute AND NOT fbSetPos.Busy THEN
	IF fbSetPos.Error THEN			
		nErrorId := fbSetPos.ErrorID;
		M_SetLocalErrorS('Error set engine position: ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbSetPos.Execute := FALSE;
END_IF

// return if other command active	
IF eCommandExecute <> E_MotionCommand.eMotionCommand_setPos THEN
	RETURN;
END_IF

//aSClearText := F_GetTranslatedTxtLib('Set engine position', eLanguage);		
IF NOT fbSetPos.Busy THEN
	fbSetPos(Axis := fbAxisRef, Execute := TRUE);
	eCommandExecute := E_MotionCommand.eMotionCommand_none;
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfSoE" Id="{613d9d7b-d5c3-43b9-a336-e93b5f411756}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[// SoE commands
CASE stSoE.eCmd OF
	
	E_SoECommand.eSoECommand_writeIndraDrvPos:
		CASE stSoE.nStep OF
			0:	
				stSoE.fRealValue := (stSoE.fRealValue * 10000);
				diTempVal := REAL_TO_DINT(stSoE.fRealValue);
				stSoE.fbSoEWrite(
					Axis    := fbAxisRef,
					Idn := S_0_IDN + 52, 				// S-0-0052, Referenzmaß 1
					Element := EC_SOE_ELEMENT_VALUE,
					pSrcBuf  := ADR(diTempVal),	// Position
					BufLen   := SIZEOF(diTempVal),
					//Password := Password,				// Password   : ST_SoE_String;
					Execute  := TRUE,
					Timeout  := DEFAULT_ADS_TIMEOUT);				
				IF NOT stSoE.fbSoEWrite.Busy THEN
					IF stSoE.fbSoEWrite.Error THEN
						eState := E_ComponentState.eComponentState_error;
						nErrorID := stSoE.fbSoEWrite.AdsErrId;
						M_SetLocalError(F_CreateDynText(TO_WSTRING(Concat4('SoEWrite error, AdsErrId: ', UINT_TO_STRING(stSoE.fbSoEWrite.AdsErrId), ', SercosErrId: ', UINT_TO_STRING(stSoE.fbSoEWrite.SercosErrId))), 0));
						stSoE.nStep := 0;
						stSoE.eCmd := E_SoECommand.eSoECommand_none;
					ELSE
						stSoE.nStep := 10;
					END_IF
					stSoE.fbSoEWrite(Axis := fbAxisRef, Execute := FALSE);
				END_IF
				
			10:	stSoE.fbSoECmd(
					Axis    := fbAxisRef,
					Execute := TRUE,
					Timeout := DEFAULT_ADS_TIMEOUT,
					Idn     := S_0_IDN + 447);			// C0300 Kommando Absolutmaß setzen		P_0_IDN + 12
				IF NOT stSoE.fbSoECmd.Busy THEN
					IF stSoE.fbSoECmd.Error THEN
						eState := E_ComponentState.eComponentState_error;
						nErrorID := stSoE.fbSoEWrite.AdsErrId;
						M_SetLocalError(F_CreateDynText(TO_WSTRING(Concat4('SoECmd error, AdsErrId: ', UINT_TO_STRING(stSoE.fbSoECmd.AdsErrId), ', SercosErrId: ', UINT_TO_STRING(stSoE.fbSoECmd.SercosErrId))), 0));
					END_IF
					stSoE.fbSoECmd(Axis := fbAxisRef, Execute := FALSE);
					stSoE.nStep := 0;
					stSoE.eCmd := E_SoECommand.eSoECommand_none;
				END_IF
				
		END_CASE
		
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfStop" Id="{68a6fae1-0791-4451-a151-ee1ec20357a9}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow stopping

// call fb cyclic
fbStop.Deceleration := stStopPrm.fDeceleration;
fbStop.Jerk := stStopPrm.fJerk;
fbStop.Options := stStopPrm.stOptions;
fbStop(Axis := fbAxisRef);

// FB diagnostic and reset
IF fbStop.Execute THEN
	IF fbStop.Error THEN			
		nErrorId := fbStop.ErrorID;
		M_SetLocalErrorS('Error stopping axis: ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbStop.Execute := FALSE;
END_IF

// return if other command active
IF eCommandExecute <> E_MotionCommand.eMotionCommand_stop THEN
	RETURN;
END_IF

//aSClearText[0] := 'Antrieb Stoppen';
//aSClearText := F_GetTranslatedTxtLib('stop the engine ', eLanguage);
fbStop(Axis := fbAxisRef, Execute := TRUE);

// stop command is not auto reset -> ext. reset needed!

//IF fbAxisRef.Status.StandStill AND fbStop.Done AND NOT fbStop.Busy THEN
	eCommandExecute := E_MotionCommand.eMotionCommand_none;
//END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfTorqCtrl" Id="{c6fa4776-bf68-4756-a2cb-7de2a63f2dde}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow torque control
stTorqCtrlPrm.stOptions.ManualTorqueStartValue := fbAxisRef.NcToPlc.ActTorque;
stTorqCtrlPrm.stOptions.EnableManualTorqueStartValue := TRUE;

// call fb cyclic
fbTorqueControl.Torque := stTorqCtrlPrm.fTorque;
fbTorqueControl.TorqueRamp := stTorqCtrlPrm.fTorqueRamp;
fbTorqueControl.VelocityLimitHigh := stTorqCtrlPrm.fVelocityLimitHigh;
fbTorqueControl.VelocityLimitLow := stTorqCtrlPrm.fVelocityLimitLow;
fbTorqueControl.ContinuousUpdate := stTorqCtrlPrm.bContinuousUpdate;
fbTorqueControl.Relative := stTorqCtrlPrm.bRelative;
fbTorqueControl.BufferMode := stTorqCtrlPrm.eBufferMode;
fbTorqueControl.Options := stTorqCtrlPrm.stOptions;
fbTorqueControl(Axis := fbAxisRef);

// FB diagnostic and reset 
IF fbTorqueControl.Execute AND NOT fbTorqueControl.Busy THEN
	IF fbTorqueControl.Error AND (fbTorqueControl.ErrorID <> 17022) THEN
		nErrorId := fbTorqueControl.ErrorID;
		M_SetLocalErrorS('engine torque control: ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbTorqueControl.Execute := FALSE;
END_IF

// return if not in torque control
IF eCommandExecute <> E_MotionCommand.eMotionCommand_torqCtrl THEN
	RETURN;
END_IF

//IF NOT fbTorqueControl.Busy THEN
	fbTorqueControl(Axis := fbAxisRef, ContinuousUpdate := stTorqCtrlPrm.bContinuousUpdate, Execute := TRUE);
	eCommandExecute := E_MotionCommand.eMotionCommand_none;
//ELSE
//	nErrorId := 0;
//	M_SetLocalError(F_CreateDynText("engine torque control. Component not ready", 0));
//END_IF
]]></ST>
      </Implementation>
    </Action>
