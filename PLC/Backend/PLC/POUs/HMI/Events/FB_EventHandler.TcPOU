    <Method Name="ArgSetSb" Id="{e2cf4d4e-36ca-4e85-a6bf-fd4680840585}" FolderPath="Fluent\StringBuilder\">
      <Declaration><![CDATA[METHOD PUBLIC ArgSetSb : I_EventHandler
VAR_INPUT
	sb 		: I_StringBuilder := 0; // optional external string builder, set to 0 to use internal
END_VAR
VAR
	value	: STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF sb = 0 THEN
	sb := Isb;
END_IF

value := sb.ToString();
ArgSetSb := ArgClear().ArgAddString(value);]]></ST>
      </Implementation>
    </Method>
