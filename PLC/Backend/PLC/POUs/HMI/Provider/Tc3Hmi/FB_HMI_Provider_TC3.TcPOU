    <Method Name="M_Counter" Id="{d861ca0b-f083-4d76-bc86-90629ace4a62}">
      <Declaration><![CDATA[METHOD M_Counter : BOOL
VAR_INPUT
END_VAR
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// counter handling
fbCounter(eUserLevel := HMI.eUserLevel, stControlCounterIn := stIn.stControlCounter, stControlCounterOut := stOut.stControlCounter, stCounter := HMI.stCounter, stCounterView := stOut.stCounter);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_HmiToPlc" Id="{37424035-f23c-46fd-b31e-e511b9484f31}">
      <Declaration><![CDATA[METHOD PRIVATE M_HmiToPlc : BOOL
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// map specific in
M_SpecificIn();
M_HmiToPlc := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Init" Id="{c07d4bad-1ccc-4813-be21-5757930cee7f}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC M_Init : BOOL
VAR_INPUT
END_VAR
VAR
	ii		: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//aSClearText[EN] := 'Initialize TC3 HMI';

// set up defaults
eProvider := E_HMI_PROVIDER.eHmiProvider_TC3HMI;
ILog := SERVICES.ILog;
M_SetReferences(HMI.stHmiTc3.stOut, HMI.stHmiTc3.stIn);

// recipe, settings and user management done only by this provider
bRequestRecipeMgmt := TRUE;
bRequestSettingMgmt := TRUE;
bRequestUserMgmt := TRUE;

FOR ii := 0 TO 30 DO
	stOut.stSetupPlant[ii].stGet.wsName := stOut.stSetupPlant[ii].stGet.wsNameId := "0";
	stOut.stSetupPlant[ii].stSet.wsName := stOut.stSetupPlant[ii].stSet.wsNameId := "0";
	stOut.stSetupPlant[ii].stState.wsName := stOut.stSetupPlant[ii].stState.wsNameId := "0";
END_FOR

M_SpecificInit();

//aSClearText[EN] := 'HMI init done.';
M_Init := SUPER^.M_Init();]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PlcToHmi" Id="{d28a57fd-5088-46a3-8a40-39b60bd7bc82}">
      <Declaration><![CDATA[METHOD PRIVATE M_PlcToHmi : BOOL
VAR
	ii, nn, nnn	: DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// map HMI provider interface out to TC3 hmi (mapping of common out not needed anymore, due to reference type!)
//stTc3HmiOut.stCommon := stItfHmiOut.stCommon;

//---------------------------------------------------------------------------------------------------------------------------------------------
// system time and date
stOut.stHeader.sDateAndTime := LEFT (Statics.sTimeString, 19);

//language
stOut.stHeader.nLanguageList := 2;
stOut.stHeader.aLanguageList[0] := CONST.stTextListGlobal.stText_EN;
stOut.stHeader.aLanguageList[1] := CONST.stTextListGlobal.stText_DE;
stOut.stHeader.aLanguageList[2] := CONST.stTextListGlobal.stText_BE;

stOut.stHeader.stMessageBox1 := CONST.stTextListGlobal.stText_AllOk;
stOut.stHeader.stMessageBox2 := CONST.stTextListGlobal.stText_notextempty;
stOut.stHeader.stMessageBox3 := CONST.stTextListGlobal.stText_notextempty;

stOut.stHeader.stMessageBox1Color.color := F_ColorToStringHexColor(STATICS.stColor.Theme);
stOut.stHeader.stMessageBox2Color.color := F_ColorToStringHexColor(STATICS.stColor.Theme);
stOut.stHeader.stMessageBox3Color.color := F_ColorToStringHexColor(STATICS.stColor.Theme);

//---------------------------------------------------------------------------------------------------------------------------------------------
// default buttons

//set button language
stOut.stControlCounter.stButtonSave.stName := stTextListGlobal.stText_Save;

//--------------------------------------------------------------------------------------------------------------
// safety - ES
// safety - ES dynamic (loop)
//stOut.stEmergencyStop[0].nState := SEL(P_Safety.arrEmergencyStopState[E_EmergencyStop.eEmergencyStop_A1], 0, 1);
//stOut.stEmergencyStop[1].nState := SEL(P_Safety.arrEmergencyStopState[E_EmergencyStop.eEmergencyStop_M1P1], 0, 1);
//stOut.stEmergencyStop[2].nState := SEL(P_Safety.arrEmergencyStopState[E_EmergencyStop.eEmergencyStop_M1P2], 0, 1);

// doors
//stOut.stDoor[0].stStateColor.color := F_ColorToStringHexColor(P_Safety.fbDoor[1].iDoorStateCol);

M_SpecificOut();
M_PlcToHmi := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Popup" Id="{4535c10a-fd4b-4f4f-93af-6d169a5feca8}" FolderPath="Popup\">
      <Declaration><![CDATA[METHOD PRIVATE M_Popup : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tonResetToken.IN := bResetToken;
tonResetToken.PT := T#1S;
tonResetToken();
IF tonResetToken.Q THEN
	bResetToken := FALSE;
	M_PopupReset();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PopupCheck" Id="{542dd2da-dd40-40c9-b4e0-bce7bbe67755}" FolderPath="Popup\">
      <Declaration><![CDATA[METHOD PUBLIC M_PopupCheck : BOOL
VAR_INPUT
	nToken		: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_PopupCheck := (nPopupToken = 0) or (nPopupToken = nToken);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PopupReset" Id="{bdb7b7c5-ac2f-4f52-92ff-03e4ce81d64f}" FolderPath="Popup\">
      <Declaration><![CDATA[METHOD PUBLIC M_PopupReset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nPopupToken := 0;
stOut.stPopup.bVisible := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PopupSet" Id="{e7659773-6f45-42ac-ba75-c20524d37a93}" FolderPath="Popup\">
      <Declaration><![CDATA[METHOD PUBLIC M_PopupSet : INT
VAR_INPUT
	nToken			: int;
	stText			: ST_TEXT;
	stNameButton01	: ST_Text;
	stNameButton02	: ST_Text;
	stNameButton03	: ST_Text;
	stNameButton04	: ST_Text;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_PopupSet := 0;
nPopupToken := nToken;
stOut.stPopup.bVisible := TRUE;
stOut.stPopup.stText := stText;
stOut.stPopup.bButton01:= FALSE;
stOut.stPopup.bButton02:= FALSE;
stOut.stPopup.bButton03:= FALSE;
stOut.stPopup.bButton04:= FALSE;
IF stNameButton01.wsNameId <>"" THEN
	stOut.stPopup.bButton01:= TRUE;
	stOut.stPopup.stButton01.stName := stNameButton01;
END_IF
IF stNameButton02.wsNameId <>"" THEN
	stOut.stPopup.bButton02:= TRUE;
	stOut.stPopup.stButton02.stName := stNameButton02;
END_IF
IF stNameButton03.wsNameId <>"" THEN
	stOut.stPopup.bButton03:= TRUE;
	stOut.stPopup.stButton03.stName := stNameButton03;
END_IF
IF stNameButton04.wsNameId <>"" THEN
	stOut.stPopup.bButton04:= TRUE;
	stOut.stPopup.stButton04.stName := stNameButton04;
END_IF
IF  HMI.stHmiTc3.stIn.stPopup.stButton01.bClick THEN
	bResetToken	:= true;
	M_PopupSet := 1;
ELSIF HMI.stHmiTc3.stIn.stPopup.stButton02.bClick THEN
	bResetToken	:= TRUE;
	M_PopupSet := 2;	
ELSIF HMI.stHmiTc3.stIn.stPopup.stButton03.bClick THEN
	bResetToken	:= TRUE;
	M_PopupSet := 3;	
ELSIF HMI.stHmiTc3.stIn.stPopup.stButton04.bClick THEN
	bResetToken	:= TRUE;
	M_PopupSet := 4;		
END_IF
IF M_PopupSet <> 0 THEN
	stOut.stPopup.bVisible := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Reset" Id="{a7dc6071-1ee5-46a0-9915-4b919ad2444b}">
      <Declaration><![CDATA[/// reset
METHOD M_Reset : BOOL
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_Reset := SUPER^.M_Reset();

M_PopupReset();

bRequestManualControl := FALSE;
// recipe, settings and user management done only by this provider
//bRequestRecipeMgmt := FALSE;
//bRequestSettingMgmt := FALSE;
//bRequestUserMgmt := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Run" Id="{41e4862b-eb73-4b6f-8aac-d6a037a8f3ac}">
      <Declaration><![CDATA[METHOD M_Run : BOOL
VAR_INST
	tofCleanScreen		: TOF;
	arrModuleManMir	: ARRAY[0..E_Module.eModule_nMaxIdx] OF ST_HMI_BASE_MODULE_MANUAL_IN;
	arrStationManMir	: ARRAY[0..E_Station.eStation_nMaxIdx] OF ST_HMI_BASE_STATION_MANUAL_IN;
END_VAR
VAR
	ii : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT SUPER^.M_Run() THEN
	RETURN;
END_IF

// chk control request, e.g.: watch for changes --> stIn.arrStStation[xx].stManual...
// modules
FOR ii := 0 TO E_Module.eModule_nMaxIdx DO
	IF P_Plant.aIModule[ii] = 0 THEN CONTINUE; END_IF
	
	IF (MEMCMP(ADR(arrModuleManMir[ii]), ADR(stIn.arrStModule[ii].stManual), SIZEOF(arrModuleManMir[ii])) <> 0) THEN
		bRequestManualControl := TRUE; // request manual control on any change in .stManual. ...
	END_IF
	MEMCPY(ADR(arrModuleManMir[ii]), ADR(stIn.arrStModule[ii].stManual), SIZEOF(arrModuleManMir[ii]));
END_FOR
FOR ii := 0 TO E_Station.eStation_nMaxIdx DO	
	IF P_Plant.aIStaton[ii] = 0 THEN CONTINUE; END_IF
	
	IF (MEMCMP(ADR(arrStationManMir[ii]), ADR(stIn.arrStStation[ii].stManual), SIZEOF(arrStationManMir[ii])) <> 0) THEN
		bRequestManualControl := TRUE; // request manual control on any change in .stManual. ...
	END_IF
	MEMCPY(ADR(arrStationManMir[ii]), ADR(stIn.arrStStation[ii].stManual), SIZEOF(arrStationManMir[ii]));
END_FOR

// recipe, settings and user management done only by this provider
bRequestRecipeMgmt := TRUE;
bRequestSettingMgmt := TRUE;
bRequestUserMgmt := TRUE;

tofCleanScreen(IN := stHmi.stIn.stSpecial.stButton_CleanScreen.bClick, PT := T#1M, Q => bMute);

M_HmiToPlc(); 
M_Counter();
M_PlcToHmi();

M_Run := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SetReferences" Id="{5e7e33ce-c0c5-4400-8bfa-1ab1eaa84945}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD M_SetReferences : BOOL
VAR_IN_OUT
	stToTc3Hmi		: ST_ToTc3Hmi;
	stFromTc3Hmi	: ST_FromTc3Hmi;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_SetReferences := SUPER^.M_SetReferencesBase(stFromTc3Hmi, stToTc3Hmi);
stOut REF= stToTc3Hmi;
stIn REF= stFromTc3Hmi;]]></ST>
      </Implementation>
    </Method>
