    <Method Name="CoordinatesOf" Id="{fb9ca07f-d465-4155-b936-ffa9ed3dcdea}" FolderPath="Functions\">
      <Declaration><![CDATA[METHOD CoordinatesOf : ST_Coordinate
VAR_INPUT
	WorkpiecePlace		: INT;
END_VAR

VAR
	tmpData				: TcaCarrierConfig;
	
	tmpOffset 			: REAL;
	tmpOddRow			: INT;
	tmpEvenRow			: INT;
	tmpWorkpieceCount	: INT;
	
	tmpPos		 		: INT;
	tmpLoc		 		: INT;		
	tmpRow 				: INT;
	//tmpLvl				: INT;
	
	nRowNumber			: INT;
	nLocationNumber		: INT; 
	
	tmpCoordinate 		: ST_Coordinate;		
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _data.WorkpiecesEnabled[WorkpiecePlace] THEN
	RETURN;
END_IF	

CoordinatesOf := _WorkpiecesCoordinate[WorkpiecePlace];]]></ST>
      </Implementation>
    </Method>
    <Method Name="CountEmptyPlaces" Id="{180bc4e3-ba20-47fb-92c1-8b8a99e6818d}" FolderPath="Functions\">
      <Declaration><![CDATA[METHOD CountEmptyPlaces : INT

VAR
	tmp				: INT;
	ni				: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CountEmptyPlaces := CountPlacesByStatus(eTcaWorkpieceStatus.undefined);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CountPlacesByStatus" Id="{d8fa782e-a592-4393-b541-142317da77e8}" FolderPath="Functions\">
      <Declaration><![CDATA[METHOD CountPlacesByStatus : INT
VAR_INPUT
	Status			: eTcaWorkpieceStatus;
END_VAR

VAR
	tmp				: INT;
	ni				: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CountPlacesByStatus := 0;

FOR ni := 0 TO MAX_WORKPIECEPLACES DO

	IF NOT _data.WorkpiecesEnabled[ni] THEN
		CONTINUE;
	END_IF	
	
	IF _data.WorkpiecesData[ni].Error THEN
		CONTINUE;
	END_IF

	IF _data.WorkpiecesData[ni].CurrentStatus = Status THEN
			tmp := tmp + 1;
	END_IF
	
END_FOR

CountPlacesByStatus := tmp;]]></ST>
      </Implementation>
    </Method>
