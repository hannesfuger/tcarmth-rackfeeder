<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <DUT Name="E_EcDeviceState" Id="{da0e86a2-2b62-4afb-9152-fc69a1bcc5f5}">
    <Declaration><![CDATA[/// Enumeration of possible EtherCAT states.
TYPE E_EcDeviceState :
(
	/// no error
	eEtherCATState_NoError := 0,
	/// Link error
	eEtherCATState_LinkError := 16#1,
	/// I/O locked after link error (I/O reset required)
	eEtherCATState_IoLockedAfterLinkErr := 16#2,
	/// Link error (redundancy adapter)
	eEtherCATState_LinkErrRedAdapter := 16#4,
	/// Missing one frame (redundancy mode)
	eEtherCATState_MissingFrame := 16#8,
	/// Out of send resources (I/O reset required)
	eEtherCATState_OutOfSendResources := 16#10,
	/// Watchdog triggered
	eEtherCATState_WatchdogTriggered := 16#20,
	/// Ethernet driver (miniport) not found
	eEtherCATState_EthernetDrvNotFound := 16#40,
	/// I/O reset active
	eEtherCATState_IO_resetActive := 16#80,
	/// At least one device in 'INIT' state
	eEtherCATState_AtLeastOneDeviceInit := 16#100,
	///  At least one device in 'PRE-OP' state
	eEtherCATState_AtLeastOneDevicePreOp := 16#200,
	/// At least one device in 'SAFE-OP' state
	eEtherCATState_AtLeastOneDeviceSafeOp := 16#400,
	/// At least one device indicates an error state
	eEtherCATState_AtLeastOneDeviceError := 16#800,
	/// DC not in sync
	eEtherCATState_DC_notInSync := 16#1000
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>