<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.4">
  <DUT Name="E_ComponentState" Id="{dc5df259-8a08-4361-810c-c2d873cd0bb4}">
    <Declaration><![CDATA[/// Enumeration of all possible (sub) component states
TYPE E_ComponentState :
(
	/// Component state not set
	eComponentState_none := 0,
	/// Component is resetting
	eComponentState_resetting,
	/// Component is ready
	eComponentState_ready,
	/// Component is running
	eComponentState_running,
	/// Component has error
	eComponentState_error,
	/// Component has warning
	eComponentState_warning,
	/// Component has info
	eComponentState_info
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>