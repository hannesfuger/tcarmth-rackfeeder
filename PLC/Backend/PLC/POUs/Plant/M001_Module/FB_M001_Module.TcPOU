    <Method Name="M_Run" Id="{fe3a7cc9-466d-455f-b51d-3bad0f9a9a53}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC M_Run : BOOL
VAR_INPUT
END_VAR
VAR
	b1stShot				: BOOL := TRUE;
	stModuleStationsInfoRef	: REFERENCE TO ST_MODULE_STATIONS_INFO;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bSafetyOk := P_Safety.SafetyOk;
aIStaton[E_Station.eStation_ST010_OvenA].SafetyOk := P_Safety.SafetyOk;
aIStaton[E_Station.eStation_ST020_OvenB].SafetyOk := P_Safety.SafetyOk;
aIStaton[E_Station.eStation_ST030_Handling].SafetyOk := P_Safety.SafetyOk;
aIStaton[E_Station.eStation_ST040_Storage].SafetyOk := P_Safety.SafetyOk;
aIStaton[E_Station.eStation_ST050_Mould].SafetyOk := P_Safety.SafetyOk;

// call module base (calls station run)
M_Run := SUPER^.M_Run();

M_DynSettings();
M_DynManual();
M_DynMonitoring();

// loop module stations, collect infos
b1stShot := TRUE;
stModuleStationsInfoRef REF= stGlobalModuleInfo.astModuleStationsInfo[eModule];
FOR ii := 0 TO E_Station.eStation_nMaxIdx DO
	IF aIStaton[ii] = 0 THEN
		CONTINUE;
	END_IF
	
	F_AND_REF_EX(stModuleStationsInfoRef.bStation_All_Auto, aIStaton[ii].OpMode = E_OpMode.eOpMode_auto, b1stShot);
	F_OR_REF_EX(stModuleStationsInfoRef.bStation_Any_Step, aIStaton[ii].OpMode = E_OpMode.eOpMode_step, b1stShot);
	F_OR_REF_EX(stModuleStationsInfoRef.bStation_Any_Manual, aIStaton[ii].OpMode = E_OpMode.eOpMode_manual, b1stShot);
	
	F_OR_REF_EX(stModuleStationsInfoRef.bStation_Any_Error, aIStaton[ii].State = E_ComponentState.eComponentState_error, b1stShot);
	F_OR_REF_EX(stModuleStationsInfoRef.bStation_Any_Warning, aIStaton[ii].State = E_ComponentState.eComponentState_warning, b1stShot);
	F_OR_REF_EX(stModuleStationsInfoRef.bStation_Any_Info, aIStaton[ii].State = E_ComponentState.eComponentState_info, b1stShot);
	
	F_AND_REF_EX(stModuleStationsInfoRef.bStation_All_Started, (aIStaton[ii].OpMode = E_OpMode.eOpMode_auto OR aIStaton[ii].OpMode = E_OpMode.eOpMode_step) AND aIStaton[ii].RunCycle, b1stShot);
	F_AND_REF_EX(stModuleStationsInfoRef.bStation_All_Stopped, aIStaton[ii].Stopped, b1stShot);
	F_AND_REF_EX(stModuleStationsInfoRef.bStation_All_InHome, aIStaton[ii].InHome, b1stShot);
	F_OR_REF_EX(stModuleStationsInfoRef.bStation_Any_Homing, aIStaton[ii].Homing, b1stShot);
	
	b1stShot := FALSE;
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Sequence" Id="{ac56d7f6-30a2-4ce2-89f2-cc7ec18079eb}">
      <Declaration><![CDATA[METHOD PROTECTED M_Sequence
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// signal mapping (e.g.: enable)
stM001IModule.bRunCycle := RunCycle;

// automatic sequence
CASE sqAuto.Step OF
	
	0:	sqAuto.Info.Set("Warte auf Auto Start");
		IF NOT (RunCycle AND RunStep) THEN RETURN; END_IF
		
		sqAuto.Info.Set("Warte auf GRST");
		//IF sqHome.InHome AND bInHome THEN
			//fbAxisVm.SetPos(0);
			sqHome.InHome := FALSE;
			sqAuto.Step := 10;
		//ELSE
		//	INotiHdl.M_SetNotiDefaultInf(stTextlistGlobal.stText_NG_Stations, Name, stTextlistGlobal.stText_station_not_in_hp, stEmptyText);
		//END_IF
		
	10:	sqAuto.Info.Set("Prüfe Startbedingungen");
		IF NOT RunCycle THEN sqAuto.Step := 900; END_IF				
		CycleStart();		
		sqAuto.Step := 100;
		
	// work
	100: sqAuto.Info.Set("Automatik");
		TransitionLogic();
		IF NOT RunCycle THEN
			sqAuto.Step := 900;
		END_IF
		
	// stop from safety	or error
	800: sqAuto.Info.Set("Fehler/Safety Stop!");
		FOR ii := 0 TO E_Station.eStation_nMaxIdx DO
			IF aIStaton[ii] <> 0 THEN
				aIStaton[ii].RunCycle := FALSE;
			END_IF
		END_FOR
		sqAuto.Step := 900;		
		
	// rdy	
	900: sqAuto.Info.Set("Zyklus beendet");
		CycleEnd();
		sqAuto.Step := 0;

	// error
	1000: sqAuto.Info.Set("Error");
		bStopped := TRUE;
		sqHome.InHome := FALSE;
		bRunHoming := FALSE;

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SetReferences" Id="{95732bac-aa45-4a9a-b22b-be5de48f12fe}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD INTERNAL M_SetReferences : BOOL
VAR_IN_OUT
	stIoRef : ST_M001_IO;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIO REF= stIoRef;
M_SetReferences := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Supervision" Id="{88eca460-e5f0-4020-8dbf-712cb042cb10}">
      <Declaration><![CDATA[METHOD PROTECTED M_Supervision : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// to be subclassed// chk stopped
IF NOT bRunCycle OR P_Safety.bMachineRequestStop THEN
	IF sqAuto.StepTime > T#20S THEN
		bStopped := TRUE;
	END_IF
END_IF

(*ToDo: // axis
IF fbAxisVm.bError THEN
	SUPER^.M_SetNotification(F_CreateDynTextUn(E_UniqNoti.eUniqNoti_M001_Module_ServoVm),	// id
					Name,																	// group (e.g.: station name)
					fbAxisVm.Name,															// txt1 (e.g.: source)
					fbAxisVmUi.stErrorText,													// txt2 (e.g.: error text)
					fbAxisVmUi.stBmk,														// txt3 (e.g.: BMK)
					E_AlarmPriority.Error,													// prio
					E_NotificationMode.eNotificationMode_Reset,								// notification mode
					E_AlarmStopMode.Stop);													// alarm stop mode
					

					
ELSIF NOT stIO.stIn.bCentrSuctPwrCircBreakerOk THEN
	SUPER^.M_SetNotification(F_CreateDynTextUn(E_UniqNoti.eUniqNoti_M001_CentralSuction),
					Name,
					F_CreateDynTextDefault("Fehler Netz Schutzschalter"),
					fbCentrSuction.Name,
					F_CreateDynTextDefault("BMK=+xyz-"),
					E_AlarmPriority.Error,
					E_NotificationMode.eNotificationMode_Reset,
					E_AlarmStopMode.Stop);
END_IF *)
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{dedc3dfa-3d36-43ed-a3df-30ac47927668}" FolderPath="Internal\">
      <Declaration><![CDATA[/// Reset station logic
{attribute 'object_name' := 'Reset'}
METHOD Reset
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// base logic run
SUPER^.Reset();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TransitionLogic" Id="{d5dac726-d3a5-4591-a1f8-66a547b0dcc6}" FolderPath="StateEngine\">
      <Declaration><![CDATA[METHOD PRIVATE TransitionLogic : INT
VAR
	hgCmd : ST_St030_Command;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Plant.stSt050IMould.bEnableHG THEN
	sqAuto.Info.Set("Wait for HG enable from mould");
	RETURN;
END_IF

// switxh logic by type
CASE Services.stSettings.stProduct_Settings[E_ProductSettings.eProductSettings_ProductType].nValue OF // or use production settings...
	3: hgCmd := GetHgCmd_Type3(); // e.g.: impelemt custom handling command for type 3...
	5: hgCmd := GetHgCmd_Type5(); // e.g.: impelemt custom handling command for type 5...
	6: hgCmd := GetHgCmd_Type6(); // e.g.: impelemt custom handling command for type 6...
ELSE
	
	// default logic
	hgCmd := GetHgCmd_Default();
END_CASE

Plant.stSt030IHandling.CommandRequest := hgCmd;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>