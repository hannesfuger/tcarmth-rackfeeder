    <Method Name="M_DynMonitoring" Id="{d8e9594f-1f17-46b4-97d3-79b662b97cf4}" FolderPath="DynSetMonObj\">
      <Declaration><![CDATA[METHOD PROTECTED M_DynMonitoring : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_DynMonitoring := SUPER^.M_DynMonitoring();

// init
IF NOT bInitMonitoring THEN
	bInitMonitoring := TRUE;
	MEMSET(ADR(stLocalMonitoring), 0, SIZEOF(stLocalMonitoring)); // reset
	
	M_InitDynMonitoringItem(0, 								// monitoring index 
							"VM Position", 					// name
							Name, 							// group (station name)
							E_DataType.eDataType_lreal, 	// data type							
							stTextListGlobal.stText_m);		// unit	

	M_InitDynMonitoringItem(1, "VM Geschwindigkeit", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_mmin);
END_IF

//stLocalMonitoring.astMonitoring[0].fValue := stM001IModule.fVmPos;
//stLocalMonitoring.astMonitoring[1].fValue := stM001IModule.fVmSpeed;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_DynSettings" Id="{6dcff948-d31f-47e0-a2a0-588197f4fa0c}" FolderPath="DynSetMonObj\">
      <Declaration><![CDATA[METHOD INTERNAL M_DynSettings : BOOL
VAR_INST
	fSpeedMir : LREAL;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[// init station settings
IF NOT bInitSettings THEN
	bInitSettings := TRUE;
	stLocalSettingsBackup := stLocalSettings; // backup
	MEMSET(ADR(stLocalSettings), 0, SIZEOF(stLocalSettings)); // reset
	
	M_InitDynSettingsItem(E_M001_Settings.eM001_Settings_Deaktiv,		// settings index
		TO_WSTRING(E_M001_Settings.eM001_Settings_Deaktiv),				// settings wsIndex
		Name,															// group
		stTextListGlobal.stText_DeactivateModule,						// name
		stTextListGlobal.stText_bool, E_DataType.eDataType_bool,		// unit & data type
		0, 1, 6);														// min, max & user level

	M_InitDynSettingsItem(E_M001_Settings.eM001_Settings_Autohome,
		TO_WSTRING(E_M001_Settings.eM001_Settings_Autohome),
		Name,
		stTextListGlobal.stText_AutoHome,
		stTextListGlobal.stText_bool, E_DataType.eDataType_bool,
		0, 1, 3);
		
//	M_InitDynSettingsItem(E_M001_Settings.eM001_Settings_PalletLayout,
//		TO_WSTRING(E_M001_Settings.eM001_Settings_PalletLayout),
//		Name,
//		F_CreateDynTextDefault("Palettenlayout (1-4)"),
//		stTextListGlobal.stText_notext, E_DataType.eDataType_int,
//		1, 4, 3);
		
	// restore values
	F_RestoreSettingValues(stLocalSettings.stDynStationSettings, stLocalSettingsBackup.stDynStationSettings);
END_IF

// run settings mgmt
//F_Settings_Management(stLocalSettings.stDynStationSettings);

// map current settings values
bAutoHome := stLocalSettings.stDynStationSettings[E_M001_Settings.eM001_Settings_Autohome].bValue;

]]></ST>
      </Implementation>
    </Method>
