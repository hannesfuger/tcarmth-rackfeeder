    <Method Name="IsEmptySlotAt" Id="{b6ed80dd-3ce7-48ba-bfca-37c6d5a5e5ca}" FolderPath="Functions\">
      <Declaration><![CDATA[METHOD PUBLIC IsEmptySlotAt : BOOL
VAR_INPUT
	Position	 : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Position < 0 OR Position > MAX_CARRIERPLACES OR NOT _data.CarriersEnabled[Position] THEN
   IsEmptySlotAt := FALSE;
   RETURN;
END_IF
   
IsEmptySlotAt := NOT _data.CarriersData[Position].Enabled;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveCarrierAt" Id="{0a0c83a8-d580-4e20-a2d4-441515e6f4fc}" FolderPath="Functions\">
      <Declaration><![CDATA[METHOD PUBLIC RemoveCarrierAt : BOOL
VAR_INPUT
	Position	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Position < 0 OR Position > MAX_CARRIERPLACES OR NOT _data.CarriersEnabled[Position] THEN
   RETURN;
END_IF

_data.CarriersData[Position].Enabled := FALSE;]]></ST>
      </Implementation>
    </Method>
