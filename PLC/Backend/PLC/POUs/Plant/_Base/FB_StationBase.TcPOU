    <Property Name="InHome" Id="{6a5ace07-5006-4caa-b686-c8b542cb3a49}" FolderPath="Properties\">
      <Declaration><![CDATA[/// Station in Home flag
{attribute 'monitoring':='call'}
PROPERTY InHome : BOOL
]]></Declaration>
      <Get Name="Get" Id="{620ea1cd-6ef3-450e-8e8d-d7e211d4ad3c}">
        <Declaration><![CDATA[VAR

END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[InHome := TRUE;
//FOR ii := 0 TO iNumberOfStepChains - 1 DO
	IF NOT sqHome.InHome THEN
		InHome := FALSE;
	END_IF
//END_FOR

bInHome := InHome;
IF InHome THEN
	bRunHoming := FALSE;
END_IF
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="InitEvents" Id="{f7ca0fb6-bc90-4005-9d7e-929db98cbd24}" FolderPath="Events\">
      <Declaration><![CDATA[METHOD PUBLIC InitEvents : IStation
VAR_IN_OUT CONSTANT
	infoEvent,
	warnEvent,
	errorEvent : TcEventEntry;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// create default station alarms
localEvents.Info := infoEvent;
localEvents.Warning := warnEvent;
localEvents.Error := errorEvent;
IEvent.CreateAlarm(infoEvent, FALSE, TcSourceInfo)
	  .CreateAlarm(warnEvent, TRUE, TcSourceInfo)
	  .CreateAlarm(errorEvent, TRUE, TcSourceInfo);

InitEvents := THIS^;]]></ST>
      </Implementation>
    </Method>
