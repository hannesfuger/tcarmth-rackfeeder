{attribute 'to_string'}
{attribute 'to_wstring'}
TYPE E_User_Level :
(
	eUser_Level_none := 0,			(*user level 0 = none 1= Operator 2 = Plant Manager 3 = maintenance 4 = reserve 5= admin*)
	eUser_Level_Operator,			(* 1 = Bediener*)
	eUser_Level_Manager,			(* 2 = Einsteller*)
	eUser_Level_Maintenance,		(* 3 = Instandhalter*)
