    <Method Name="M_Run" Id="{4bea32ab-ef45-430f-b1b8-b1769c0ad78d}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC M_Run : BOOL
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_Run := TRUE; // to be subclassed..

// call component run
SUPER^.Run();

// Safety OP-Mode
rtirgSafetyOpMode_Auto(CLK := stHmiToStation.eSafetyOpMode = E_Opmode.eOpMode_auto);
rtirgSafetyOpMode_Hand(CLK := stHmiToStation.eSafetyOpMode = E_Opmode.eOpMode_manual);
rtirgSafetyOpMode_Aus(CLK := stHmiToStation.eSafetyOpMode = E_Opmode.eOpMode_off);

// reset (all or this station)
IF stHmiToStation.bReset THEN
	Reset();
END_IF

// step (all or this station)
// step -> ist bei Auto über die Property immer TRUE
bRunStep := stHmiToStation.bStep;
	
// start (all or this station)
IF stHmiToStation.bStart OR P_Safety.bMachineRequestStart OR stHmiToStation.bStep THEN		
	IF NOT bEnable THEN
		StationWarning.ArgSetString('Kein Enable Signal bei Start').Raise();
	ELSIF NOT bSafetyOk THEN
		StationWarning.ArgSetString('Safety nicht ok bei Start').Raise();
	// Fehler steht noch an
	ELSIF bAutoStop_Error THEN
		StationWarning.ArgSetString('Station in Fehlerstatus --> Reset').Raise();

	// Safety muss in Auto sein
	ELSIF stHmiToStation.eSafetyOpMode <> E_Opmode.eOpMode_auto AND Const.bEnSafetyOpMode THEN
		StationWarning.ArgSetString('Safety Betriebsart nicht AUTO').Raise();
		
	// START
	ELSIF (OpMode = E_Opmode.eOpMode_auto OR OpMode = E_Opmode.eOpMode_step) THEN
		//bRunStep := FALSE;
		bRunCycle := TRUE;
	END_IF
END_IF

// cycle stop (all or this station)
IF stHmiToStation.bStop OR P_Safety.bMachineRequestCycleStop OR P_Supervision.bCycleStop THEN
	bRunCycle := bRunHoming := FALSE;
END_IF

// fast stop (all or this station)
IF stHmiToStation.bFastStop OR P_Supervision.bFastStop THEN 
	bRunCycle := bRunStep := bRunHoming := FALSE;
END_IF

// set op mode (all or this station)
tonOpModeOff(IN := stHmiToStation.bStop, PT := T#10S);
IF stHmiToStation.bOpModeManual OR rtirgSafetyOpMode_Hand.Q THEN
	bRunStep := FALSE;
	bRunCycle := FALSE;
	bRunHoming := FALSE;
	eOpMode := E_OpMode.eOpMode_manual;
ELSIF stHmiToStation.bOpModeAuto OR rtirgSafetyOpMode_Auto.Q THEN
	bRunStep := FALSE;
	bRunCycle := FALSE;
	bRunHoming := FALSE;
	eOpMode := E_OpMode.eOpMode_auto;
ELSIF stHmiToStation.bOpModeStep THEN
	bRunStep := FALSE;
	bRunCycle := FALSE;
	bRunHoming := FALSE;
	eOpMode := E_OpMode.eOpMode_step;
ELSIF tonOpModeOff.Q THEN
	eOpMode := E_OpMode.eOpMode_off;
END_IF
	
IF NOT bEmergencyStopOk THEN
	sqHome.InHome := FALSE;
	sqHome.Step := 0;
	sqAuto.Step := 0;
END_IF

// homing (all or this station)
IF stHmiToStation.bHome OR (stHmiToStation.bStart AND bAutoHome AND NOT sqHome.InHome AND sqHome.Step = 0 AND sqAuto.Step = 0) THEN
	IF NOT bEnable THEN
		StationWarning.ArgSbAppendRaise('Kein Enable Signal bei Start Grundstellung');
	ELSIF NOT bSafetyOk THEN
		StationWarning.ArgSbAppendRaise('Safety nicht ok bei Start Grundstellung');
		
	// Fehler steht noch an
	ELSIF bAutoStop_Error THEN
		StationWarning.ArgSbAppendRaise('Station in Fehlerstatus --> Reset');
	ELSE		
		sqHome.Step := 0;
		sqHome.InHome		:= FALSE;
		bRunCycle			:= FALSE;
		bRunHoming 			:= TRUE;
	END_IF
END_IF

/// Set Station State Color
IF State = eComponentState_error THEN
	nStateColor := STATICS.stColor.Red;
ELSIF bInHome AND (eOpMode = eOpMode_Auto OR eOpMode = eOpMode_Step) THEN	
	nStateColor := STATICS.stColor.LightBlue;
ELSIF bStopped AND (eOpMode = eOpMode_Auto OR eOpMode = eOpMode_Step) THEN
	nStateColor := STATICS.stColor.Blue;									
ELSIF State = eComponentState_running AND (eOpMode = eOpMode_Auto OR eOpMode = eOpMode_Step) THEN
	nStateColor := STATICS.stColor.LimeGreen;					
ELSIF State = eComponentState_running AND eOpMode = eOpMode_manual THEN
	nStateColor := STATICS.stColor.Orange;		
ELSE
	nStateColor := STATICS.stColor.White;
END_IF

//StepChainTextMapping
//stTextAuto := arraSTextAuto[iStepChainIndex];
//IF iStepChainIndex >= 0 AND iStepChainIndex <= CONST.iMaxIdxLocalStepChain THEN
	stTextAuto.nNameId := sqAuto.InfoTextId;
	stTextAuto.wsName := WConcat3(TO_WSTRING(sqAuto.Step),": ", sqAuto.Info.ToWString());
	stTextAuto.wsNameId := WConcat3(TO_WSTRING(sqAuto.Step),": ", sqAuto.InfoTextWsId);	
	
	//stTextHome := arraSTextHome[iStepChainIndex];
	stTextHome.nNameId := sqHome.InfoTextId;
	stTextHome.wsName := WConcat3(TO_WSTRING(sqHome.Step), ": ", sqHome.Info.ToWString());
	stTextHome.wsNameId := WConcat3(TO_WSTRING(sqHome.Step),": ", sqHome.InfoTextWsId);
//END_IF

rtrigOpModeChanged(CLK := eOpModeOld <> eOpMode);
IF rtrigOpModeChanged.Q THEN
	eOpModeOld := eOpMode;
	M_OpModeChanged();
END_IF

//call methodes
sqHome.EnableStep := RunStep;
sqHome();
sqAuto.EnableStep := RunStep;
sqAuto();

M_CallObjects();
M_Homing();
M_Sequence();
M_Manual();
M_Supervision();]]></ST>
      </Implementation>
    </Method>
