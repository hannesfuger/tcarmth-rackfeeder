	fDeceleration	: LREAL;	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// move axis vel

// init result pessimistic
MoveVelAccDec := E_OperationResult.eOperationResult_NOk;

// if stopping or resetting is active return --> higher prio
IF eCommandExecute = E_MotionCommand.eMotionCommand_reset OR eCommandExecute = E_MotionCommand.eMotionCommand_stop THEN
	RETURN;
END_IF

stMovVelPrm := stDefaultPrm.stMovVelPrm;
stMovVelPrm.fVelocity := fVelocity;
stMovVelPrm.eDirection := eDirection;
stMovVelPrm.fAcceleration := fAcceleration;
stMovVelPrm.fDeceleration := fDeceleration;

eCommandRequest := E_MotionCommand.eMotionCommand_moveVel;
MoveVelAccDec := E_OperationResult.eOperationResult_Ok;]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveVelEx" Id="{0aab1f1d-aaf5-4d54-b814-884d20a9023b}" FolderPath="AxisCmdMethods\">
      <Declaration><![CDATA[/// Performs an velocity axis movement using specified parameter
/// This motion is capable to overlay (max. 2 parallel at one time)
{attribute 'object_name' := 'MoveVelEx'}
METHOD MoveVelEx : E_OperationResult
VAR_INPUT
	/// Parameter set to use
	stMovVelParameter: ST_AxisMoveVelParameter;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// move axis abs

MoveVelEx := THIS^.MoveVel(stMovVelParameter.fVelocity, stMovVelParameter.eDirection);

IF MoveVelEx = E_OperationResult.eOperationResult_Ok THEN
	stMovVelPrm := stMovVelParameter;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Moving" Id="{af6c8c6d-59ac-48bd-ad09-32ea6f1dda8a}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Moving : BOOL
]]></Declaration>
      <Get Name="Get" Id="{c33cabab-1190-48c3-8ab5-fa2523fe4312}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Moving := fbAxisRef.Status.Moving;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NotMoving" Id="{57239cdf-311f-4aaf-9a05-d598bb2e17f1}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY NotMoving : BOOL
]]></Declaration>
      <Get Name="Get" Id="{ce9f4ee9-82d6-4788-b049-5e985644f37c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[NotMoving := fbAxisRef.Status.NotMoving;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Override" Id="{4152e1b3-7f6f-4df6-9a03-2c82751fdc7f}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Override : LREAL
]]></Declaration>
      <Get Name="Get" Id="{71af583a-5831-4315-ba01-95047b073bea}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Override := fSetOverride;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{a9ced325-4067-4308-99db-ebcf09e267d4}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[fSetOverride := LIMIT(0, Override, 100);]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="PositionReachedOrHigher" Id="{6ba55824-65c3-4193-81d2-ab29273afa63}" FolderPath="Methods\">
      <Declaration><![CDATA[/// Get's a value, indicating whether axis position is in target position or higher.
METHOD PUBLIC PositionReachedOrHigher : BOOL
VAR_INPUT
	fPosition	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[PositionReachedOrHigher := Position >= (fPosition - fEpsilon);]]></ST>
      </Implementation>
    </Method>
    <Method Name="PositionReachedOrLower" Id="{a0cc3a2e-30b9-41ef-96fb-48ad55f5eba9}" FolderPath="Methods\">
      <Declaration><![CDATA[/// Get's a value, indicating whether axis position is in target position or lower.
METHOD PUBLIC PositionReachedOrLower : BOOL
VAR_INPUT
	fPosition	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[PositionReachedOrLower := Position <= (fPosition + fEpsilon);]]></ST>
      </Implementation>
    </Method>
    <Method Name="PositionReachedWindow" Id="{c0d97e2f-da26-4eb3-b521-022f694a4a8a}" FolderPath="Methods\">
      <Declaration><![CDATA[/// Get's a value, indicating whether axis position is in target position window.
METHOD PUBLIC PositionReachedWindow : BOOL
VAR_INPUT
	fPosition	: LREAL;
	fWindow 	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[PositionReachedWindow := ABS(Position - fPosition) <= fWindow AND NotMoving;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{dc0952ce-b758-47c3-a3f4-061239d43abc}" FolderPath="Methods\">
      <Declaration><![CDATA[/// Reset component logic
{attribute '' := ''}
{attribute 'object_name' := 'Reset'}
METHOD Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// base logic run
SUPER^.Reset();

// reset axis
tonTimeout(IN := FALSE);
eCommandRequest := E_MotionCommand.eMotionCommand_reset;
eState := E_ComponentState.eComponentState_resetting;

nErrorId := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetMc" Id="{9b3bcf37-9c8f-4942-86f3-8bc51c5e43de}" FolderPath="AxisCmdMethods\">
      <Declaration><![CDATA[/// Forces MC reset (e.g.: reset lag distance)
METHOD ResetMc : E_OperationResult
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// set axis pos

// init result pessimistic
ResetMc := E_OperationResult.eOperationResult_NOk;

// if stopping or resetting is active return --> higher prio
IF eCommandExecute = E_MotionCommand.eMotionCommand_reset OR eCommandExecute = E_MotionCommand.eMotionCommand_stop THEN
	RETURN;
END_IF

eCommandRequest := eMotionCommand_resetMc;

ResetMc := E_OperationResult.eOperationResult_Ok;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Run" Id="{14da8f46-bb3a-4659-8b28-b3f39c173427}" FolderPath="Methods\">
      <Declaration><![CDATA[/// Run component logic
{attribute 'object_name' := 'Run'}
METHOD Run : E_ComponentState
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// base logic run
Run := SUPER^.Run();

// return here as long axis ref not set
IF NOT __ISVALIDREF(fbAxisRef) THEN
	//aSClearText[0] := 'Axis ref not set!';
	//aSClearText := F_GetTranslatedTxtLib("Axis ref not set!", eLanguage);
	RETURN;
END_IF

// switch case request
CASE eCommandRequest OF	
	/// No command
	E_MotionCommand.eMotionCommand_none:
	
	/// Reset axis
	E_MotionCommand.eMotionCommand_reset, eMotionCommand_resetMc:
		IF (eCommandExecute <> E_MotionCommand.eMotionCommand_stop AND eCommandExecute <> E_MotionCommand.eMotionCommand_halt) OR fbAxisRef.Status.StandStill THEN
			eCommandExecute := eCommandRequest;
			eCommandRequest := E_MotionCommand.eMotionCommand_none;
		END_IF
	
	/// Axis halt (default stopping method)
	E_MotionCommand.eMotionCommand_halt:
		IF eCommandExecute <> E_MotionCommand.eMotionCommand_stop THEN
			eCommandExecute := eCommandRequest;
			eCommandRequest := E_MotionCommand.eMotionCommand_none;
		END_IF;
	
	/// Axis stop (needs reset before next motion command)
	E_MotionCommand.eMotionCommand_stop:
		eCommandExecute := eCommandRequest;
		eCommandRequest := E_MotionCommand.eMotionCommand_none;
	
	/// other commands
	E_MotionCommand.eMotionCommand_home,
	E_MotionCommand.eMotionCommand_jog,
	E_MotionCommand.eMotionCommand_jogAcc,
	E_MotionCommand.eMotionCommand_moveAbs,
	E_MotionCommand.eMotionCommand_moveAdd,
	E_MotionCommand.eMotionCommand_moveRel,
	E_MotionCommand.eMotionCommand_moveMod,
	E_MotionCommand.eMotionCommand_moveVel,
	E_MotionCommand.eMotionCommand_torque,
	E_MotionCommand.eMotionCommand_gearIn,
	E_MotionCommand.eMotionCommand_gearOut,
	E_MotionCommand.eMotionCommand_touchProbe,
	E_MotionCommand.eMotionCommand_torqCtrl:
		// wait for active command none and axis ready
		IF eCommandExecute = eMotionCommand_none AND fbPower.Status THEN
			eCommandExecute := eCommandRequest;
			eCommandRequest := E_MotionCommand.eMotionCommand_none;
		END_IF
		
	E_MotionCommand.eMotionCommand_setPos,
	E_MotionCommand.eMotionCommand_setAxPosOffs:
		IF eCommandExecute = eMotionCommand_none THEN
			eCommandExecute := eCommandRequest;
			eCommandRequest := E_MotionCommand.eMotionCommand_none;
		END_IF
	
END_CASE

// call workflows 
WfDiagnostic();
WfPower();
WfReset();
WfHome();
WfSetPos();
WfJog();
WfJogAcc();
WfMovAbs();
WfMovAdd();
WfMovRel();
WfMovMod();
WfMovVel();
WfGearIn();
WfGearOut();
WfTorqCtrl();
WfHalt();
WfStop();
WfErrorHandling();
WfSoE();
WfInitPositionOffset();
WfAxSetPosOffset();

// set clear text
IF eState <> E_ComponentState.eComponentState_error THEN
	;
ELSE
	aSClearText := F_CreateDynText( WConcat("error number: ", UDINT_TO_WSTRING(nErrorID)), 0);
	// try get details
	IF eAxisType = E_AxisType.AX5xxx THEN
		IF fbAxisRef.Status.Error AND stAX5xxxDiag.stDiagNumberList.arrDiagNumbers[0] <> 0 THEN
			sMsg := stAX5xxxDiag.strDiagMessage; // display diag msg
			FOR ii := 0 TO 2 DO	// add first 3 error codes 
				sMsg := Concat3(sMsg, ', ', UDINT_TO_STRING(stAX5xxxDiag.stDiagNumberList.arrDiagNumbers[ii]));
			END_FOR
			aSClearText.wsName := STRING_TO_WSTRING(sMsg);
		END_IF
	// Bosch Indradrive
	ELSIF eAxisType = E_AxisType.Bosch_IndradriveEc THEN
		sMsg := stIndraDrvDiag.strDiagMessage; // display diag msg
		FOR ii := 0 TO 2 DO	// add first 3 error codes 
			sMsg := Concat3(sMsg, ', ', UDINT_TO_STRING(stIndraDrvDiag.stDiagNumberList.arrDiagNumbers[ii]));
		END_FOR
		aSClearText.wsName := STRING_TO_WSTRING(sMsg);
		
	END_IF
END_IF

// Ausgabedaten
bError := (eState = E_ComponentState.eComponentState_error);
Position := fbAxisRef.NcToPlc.ActPos;
ModuloPosition := fbAxisRef.NcToPlc.ModuloActPos;
Operational := fbAxisRef.Status.Operational AND NOT fbAxisRef.Status.Disabled;
fPosDiff := fbAxisRef.NcToPlc.PosDiff;
Homed := fbAxisRef.Status.Homed;
bHasJob := fbAxisRef.Status.HasJob;
bHoldActiv := bHold;
bHold := FALSE;

CheckLatchState();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetAxisReference" Id="{1436a276-f397-4f1b-af4c-39c10125e030}" FolderPath="Methods\">
      <Declaration><![CDATA[/// Set axis reference
{attribute 'object_name' := 'SetAxisReference'}
METHOD SetAxisReference
VAR_IN_OUT
	/// NC Axis reference
	fbRefAxis: AXIS_REF;
	/// Additional inputs from axis
	stRefIn: ST_AxisIn;
	/// Additional outputs to axis
	stRefOut: ST_AxisOut;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbAxisRef REF= fbRefAxis;
stIn REF= stRefIn;
stOut REF= stRefOut;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetAxPosOffs" Id="{29fe56f0-c445-413e-8d6e-70f3131b49a1}" FolderPath="AxisCmdMethods\">
      <Declaration><![CDATA[/// Set axis position, method with minimal options
{attribute 'object_name' := 'SetAxPosOffs'}
METHOD SetAxPosOffs : E_OperationResult
VAR_INPUT
	/// Parameter set to use
	fPosition 	: REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// set ax axis pos offset

// init result pessimistic
SetAxPosOffs := SetAxPosOffsEx(fPosition, FALSE, 
					E_PositionOffsetFeedback.ePositionOffsetFeedback1, 
					E_PositionOffsetMemory.ePositionOffsetMemory_Drive);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetAxPosOffsEx" Id="{b76eae14-edbd-45d0-a62e-b188abffa8ce}" FolderPath="AxisCmdMethods\">
      <Declaration><![CDATA[/// Set axis position, extended method with all options
{attribute 'object_name' := 'SetAxPosOffsEx'}
METHOD SetAxPosOffsEx : E_OperationResult
VAR_INPUT
	/// Parameter set to use
	fPosition 	: REAL;
	bRelative 	: BOOL;
	eFeedback 	: E_PositionOffsetFeedback;
	eMemory 	: E_PositionOffsetMemory;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// set ax axis pos offset

// init result pessimistic
SetAxPosOffsEx := E_OperationResult.eOperationResult_NOk;

// if stopping or resetting is active return --> higher prio
IF eCommandExecute = E_MotionCommand.eMotionCommand_reset OR eCommandExecute = E_MotionCommand.eMotionCommand_stop THEN
	RETURN;
END_IF

fbAxSetPosOffs.Position := fPosition;
fbAxSetPosOffs.Relative := bRelative;
fbAxSetPosOffs.Feedback := eFeedback;
fbAxSetPosOffs.Memory := eMemory;

eCommandRequest := E_MotionCommand.eMotionCommand_setAxPosOffs;
SetAxPosOffsEx := E_OperationResult.eOperationResult_Ok;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetCalibration" Id="{8230a370-f00b-49ba-899a-838acf6e61cf}" FolderPath="AxisCmdMethods\">
      <Declaration><![CDATA[/// Axis home reset
{attribute 'object_name' := 'SetCalibration'}
METHOD SetCalibration : E_OperationResult
VAR_INPUT
	/// TRUE = Set-Calibration, FALSE = Reset-Calibration
	bSet			:BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// home axis

SetCalibration := THIS^.Home();

IF SetCalibration = E_OperationResult.eOperationResult_Ok THEN
	IF bSet THEN
		stHomingPrm.eHomingMode := MC_HomingMode.MC_ForceCalibration;		
	ELSE
		stHomingPrm.eHomingMode := MC_HomingMode.MC_ResetCalibration;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetPos" Id="{2221c177-ba9c-4be4-8025-c2bd402ffa5f}" FolderPath="AxisCmdMethods\">
      <Declaration><![CDATA[/// Set axis position
{attribute 'object_name' := 'SetPos'}
METHOD SetPos : E_OperationResult
VAR_INPUT
	fPosition: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// set axis pos

// init result pessimistic
SetPos := E_OperationResult.eOperationResult_NOk;

// if stopping or resetting is active return --> higher prio
IF eCommandExecute = E_MotionCommand.eMotionCommand_reset OR eCommandExecute = E_MotionCommand.eMotionCommand_stop THEN
	RETURN;
END_IF

stSetPosPrm := stDefaultPrm.stSetPosPrm;
stSetPosPrm.fPosition := fPosition;

eCommandRequest := E_MotionCommand.eMotionCommand_setPos;
SetPos := E_OperationResult.eOperationResult_Ok;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetPosEx" Id="{0f2aba2a-81b3-4df7-ae20-e30651249a64}" FolderPath="AxisCmdMethods\">
      <Declaration><![CDATA[/// Set axis position, extended method with all options
{attribute 'object_name' := 'SetPosEx'}
METHOD SetPosEx : E_OperationResult
VAR_INPUT
	/// Parameter set to use
	stSetPosParameter: ST_AxisSetPosParameter;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// set axis pos

SetPosEx := THIS^.SetPos(stSetPosParameter.fPosition);

IF SetPosEx = E_OperationResult.eOperationResult_Ok THEN
	stSetPosPrm := stSetPosParameter;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetPosIndraSoE" Id="{f03404f2-0725-44ee-8c58-e4423f82037f}" FolderPath="AxisCmdMethods\">
      <Declaration><![CDATA[/// Set axis position SoE for Indra drives
METHOD SetPosIndraSoE : E_OperationResult
VAR_INPUT
	fPosition: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// set axis pos

// init result pessimistic
SetPosIndraSoE := E_OperationResult.eOperationResult_NOk;

// if stopping or resetting is active return --> higher prio
IF eCommandExecute = E_MotionCommand.eMotionCommand_reset OR eCommandExecute = E_MotionCommand.eMotionCommand_stop THEN
	RETURN;
END_IF

stSoE.fRealValue := LREAL_TO_REAL(fPosition * 1E-4);
stSoE.eCmd := E_SoECommand.eSoECommand_writeIndraDrvPos;

SetPosIndraSoE := E_OperationResult.eOperationResult_Ok;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{db686c69-1e23-442b-bfd8-6dccc23f4a5f}" FolderPath="AxisCmdMethods\">
      <Declaration><![CDATA[/// Axis stop using default parameter
{attribute 'object_name' := 'Stop'}
METHOD Stop : E_OperationResult
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// stop axis

stStopPrm := stDefaultPrm.stStopPrm;

eCommandRequest := E_MotionCommand.eMotionCommand_stop;
Stop := E_OperationResult.eOperationResult_Ok;
// sofort aufrufen
Run();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StopEx" Id="{8f235dd7-7490-48fe-b11e-54684eec292c}" FolderPath="AxisCmdMethods\">
      <Declaration><![CDATA[/// Axis stop using specified parameter
{attribute 'object_name' := 'StopEx'}
METHOD StopEx : E_OperationResult
VAR_INPUT
	/// Parameter set to use
	stStopParameter: ST_AxisStopParameter;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// stop axis

stStopPrm := stStopParameter;
StopEx := THIS^.Stop();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TargetReached" Id="{f887d39e-20c6-454e-a042-f9fffe75e9f8}" FolderPath="Methods\">
      <Declaration><![CDATA[/// Get's a value, indicating whether axis position is within target position window and not moving.
/// Position window: default epsilon (1E-3).
/// Valid for previous ABS movement's.
METHOD PUBLIC TargetReached : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TargetReached := TargetWindowReached(fEpsilon);]]></ST>
      </Implementation>
    </Method>
    <Method Name="TargetReachedEx" Id="{ff6b99f0-9729-44f9-b3ea-0bc6d1263c29}" FolderPath="Methods\">
      <Declaration><![CDATA[/// Get's a value, indicating whether axis position is within target position window and not moving.
/// Extended: timeout
/// Position window: default epsilon (1E-3).
/// Valid for previous ABS movement's.
METHOD PUBLIC TargetReachedEx : BOOL
VAR_INPUT
	tTimeout	: TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TargetReachedEx := TargetWindowReachedEx(fEpsilon, tTimeout);]]></ST>
      </Implementation>
    </Method>
    <Method Name="TargetWindowReached" Id="{1c46b40e-9092-469f-8fa9-505e3eea3ec7}" FolderPath="Methods\">
      <Declaration><![CDATA[/// Get's a value, indicating whether axis position is within target position window and not moving.
/// Valid for previous ABS movement's. 
METHOD PUBLIC TargetWindowReached : BOOL
VAR_INPUT
	fWindow : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TargetWindowReached := Position >= (stMovAbsPrm.fPosition - fWindow) AND Position <= (stMovAbsPrm.fPosition + fWindow) AND NotMoving;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TargetWindowReachedEx" Id="{ce52d13e-b498-4bc6-bdf7-700d807196cf}" FolderPath="Methods\">
      <Declaration><![CDATA[/// Get's a value, indicating whether axis position is within target position window and not moving.
/// Extended: timeout
/// Valid for previous ABS movement's. 
METHOD PUBLIC TargetWindowReachedEx : BOOL
VAR_INPUT
	fWindow 	: LREAL;
	tTimeout	: TIME;
END_VAR
VAR
	bPosOk		: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[bPosOk := TargetWindowReached(fWindow);

tonTimeout(IN := NOT bPosOk, PT := tTimeout);
IF tonTimeout.Q THEN
	M_SetLocalError(F_CreateDynText("Zeitueberschreitung bei Positionierung", 0));
	Halt();
	bError := TRUE;
END_IF

TargetWindowReachedEx := bPosOk;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TorqCtrl" Id="{73d82a5e-555e-47e0-afe5-47572d0db0b4}" FolderPath="AxisCmdMethods\">
      <Declaration><![CDATA[{attribute 'object_name' := 'TorqCtrl'}
METHOD TorqCtrl : E_OperationResult
VAR_INPUT
	/// torque value [%]
	fTorque: LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// axis in torque control mode

// init result pessimistic
TorqCtrl := E_OperationResult.eOperationResult_NOk;

// if stopping or resetting is active return --> higher prio
IF eCommandExecute = E_MotionCommand.eMotionCommand_reset OR eCommandExecute = E_MotionCommand.eMotionCommand_stop THEN
	RETURN;
END_IF

stTorqCtrlPrm := stDefaultPrm.stTorqCtrlPrm;
stTorqCtrlPrm.fTorque := fTorque;

eCommandRequest := E_MotionCommand.eMotionCommand_torqCtrl;
TorqCtrl := E_OperationResult.eOperationResult_Ok;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="TorqCtrlEx" Id="{26cd551f-78c7-4216-9740-9ea3a9ff1f53}" FolderPath="AxisCmdMethods\">
      <Declaration><![CDATA[{attribute 'object_name' := 'TorqCtrlEx'}
METHOD TorqCtrlEx : E_OperationResult
VAR_INPUT
	/// Parameter set to use
	stParameter: ST_AxisTorqCtrlParameter;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// axis in torque control mode

TorqCtrlEx := THIS^.TorqCtrl(stParameter.fTorque);

IF TorqCtrlEx = E_OperationResult.eOperationResult_Ok THEN
	stTorqCtrlPrm := stParameter;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Torque" Id="{2f6ac4b8-5653-472c-bf25-47942359e6c2}" FolderPath="Properties\">
      <Declaration><![CDATA[/// Actual torque [Nm]
{attribute 'monitoring' := 'call'}
PROPERTY Torque : LREAL
]]></Declaration>
      <Get Name="Get" Id="{9710527c-3c6a-4c62-8be3-1b315fb71e72}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[/// Actual torque [Nm]
Torque := fbAxisRef.NcToPlc.ActTorque * fTorqueFactor;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="TorqueLimit" Id="{8a8ed15b-b81f-476d-9723-fd105ed303f4}" FolderPath="Properties\">
      <Declaration><![CDATA[/// The torque limit for both directions. [%]
{attribute 'monitoring' := 'call'}
PROPERTY TorqueLimit : LREAL
]]></Declaration>
      <Get Name="Get" Id="{434d86f5-1dfb-4daa-b279-b66b5d2e9999}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[/// The torque limit for both directions. [0.1%]
TorqueLimit := INT_TO_LREAL(stOut.iBipolarTorqueLimitValue);]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f41b5a9e-2101-45ad-acd8-fa0dff3fa3b3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[stOut.iBipolarTorqueLimitValue := LREAL_TO_INT(TorqueLimit);]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Velocity" Id="{a0cb0511-b768-4ff3-9394-f37e47328e45}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Velocity : LREAL
]]></Declaration>
      <Get Name="Get" Id="{9068bbc0-dcc9-474d-8f78-89678bc88d09}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Velocity  := fbAxisRef.NcToPlc.ActVelo;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Action Name="WfAxSetPosOffset" Id="{2f958e99-6209-400c-a912-8db3f2c3b0e4}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow set ax position offset

// call fb cyclic
//fbAxSetPosOffs.Position := fPosition;
//fbAxSetPosOffs.Relative := bRelative;
//fbAxSetPosOffs.Feedback := E_PositionOffsetFeedback.ePositionOffsetFeedback1;
//fbAxSetPosOffs.Memory := E_PositionOffsetMemory.ePositionOffsetMemory_Drive;
fbAxSetPosOffs(Axis := fbAxisRef);

// FB diagnostic and reset 
IF fbAxSetPosOffs.Execute AND NOT fbAxSetPosOffs.Busy THEN
	IF fbAxSetPosOffs.Error THEN			
		nErrorId := fbAxSetPosOffs.ErrorID;
		M_SetLocalErrorS('Error set ax position offset: ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbAxSetPosOffs.Execute := FALSE;
END_IF

// return if other command active	
IF eCommandExecute <> E_MotionCommand.eMotionCommand_setAxPosOffs THEN
	RETURN;
END_IF

//aSClearText := F_GetTranslatedTxtLib('Set ax position offset', eLanguage);		
IF NOT fbAxSetPosOffs.Busy THEN
	fbAxSetPosOffs(Axis := fbAxisRef, Execute := TRUE);
	eCommandExecute := E_MotionCommand.eMotionCommand_none;
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfDiagnostic" Id="{27ade543-34b1-4b96-a376-c83a1081a1e7}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow axis diagnostic

// run axis FBs
fbAxisRef.ReadStatus();

// return in case of reset
(*IF eCommandExecute = E_MotionCommand.eMotionCommand_reset THEN
	RETURN;
END_IF*)

// diagnostics AX5xxx
IF eAxisType = E_AxisType.AX5xxx THEN
	// Diag + Reset of AX5000
	// call drive diag FBs
	fbAX5xxxDiag(
		IPCNetID	:= IPCNetID,
		Axis		:= fbAxisRef,
		stAX5000Diag:= stAX5xxxDiag);

	// clear reset/diag request if not active
	fbAX5xxxDiag.Reset := fbAX5xxxDiag.Reset AND fbAX5xxxDiag.ResetAct;
	fbAX5xxxDiag.GetDiag := fbAX5xxxDiag.GetDiag AND fbAX5xxxDiag.DiagAct;

	//IF fbAX5xxxDiag.Error THEN... / nErrorId := fbAX5xxxDiag.AdsErrId; -> WfErrorHandling
	stDriveRef := fbAX5xxxDiag.DriveRef;
	
// Bosch Indradrive
ELSIF eAxisType = E_AxisType.Bosch_IndradriveEc THEN
	// Diag + Reset of Indradrive
	// call drive diag FBs
	fbIndraDrvDiag(
		sIPCNetID	:= IPCNetID,
		Axis		:= fbAxisRef,
		stDriveDiag:= stIndraDrvDiag);

	// clear reset/diag request if not active
	fbIndraDrvDiag.bReset := fbIndraDrvDiag.bReset AND fbIndraDrvDiag.bResetAct;
	fbIndraDrvDiag.bGetDiag := fbIndraDrvDiag.bGetDiag AND fbIndraDrvDiag.bDiagAct;

	//IF fbAX5xxxDiag.Error THEN... / nErrorId := fbAX5xxxDiag.AdsErrId; -> WfErrorHandling
	stDriveRef := fbIndraDrvDiag.stDriveRef;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfErrorHandling" Id="{a5216dc9-c13a-4cd8-bd0a-156974980ce7}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
// chk axis operational
tonChkOperation(IN := (eState = E_ComponentState.eComponentState_running AND fbPower.Enable AND 
						NOT fbAxisRef.Status.Operational), PT := T#5S);
IF tonChkOperation.Q THEN
	eState := E_ComponentState.eComponentState_error;
END_IF
// Safety Error liegt an
IF bAX5805_Error AND eAxisType = E_AxisType.AX5xxx THEN
	M_SetLocalError(CONST.stTextListGlobal.stText_Comp.stText_Axis_SafetyError);
END_IF

// run error trigger
rtrigError(CLK := fbAxisRef.Status.Error OR stAX5xxxDiag.bAxisError OR stIndraDrvDiag.bAxisError OR
					eState = E_ComponentState.eComponentState_error);
IF rtrigError.Q THEN
	eState := E_ComponentState.eComponentState_error;
	// AX5000
	IF eAxisType = E_AxisType.AX5xxx THEN
		IF fbAxisRef.Status.Error AND fbAxisRef.Status.ErrorID = 18000 THEN
			bErrDiagActive := TRUE;
			fbAX5xxxDiag.GetDiag := TRUE; // get diag for AX5xxx
		ELSE
			IF tonChkOperation.Q THEN	
				M_SetLocalError(CONST.stTextListGlobal.stText_Comp.stText_Axis_DriveNotReady);
			ELSIF bAX5805_Error THEN
				M_SetLocalError(CONST.stTextListGlobal.stText_Comp.stText_Axis_SafetyError);
			ELSIF nErrorId = 16931 THEN
				M_SetLocalError(CONST.stTextListGlobal.stText_Comp.stText_Axis_MovingNotReleased);
			ELSIF nErrorId = 17505 THEN
				M_SetLocalError(CONST.stTextListGlobal.stText_Comp.stText_Axis_TargetOutOfArea);
			ELSIF nErrorId = 18000 THEN
				M_SetLocalError(CONST.stTextListGlobal.stText_Comp.stText_Axis_HwNotReady);
			ELSIF nErrorId <> 0 THEN
				M_SetLocalErrorEx(CONST.stTextListGlobal.stText_Comp.stText_Axis_FbError, F_CreateDynText(TO_WSTRING(nErrorId), 0));
			ELSIF fbAxisRef.Status.ErrorID <> 0 THEN
				M_SetLocalErrorEx(CONST.stTextListGlobal.stText_Comp.stText_Axis_NcError, F_CreateDynText(TO_WSTRING(fbAxisRef.Status.ErrorID), 0));
			END_IF	
		END_IF	
	
	// Bosch Indradrive
	ELSIF eAxisType = E_AxisType.Bosch_IndradriveEc THEN
		IF fbAxisRef.Status.Error AND fbAxisRef.Status.ErrorID = 18000 THEN
			bErrDiagActive := TRUE;
			fbIndraDrvDiag.bGetDiag := TRUE; // get diag for Indradrive
		ELSE
			IF tonChkOperation.Q THEN	
				M_SetLocalError(CONST.stTextListGlobal.stText_Comp.stText_Axis_DriveNotReady);
			ELSIF bAX5805_Error THEN
				M_SetLocalError(CONST.stTextListGlobal.stText_Comp.stText_Axis_SafetyError);
			ELSIF nErrorId = 16931 THEN
				M_SetLocalError(CONST.stTextListGlobal.stText_Comp.stText_Axis_MovingNotReleased);
			ELSIF nErrorId = 17505 THEN
				M_SetLocalError(CONST.stTextListGlobal.stText_Comp.stText_Axis_TargetOutOfArea);
			ELSIF nErrorId = 18000 THEN
				M_SetLocalError(CONST.stTextListGlobal.stText_Comp.stText_Axis_HwNotReady);
			ELSIF nErrorId <> 0 THEN
				M_SetLocalErrorEx(CONST.stTextListGlobal.stText_Comp.stText_Axis_FbError, F_CreateDynText(TO_WSTRING(nErrorId), 0));
			ELSIF fbAxisRef.Status.ErrorID <> 0 THEN
				M_SetLocalErrorEx(CONST.stTextListGlobal.stText_Comp.stText_Axis_NcError, F_CreateDynText(TO_WSTRING(fbAxisRef.Status.ErrorID), 0));
			END_IF
		END_IF

	ELSE
		IF nErrorId <> 0 THEN
			M_SetLocalErrorEx(CONST.stTextListGlobal.stText_Comp.stText_Axis_FbError, F_CreateDynText(TO_WSTRING(nErrorId), 0));
		ELSIF fbAxisRef.Status.ErrorID <> 0 THEN
			M_SetLocalErrorEx(CONST.stTextListGlobal.stText_Comp.stText_Axis_NcError, F_CreateDynText(TO_WSTRING(fbAxisRef.Status.ErrorID), 0));
		END_IF
	END_IF
END_IF


// run AX5000 diag 
ftrigDiag(CLK := fbAX5xxxDiag.DiagAct);
IF ftrigDiag.Q AND bErrDiagActive THEN
	bErrDiagActive := FALSE;
	IF fbAxisRef.Status.Error AND stAX5xxxDiag.stDiagNumberList.arrDiagNumbers[0] <> 0 THEN
		sMsg := Concat3(TO_STRING(stName.wsName), ': ', stAX5xxxDiag.strDiagMessage); // display diag msg
		FOR ii := 0 TO 2 DO	// add first 3 error codes 
			sMsg := Concat3(sMsg, ', ', UDINT_TO_STRING(stAX5xxxDiag.stDiagNumberList.arrDiagNumbers[ii]));
		END_FOR
		M_SetLocalErrorEx(CONST.stTextListGlobal.stText_Comp.stText_Axis_HwError, F_CreateDynText(TO_WSTRING(sMsg), 0));

	ELSE
		sMsg := Concat3(TO_STRING(stName.wsName), ': ', sLastError);
		sMsg := Concat3(sMsg, ' / FehlerNr: ', UDINT_TO_STRING(nErrorId));
		M_SetLocalErrorEx(CONST.stTextListGlobal.stText_Comp.stText_Axis_HwError, F_CreateDynText(TO_WSTRING(sMsg), 0));
	END_IF
END_IF;

// Bosch Indradrive diag
ftrigDiagIndradrv(CLK := fbIndraDrvDiag.bDiagAct);
IF ftrigDiagIndradrv.Q AND bErrDiagActive THEN
	bErrDiagActive := FALSE;
	IF fbAxisRef.Status.Error THEN
		sMsg := Concat3(TO_STRING(stName.wsName), ': ', stIndraDrvDiag.strDiagMessage); // display diag msg
		FOR ii := 0 TO 2 DO	// add first 3 error codes 
			sMsg := Concat3(sMsg, ', ', UDINT_TO_STRING(stIndraDrvDiag.stDiagNumberList.arrDiagNumbers[ii]));
		END_FOR
		M_SetLocalErrorEx(CONST.stTextListGlobal.stText_Comp.stText_Axis_HwError, F_CreateDynText(TO_WSTRING(sMsg), 0));

	ELSE
		sMsg := Concat3(TO_STRING(stName.wsName), ': ', sLastError);
		sMsg := Concat3(sMsg, ' / FehlerNr: ', UDINT_TO_STRING(nErrorId));
		M_SetLocalErrorEx(CONST.stTextListGlobal.stText_Comp.stText_Axis_HwError, F_CreateDynText(TO_WSTRING(sMsg), 0));
	END_IF	
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfGearIn" Id="{08bf6bc0-749e-4814-b6b7-9e0121bf293d}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow gear in

// call fb cyclic
fbGearIn.GearRatio := stGearInPrm.fGearRatio;
fbGearIn.Acceleration := stGearInPrm.fAcceleration;
fbGearIn.Deceleration := stGearInPrm.fDeceleration;
fbGearIn.Jerk := stGearInPrm.fJerk;
fbGearIn.BufferMode := stGearInPrm.eBufferMode;
fbGearIn.Options := stGearInPrm.stOptions;
IF __ISVALIDREF(stGearInPrm.fbMaster) THEN
	fbGearIn(Master := stGearInPrm.fbMaster, Slave := fbAxisRef);	
END_IF

// FB diagnostic and reset 
IF fbGearIn.Enable AND NOT fbGearIn.Busy THEN
	IF fbGearIn.Error THEN			
		nErrorId := fbGearIn.ErrorID;
		M_SetLocalErrorS('error engine couple: ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbGearIn.Enable := FALSE;
END_IF

// set master axis ID
eMasterAxisId := SEL(fbAxisRef.Status.Coupled, eAxis_none, stGearInPrm.eMasterId);

// return if other command active	
IF eCommandExecute <> E_MotionCommand.eMotionCommand_gearIn THEN
	RETURN;
END_IF

//aSClearText[0] := 'Antrieb Koppeln';	
//aSClearText := F_GetTranslatedTxtLib('engine couple', eLanguage);	
IF NOT fbGearIn.InGear THEN
	fbGearIn.Enable := TRUE;
END_IF
eCommandExecute := E_MotionCommand.eMotionCommand_none;

]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfGearOut" Id="{8c357f54-a169-4f21-85ab-ba7abb01284c}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow gear out

// call fb cyclic
fbGearOut.Options := stGearOutPrm.stOptions;
fbGearOut(Slave := fbAxisRef);

// FB diagnostic and reset 
IF fbGearOut.Execute AND NOT fbGearOut.Busy THEN
	IF fbGearOut.Error THEN
		nErrorId := fbGearOut.ErrorID;
		M_SetLocalErrorS('error engine decouple: ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbGearOut.Execute := FALSE;
END_IF
		
// return if not in gear out
IF eCommandExecute <> E_MotionCommand.eMotionCommand_gearOut THEN
	RETURN;
END_IF

//aSClearText[0] := 'Antrieb Entoppeln';
//aSClearText := F_GetTranslatedTxtEx("engine decouple", eLanguage);
IF stGearOutPrm.bHaltAxis THEN
	stHaltPrm.eBufferMode := MC_Aborting;
	stHaltPrm.fDeceleration := stGearInPrm.fDeceleration;
	stHaltPrm.fJerk := stGearInPrm.fJerk;
	//stHaltPrm.stOptions := stGearInPrm.stOptions;
	THIS^.HaltEx(stHaltPrm);
ELSE
	fbGearOut(Slave := fbAxisRef, Execute := TRUE);	
END_IF
eCommandExecute := E_MotionCommand.eMotionCommand_none;]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfHalt" Id="{8d9667ec-9214-4460-9864-25b8ae9d73d7}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow halting

// call fb cyclic
fbHalt.BufferMode := stHaltPrm.eBufferMode;
fbHalt.Deceleration := stHaltPrm.fDeceleration;
fbHalt.Jerk := stHaltPrm.fJerk;
fbHalt.Options := stHaltPrm.stOptions;
fbHalt(Axis := fbAxisRef);

// FB diagnostic and reset 
IF fbHalt.Execute AND NOT fbHalt.Busy THEN
	IF fbHalt.Error THEN
		nErrorId := fbHalt.ErrorID;
		M_SetLocalErrorS('error at engine halt: ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbHalt.Execute := FALSE;
END_IF
		
// return if not in halting
IF eCommandExecute <> E_MotionCommand.eMotionCommand_halt THEN
	RETURN;
END_IF

//aSClearText[0] := 'Antrieb Halt';
//aSClearText := F_GetTranslatedTxtLib('stop engine', eLanguage);
fbHalt(Axis := fbAxisRef, Execute := TRUE);
eCommandExecute := E_MotionCommand.eMotionCommand_none;
IF fbAxisRef.Status.StandStill THEN
	eCommandExecute := E_MotionCommand.eMotionCommand_none;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfHome" Id="{83d1825c-f56f-47c3-9990-ec53d2c01df0}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow homing

// call fb cyclic
fbHoming.bCalibrationCam := bCalibrationCam;	
fbHoming.BufferMode := stHomingPrm.eBufferMode;
fbHoming.HomingMode := stHomingPrm.eHomingMode;
fbHoming.Options := stHomingPrm.stOptions;
fbHoming.Position := stHomingPrm.fPosition;
fbHoming(Axis := fbAxisRef);

// FB diagnostic and reset 
IF fbHoming.Execute AND NOT fbHoming.Busy THEN
	IF fbHoming.Error THEN
		nErrorId := fbHoming.ErrorID;
		M_SetLocalErrorS('Error axis homing: ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbHoming.Execute := FALSE;
END_IF
		
// return if not in homing
IF eCommandExecute <> E_MotionCommand.eMotionCommand_home THEN
	RETURN;
END_IF

//aSClearText[0] := 'Antrieb GRST';	
//aSClearText := F_GetTranslatedTxtEx("engine home position", eLanguage);	
IF NOT fbHoming.Busy THEN
	fbHoming(Axis := fbAxisRef, Execute := TRUE);
	eCommandExecute := E_MotionCommand.eMotionCommand_none;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Method Name="WfInitPositionOffset" Id="{583851c3-5a07-4d17-b3fc-132ea0df36d1}" FolderPath="Workflows\">
      <Declaration><![CDATA[METHOD PRIVATE WfInitPositionOffset : BOOL
VAR_INPUT
END_VAR
VAR_INST
	fbAdsWriteOffset			:ADSWRITE;
	iStepSetPosOffset			:INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[

CASE iStepSetPosOffset OF
	
	0:
		// warte auf Trigger
		IF bStartInitPosOffset THEN
			// Position offset set
			bSetPositionOffsetDone := FALSE;
			// Current position offset value
			fCurrentPositionOffset := 0;			
			iStepSetPosOffset := 5;
		END_IF	
		
	5:
		IF fbAxisRef.NcToPlc.AxisId > 0 THEN
			iStepSetPosOffset := 6;
		ELSE
			M_SetLocalErrorEx(CONST.stTextListGlobal.stText_Comp.stText_Axis_FbError, F_CreateDynText("No Nc.AxisId!", 0));
		END_IF

	6:
		IF NOT Operational THEN
			iStepSetPosOffset := 10;
		ELSE
			M_SetLocalErrorEx(CONST.stTextListGlobal.stText_Comp.stText_Axis_FbError, F_CreateDynText("Axis is Operational. Please switch off axis!", 0));
		END_IF

	10:
		fbAdsWriteOffset.IDXGRP := 16#5000 + fbAxisRef.NcToPlc.AxisId;        (* Ind.Gr. f. AxisPara *)
		fbAdsWriteOffset.IDXOFFS := 16#7;
		fbAdsWriteOffset.LEN:= SIZEOF(fPosOffsetValToSet);
		fbAdsWriteOffset.SRCADDR:= ADR(fPosOffsetValToSet);
		fbAdsWriteOffset.WRITE:= TRUE;
		iStepSetPosOffset := 15;
   
    15:
        // 'wait until offset-parameter is handed over';
        IF NOT fbAdsWriteOffset.BUSY THEN
            IF fbAdsWriteOffset.ERRID = 0 THEN
				// Position offset set
				bSetPositionOffsetDone := TRUE;
				// Current position offset value
				fCurrentPositionOffset := fPosOffsetValToSet;
                iStepSetPosOffset := 100;
            ELSE
                M_SetLocalErrorEx(CONST.stTextListGlobal.stText_Comp.stText_Axis_FbError, F_CreateDynText("Error writing offset to NC.", 0));
				iStepSetPosOffset := 100;
            END_IF
        END_IF	
		

		// finish
	100:
		fbAdsWriteOffset.WRITE:= FALSE;
		bStartInitPosOffset := FALSE; // Finish
		fPosOffsetValToSet := 0;
		iStepSetPosOffset := 0;

END_CASE

fbAdsWriteOffset.PORT := 500;
fbAdsWriteOffset();

]]></ST>
      </Implementation>
    </Method>
    <Action Name="WfJog" Id="{75510e43-31e2-42dc-8136-3ee84186f880}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow jog axis

// call fb cyclic
fbjog.JogBackwards := stJogPrm.bJogBackwards AND Operational;
fbjog.JogForward := stJogPrm.bJogForward AND Operational;
fbjog.Acceleration := stJogPrm.fAcceleration;
fbjog.Deceleration := stJogPrm.fDeceleration;
fbjog.Jerk := stJogPrm.fJerk;
fbjog.Mode := stJogPrm.eMode;
fbjog.Position := stJogPrm.fPosition;
fbjog.Velocity := stJogPrm.fVelocity;
fbjog(Axis := fbAxisRef);

// reset jog F/B each cycle (stop's axis if Jog/JogEx method isn't called anymore)
stJogPrm.bJogBackwards := FALSE;
stJogPrm.bJogForward := FALSE;

// return if not in jog
IF eCommandExecute <> E_MotionCommand.eMotionCommand_jog THEN
	RETURN;
END_IF

// case of jog error
IF fbjog.Error  THEN
	nErrorId := fbjog.ErrorID;
	M_SetLocalErrorS('Error axis jogging: ErrId: ', TO_STRING(nErrorId));
END_IF		

eCommandExecute := E_MotionCommand.eMotionCommand_none;]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfJogAcc" Id="{2f2b23b4-1877-4af4-bc18-2a53f5ffa3bd}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow jog axis acc

// call fb's cyclic
//fbJogAcc.Direction := MC_Current_Direction;
//IF stJogAccPrm.bJogForward OR stJogAccPrm.bJogBackwards THEN
fbJogAcc.Direction := SEL(stJogAccPrm.bJogForward, MC_Negative_Direction, MC_Positive_Direction);	
//END_IF
fbJogAcc.Acceleration := stJogAccPrm.fAcceleration;
fbJogAcc.Deceleration := stJogAccPrm.fDeceleration;
fbJogAcc.Jerk := stJogAccPrm.fJerk;
fbJogAcc.BufferMode := stJogAccPrm.eBufferMode;
fbJogAcc.Options := stJogAccPrm.stOptions;
fbJogAcc(Axis := fbAxisRef);

// FB diagnostic and reset 
IF fbJogAcc.Execute AND (NOT fbJogAcc.Busy OR fbJogAcc.InVelocity) THEN
	IF fbJogAcc.Error THEN
		nErrorId := fbJogAcc.ErrorID;
		M_SetLocalErrorS('Error axis jogging acceleration: ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbJogAcc.Velocity := 0;
	fbJogAcc.Execute := FALSE;
END_IF

// measure jog time to capture speed at the according ramp positon
tonJogAcc.IN := stJogAccPrm.bJogForward OR stJogAccPrm.bJogBackwards;
tonJogAcc.PT := stJogAccPrm.tAccTime;
tonJogAcc();

// reset jog F/B each cycle (stop's axis if Jog/JogEx method isn't called anymore)
stJogAccPrm.bJogBackwards := FALSE;
stJogAccPrm.bJogForward := FALSE;

IF eCommandExecute <> E_MotionCommand.eMotionCommand_jogAcc THEN
	RETURN;
END_IF

// halt axis if jogAcc timer is disabled
IF NOT tonJogAcc.IN THEN
	fbJogAcc.Velocity := 0;
	eCommandExecute := E_MotionCommand.eMotionCommand_none;
	stHaltPrm.eBufferMode := MC_Aborting;
	stHaltPrm.fDeceleration := stJogAccPrm.fDeceleration;
	stHaltPrm.fJerk := stJogAccPrm.fJerk;
	stHaltPrm.stOptions := stJogAccPrm.stOptions;
	THIS^.HaltEx(stHaltPrm);	
END_IF

//aSClearText[0] := Concat2x('Antrieb Tippen Beschleunigung, Geschwindigkeit: ', LREAL_TO_STRING(fbJogAcc.Velocity));
//aSClearText := Concat2x(F_GetTranslatedTxtLib('type engine acceleration, acceleration: ', eLanguage), LREAL_TO_STRING(fbJogAcc.Velocity));
IF fbJogAcc.Velocity < stJogAccPrm.fFastSpeed AND NOT fbJogAcc.Busy THEN
	// ramp = Kx + d
	fbJogAcc.Velocity := (TIME_TO_LREAL(tonJogAcc.ET) * ((stJogAccPrm.fFastSpeed - stJogAccPrm.fSlowSpeed)/TIME_TO_LREAL(tonJogAcc.PT))) + stJogAccPrm.fSlowSpeed;
	// limit speed	
	fbJogAcc.Velocity := LIMIT(stJogAccPrm.fSlowSpeed, fbJogAcc.Velocity, stJogAccPrm.fFastSpeed);
	fbJogAcc(Axis := fbAxisRef, Execute := TRUE);	
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfMovAbs" Id="{3d443935-f337-4f9a-8395-3640e0c53b51}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow move axis abs

// call fb's cyclic
fbMovAbs1.Position := stMovAbsPrm.fPosition;
fbMovAbs1.Velocity := stMovAbsPrm.fVelocity;
fbMovAbs1.Acceleration := stMovAbsPrm.fAcceleration;
fbMovAbs1.Deceleration := stMovAbsPrm.fDeceleration;
fbMovAbs1.Jerk := stMovAbsPrm.fJerk;
fbMovAbs1.BufferMode := stMovAbsPrm.eBufferMode;
fbMovAbs1.Options := stMovAbsPrm.stOptions;
fbMovAbs1(Axis := fbAxisRef);

fbMovAbs2.Position := stMovAbsPrm.fPosition;
fbMovAbs2.Velocity := stMovAbsPrm.fVelocity;
fbMovAbs2.Acceleration := stMovAbsPrm.fAcceleration;
fbMovAbs2.Deceleration := stMovAbsPrm.fDeceleration;
fbMovAbs2.Jerk := stMovAbsPrm.fJerk;
fbMovAbs2.BufferMode := stMovAbsPrm.eBufferMode;
fbMovAbs2.Options := stMovAbsPrm.stOptions;
fbMovAbs2(Axis := fbAxisRef);

bMovAbsRdy := NOT (fbMovAbs1.Busy AND fbMovAbs2.Busy);

// FB diagnostic and reset 
IF fbMovAbs1.Execute AND NOT fbMovAbs1.Busy THEN
	IF fbMovAbs1.Error AND (fbMovAbs1.ErrorID <> 17022) THEN
		nErrorId := fbMovAbs1.ErrorID;
		M_SetLocalErrorS('engine positioning absolut (FB1): ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbMovAbs1.Execute := FALSE;
END_IF
IF fbMovAbs2.Execute AND NOT fbMovAbs2.Busy THEN
	IF fbMovAbs2.Error AND (fbMovAbs2.ErrorID <> 17022) THEN
		nErrorId := fbMovAbs2.ErrorID;
		M_SetLocalErrorS('engine positioning absolut (FB2): ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbMovAbs2.Execute := FALSE;
END_IF

// return if not in move abs
IF eCommandExecute <> E_MotionCommand.eMotionCommand_moveAbs THEN
	RETURN;
END_IF

//aSClearText[0] := 'Antrieb Positionierung Absolut';	
//aSClearText := F_GetTranslatedTxtLib('engine positioning absolut', eLanguage);
IF NOT fbMovAbs1.Busy THEN
	fbMovAbs1(Axis := fbAxisRef, Execute := TRUE);
	eCommandExecute := E_MotionCommand.eMotionCommand_none;
ELSIF NOT fbMovAbs2.Busy THEN
	fbMovAbs2(Axis := fbAxisRef, Execute := TRUE);
	eCommandExecute := E_MotionCommand.eMotionCommand_none;
ELSE
	nErrorId := 0;
	M_SetLocalError(F_CreateDynText("engine positioning absolut. No component ready", 0));
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfMovAdd" Id="{f3bdc03d-c049-4b44-809c-8af04e307705}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow move axis add

// call fb's cyclic
fbMovAdd1.Distance := stMovAddPrm.fDistance;
fbMovAdd1.Velocity := stMovAddPrm.fVelocity;
fbMovAdd1.Acceleration := stMovAddPrm.fAcceleration;
fbMovAdd1.Deceleration := stMovAddPrm.fDeceleration;
fbMovAdd1.Jerk := stMovAddPrm.fJerk;
fbMovAdd1.BufferMode := stMovAddPrm.eBufferMode;
fbMovAdd1.Options := stMovAddPrm.stOptions;
fbMovAdd1(Axis := fbAxisRef);

fbMovAdd2.Distance := stMovAddPrm.fDistance;
fbMovAdd2.Velocity := stMovAddPrm.fVelocity;
fbMovAdd2.Acceleration := stMovAddPrm.fAcceleration;
fbMovAdd2.Deceleration := stMovAddPrm.fDeceleration;
fbMovAdd2.Jerk := stMovAddPrm.fJerk;
fbMovAdd2.BufferMode := stMovAddPrm.eBufferMode;
fbMovAdd2.Options := stMovAddPrm.stOptions;
fbMovAdd2(Axis := fbAxisRef);

// FB diagnostic and reset 
IF fbMovAdd1.Execute AND NOT fbMovAdd1.Busy THEN
	IF fbMovAdd1.Error AND (fbMovAdd1.ErrorID <> 17022) THEN
		nErrorId := fbMovAdd1.ErrorID;
		M_SetLocalErrorS('engine positioning additive (FB1): ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbMovAdd1.Execute := FALSE;
END_IF
IF fbMovAdd2.Execute AND NOT fbMovAdd2.Busy THEN
	IF fbMovAdd2.Error AND (fbMovAdd2.ErrorID <> 17022) THEN
		nErrorId := fbMovAdd2.ErrorID;
		M_SetLocalErrorS('engine positioning additive (FB2): ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbMovAdd2.Execute := FALSE;
END_IF

// return if not in move add
IF eCommandExecute <> E_MotionCommand.eMotionCommand_moveAdd THEN
	RETURN;
END_IF

//aSClearText := F_GetTranslatedTxtLib('engine positioning additive', eLanguage);
IF NOT fbMovAdd1.Busy THEN
	fbMovAdd1(Axis := fbAxisRef, Execute := TRUE);
	eCommandExecute := E_MotionCommand.eMotionCommand_none;	
ELSIF NOT fbMovAdd2.Busy THEN
	fbMovAdd2(Axis := fbAxisRef, Execute := TRUE);
	eCommandExecute := E_MotionCommand.eMotionCommand_none;	
ELSE
	nErrorId := 0;
	M_SetLocalError(F_CreateDynText("engine positioning additive. No component ready", 0));
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="WfMovMod" Id="{37d22f1f-a6d6-4028-b7c1-70ae283562c4}" FolderPath="Workflows\">
      <Implementation>
        <ST><![CDATA[
/// Workflow move axis mod

// call fb's cyclic
fbMovMod1.Position := stMovModPrm.fPosition;
fbMovMod1.Direction := stMovModPrm.eDirection;
