												wsName:= "EtherCAT Device State: Pre-Operational");
	stText_EC_DeviceState_Bootstrap			: ST_Text := (
												wsNameId:= "EC_DeviceState_Bootstrap",
												wsName:= "EtherCAT Device State: Bootstrap");
