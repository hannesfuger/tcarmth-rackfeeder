<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_StationBase" Id="{f54fb284-2edb-421a-b9be-72585b0b821e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK PUBLIC FB_StationBase EXTENDS FB_ComponentBase IMPLEMENTS IStation
VAR_INPUT
	/// Enable items
	bEmergencyStopOk 	: BOOL;
	bSafetyOk 			: BOOL;
	bEnable 			: BOOL;
	bAutoHome 			: BOOL;		// if its true station will be homed by start button
	iNumberOfStepChains	: INT := 1;	// count of stepchains per station
	iStepChainIndex		: INT; 		// index to link text of choosed stepchain to hmi
END_VAR
VAR_OUTPUT
	nStateColor			: DWORD;	// color for state of station
	bBusy				: BOOL;		// station is busy
	bTransferEnable		: BOOL;		// transfer enable from station
	stTextAuto			: ST_Text;	// T_MaxString;
	stTextHome			: ST_Text;	// T_MaxString;
	
	/// error-stop status
	bAutoStop_Error		: BOOL;
END_VAR
VAR
	/// Refs
	stHmiToStation		: REFERENCE TO ST_DefaultHmiToPlc;				// default hmi to station
	stHmiManualIn		: REFERENCE TO ST_HMI_BASE_STATION_MANUAL_IN;	// hmi manual to station
	stHmiManualOut		: REFERENCE TO ST_HMI_BASE_STATION_MANUAL_OUT;	// hmi manual from station
	stLocalSettings		: REFERENCE TO ST_StationDynSettings;			// dyn. station settings
	stLocalMonitoring	: REFERENCE TO ST_Monitoring_Station;			// dyn. station monitoring
	
	stLocalSettingsBackup	: ST_StationDynSettings;	// dyn. station settings
	
	/// private var's
	nStationNb		: INT;
	eStation		: E_Station;
	eParent 		: E_Module;
	eOpMode			: E_OpMode;	
	bStopped		: BOOL := TRUE;
	bTipEnable		: BOOL;
	
	/// enable var's
	bRunCycle, bRunStep, 
	bRunHoming, bInHome,
	bEnableManualStep		 : BOOL;

	/// counter
	diCycles				: UDINT; // Zykluszähler
	diLastCycleTime			: UDINT; // letzte Zykluszeit [ms]
	
	tonOpModeOff			: TON;
	fTrigSafetyOk			: F_TRIG;
	rtrigOpModeChanged		: R_TRIG;
		
	rtirgSafetyOpMode_Auto	: R_TRIG;
	rtirgSafetyOpMode_Hand	: R_TRIG;
	rtirgSafetyOpMode_Aus	: R_TRIG;
	
	bInitSettings	: BOOL;
	bInitMonitoring	: BOOL;
	bInitManual		: BOOL;
	
	sb				: FB_StringBuilder;
	sqHome, sqAuto	: FB_SequenceHelperSb;
	localEvents		: ST_DefaultEventClasses;
END_VAR
VAR PERSISTENT
	diTotalCycles	: UDINT; // Zykluszähler
	eOpModeOld		: E_OpMode;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[/// 
/// Station 01 function block 
/// ]]></ST>
    </Implementation>
