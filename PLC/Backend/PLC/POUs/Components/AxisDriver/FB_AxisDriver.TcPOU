    <Method Name="InitPosOffset" Id="{809f0de9-dc34-4b3e-8135-29f8d4edc181}" FolderPath="AxisCmdMethods\">
      <Declaration><![CDATA[METHOD PUBLIC InitPosOffset : BOOL
VAR_INPUT
	fPositionOffset				:LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// check ready
IF bStartInitPosOffset THEN
	InitPosOffset := FALSE;
	RETURN;
END_IF

bStartInitPosOffset	:= TRUE;
fPosOffsetValToSet := fPositionOffset;]]></ST>
      </Implementation>
    </Method>
    <Property Name="InTorque" Id="{76eca5f1-b4e3-4176-b763-40b9ed3e895a}" FolderPath="Properties\">
      <Declaration><![CDATA[/// Gets the InTorque output for TorqueControl.
{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC InTorque : BOOL]]></Declaration>
