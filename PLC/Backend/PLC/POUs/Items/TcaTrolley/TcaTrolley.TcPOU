    <Property Name="SlotOfCarrierWithEmptyWorkpieceplace" Id="{7ad8ab13-f750-43ae-b724-501a92decab4}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY SlotOfCarrierWithEmptyWorkpieceplace : INT]]></Declaration>
      <Get Name="Get" Id="{f711a5db-e8d5-479c-b70c-490d7307f042}">
        <Declaration><![CDATA[VAR
	_i : INT;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[SlotOfCarrierWithEmptyWorkpieceplace:= -1;
	
FOR _i:= 0 TO MAX_CARRIERPLACES DO

	THIS^._TemplateCarrier.Data := _data.CarriersData[_i];
	
	IF _TemplateCarrier.HasEmptyWorkpieceplaces THEN
		SlotOfCarrierWithEmptyWorkpieceplace:= _i;
		RETURN;
	END_IF

END_FOR]]></ST>
        </Implementation>
      </Get>
    </Property>
