  <DUT Name="ST_Text_List_System" Id="{0f12a233-9daa-4e0a-bc2a-b2193327bff6}">
    <Declaration><![CDATA[TYPE ST_Text_List_System :
STRUCT
	stText_CycletimeExceeded				: ST_Text := (
