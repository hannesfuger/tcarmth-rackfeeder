      <LineId Id="3" Count="6" />
      <LineId Id="2" Count="0" />
    </LineIds>
    <LineIds Name="FB_TestCaseBase.TestResult.Get">
      <LineId Id="2" Count="0" />
    </LineIds>
    <LineIds Name="FB_TestCaseBase.TestState.Get">
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>