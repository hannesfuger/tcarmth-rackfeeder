    <Method Name="M_Init" Id="{dd195e2f-de60-4c36-b80c-fe91574eb32b}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC M_Init : IStation
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// set up defaults
Active := TRUE;
Enable := TRUE;
SUPER^.M_InitComponentBase();

// set up station id and name -> to be subclassed... 
//Station := E_Station.eStation_none;
//stName := stTextListGlobal.stText_ST000_Name;

sqAuto.SetInfo(Name);
nStateColor := TO_DWORD(STATICS.stColor.White);

stHmiToStation REF= P_HMI_Controller.aStHmiToStation[eStation];
stHmiManualIn REF= HMI.stHmi.stIn.arrStStation[eStation].stManual;
stHmiManualOut REF= HMI.stHmi.stOut.stCommon.arrStStation[eStation].stManual;
stLocalSettings REF= Services.stSettings.stStationSettings[eStation];
stLocalMonitoring REF= HMI.stHmi.stOut.stCommon.stMonitoring.astMonitoringStation[eStation];

//FOR ii := 0 TO CONST.iMaxIdxLocalStepChain DO
	sqAuto.SetInfo(stTextListGlobal.stText_initialize_station);	// -> to be subclassed, ... 
//END_FOR

M_Init := THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_InitDynManual" Id="{694f5279-f539-4db9-a107-1ad97e411fbb}" FolderPath="DynSetMonMan\">
      <Declaration><![CDATA[METHOD PROTECTED M_InitDynManual : BOOL
VAR_INPUT
	nIndex			: INT;
	stName			: ST_Text;
	stGroup			: ST_Text;
	stType			: ST_Text;
	diObjectIndex	: DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// chk
IF nIndex < 0 OR nIndex > CONST.iMaxIdxObject THEN
	StationError.ArgSbAppendRaise('Dyn. manual index out of range.');
	RETURN;
END_IF

stHmiManualOut.stObjects[nIndex].stName := stName;
stHmiManualOut.stObjects[nIndex].stGroup := stGroup;
stHmiManualOut.stObjects[nIndex].stType := stType;
stHmiManualOut.stObjects[nIndex].diObjectIndex := diObjectIndex;

M_InitDynManual := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_InitDynManualUi" Id="{a093ea62-0ed7-43f2-9d3d-c205c0028916}" FolderPath="DynSetMonMan\">
      <Declaration><![CDATA[METHOD PROTECTED M_InitDynManualUi : BOOL
VAR_IN_OUT
	fbManualUi	: FB_ManualUiBase;
END_VAR
VAR
	IManualUi	: I_ManualUi;
	nIx, ix		: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IManualUi := fbManualUi;

// search next free index
nIx := -1;
FOR ix := 0 TO CONST.iMaxIdxObject DO
	IF stHmiManualOut.stObjects[ix].stName.wsName = "" THEN
		nIx := ix;
		EXIT;
	END_IF
END_FOR

IF nIx < 0 THEN
	StationError.ArgSbAppendRaise('Next free dyn. manual index not found.');
	RETURN;
END_IF

IManualUi.ObjectIndex := (StationNb * 1000) + nIx + 1; // create unique object index

M_InitDynManualUi := M_InitDynManual(nIx,			// index 
		IManualUi.Name,								// device name
		Name,										// group -> station name
		stTextListGlobal.stText_ObjectTypeDrive,	// type
		IManualUi.ObjectIndex);						// object index
		
IManualUi.M_SetStateObject(stHmiManualOut.stObjects[nIx]);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_InitDynMonitoringItem" Id="{75c32d60-2a6d-4406-a748-73d378a60d34}" FolderPath="DynSetMonMan\">
      <Declaration><![CDATA[METHOD PROTECTED M_InitDynMonitoringItem : BOOL
VAR_INPUT
	nIndex		: INT;
	wsName		: WSTRING;
	stGroup		: ST_Text;
	eDataType	: E_DataType;
	stUnit		: ST_Text;			
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// chk
IF nIndex < 0 OR nIndex > CONST.iMaxIdxMonitoring THEN
	StationError.ArgSbAppendRaise('Dyn. monitoring index out of range.');
	RETURN;
END_IF

stLocalMonitoring.astMonitoring[nIndex].stIndex.nNameId := nIndex;
stLocalMonitoring.astMonitoring[nIndex].stIndex.wsNameId := wsName;
stLocalMonitoring.astMonitoring[nIndex].stName := F_CreateDynText(wsName, nIndex);
stLocalMonitoring.astMonitoring[nIndex].eDataType := eDataType;
stLocalMonitoring.astMonitoring[nIndex].stGroup := stGroup;
stLocalMonitoring.astMonitoring[nIndex].stUnit := stUnit;

M_InitDynMonitoringItem := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_InitDynSettingsItem" Id="{c58a2340-e337-4ec5-b5c0-cb90b5f97eba}" FolderPath="DynSetMonMan\">
      <Declaration><![CDATA[METHOD PROTECTED M_InitDynSettingsItem : BOOL
VAR_INPUT
	nIndex					: INT;
	wsIndex					: WSTRING;
	stSettGroup				: ST_Text;
	stSettTitle				: ST_Text;
	stSettUnit				: ST_Text;	
	eSettDataType			: E_DataType;	
	fSettValueMin			: REAL;
	fSettValueMax			: REAL;
	// required user level, 0 = none
	nRequiredUserLevel		: INT := 0;	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// chk
IF nIndex < 0 OR nIndex > CONST.iMaxIdxLocalSetting THEN
	StationError.ArgSbAppendRaise('Dyn. setting index out of range.');
	RETURN;
END_IF

M_InitDynSettingsItem := F_InitDynDataItem(
							nIndex,
							wsIndex,
							stSettGroup,
							stSettTitle,
							stSettUnit,
							eSettDataType,
							fSettValueMin,
							fSettValueMax,
							// required user level, 0 = none
							nRequiredUserLevel,
							E_RecipeMode.eRecipeMode_ToFrom,
							stLocalSettings.stDynStationSettings);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_InitEx" Id="{ee927414-04b1-467a-ae4b-7b83ebf46dd2}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC M_InitEx : IStation
VAR_INPUT
	ILogger			: I_Logger;
	IEventHandler	: I_EventHandler;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_InitEx := THIS^.M_Init();

// set up logger and event handler
SUPER^.M_InitComponentBaseEx(ILogger, IEventHandler);

// init extended stuff here...
]]></ST>
      </Implementation>
    </Method>
