END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[SelPointAutoTwo := fbTmpCtrl.bSelSetpoint;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{743c2d28-07a7-4350-a39a-a1ab777951a5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[fbTmpCtrl.bSelSetpoint := SelPointAutoTwo;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="SeqRun" Id="{8568ac87-243b-4b03-83c4-d4c777d80bec}" FolderPath="_Sequences\">
      <Declaration><![CDATA[METHOD SeqRun
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
CASE eSequenceId OF

	eFurnaceSeq_hand:
		THIS^._HAND();
		
	eFurnaceSeq_auto:
		THIS^._AUTO();
	
	eFurnaceSeq_tune:
		THIS^._TUNE();
		
	eFurnaceSeq_off:
		THIS^._OFF();
END_CASE
]]></ST>
      </Implementation>
    </Method>
