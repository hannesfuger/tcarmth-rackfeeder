<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_HMI_Provider_TC3" Id="{836e141b-a066-4f0e-9bc2-7781bf259c31}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_HMI_Provider_TC3 EXTENDS FB_HMI_PROVIDER_BASE
VAR_OUTPUT
END_VAR
VAR
	ILog	: I_Logger;
	stIn	: REFERENCE TO ST_FromTc3Hmi;
	stOut	: REFERENCE TO ST_ToTc3Hmi;

	fbCounter			: FB_CounterHandling;
	
	nPopupToken			: INT;
	bResetToken			: BOOL;
	tonResetToken		: TON;
	
	stInMain_Mirror		: ST_HMI_BASE_CONTROL_IN;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{f201b223-3f8e-49e7-9b66-ad300a907129}" />
    <Folder Name="Popup" Id="{84ffd6a9-3ca3-46e0-bcf4-5ba7d493e3db}" />
