    <Method Name="M_OpModeChanged" Id="{84539c43-6268-4497-8d96-e78fff88c5f9}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PROTECTED M_OpModeChanged : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*bBusy := FALSE;

IF (eOpMode <> eOpMode_step AND eOpMode <> eOpMode_auto) THEN
	sqAuto.Set(0);
END_IF

fbAxis.Stop();
fbAxisCh1.Stop();
fbAxisCh2.Stop();*)
]]></ST>
