    <Method Name="M_Counter" Id="{4738caff-80fd-476e-b77e-78d7fec25246}">
      <Declaration><![CDATA[METHOD M_Counter : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//init counter
IF NOT bInitCounter THEN
	bInitCounter := TRUE;
	
	FOR ii := 0 TO CONST.iMaxIdxCounter DO
		MEMSET(ADR(stCounter[ii].stGroup), 0, SIZEOF(stCounter[ii].stGroup));
		MEMSET(ADR(stCounter[ii].stName), 0, SIZEOF(stCounter[ii].stName));
		stCounter[ii].stGroup.wsNameId := stCounter[ii].stGroup.wsName := TO_WSTRING(ii);
	END_FOR
	
	stCounter[E_Counter.eCounter_General].stName.wsName := "Zaehler | Gesamt";
	//stCounter[E_Counter.eCounter_Maintenance].stName.wsName := "Zaehler | Wartung";
	stCounter[E_Counter.eCounter_Shift].stName.wsName := "Zaehler | Schicht";
	//stCounter[E_Counter.eCounter_Order].stName.wsName := "Zaehler | Auftrag";	
	//stCounter[E_Counter.eCounter_St001].stName.wsName := "Zaehler | St001_Eingabe_Takte";

	FOR ii := 0 TO CONST.iMaxIdxCounter DO
		stCounter[ii].stName.wsNameId := stCounter[ii].stName.wsName;
	END_FOR	
END_IF


FOR ii := 0 TO CONST.iMaxIdxCounter DO
	IF (stCounter[ii].eCurrentReactionOkLevel1 = E_CounterReaction.eCounterReaction_Info) THEN
		IEvent.Select(Tc_Events.PlantEventClass.InfoEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 1 Ok');
	END_IF
	IF (stCounter[ii].eCurrentReactionOkLevel2 = E_CounterReaction.eCounterReaction_Info) THEN
		IEvent.Select(Tc_Events.PlantEventClass.InfoEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 2 Ok');
	END_IF
	
	IF (stCounter[ii].eCurrentReactionOkLevel1 = E_CounterReaction.eCounterReaction_Warning) THEN
		IEvent.Select(Tc_Events.PlantEventClass.WarningEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 1 Ok');
	END_IF
	IF (stCounter[ii].eCurrentReactionOkLevel2 = E_CounterReaction.eCounterReaction_Warning) THEN
		IEvent.Select(Tc_Events.PlantEventClass.WarningEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 2 Ok');
	END_IF

	IF (stCounter[ii].eCurrentReactionOkLevel1 = E_CounterReaction.eCounterReaction_Error) THEN
		IEvent.Select(Tc_Events.PlantEventClass.ErrorEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 1 Ok');
	END_IF
	IF (stCounter[ii].eCurrentReactionOkLevel2 = E_CounterReaction.eCounterReaction_Error) THEN
		IEvent.Select(Tc_Events.PlantEventClass.ErrorEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 2 Ok');
	END_IF

	
	IF (stCounter[ii].eCurrentReactionNokLevel1 = E_CounterReaction.eCounterReaction_Info) THEN
		IEvent.Select(Tc_Events.PlantEventClass.InfoEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 1 NOk');
	END_IF
	IF (stCounter[ii].eCurrentReactionNokLevel2 = E_CounterReaction.eCounterReaction_Info) THEN
		IEvent.Select(Tc_Events.PlantEventClass.InfoEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 2 NOk');
	END_IF
	
	IF (stCounter[ii].eCurrentReactionNokLevel1 = E_CounterReaction.eCounterReaction_Warning) THEN
		IEvent.Select(Tc_Events.PlantEventClass.WarningEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 1 NOk');
	END_IF
	IF (stCounter[ii].eCurrentReactionNokLevel2 = E_CounterReaction.eCounterReaction_Warning) THEN
		IEvent.Select(Tc_Events.PlantEventClass.WarningEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 2 NOk');
	END_IF

	IF (stCounter[ii].eCurrentReactionNokLevel1 = E_CounterReaction.eCounterReaction_Error) THEN
		IEvent.Select(Tc_Events.PlantEventClass.ErrorEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 1 NOk');
	END_IF
	IF (stCounter[ii].eCurrentReactionNokLevel2 = E_CounterReaction.eCounterReaction_Error) THEN
		IEvent.Select(Tc_Events.PlantEventClass.ErrorEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 2 NOk');
	END_IF
	
	
	IF (stCounter[ii].eCurrentReactionTotalLevel1 = E_CounterReaction.eCounterReaction_Info) THEN
		IEvent.Select(Tc_Events.PlantEventClass.InfoEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 1 Total');
	END_IF
	IF (stCounter[ii].eCurrentReactionTotalLevel2 = E_CounterReaction.eCounterReaction_Info) THEN
		IEvent.Select(Tc_Events.PlantEventClass.InfoEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 2 Total');
	END_IF
	
	IF (stCounter[ii].eCurrentReactionTotalLevel1 = E_CounterReaction.eCounterReaction_Warning) THEN
		IEvent.Select(Tc_Events.PlantEventClass.WarningEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 1 Total');
	END_IF
	IF (stCounter[ii].eCurrentReactionTotalLevel2 = E_CounterReaction.eCounterReaction_Warning) THEN
		IEvent.Select(Tc_Events.PlantEventClass.WarningEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 2 Total');
	END_IF

	IF (stCounter[ii].eCurrentReactionTotalLevel1 = E_CounterReaction.eCounterReaction_Error) THEN
		IEvent.Select(Tc_Events.PlantEventClass.ErrorEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 1 Total');
	END_IF
	IF (stCounter[ii].eCurrentReactionTotalLevel2 = E_CounterReaction.eCounterReaction_Error) THEN
		IEvent.Select(Tc_Events.PlantEventClass.ErrorEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 2 Total');
	END_IF


	IF (stCounter[ii].eCurrentReactionNokLevel1 = E_CounterReaction.eCounterReaction_SerialFault_Warning) THEN
		IEvent.Select(Tc_Events.PlantEventClass.WarningEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 1 NOk Serienfehler');
	END_IF
	IF (stCounter[ii].eCurrentReactionNokLevel2 = E_CounterReaction.eCounterReaction_SerialFault_Warning) THEN
		IEvent.Select(Tc_Events.PlantEventClass.WarningEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 2 NOk Serienfehler');
	END_IF

	IF (stCounter[ii].eCurrentReactionNokLevel1 = E_CounterReaction.eCounterReaction_SerialFault_Error) THEN
		IEvent.Select(Tc_Events.PlantEventClass.ErrorEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 1 NOk Serienfehler');
	END_IF
	IF (stCounter[ii].eCurrentReactionNokLevel2 = E_CounterReaction.eCounterReaction_SerialFault_Error) THEN
		IEvent.Select(Tc_Events.PlantEventClass.ErrorEvent)
			  .ArgSbInitWs(stTextListGlobal.stText_NG_Counter.wsName)
			  .ArgSbAppend(' | ')
			  .ArgSbAppendWs(stCounter[ii].stName.wsName)
			  .ArgSbAppendRaise(' | Level 2 NOk Serienfehler');
	END_IF
END_FOR	

//reset counter

//rtrigResetCounter.CLK:=HMI.stRmthVisu.stVisuToPlc.bResetCounter;
//rtrigResetCounter();
//
//HMI.stRmthVisu.stVisuToPlc.iResetCounter:=LIMIT(1,HMI.stRmthVisu.stVisuToPlc.iResetCounter,(E_Counter.eCounter_Max-1));
//
//IF (HMI.stRmthVisu.stVisuToPlc.iResetCounter <=0) THEN
//	;
//ELSE
//	IF rtrigResetCounter.Q  AND bUserLevel[1] THEN
//		FOR ii:=2 TO (E_Counter.eCounter_Max-1) BY 1 DO 
//			IF(HMI.stRmthVisu.stVisuToPlc.iResetCounter = 1) THEN
//				F_Counter(E_CounterMode.eCounterMode_All_Clear,stCounter[ii]);	
//			END_IF		
//		END_FOR 
//		IF (HMI.stRmthVisu.stVisuToPlc.iResetCounter <> 1) THEN
//			F_Counter(E_CounterMode.eCounterMode_All_Clear,stCounter[LIMIT(2,HMI.stRmthVisu.stVisuToPlc.iResetCounter,(E_Counter.eCounter_Max-1))]);
//		END_IF
//	END_IF
//	//shift counter
