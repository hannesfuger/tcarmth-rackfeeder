    <Property Name="Enable" Id="{c379c254-1955-4809-af60-2f3bc1324938}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
PROPERTY PUBLIC Enable : BOOL]]></Declaration>
      <Get Name="Get" Id="{4ca5a6a0-36b6-4779-92fc-58d868446c73}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Enable := bEnable;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{c18b50e2-a2b8-4393-8ffe-e8a4cb226920}">
        <Declaration><![CDATA[]]></Declaration>
