    <Method Name="CreateAlarm" Id="{1f60ac4f-2e26-4b3b-8d04-66a211566c2d}" FolderPath="Fluent\">
      <Declaration><![CDATA[METHOD PUBLIC CreateAlarm : I_EventHandler
VAR_INPUT
	stEventEntry      : TcEventEntry;
    bWithConfirmation : BOOL := FALSE;
    ipSourceInfo      : I_TcSourceInfo := NULL;
END_VAR
VAR
	hres 	: HRESULT;
	msg		: STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CreateAlarm := THIS^;
IF (iCntAlm > Const.iMaxIdxAlam) THEN
	msg := CONCAT('Max. events exceeded, Const.iMaxIdxAlam: ', TO_STRING(Const.iMaxIdxAlam));
	fbCodeErrRef.ipArguments.Clear().AddString(msg);
	fbCodeErrRef.Raise(0);
	RETURN;
END_IF

hres := afbAlarm[iCntAlm].CreateEx(stEventEntry, bWithConfirmation, ipSourceInfo);

IF (hres = S_OK) THEN
	iCntAlm := iCntAlm + 1;
ELSE
	msg := CONCAT('Create alarm failed, HRESULT: ', TO_STRING(hres));
	fbCodeErrRef.ipArguments.Clear().AddString(msg);
	fbCodeErrRef.Raise(0);
END_IF]]></ST>
      </Implementation>
    </Method>
