  "trigger": [
    {
      "event": "onInitialized",
      "actions": [
        {
          "objectType": "JavaScript",
          "active": true,
          "sourceLines": [
            "var nLevel = 0;",
            "var userGroup = TcHmi.Server.getGroupsOfCurrentUser();",
            "if(userGroup.length) {",
            "    console.log('Current user is in groups ' + userGroup.join(', '));",
            " ",
            "    if (userGroup.includes(\"__SystemAdministrators\" )) {",
            "\t    nLevel = 6;",
            "\t}",
            "    else if (userGroup.includes(\"__SystemMaintenanceUsers\" ) ) {",
            "\t    nLevel = 3;",
            "\t}",
            "    //TcHmi.Write",
            "} else {",
            "    console.log('We have no current user group.');",
            "}",
            "",
            "// write level",
            "TcHmi.Server.writeSymbolEx('PLC1.HMI.stHmiTc3::stIn::stUserMgmt::iHmiUserLevel', nLevel, { timeout: 2000 }, function(data){",
            "    if(data.error !== TcHmi.Errors.NONE){",
            "        console.log('TcHmi.Server class level error:', data.error);",
            "        return;",
            "    }",
            "    var response = data.response;",
            "    if (!response || response.error !== undefined) {",
            "        console.log('TwinCAT HMI Server response level error:', response.error);",
            "        return;",
            "    }",
            "    var commands = response.commands;",
            "    if(commands === undefined){",
            "        return;",
            "    }",
            "    var command = commands[0];",
            "    if(command === undefined){",
            "        return;",
            "    }",
            "    if(command.error !== undefined){",
            "        console.log('TwinCAT HMI Server command level error:', command.error);",
            "        return;",
            "    }",
            "    ",
            "    console.log('User level written.');",
            "});"
          ],
          "asyncWait": true,
          "waitMode": "Synchronous"
        }
      ]
    }
  ],
