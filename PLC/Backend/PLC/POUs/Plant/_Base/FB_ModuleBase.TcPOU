    <Method Name="M_Init" Id="{12111a4c-2c7a-41dc-8718-0a2a44be41f0}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC M_Init : IModule
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// set up defaults
Active := TRUE;
Enable := TRUE;
SUPER^.M_InitComponentBase();

// set up station id and name -> to be subclassed... 
//Module := E_Module.eModule_none;
//Name := stTextListGlobal.stText_M000_Name;

sqAuto.SetInfo(Name);
nStateColor := TO_DWORD(STATICS.stColor.White);

stHmiToModule REF= P_HMI_Controller.aStHmiToModule[eModule];
stHmiManualIn REF= HMI.stHmi.stIn.arrStModule[eModule].stManual;
stHmiManualOut REF= HMI.stHmi.stOut.stCommon.arrStModule[eModule].stManual;
stLocalSettings REF= Services.stSettings.stModuleSettings[eModule];
stLocalMonitoring REF= HMI.stHmi.stOut.stCommon.stMonitoring.astMonitoringModule[eModule];

//FOR ii := 0 TO CONST.iMaxIdxLocalStepChain DO
	sqAuto.SetInfo(stTextListGlobal.stText_initialize_station);	// -> to be subclassed, ... 
//END_FOR

M_Init := THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_InitDynManual" Id="{6be7f316-ffd0-4fc9-9a8c-58b08bb54d75}" FolderPath="DynSetMonMan\">
      <Declaration><![CDATA[METHOD PROTECTED M_InitDynManual : BOOL
VAR_INPUT
	nIndex			: INT;
	stName			: ST_Text;
	stGroup			: ST_Text;
	stType			: ST_Text;
	diObjectIndex	: DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// chk
IF nIndex < 0 OR nIndex > CONST.iMaxIdxObject THEN
	ModuleError.ArgSbAppendRaise('Dyn. manual index out of range.');
	RETURN;
END_IF

stHmiManualOut.stObjects[nIndex].stName := stName;
stHmiManualOut.stObjects[nIndex].stGroup := stGroup;
stHmiManualOut.stObjects[nIndex].stType := stType;
stHmiManualOut.stObjects[nIndex].diObjectIndex := diObjectIndex;

M_InitDynManual := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_InitDynManualUi" Id="{4c3a9304-06be-4330-844b-ab4d111fe81a}" FolderPath="DynSetMonMan\">
      <Declaration><![CDATA[METHOD PROTECTED M_InitDynManualUi : BOOL
VAR_IN_OUT
	fbManualUi	: FB_ManualUiBase;
END_VAR
VAR
	IManualUi	: I_ManualUi;
	nIx, ix		: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IManualUi := fbManualUi;

// search next free index
nIx := -1;
FOR ix := 0 TO CONST.iMaxIdxObject DO
	IF stHmiManualOut.stObjects[ix].stName.wsName = "" THEN
		nIx := ix;
		EXIT;
	END_IF
END_FOR

IF nIx < 0 THEN
	ModuleError.ArgSbAppendRaise('Next free dyn. manual index not found.');
	RETURN;
END_IF

IManualUi.ObjectIndex := (ModuleNb * 100) + nIx + 1; // create unique object index

M_InitDynManualUi := M_InitDynManual(nIx,			// index 
		IManualUi.Name,								// device name
		Name,										// group -> module name
		stTextListGlobal.stText_ObjectTypeDrive,	// type
		IManualUi.ObjectIndex);						// object index
		
IManualUi.M_SetStateObject(stHmiManualOut.stObjects[nIx]);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_InitDynMonitoringItem" Id="{0e4d8124-bbc8-4c68-833c-270c558ed0da}" FolderPath="DynSetMonMan\">
      <Declaration><![CDATA[METHOD PROTECTED M_InitDynMonitoringItem : BOOL
VAR_INPUT
	nIndex		: INT;
	wsName		: WSTRING;
	stGroup		: ST_Text;
	eDataType	: E_DataType;
	stUnit		: ST_Text;			
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// chk
IF nIndex < 0 OR nIndex > CONST.iMaxIdxMonitoring THEN
	ModuleError.ArgSbAppendRaise('Dyn. monitoring index out of range.');
	RETURN;
END_IF

stLocalMonitoring.astMonitoring[nIndex].stIndex.nNameId := nIndex;
stLocalMonitoring.astMonitoring[nIndex].stIndex.wsNameId := wsName;
stLocalMonitoring.astMonitoring[nIndex].stName := F_CreateDynText(wsName, nIndex);
stLocalMonitoring.astMonitoring[nIndex].eDataType := eDataType;
stLocalMonitoring.astMonitoring[nIndex].stGroup := stGroup;
stLocalMonitoring.astMonitoring[nIndex].stUnit := stUnit;

M_InitDynMonitoringItem := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_InitDynSettingsItem" Id="{1e8f7297-bb82-4f81-a8c3-9add4b30dfed}" FolderPath="DynSetMonMan\">
      <Declaration><![CDATA[METHOD PROTECTED M_InitDynSettingsItem : BOOL
VAR_INPUT
	nIndex					: INT;
	wsIndex					: WSTRING;
	stSettGroup				: ST_Text;
	stSettTitle				: ST_Text;
	stSettUnit				: ST_Text;	
	eSettDataType			: E_DataType;	
	fSettValueMin			: REAL;
	fSettValueMax			: REAL;
	// required user level, 0 = none
	nRequiredUserLevel		: INT := 0;	
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// chk
IF nIndex < 0 OR nIndex > CONST.iMaxIdxLocalSetting THEN
	ModuleError.ArgSbAppendRaise('Dyn. setting index out of range.');
	RETURN;
END_IF

M_InitDynSettingsItem := F_InitDynDataItem(
							nIndex,
							wsIndex,
							stSettGroup,
							stSettTitle,
							stSettUnit,
							eSettDataType,
							fSettValueMin,
							fSettValueMax,
							// required user level, 0 = none
							nRequiredUserLevel,
							E_RecipeMode.eRecipeMode_ToFrom,
							stLocalSettings.stDynStationSettings);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_InitEvents" Id="{a3fe97e4-aa70-4896-9a1e-9701c9dc6d82}" FolderPath="Events\">
      <Declaration><![CDATA[METHOD PUBLIC M_InitEvents : IModule
VAR_IN_OUT CONSTANT
	infoEvent,
	warnEvent,
	errorEvent : TcEventEntry;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// create default module alarms
localEvents.Info := infoEvent;
localEvents.Warning := warnEvent;
localEvents.Error := errorEvent;
IEvent.CreateAlarm(infoEvent, FALSE, TcSourceInfo)
	  .CreateAlarm(warnEvent, TRUE, TcSourceInfo)
	  .CreateAlarm(errorEvent, TRUE, TcSourceInfo);

M_InitEvents := THIS^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_InitEx" Id="{4fc6f994-71fd-4b1d-bda3-e6b04f23471d}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD Public M_InitEx : IModule
VAR_INPUT
	ILogger			: I_Logger;
	IEventHandler	: I_EventHandler;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// set up logger and event handler
SUPER^.M_InitComponentBaseEx(ILogger, IEventHandler);

// set up module name -> to be subclassed... 
stName := stTextListGlobal.stText_M000_Name;

M_InitEx := THIS^;]]></ST>
      </Implementation>
    </Method>
