END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[result.Command := E_St030_Command.eSt030_Command_Storage_Get;
result.Position := iIxd;

GetHgCmd_StorageGet := result;]]></ST>
      </Implementation>
    </Method>
