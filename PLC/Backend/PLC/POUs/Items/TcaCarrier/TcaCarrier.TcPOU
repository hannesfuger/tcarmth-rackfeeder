    <Method Name="InitialCarrier" Id="{3b0c22c0-d494-4035-843c-f65b12875767}" FolderPath="Operations\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable'}
METHOD InitialCarrier : TcaCarrierData
VAR
	_i			: INT;
END_VAR

VAR_INST
	WorkpieceCtrl : TcaWorkpieceControl;//(This^);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_data.Enabled := TRUE;

FOR _i := 0 TO MAX_WORKPIECEPLACES DO	
	
	IF NOT _data.WorkpiecesEnabled[_i] THEN
		RETURN;
	END_IF	

	_data.WorkpiecesData[_i].Id := _i+1;
	_data.WorkpiecesData[_i].Error := FALSE;
	_data.WorkpiecesData[_i].SerialNumber := '';
	_data.WorkpiecesData[_i].CurrentStatus := _config.InitialStatus;	
	_data.WorkpiecesData[_i].InitialStatus := _config.InitialStatus;
	_data.WorkpiecesData[_i].RequestStatus := _config.RequestStatus;
	
	WorkpieceCtrl.SetReference(_data.WorkpiecesData[_i]);
	WorkpieceCtrl.LogEntry('New Workpiece');
	
	
END_FOR]]></ST>
      </Implementation>
    </Method>
