    <Method Name="M_Init" Id="{83805d63-39e2-4a85-a14a-af5b166d1563}" FolderPath="Methods\">
      <Declaration><![CDATA[METHOD INTERNAL M_Init : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// init Safety stuff here...

// set up logger
ILog := Services.ILog;

// set up safety IOs
stIO REF= IO.stSafetyIO;

// set up event handler 
IEvent := Services.fbEventHandler;

//aSClearText[EN] := 'Safety init done.';
M_Init := TRUE;
]]></ST>
      </Implementation>
