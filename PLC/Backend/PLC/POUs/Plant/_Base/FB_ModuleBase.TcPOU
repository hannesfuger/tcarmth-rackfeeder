<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ModuleBase" Id="{750026b4-7c8f-4465-87ee-327696055617}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ModuleBase EXTENDS FB_ComponentBase IMPLEMENTS IModule
VAR_INPUT
	bEmergencyStopOk 	: BOOL;
	bSafetyOk 			: BOOL;
	bEnable 			: BOOL;
	bAutoHome 			: BOOL;		// if its true station will be homed by start button
	iNumberOfStepChains	: INT := 1;	// count of stepchains per station
	iStepChainIndex		: INT; 		// index to link text of choosed stepchain to hmi
END_VAR
VAR_OUTPUT
	nStateColor			: DWORD;	// color for state of module

	bBusy				: BOOL;		// module is busy
	bTransferEnable		: BOOL;		// transfer enable from module
	stTextAuto			: ST_Text;
	stTextHome			: ST_Text;
	
	/// error-stop status
	bAutoStop_Error		: BOOL;
END_VAR
VAR
	stHmiToModule		: REFERENCE TO ST_DefaultHmiToPlc;				// default hmi to module
	stHmiManualIn		: REFERENCE TO ST_HMI_BASE_MODULE_MANUAL_IN;	// hmi manual to module
	stHmiManualOut		: REFERENCE TO ST_HMI_BASE_MODULE_MANUAL_OUT;	// hmi manual from module
	stLocalSettings		: REFERENCE TO ST_ModuleDynSettings;			// dyn. module settings
	stLocalMonitoring	: REFERENCE TO ST_Monitoring_Module;			// dyn. module monitoring
	
	stLocalSettingsBackup	: ST_ModuleDynSettings;	// dyn. module settings
	
	/// - stations of this module -
	aIStaton	: ARRAY[0..E_Station.eStation_nMaxIdx] OF IStation;
	
	nModuleNb	: INT;
	eModule		: E_Module;
	eOpMode		: E_OpMode;
	bStopped	: BOOL := TRUE;
	
	/// enable var's
	bRunCycle, bRunStep, bRunHoming, bInHome : BOOL;

	/// counter
	diCycles				: UDINT; // Zykluszähler
	diLastCycleTime			: UDINT; // letzte Zykluszeit [ms]
	
	tonOpModeOff			: TON;
	fTrigSafetyOk			: F_TRIG;
	rtrigOpModeChanged		: R_TRIG;
	
	rtirgSafetyOpMode_Auto	: R_TRIG;
	rtirgSafetyOpMode_Hand	: R_TRIG;
	rtirgSafetyOpMode_Aus	: R_TRIG;
	
	bInitSettings	: BOOL;
	bInitMonitoring	: BOOL;
	bInitManual		: BOOL;
	
	sb				: FB_StringBuilder;
	sqHome, sqAuto	: FB_SequenceHelperSb;
	localEvents		: ST_DefaultEventClasses;
END_VAR
VAR PERSISTENT
	diTotalCycles	: UDINT; // Zykluszähler
	eOpModeOld		: E_OpMode;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
