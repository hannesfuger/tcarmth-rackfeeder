    <div id="Module_ManualPage_UcManual" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-height="95" data-tchmi-height-unit="%" data-tchmi-left="0" data-tchmi-left-unit="%" data-tchmi-top="7" data-tchmi-top-unit="%" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-right-unit="px" data-tchmi-bottom-unit="px" data-tchmi-target-user-control="Base_HMI/Base/Manual/ucManual.usercontrol" data-tchmi-stmanualtohmi="%pp%stModuleBaseToHmi::stManual%/pp%" data-tchmi-stmanualfromhmi="%pp%stModuleBaseFromHmi::stManual%/pp%">
