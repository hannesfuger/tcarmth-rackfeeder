// FB diagnostic and reset 
IF fbMovMod1.Execute AND NOT fbMovMod1.Busy THEN
	IF fbMovMod1.Error AND (fbMovMod1.ErrorID <> 17022) THEN
		nErrorId := fbMovMod1.ErrorID;
		M_SetLocalErrorS('engine positioning modulo (FB1): ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbMovMod1.Execute := FALSE;
END_IF
IF fbMovMod2.Execute AND NOT fbMovMod2.Busy THEN
	IF fbMovMod2.Error AND (fbMovMod2.ErrorID <> 17022) THEN
		nErrorId := fbMovMod2.ErrorID;
		M_SetLocalErrorS('engine positioning modulo (FB2): ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbMovMod2.Execute := FALSE;
END_IF

// return if not in move rel
IF eCommandExecute <> E_MotionCommand.eMotionCommand_moveMod THEN
	RETURN;
END_IF

//aSClearText[0] := 'Antrieb Positionierung Modulo';	
//aSClearText := F_GetTranslatedTxtLib('engine positioning modulo', eLanguage);	
IF NOT fbMovMod1.Busy THEN
	fbMovMod1(Axis := fbAxisRef, Execute := TRUE);
	eCommandExecute := E_MotionCommand.eMotionCommand_none;
ELSIF NOT fbMovMod2.Busy THEN
	fbMovMod2(Axis := fbAxisRef, Execute := TRUE);
	eCommandExecute := E_MotionCommand.eMotionCommand_none;
ELSE
	nErrorId := 0;
	M_SetLocalError(F_CreateDynText("engine positioning modulo. No component ready", 0));
END_IF]]></ST>
      </Implementation>
    </Action>
