    <Property Name="RunManStep" Id="{bebf9843-2bf1-4211-9e43-ad5dcf762cbe}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring':='variable'}
PROPERTY PUBLIC RunManStep : Bool]]></Declaration>
      <Get Name="Get" Id="{b3a7a39c-b06b-40c8-9401-97baca3fa651}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[RunManStep := EnableSummary AND
			NOT bAutoStop_Error AND
			(OpMode = E_OpMode.eOpMode_manual AND (bRunStep OR NOT bEnableManualStep));
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="RunStep" Id="{2cd1a20d-9c63-48a7-aef5-2e9908460bef}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring':='variable'}
PROPERTY PUBLIC RunStep : BOOL]]></Declaration>
      <Get Name="Get" Id="{9386ea9e-764e-4c1a-9ce1-22eaa413ff55}">
        <Declaration><![CDATA[VAR
	sMsg : WSTRING(255);
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[// Rückgabe
RunStep := EnableSummary AND
			NOT bAutoStop_Error AND
			((bRunStep AND eOpMode = eOpMode_step) OR
			(eOpMode = eOpMode_auto));
]]></ST>
        </Implementation>
      </Get>
    </Property>
