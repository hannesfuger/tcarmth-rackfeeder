    <Property Name="RunStep" Id="{1ce4bda6-3896-4b76-a0b8-82ffd7bcfa89}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring':='variable'}
PROPERTY PUBLIC RunStep : BOOL]]></Declaration>
      <Get Name="Get" Id="{0ef3308d-b9c7-4e84-b7fc-be1062c23ee7}">
        <Declaration><![CDATA[VAR
	sMsg : WSTRING(255);
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[// Rückgabe
RunStep := EnableSummary AND
			NOT bAutoStop_Error AND
			((bRunStep AND eOpMode = eOpMode_step) OR
			(eOpMode = eOpMode_auto));
]]></ST>
        </Implementation>
      </Get>
    </Property>
