      </Set>
    </Property>
    <Method Name="ServiceMode" Id="{0366d0b8-be6d-4911-9590-379d02ca1371}">
      <Declaration><![CDATA[{warning 'Methodenimplementierung hinzufügen'}
(*~
	<docu>
		<summary>
		    Custom service (manual, maintenance) logic.
			This method must be implemented in derived class.
		</summary>			
	</docu>	
~*)
METHOD ServiceMode
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _service.DisableCarriers THEN 
_service.DisableCarriers := FALSE;
DisableCarriers(); 
END_IF

IF _service.EnableCarriers THEN 
_service.EnableCarriers := FALSE;
EnableCarriers(); 
END_IF

IF _service.FillWithEmptyCarriers THEN 
_service.FillWithEmptyCarriers := FALSE;
FillWithEmptyCarriers(); 
END_IF

IF _service.FillWithFinishedCarriers THEN 
_service.FillWithFinishedCarriers := FALSE;
FIllWithFinishedCarriers(); 
END_IF

IF _service.FillWithInitialCarriers THEN 
_service.FillWithInitialCarriers := FALSE;
FillWithInitialCarriers(); 
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetCarrierAt" Id="{b0bd40da-f776-440b-9c03-0fdf5c1fbe9f}" FolderPath="Functions\">
      <Declaration><![CDATA[METHOD PUBLIC SetCarrierAt : BOOL
VAR_INPUT
	Position	: INT;
	Data : TcaCarrierData;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Position < 0 OR Position > MAX_CARRIERPLACES OR NOT _data.CarriersEnabled[Position] THEN
   RETURN;
END_IF

_data.CarriersData[Position]:= Data;
_data.CarriersData[Position].Enabled := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetEmptyCarrierAt" Id="{65c5df25-be19-4fa2-83aa-fbe7eb2cc13d}" FolderPath="Functions\">
      <Declaration><![CDATA[METHOD PUBLIC SetEmptyCarrierAt : BOOL
VAR_INPUT
	Position	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Position < 0 OR Position > MAX_CARRIERPLACES OR NOT _data.CarriersEnabled[Position] THEN
   RETURN;
END_IF

_TemplateCarrier.Config := _config.CarrierConfig;
_TemplateCarrier.EmptyCarrier();

_data.CarriersData[Position]:= _TemplateCarrier.Data;
_data.CarriersData[Position].Enabled := TRUE;]]></ST>
      </Implementation>
    </Method>
