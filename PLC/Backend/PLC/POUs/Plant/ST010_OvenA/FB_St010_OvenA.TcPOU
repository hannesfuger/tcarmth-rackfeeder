    <Method Name="M_Run" Id="{cebb2ecc-c279-4c6f-a6fe-0321de233eaa}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC M_Run : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// check refs valid
IF NOT __ISVALIDREF(stIO) THEN
	RETURN;
END_IF

M_RUN := SUPER^.M_Run();

M_DynSettings();
M_DynManual();
M_DynMonitoring();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Sequence" Id="{7dff6ed7-6328-47b2-aea8-f4412174983d}">
      <Declaration><![CDATA[METHOD PROTECTED M_Sequence
VAR
	fTmp : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// signal mapping (e.g.: enable)
stSt010IOvenA.bEnableSequence := (sqAuto.Step = 100 AND fbAxis.Operational AND fbAxisCh1.Operational AND fbAxisCh2.Operational) OR
									bStationDeaktiv;

// automatic sequence
CASE sqAuto.Step OF
	
	0:	sqAuto.Info.Set("Warte auf Auto Start");
		IF RunCycle AND RunStep THEN
			//sqAuto.Info.Set("Warte auf GRST");
			//IF sqAuto.InHome AND bInHome THEN
				sqAuto.InHome := FALSE;
				sqAuto.Step := 10;
			//ELSE
			//	StationError.ArgSbAppendWsRaise(stTextlistGlobal.stText_station_not_in_hp);
			//END_IF
		END_IF
		
	10:	sqAuto.Info.Set("Prüfe Startbedingungen");
		IF NOT (fbAxis.Operational AND fbAxis.Homed) THEN
			StationError.ArgSbAppendRaise('Achse nicht bereit');
		ELSIF NOT fbAxisCh1.Operational THEN
			StationError.ArgSbAppendRaise('Achse CH1 nicht bereit');
		ELSIF NOT fbAxisCh2.Operational THEN
			StationError.ArgSbAppendRaise('Achse CH2 nicht bereit');
		ELSE
			CycleStart();
			//stSt010IOvenA.bStorageEnd := FALSE;
			sqAuto.Step := 15;
		END_IF
		
	15:	sqAuto.Info.Set("Prüfe Status");
		IF F_TargetWindowReached(fbAxisCh1.Position, PosHomeCh, chAxisPosTol) AND 
		   F_TargetWindowReached(fbAxisCh2.Position, PosHomeCh, chAxisPosTol) THEN
			sqAuto.SetStep(20);
		ELSE
			sqAuto.SetStep(160); // close segment
		END_IF
		
	20:	sqAuto.Info.Set("Start Achse CH1 auf Homepos.");
		fbAxisCh1.MoveAbsExVel(PosHomeCh, WorkSpeedCh);
		fbAxisCh2.MoveAbsExVel(PosHomeCh, WorkSpeedCh);
		sqAuto.Step := 30;
		
	30:	sqAuto.Info.Set("Warte Achse CH1 in Homeposition");
		IF NOT fbAxisCh1.TargetWindowReached(chAxisPosTol) THEN RETURN; END_IF
		sqAuto.Info.Set("Warte Achse CH2 in Homeposition");
		IF NOT fbAxisCh2.TargetWindowReached(chAxisPosTol) THEN RETURN; END_IF
		sqAuto.SetStep(100);

	// work
	100: sqAuto.Info.Set("Automatik, warte auf Anforderung vom HG");
		IF stSt030IHandling.bReqestOvenA_ChkIndex THEN
			sqAuto.Info.Append(", Index-Check");
			stSt010IOvenA.iConfirmPosition := stSt030IHandling.ActiveCommand.Position;
			stSt010IOvenA.bResponseIsEmptySlot := stSt010IOvenA.Trolley.IsEmptySlotAt(stSt010IOvenA.iConfirmPosition);
			stSt010IOvenA.bResponseChkIndex := TRUE;
			IF stSt030IHandling.bReqestOvenA THEN sqAuto.SetStep(110); END_IF
		END_IF	
		IF RunCycle THEN RETURN; END_IF
		sqAuto.Info.Set("Stop - warte auf Ablauf gestoppt");
		sqAuto.Step := 900;
		
	110: sqAuto.Info.Set("Start Achse zu Arbeitspos.");
		fPickupPos := PosWork;
		fbAxis.MoveAbsExVel(fPickupPos, WorkSpeed);
		sqAuto.Step := 115;
		
	115: sqAuto.Info.Set("Warte auf Achse in Arbeitspos");
		IF fbAxis.TargetReached() THEN
			sqAuto.SetStep(120);
		END_IF
		
	120: sqAuto.Info.Set("Start Achse CH1 zu Arbeitspos.");
		fbAxisCh1.MoveAbsExVel(PosWorkCh, WorkSpeedCh);
		fbAxisCh2.MoveAbsExVel(PosWorkCh, WorkSpeedCh);
		sqAuto.Step := 125;
		
	125: sqAuto.Info.Set("Warte Achse CH1 in Arbeitspos");
		IF fbAxisCh1.TargetWindowReached(chAxisPosTol) THEN
			sqAuto.SetStep(130);
		END_IF
		
	130: sqAuto.Info.Set("Start Achse CH2 zu Arbeitspos.");
		fbAxisCh2.MoveAbsExVel(PosWorkCh, WorkSpeedCh);
		sqAuto.Step := 135;
		
	135: sqAuto.Info.Set("Warte Achse CH2 in Arbeitspos");
		IF fbAxisCh2.TargetWindowReached(chAxisPosTol) THEN
			sqAuto.SetStep(140);
		END_IF
		
	140: sqAuto.Info.Set("Start Achse zu Arbeitspos. offen");
		fTmp := (PosWorkOpn - PosWork);
		IF fTmp > 540 THEN
			sqAuto.Info.Set("Max. Öffnungsweg überschritten: ")
					   .AppendAny(fTmp);
					   
			StationError.ArgSbAppendS(sqAuto.Info.ToString())
						.Raise();
			RETURN;
		END_IF
		fbAxis.MoveAbsExVel(PosWorkOpn, WorkSpeed);
		sqAuto.Step := 145;
		
	145: sqAuto.Info.Set("Warte auf Achse in Arbeitspos. offen");
		IF fbAxis.TargetReached() THEN
			sqAuto.Step := 150;
		END_IF
		
	150: sqAuto.Info.Set("Segment offen, warte auf Anforderung vom HG");
		stSt010IOvenA.bResponseOpn := TRUE;
		IF NOT stSt030IHandling.bReqestOvenA THEN
			stSt010IOvenA.bResponseOpn := FALSE;
			sqAuto.SetStep(160);
		END_IF
		
	160: sqAuto.Info.Set("Start Achse zu Arbeitspos.");
		fbAxis.MoveAbsExVel(fPickupPos, WorkSpeed);
		sqAuto.Step := 165;
		
	165: sqAuto.Info.Set("Warte auf Achse in Arbeitspos");
		IF fbAxis.TargetReached() THEN
			sqAuto.SetStep(170);
		END_IF
		
	170: sqAuto.Info.Set("Start Achse CH1 auf Homepos.");
		fbAxisCh1.MoveAbsExVel(PosHomeCh, WorkSpeedCh);
		fbAxisCh2.MoveAbsExVel(PosHomeCh, WorkSpeedCh);
		sqAuto.Step := 175;
		
	175:	sqAuto.Info.Set("Warte Achse CH1 in Homeposition");
		IF NOT fbAxisCh1.TargetWindowReached(chAxisPosTol) THEN RETURN; END_IF
		sqAuto.Info.Set("Warte Achse CH2 in Homeposition");
		IF NOT fbAxisCh2.TargetWindowReached(chAxisPosTol) THEN RETURN; END_IF
		sqAuto.SetStep(900);
		
	// rdy	
	900: sqAuto.Info.Set("Zyklus beendet");
		CycleEnd();
		sqAuto.Step := 0;	// ch axis back, loop

	// error
	1000: sqAuto.Info.Set("Error");
		bStopped := TRUE;
		sqAuto.InHome := FALSE;
		bRunHoming := FALSE;

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SetReferences" Id="{77f2783d-4b5a-4a5f-b2f5-d19ff9e14309}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD INTERNAL M_SetReferences : BOOL
VAR_IN_OUT
	stIoRef : ST_St010_IO;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIO REF= stIoRef;
M_SetReferences := TRUE;

fbHeatingPlate.SetReferences(stIoRef.stHeatingPlateIO);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Supervision" Id="{469169be-2989-41a7-a875-96ccd50f9999}">
      <Declaration><![CDATA[METHOD PROTECTED M_Supervision : BOOL
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// chk stopped
IF NOT bRunCycle OR P_Safety.bMachineRequestStop THEN
	IF P_Safety.bMachineRequestStop THEN
		fbAxis.Stop();
	END_IF
	IF sqAuto.StepTime > T#20S THEN
		bStopped := TRUE;
	END_IF
END_IF

// chk requested index
IF stSt030IHandling.bReqestOvenA_ChkIndex THEN
	;// --> confirm chk implemented in M_Sequence, step 100
	//stSt010IOvenA.iConfirmOpnIdxX := stSt030IHandling.ActiveCommand.IndexX;
	//stSt010IOvenA.iConfirmOpnIdxY := stSt030IHandling.ActiveCommand.IndexY;
	//stSt010IOvenA.bResponseEmptyAtIndex := stSt010IOvenA.Trolley.IsEmptySlotAt(stSt010IOvenA.iConfirmOpnIdxX, stSt010IOvenA.iConfirmOpnIdxY);
	//stSt010IOvenA.bResponseChkIndex := TRUE;
ELSE
	stSt010IOvenA.iConfirmPosition := -1;
	stSt010IOvenA.bResponseIsEmptySlot := FALSE;
	stSt010IOvenA.bResponseChkIndex := FALSE;
END_IF

// axis
IF fbAxis.bError THEN
	ReactToComponentError(fbAxisUi, E_EventReaction.Stop);
	
// ch1
ELSIF fbAxisCh1.bError THEN
	ReactToComponentError(fbAxisCh1Ui, E_EventReaction.Stop);
	
// ch2
ELSIF fbAxisCh2.bError THEN
	ReactToComponentError(fbAxisCh2Ui, E_EventReaction.Stop);
	
END_IF
]]></ST>
      </Implementation>
    </Method>
