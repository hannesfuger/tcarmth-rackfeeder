<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_ManualMode" Id="{42e0d273-a00b-42bd-ac19-f80248de52e4}">
    <Declaration><![CDATA[/// Enumeration of possible jog modi.
TYPE E_ManualMode :
(
	/// Manual mode - Tippen konstant
	eManualMode_Tippen := 0,
	
	/// Manual mode - Sollposition Absolut
	//eManualMode_MoveSollAbs,
	/// Manual mode - Relativ 0.01 Einheit
	eManualMode_Jog001,	
	/// Manual mode - Relativ 0.1 Einheit
	eManualMode_Jog01,
	/// Manual mode - Relativ 1 Einheit
	eManualMode_Jog1,
	/// Manual mode - Relativ 10 Einheiten
	eManualMode_Jog10,
	/// Manual mode - Relativ 100 Einheiten
	eManualMode_Jog100,
	/// Manual mode not set
	eManualMode_none
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>