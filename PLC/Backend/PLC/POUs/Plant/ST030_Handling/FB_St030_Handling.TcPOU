    <Method Name="Reset" Id="{10a8e846-9903-4149-8623-7023eb002a1c}" FolderPath="Internal\">
      <Declaration><![CDATA[/// Reset station logic
{attribute 'object_name' := 'Reset'}
METHOD Reset
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// base logic run
SUPER^.Reset();

// reset objects

IF fbAxisX.bError OR NOT RunCycle THEN
	fbAxisX.Reset();
END_IF
IF fbAxisY.bError OR NOT RunCycle THEN
	fbAxisY.Reset();
END_IF
IF fbAxisZ.bError OR NOT RunCycle THEN
	fbAxisZ.Reset();
END_IF]]></ST>
      </Implementation>
    </Method>
