    <Method Name="GetHgCmd_Default" Id="{24f6ce4a-4dd5-4ffb-858c-52d6dc116a8e}" FolderPath="StateEngine\">
      <Declaration><![CDATA[METHOD PRIVATE GetHgCmd_Default : ST_St030_Command
VAR
	result : ST_St030_Command;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// get next job for handling
// 1. drop existing HG pallet
// 2/3. put empty pallet to storage 1/2
// 4/5. put unfinished pallet to storage 1/2

// chk HG has active command
IF Plant.stSt030IHandling.ActiveCommand.Command <> E_St030_Command.eSt030_Command_none THEN
	// sb.Set('wait for active HG command done. Active cmd: ')
		//	 .Append(TO_String(Plant.stSt030IHandling.ActiveCommand.Command));
	RETURN;
END_IF
	
// prio 1: put handling command (e.g. drop existing pallet)
result := GetHgCmd_Default_Put();
IF result.Command <> E_St030_Command.eSt030_Command_none THEN
	// sb.Set('wait for requested HG command is active, cmd: ')
		//	 .Append(TO_String(Plant.stSt030IHandling.CommandRequest.Command));
	GetHgCmd_Default := result;
	RETURN;
END_IF

// prio 2-6: get handling command (e.g. get unfinished pallet)
result := GetHgCmd_Default_Get();
GetHgCmd_Default := result;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetHgCmd_Default_Get" Id="{99858cad-0d87-46ff-83b1-8ead73aa9117}" FolderPath="StateEngine\">
      <Declaration><![CDATA[METHOD PRIVATE GetHgCmd_Default_Get : ST_St030_Command
VAR
	none	: ST_St030_Command;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// default logic
GetHgCmd_Default_Get := none;

// chk pallet already on handling
IF Plant.stSt030IHandling.Pallet.CarrierPresent THEN
	RETURN;
END_IF

// prio 2: req empty carrier @ storage #1
IF Plant.stSt050IMould.bReqS1Empty AND 
NOT Plant.stSt040IStorage.Pallet1.HasEmptyWorkpieceplaces THEN
	IF Plant.stSt040IStorage.Pallet1.CarrierPresent THEN
		GetHgCmd_Default_Get := GetHgCmd_StorageGet(1); // 1st, get pallet from storage 1
	ELSE
		// sb.Set('wait for oven 1/2 has empty pallet)
		GetHgCmd_Default_Get := GetHgCmd_OvenGetEmptyPallet(); // get empty pallet from oven A/B
	END_IF
	RETURN;
END_IF

// prio 3: req empty carrier @ storage #2
IF Plant.stSt050IMould.bReqS2Empty AND 
NOT Plant.stSt040IStorage.Pallet2.HasEmptyWorkpieceplaces THEN
	IF Plant.stSt040IStorage.Pallet2.CarrierPresent THEN
		GetHgCmd_Default_Get := GetHgCmd_StorageGet(2); // 1st, get pallet from storage 2
	ELSE
		// sb.Set('wait for oven 1/2 has empty pallet)
		GetHgCmd_Default_Get := GetHgCmd_OvenGetEmptyPallet(); // get empty pallet from oven A/B
	END_IF
	RETURN;
END_IF

// prio 4: req unfinished carrier @ storage #1
IF Plant.stSt050IMould.bReqS1Unfinished AND 
NOT Plant.stSt040IStorage.Pallet1.HasWorkpiecesWithRequestStatus THEN
	IF Plant.stSt040IStorage.Pallet1.CarrierPresent THEN
		GetHgCmd_Default_Get := GetHgCmd_StorageGet(1); // 1st, get pallet from storage 1
	ELSE
		// sb.Set('wait for oven 1/2 has unfinished pallet)
		GetHgCmd_Default_Get := GetHgCmd_OvenGetUnfinishedPallet(); // get unfinished pallet from oven A/B
	END_IF
	RETURN;
END_IF

// prio 5: req unfinished carrier @ storage #2
IF Plant.stSt050IMould.bReqS2Unfinished AND 
NOT Plant.stSt040IStorage.Pallet2.HasWorkpiecesWithRequestStatus THEN
	IF Plant.stSt040IStorage.Pallet2.CarrierPresent THEN
		GetHgCmd_Default_Get := GetHgCmd_StorageGet(2); // 1st, get pallet from storage 2
	ELSE
		// sb.Set('wait for oven 1/2 has unfinished pallet)
		GetHgCmd_Default_Get := GetHgCmd_OvenGetUnfinishedPallet(); // get unfinished pallet from oven A/B
	END_IF
	RETURN;
END_IF

// prio 6: req no carrier @ storage #1/2
IF (Plant.stSt050IMould.bReqS1NoCarrier OR Plant.stM001IModule.bEmptyPlant) AND Plant.stSt040IStorage.Pallet1.CarrierPresent THEN
	GetHgCmd_Default_Get := GetHgCmd_StorageGet(1); // empty plant, get pallet from storage 1
ELSIF (Plant.stSt050IMould.bReqS2NoCarrier OR Plant.stM001IModule.bEmptyPlant) AND Plant.stSt040IStorage.Pallet2.CarrierPresent THEN
	GetHgCmd_Default_Get := GetHgCmd_StorageGet(2); // empty plant, get pallet from storage 2
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetHgCmd_Default_Put" Id="{725bef36-2c65-4ebd-99ec-f115d1b8b79f}" FolderPath="StateEngine\">
      <Declaration><![CDATA[METHOD PRIVATE GetHgCmd_Default_Put : ST_St030_Command
VAR
	none,
	result	: ST_St030_Command;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// default logic
GetHgCmd_Default_Put := none;

// chk pallet on handling
IF NOT Plant.stSt030IHandling.Pallet.CarrierPresent THEN
	RETURN;
END_IF

// unfinished @ hg --> to storage 1/2
IF Plant.stSt030IHandling.Pallet.HasUnfinishedWorkpieces THEN
	// sb.Set('wait for storage request unfinished')
	IF Plant.stSt050IMould.bReqS1Unfinished AND
	   NOT Plant.stSt040IStorage.Pallet1.CarrierPresent THEN
		GetHgCmd_Default_Put := GetHgCmd_StationPut(E_Station.eStation_ST040_Storage, 1);
	ELSIF Plant.stSt050IMould.bReqS2Unfinished AND
	   NOT Plant.stSt040IStorage.Pallet2.CarrierPresent THEN
		GetHgCmd_Default_Put := GetHgCmd_StationPut(E_Station.eStation_ST040_Storage, 2);
	ELSE
		// unfinished back to oven 1/2
		GetHgCmd_Default_Put := GetHgCmd_StationPut(Plant.stSt030IHandling.Source);
	END_IF
	RETURN;
END_IF

// empty @ hg --> to storage 1/2
IF Plant.stSt030IHandling.Pallet.HasEmptyWorkpieceplaces THEN
	// sb.Set('wait for storage request empty')
	IF Plant.stSt050IMould.bReqS1Empty AND
	   NOT Plant.stSt040IStorage.Pallet1.CarrierPresent THEN
		GetHgCmd_Default_Put := GetHgCmd_StationPut(E_Station.eStation_ST040_Storage, 1);
	ELSIF Plant.stSt050IMould.bReqS2Empty AND
	   NOT Plant.stSt040IStorage.Pallet2.CarrierPresent THEN
		GetHgCmd_Default_Put := GetHgCmd_StationPut(E_Station.eStation_ST040_Storage, 2);
	ELSE
		// empty back to oven 1/2
		GetHgCmd_Default_Put := GetHgCmd_StationPut(Plant.stSt030IHandling.Source);
	END_IF
	RETURN;
END_IF 

// finished & pallet full @ hg --> to oven 2
IF Plant.stSt030IHandling.Pallet.HasAllWorkpiecesFinished THEN
	// sb.Set('wait for oven 2 rdy for finished pallet)
	// full back to oven 1/2
	GetHgCmd_Default_Put := GetHgCmd_StationPut(Plant.stSt030IHandling.Source);
END_IF

//sb.Set('state not implemented: no empty/finished or unfinished');]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetHgCmd_OvenGetEmptyPallet" Id="{71f8a272-6a15-41d2-90ac-d896802e7914}" FolderPath="StateEngine\CmdPool\">
      <Declaration><![CDATA[METHOD PRIVATE GetHgCmd_OvenGetEmptyPallet : ST_St030_Command
VAR
	result : ST_St030_Command;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[result.Command := E_St030_Command.eSt030_Command_none;
IF Plant.stSt010IOvenA.Trolley.HasCarrierWithEmptyWorkpieceplace THEN
	result.Command := E_St030_Command.eSt030_Command_OvenA_Get; // get empty pallet from oven A
	result.Position := Plant.stSt010IOvenA.Trolley.SlotOfCarrierWithEmptyWorkpieceplace; 
ELSIF Plant.stSt020IOvenB.Trolley.HasCarrierWithEmptyWorkpieceplace THEN
	result.Command := E_St030_Command.eSt030_Command_OvenB_Get; // get empty pallet from oven B
	result.Position := Plant.stSt020IOvenB.Trolley.SlotOfCarrierWithEmptyWorkpieceplace;
END_IF

GetHgCmd_OvenGetEmptyPallet := result;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetHgCmd_OvenGetUnfinishedPallet" Id="{db618b3e-2f2f-42cb-8953-308d4b5ab3ac}" FolderPath="StateEngine\CmdPool\">
      <Declaration><![CDATA[METHOD PRIVATE GetHgCmd_OvenGetUnfinishedPallet : ST_St030_Command
VAR
	result : ST_St030_Command;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[result.Command := E_St030_Command.eSt030_Command_none;
IF Plant.stSt010IOvenA.Trolley.HasCarrierWithUnfinishedWorkpiece THEN
	result.Command := E_St030_Command.eSt030_Command_OvenA_Get; // get unfinished pallet from oven A
	result.Position := Plant.stSt010IOvenA.Trolley.SlotOfCarrierWithUnfinishedWorkpiece;	
ELSIF Plant.stSt020IOvenB.Trolley.HasCarrierWithUnfinishedWorkpiece THEN
	result.Command := E_St030_Command.eSt030_Command_OvenB_Get; // get unfinished pallet from oven B
	result.Position := Plant.stSt020IOvenB.Trolley.SlotOfCarrierWithUnfinishedWorkpiece;
END_IF

GetHgCmd_OvenGetUnfinishedPallet := result;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetHgCmd_StationPut" Id="{66d63ac4-780e-4599-b2e7-8c965cac03a9}" FolderPath="StateEngine\CmdPool\">
      <Declaration><![CDATA[METHOD PRIVATE GetHgCmd_StationPut : ST_St030_Command
VAR_INPUT
	eStation 	: E_Station;
	iIxd 		: INT := 0;
END_VAR
VAR
	result 		: ST_St030_Command;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eStation OF
	E_Station.eStation_ST010_OvenA:
		IF Plant.stSt010IOvenA.Trolley.HasEmptySlot THEN
			result.Command := E_St030_Command.eSt030_Command_OvenA_Put;
			result.Position := Plant.stSt010IOvenA.Trolley.EmptySlot;
		ELSE
			ModuleWarning.ArgSbAppend('Station has no empty slot')
				 .ArgSbAppendS(TO_STRING(eStation))
				 .ArgSetSbRaise();		
		END_IF
		
	E_Station.eStation_ST020_OvenB:
		IF Plant.stSt020IOvenB.Trolley.HasEmptySlot THEN
			result.Command := E_St030_Command.eSt030_Command_OvenB_Put;
			result.Position := Plant.stSt020IOvenB.Trolley.EmptySlot;
		ELSE
			ModuleWarning.ArgSbAppend('Station has no empty slot')
				 .ArgSbAppendS(TO_STRING(eStation))
				 .ArgSetSbRaise();	
		END_IF
		
	E_Station.eStation_ST040_Storage:
		result.Command := E_St030_Command.eSt030_Command_Storage_Put;
		result.Position := iIxd;
		
ELSE
	ModuleWarning.ArgSbAppend('Put to station not implemented! Station: ')
				 .ArgSbAppendS(TO_STRING(eStation))
				 .ArgSetSbRaise();
END_CASE

GetHgCmd_StationPut := result;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetHgCmd_StorageGet" Id="{026b8a42-c45b-46a2-9e45-0b6a6251aaee}" FolderPath="StateEngine\CmdPool\">
      <Declaration><![CDATA[METHOD PRIVATE GetHgCmd_StorageGet : ST_St030_Command
VAR_INPUT
