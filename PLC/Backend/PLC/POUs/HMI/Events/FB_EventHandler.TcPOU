<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_EventHandler" Id="{15ddc12e-d496-402a-851f-a36d0274e1a7}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_EventHandler IMPLEMENTS I_EventHandler
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	// private instance var's
	iLog			: I_Logger;
	afbAlarm      	: ARRAY[0..Const.iMaxIdxAlam] OF FB_TcAlarm;
	fbCodeErrRef,
	fbAlarmRef      : REFERENCE TO FB_TcAlarm;
	fbMsg			: FB_TcMessage;
	fbEventLogger	: FB_TcEventLogger;
	ISb 			: I_StringBuilder;
	fbInternalSb	: FB_StringBuilder;
	iCntAlm			: INT;
	bInfoActive,
	bWarningActive,
	bErrorActive	: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//ToDo: SetJsonAttribute (e.g.: error reaction)
//ToDo: F_GetEventText o.ä.
//ToDo: Listener?

// unit tests
Test();]]></ST>
    </Implementation>
