{attribute 'to_string'}
{attribute 'to_wstring'}
TYPE E_St010_Settings :
(
	//eSt010_Settings_none := 0,
	
	eSt010_Settings_Station_Deaktiv,	// Station deaktivieren
	eSt010_Settings_Autohome,			// automatic home with start button
	
	eSt010_Settings_HomeSpeed,			// Homing-Geschwindigkeit [mm/s]
	eSt010_Settings_JogSpeed,			// Tippgeschwindigkeit [mm/s]
	eSt010_Settings_WorkSpeed,			// Automatik-Geschwindigkeit [mm/s]
	eSt010_Settings_JogSpeedCh,			// Tippgeschwindigkeit CH-Achsen [mm/s]
	eSt010_Settings_WorkSpeedCh,		// Automatik-Geschwindigkeit CH-Achsen [mm/s]

	eSt010_Settings_AxisRefPos,			// Referenzposition Achse [mm]
	eSt010_Settings_PosHome,			// Homeposition [mm]
	eSt010_Settings_PosWork,			// Mitnehmerposition unteres Segment [mm]
	
	eSt010_Settings_PosHomeCh,			// Homeposition CH-Achsen [mm]
	eSt010_Settings_PosWorkCh,			// Arbeitsposition CH-Achsen [mm]
	
	eSt010_Settings_OvenFixPartHeight,	// Festteilhöhe [mm]
	eSt010_Settings_OvenSegmentHeight,	// Festteilhöhe [mm] //366
	
	eSt010_Settings_OvenMiddlePointX,	// Mittelpunnkt in X-Richtung [mm]
	eSt010_Settings_OvenOffsetY,		// Y-Offset Ofen [mm]
	eSt010_Settings_OvenPickUpDepthZ,	// Teach-Position, Storage 2 Z [mm]
	
	eSt010_Settings_XPosRp1,			// Teach-Position, Ofen A, RP 1 X [mm]
	eSt010_Settings_YPosRp1,			// Teach-Position, Ofen A, RP 1 Y [mm]
	eSt010_Settings_ZPosRp1,			// Teach-Position, Ofen A, RP 1 Z [mm]
	                                                            
	eSt010_Settings_XPosRp2,			// Teach-Position, Ofen A, RP 2 X [mm]
	eSt010_Settings_YPosRp2,			// Teach-Position, Ofen A, RP 2 Y [mm]
	eSt010_Settings_ZPosRp2,			// Teach-Position, Ofen A, RP 2 Z [mm]
	
	/// has to be set to last index for array bounds!
	eSt010_Settings_nMaxIdx
);
END_TYPE
