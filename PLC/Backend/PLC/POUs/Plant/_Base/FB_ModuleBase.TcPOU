      <Set Name="Set" Id="{482a9d37-0acd-4ae9-9039-88ea28109039}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[bEmergencyStopOk := EmergencyStopOk;]]></ST>
