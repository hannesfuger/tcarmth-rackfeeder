    <Method Name="Init" Id="{fb7a6f7b-d623-47ab-8142-e647ea1a6022}">
      <Declaration><![CDATA[METHOD Init : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[iLog := SERVICES.ILog;

// init alarm event classes
CreateAlarm(TC_Events.InternalEventClass.InfoEvent);
CreateAlarm(TC_Events.InternalEventClass.WarningEvent, TRUE);
CreateAlarm(TC_Events.InternalEventClass.ErrorEvent, TRUE);
CreateAlarm(TC_Events.CodeEventClass.InfoEvent);
CreateAlarm(TC_Events.CodeEventClass.WarningEvent, TRUE);
CreateAlarm(TC_Events.CodeEventClass.ErrorEvent, TRUE);
CreateAlarm(TC_Events.SystemEventClass.InfoEvent);
CreateAlarm(TC_Events.SystemEventClass.WarningEvent, TRUE);
CreateAlarm(TC_Events.SystemEventClass.ErrorEvent, TRUE);
CreateAlarm(TC_Events.EtherCatEventClass.InfoEvent);
CreateAlarm(TC_Events.EtherCatEventClass.WarningEvent, TRUE);
CreateAlarm(TC_Events.EtherCatEventClass.ErrorEvent, TRUE);
CreateAlarm(TC_Events.EtherCatEventClass.DevicStateErrorEvent, TRUE);
CreateAlarm(TC_Events.EtherCatEventClass.LinkStateErrorEvent, TRUE);
CreateAlarm(TC_Events.HardwareEventClass.InfoEvent);
CreateAlarm(TC_Events.HardwareEventClass.WarningEvent, TRUE);
CreateAlarm(TC_Events.HardwareEventClass.ErrorEvent, TRUE);
CreateAlarm(TC_Events.TwinSafeEventClass.InfoEvent);
CreateAlarm(TC_Events.TwinSafeEventClass.WarningEvent, TRUE);
CreateAlarm(TC_Events.TwinSafeEventClass.ErrorEvent, TRUE);
CreateAlarm(TC_Events.TwinSafeEventClass.HwErrorEvent, TRUE);
CreateAlarm(TC_Events.SettingsEventClass.InfoEvent);
CreateAlarm(TC_Events.SettingsEventClass.WarningEvent, TRUE);
CreateAlarm(TC_Events.SettingsEventClass.ErrorEvent, TRUE);
CreateAlarm(TC_Events.RecipeEventClass.InfoEvent);
CreateAlarm(TC_Events.RecipeEventClass.WarningEvent, TRUE);
CreateAlarm(TC_Events.RecipeEventClass.ErrorEvent, TRUE);
CreateAlarm(TC_Events.PlantEventClass.InfoEvent);
CreateAlarm(TC_Events.PlantEventClass.WarningEvent, TRUE);
CreateAlarm(TC_Events.PlantEventClass.ErrorEvent, TRUE);

// register simple message not needed:
//CreateMessage(TC_Events.MessageEventClass.InfoEvent);

fbCodeErrRef REF= afbAlarm[0];
fbAlarmRef REF= afbAlarm[0];]]></ST>
      </Implementation>
    </Method>
    <Method Name="Raise" Id="{e70de61e-a502-44e9-a48e-2cdfab490faf}">
      <Declaration><![CDATA[METHOD PUBLIC Raise : HRESULT
VAR_INPUT
	nTimeStamp : ULINT := 0;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(fbAlarmref) THEN 
	Raise := S_FALSE;
	RETURN;	
END_IF

bInfoActive := fbAlarmRef.eSeverity >= TcEventSeverity.Info;
bWarningActive := fbAlarmRef.eSeverity >= TcEventSeverity.Warning;
bErrorActive := fbAlarmRef.eSeverity >= TcEventSeverity.Error;
Raise := fbAlarmref.Raise(nTimeStamp);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{d27a7122-a7a6-4cac-bd3d-60c72f3b7d27}">
      <Declaration><![CDATA[METHOD PUBLIC Reset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbEventLogger.ConfirmAllAlarms();
fbEventLogger.ClearAllAlarms();
fbEventLogger.ClearLoggedEvents(0);

bInfoActive :=
bWarningActive :=
bErrorActive := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Select" Id="{acc4527b-aa49-4a3f-8e5a-cc2218a63cc8}" FolderPath="Fluent\">
      <Declaration><![CDATA[METHOD PUBLIC Select : I_EventHandler
VAR_INPUT
	stEventEntry : TcEventEntry;
END_VAR
VAR
	hres : HRESULT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Select := THIS^;
fbAlarmRef REF= afbAlarm[0];
hres := fbEventLogger.GetAlarmEx(stEventEntry, 0, fbAlarmRef);
IF hres <> S_OK OR NOT __ISVALIDREF(fbAlarmRef) THEN
	fbAlarmRef REF= afbAlarm[0];
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Send" Id="{fce0bd20-fde8-463f-b238-4262ebb02044}" FolderPath="SimpleMsg\">
      <Declaration><![CDATA[METHOD PUBLIC Send : BOOL
VAR_INPUT
	stEventEntry      : TcEventEntry;
    ipSourceInfo      : I_TcSourceInfo := NULL;
    nTimeStamp        : ULINT := 0;
    ipArguments       : I_TcArguments := NULL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Send := fbEventLogger.SendMessageEx(stEventEntry, ipSourceInfo, nTimeStamp, ipArguments) = S_OK;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendJson" Id="{4f727c5f-68e6-4b53-93ea-43be75604602}" FolderPath="SimpleMsg\">
      <Declaration><![CDATA[METHOD PUBLIC SendJson : BOOL
VAR_INPUT
	stEventEntry      : TcEventEntry;
    ipSourceInfo      : I_TcSourceInfo := NULL;
    nTimeStamp        : ULINT := 0;
    ipArguments       : I_TcArguments := NULL;
END_VAR
VAR_IN_OUT CONSTANT
    sJsonAttribute    : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SendJson := fbEventLogger.SendMessageEx2(stEventEntry, ipSourceInfo, nTimeStamp, ipArguments, sJsonAttribute) = S_OK;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendString" Id="{7740b874-26f7-4c93-aad8-6040f7f3132e}" FolderPath="SimpleMsg\">
      <Declaration><![CDATA[METHOD PUBLIC SendString : BOOL
VAR_IN_OUT CONSTANT
	msg : STRING;	
END_VAR
VAR_INST
	args : FB_TcArguments;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SendString := Send(TC_EVENTS.MessageEventClass.InfoEvent, NULL, 0, 
													args.Clear().AddString(msg));]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendStringJson" Id="{e92fa693-1d37-401f-85b1-1d4c3a1d5fc4}" FolderPath="SimpleMsg\">
      <Declaration><![CDATA[METHOD PUBLIC SendStringJson : BOOL
VAR_IN_OUT CONSTANT
	msg				: STRING;
	sJsonAttribute	: STRING;
END_VAR
VAR_INST
	args 			: FB_TcArguments;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SendStringJson := SendJson(TC_EVENTS.MessageEventClass.InfoEvent, NULL, 0, 
													args.Clear().AddString(msg), 
													sJsonAttribute);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test" Id="{6dd5f8ba-68eb-4a0b-b379-52cf1523025c}">
      <Declaration><![CDATA[METHOD PRIVATE Test : BOOL
VAR_INST
	// event alarm test
	iTestCase		: INT;
	bAlarmTest, 
	bMsgTest,
	bClearAlarmTest : BOOL;
	HRES			: HRESULT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// alarm tests
IF bAlarmTest THEN
	bAlarmTest := FALSE;
	IF iTestCase = 0 THEN
		HRES := fbEventLogger.GetAlarmEx(TC_Events.CodeEventClass.ErrorEvent, 0, fbAlarmRef);
		IF (HRES <> 0 OR  NOT __ISVALIDREF(fbAlarmRef)) THEN RETURN; END_IF
		iTestCase := 10;
		fbAlarmRef.ipArguments.Clear().AddString('check bounds');
		fbAlarmRef.Raise(0);
		
	ELSIF iTestCase = 1 THEN
		Select(TC_Events.CodeEventClass.ErrorEvent)
			  .ArgSetString('check bounds')
			  .Raise();
		RETURN;
	ELSIF iTestCase = 2 THEN
		Select(TC_Events.HardwareEventClass.ErrorEvent)
			  .ArgSetString('div 0')
			  .Raise();
	ELSIF iTestCase = 3 THEN		
		Select(TC_Events.HardwareEventClass.WarningEvent)
			  .ArgSetString('check pointer')
			  .Raise();
	ELSIF iTestCase = 4 THEN
		// adding localizable argument sample 
		Select(TC_Events.SettingsEventClass.InfoEvent)
			  .ArgSetEventRef(TC_Events.TranslationListEventClass.TranslationListEventClass_NameEvent)
			  .ArgAddString('sdc')
			  .Raise();
	END_IF
	
	//fbAlarm.eConfirmationState = TcEventConfirmationState.WaitForConfirmation
	//fbAlarm.bActive
END_IF

// simple message tests
IF bMsgTest THEN
	bMsgTest := FALSE;
	IF iTestCase = 0 THEN
		SendString('Rezept wurde geladen!');
	ELSIF iTestCase = 2 THEN
		SendString('Rezept wurde gespeichert!');
	ELSIF iTestCase = 3 THEN
		SendString('Rezept wurde kopiert!');
	ELSE
		Send(TC_Events.MessageEventClass.InfoEvent, Null, 0, fbMsg.ipArguments);
	END_IF
	
	//fbMsg.Send();
END_IF

// reset/clear alarms
IF bClearAlarmTest THEN
	bClearAlarmTest := FALSE;
	Reset();
END_IF]]></ST>
      </Implementation>
    </Method>
