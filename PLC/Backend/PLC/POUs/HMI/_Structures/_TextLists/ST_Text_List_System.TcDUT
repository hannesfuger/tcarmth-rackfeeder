												wsNameId:= "EC_EthernetDrvNotFound",
												wsName:= "Ethernet driver (miniport) not found");												
	stText_EC_IO_resetActive				: ST_Text := (
												wsNameId:= "EC_IO_resetActive",
												wsName:= "I/O reset active");
	stText_EC_AtLeastOneDeviceInit			: ST_Text := (
												wsNameId:= "EC_AtLeastOneDeviceInit",
												wsName:= "At least one device in INIT state");
	stText_EC_AtLeastOneDevicePreOp			: ST_Text := (
												wsNameId:= "EC_AtLeastOneDevicePreOp",
												wsName:= "At least one device in PRE-OP state");
	stText_EC_AtLeastOneDeviceSafeOp		: ST_Text := (
												wsNameId:= "EC_AtLeastOneDeviceSafeOp",
