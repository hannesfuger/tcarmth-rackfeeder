    <Method Name="M_RestActHgCmd" Id="{c78527fb-f2ea-4f51-97a1-1bcce03d06d6}" FolderPath="Hsk\">
      <Declaration><![CDATA[METHOD PRIVATE M_RestActHgCmd : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// reset active HG command
stSt030IHandling.ActiveCommand.Command := E_St030_Command.eSt030_Command_none;
	stSt030IHandling.ActiveCommand.Position := 0;
	
stSt030IHandling.bReqestOvenA := 
stSt030IHandling.bReqestOvenA_ChkIndex := 
stSt030IHandling.bReqestOvenB := 
stSt030IHandling.bReqestOvenB_ChkIndex := 
stSt030IHandling.bReqestStorage :=
stSt030IHandling.bReqestStorage_ChkIndex := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Run" Id="{96f3750b-fb89-4ba8-a7e9-040420680515}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC M_Run : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// check refs valid
IF NOT __ISVALIDREF(stIO) THEN
	RETURN;
END_IF

M_RUN := SUPER^.M_Run();

M_DynSettings();
M_DynManual();
M_DynMonitoring();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Sequence" Id="{f8006e9a-d7cd-4012-bc45-5952bd479291}">
      <Declaration><![CDATA[METHOD PROTECTED M_Sequence
VAR
	wsCurJob : WSTRING; 
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// signal mapping (e.g.: enable)
stSt030IHandling.bEnable := (sqAuto.Step >= 100 AND sqAuto.Step <= 500) OR
									 bStationDeaktiv;
stSt030IHandling.bEnableOvenAxis := fbAxisZ.PositionReachedWindow(PosHomeZ, 30);
									 
wsCurJob := TO_WSTRING(stSt030IHandling.ActiveCommand.Command);

// automatic sequence
CASE sqAuto.Step OF
		
	0:	sqAuto.Info.Set("Warte auf Auto Start");
		IF RunCycle AND RunStep THEN
			//sqAuto.Info.Set("Warte auf GRST");
			//IF sqHome.InHome AND bInHome THEN
				sqHome.InHome := FALSE;
				sqAuto.Step := 5;
			//ELSE
			//	StationError.ArgSbAppendWsRaise(stTextlistGlobal.stText_station_not_in_hp);
			//END_IF
		END_IF
		
	5:	IF bStationDeaktiv THEN
			sqAuto.Info.Set("Station deaktiv");
		ELSE
			sqAuto.Step := 10;
		END_IF
		
	10:	sqAuto.Info.Set("Prüfe Startbedingungen");
		IF NOT (fbAxisX.Operational AND fbAxisX.Homed) THEN
			StationError.ArgSbAppendRaise('Bereitsignal Achse X fehlt');
		ELSIF NOT (fbAxisY.Operational AND fbAxisY.Homed) THEN
			StationError.ArgSbAppendRaise('Bereitsignal Achse Y fehlt');
		ELSIF NOT (fbAxisZ.Operational AND fbAxisZ.Homed) THEN
			StationError.ArgSbAppendRaise('Bereitsignal Achse Z fehlt');
		ELSE
			CycleStart();
			sqAuto.SetStep(15);
		END_IF
		
	15: sqAuto.Info.Set("Prüfe Job-Anforderung");
		IF stSt030IHandling.CommandRequest.Command = E_St030_Command.eSt030_Command_none THEN
			sqAuto.SetStep(20);	// home
		ELSE
			sqAuto.SetStep(100);
		END_IF
		
	// hg to travel/home position
	20: sqAuto.Info.Set("Grundstellungsfahrt aktiv Achse Z Homepos.");
		fbAxisZ.MoveAbsExVel(PosHomeZ, WorkSpeedZ);
		sqAuto.Step := 25;
	
	25: sqAuto.Info.Set("Warte auf Achse Z in Homeposition");
		IF fbAxisZ.TargetReached() THEN
			sqAuto.SetStep(30);	
		END_IF
		
	30: sqAuto.Info.Set("Grundstellungsfahrt aktiv Achse Y Homepos.");
		fbAxisY.MoveAbsExVel(PosHomeY, WorkSpeedY);
		sqAuto.Step := 35;

	35: sqAuto.Info.Set("Warte auf Achse Y in Homeposition");
		IF fbAxisY.TargetReached() THEN
			sqAuto.Step := 100;
		END_IF
		
	// work
	100: sqAuto.Info.Set("Automatik, warte auf Job");
		M_RestActHgCmd();
		IF NOT RunCycle THEN sqAuto.Step := 900; RETURN; END_IF
		IF NOT M_CheckHskRst() THEN RETURN; END_IF
		
		IF IsGetCmdRequested AND stSt030IHandling.Pallet.CarrierPresent THEN
			StationWarning.ArgSbAppendRaise('Palette bereits auf HG bei Abhol-Auftrag');
			RETURN;
		END_IF
		
		stSt030IHandling.ActiveCommand := stSt030IHandling.CommandRequest;
		IF stSt030IHandling.ActiveCommand.Command <> E_St030_Command.eSt030_Command_none THEN
			sqAuto.Step := 110;
		END_IF
		
	// hg switch job
	110: sqAuto.Info.Set("Automatik, Job: ")
					.Append(TO_WSTRING(stSt030IHandling.ActiveCommand.Command));
		CASE stSt030IHandling.ActiveCommand.Command OF
			E_St030_Command.eSt030_Command_OvenA_Get,
			E_St030_Command.eSt030_Command_OvenA_Put,			
			E_St030_Command.eSt030_Command_OvenB_Get,
			E_St030_Command.eSt030_Command_OvenB_Put: sqAuto.SetStep(300);
			
			E_St030_Command.eSt030_Command_Storage_Get,
			E_St030_Command.eSt030_Command_Storage_Put: sqAuto.SetStep(500);
		END_CASE
		
	// get/put oven A/B
	300: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("Achse X positionieren");
		fbAxisX.MoveAbsExVel(PosWorkOvenX, WorkSpeedX);
		sqAuto.Step := 305;
		
	305: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Achse X in Pos.");
		IF fbAxisX.TargetReached() THEN
			sqAuto.SetStep(310);
		END_IF
					
	310: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("Achse Y positionieren");
					
		fbAxisY.MoveAbsExVel(SEL(IsGetCmdActive, PosWorkOvenY_OffsUp, PosWorkOvenY_OffsDn),
							 WorkSpeedY);
		sqAuto.Step := 315;
		
	315: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Achse Y in Pos.");
		IF fbAxisY.TargetReached() THEN
			sqAuto.SetStep(320);
		END_IF
		
	320: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("Achse Z positionieren");
		fbAxisZ.MoveAbsExVel(PosHomeZ, WorkSpeedZ);
		sqAuto.Step := 325;
		
	325: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Achse Z in Pos.");
		IF fbAxisZ.TargetReached() THEN
			sqAuto.Step := 330;
		END_IF
					
	330: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("prüfe Status: ");
		IF IsOvenCmdA THEN
			sqAuto.Info.Append("Index, ");
			stSt030IHandling.bReqestOvenA_ChkIndex := TRUE;
			IF NOT stSt010IOvenA.bResponseChkIndex THEN RETURN; END_IF
			sqAuto.Info.Append("Position, ");
			IF stSt010IOvenA.iConfirmPosition <> stSt030IHandling.ActiveCommand.Position THEN RETURN; END_IF
			sqAuto.Info.Append("Pallet");
			IF stSt030IHandling.ActiveCommand.Command = E_St030_Command.eSt030_Command_OvenA_Put AND NOT stSt010IOvenA.bResponseIsEmptySlot THEN 
				StationError.ArgSbAppendRaise('Ablage auf belegte Position!');
				RETURN;
			END_IF
		ELSE
			sqAuto.Info.Append("Index, ");
			stSt030IHandling.bReqestOvenB_ChkIndex := TRUE;
			IF NOT stSt020IOvenB.bResponseChkIndex THEN RETURN; END_IF
			sqAuto.Info.Append("Position, ");
			IF stSt020IOvenB.iConfirmPosition <> stSt030IHandling.ActiveCommand.Position THEN RETURN; END_IF
			sqAuto.Info.Append("Pallet");
			IF stSt030IHandling.ActiveCommand.Command = E_St030_Command.eSt030_Command_OvenB_Put AND NOT stSt020IOvenB.bResponseIsEmptySlot THEN
	 			StationError.ArgSbAppendRaise('Ablage auf belegte Position!');
				RETURN;
			END_IF
		END_IF
		sqAuto.Step := 340;
		
	340: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Segment offen.");
		IF IsOvenCmdA THEN
			stSt030IHandling.bReqestOvenA := TRUE;
			IF NOT stSt010IOvenA.bResponseOpn THEN RETURN; END_IF
		ELSE
			stSt030IHandling.bReqestOvenB := TRUE;
			IF NOT stSt020IOvenB.bResponseOpn THEN RETURN; END_IF
		END_IF
		sqAuto.SetStep(350);
		
//ToDo: chk hier ev. X-Suchfahrt?
	345: sqAuto.Info.Set(sqSearch.Info.ToWString());
		IF sqAuto.Init THEN sqSearch.Step := 10; END_IF
		IF sqSearch.Step = 0 THEN
			sqAuto.SetStep(350);
		END_IF
		
	350: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("Achse Z positionieren");
		fbAxisZ.MoveAbsExVel(PosWorkOvenZ, WorkSpeedZ);
		sqAuto.Step := 355;
		
	355: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Achse Z in Pos.");
		IF fbAxisZ.TargetReached() THEN
			sqAuto.SetStep(360);
		END_IF
		
	360: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("Achse Y positionieren");
					
		fbAxisY.MoveAbsExVel(SEL(IsGetCmdActive, PosWorkOvenY_OffsDn, PosWorkOvenY_OffsUp),
							 WorkSpeedY);
		sqAuto.Step := 365;
		
	365: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Achse Y in Pos.");
		IF fbAxisY.TargetReached() THEN
			sqAuto.SetStep(SEL(IsGetCmdActive, 367, 366));
		END_IF
		
	366: sqAuto.Info.Set("Übernehme Teiledaten Ofen -> HG");
		IF IsOvenCmdA THEN
			stSt030IHandling.Pallet.SetCarrier(
				stSt010IOvenA.Trolley.GetCarrierAt(stSt010IOvenA.iConfirmPosition));
				stSt030IHandling.Source := E_Station.eStation_ST010_OvenA;
				
			//TODO: Daten am Handling löschen
			stSt010IOvenA.Trolley.RemoveCarrierAt(stSt010IOvenA.iConfirmPosition);
				
		ELSE
			stSt030IHandling.Pallet.SetCarrier(
				stSt020IOvenB.Trolley.GetCarrierAt(stSt020IOvenB.iConfirmPosition));
				stSt030IHandling.Source := E_Station.eStation_ST020_OvenB;
					
			//TODO: Daten am Handling löschen		
			stSt020IOvenB.Trolley.RemoveCarrierAt(stSt010IOvenA.iConfirmPosition);
		END_IF	
		sqAuto.Step := 368;
		
	367: sqAuto.Info.Set("Übernehme Teiledaten HG -> Ofen");
		IF IsOvenCmdA THEN
			stSt010IOvenA.Trolley.SetCarrierAt(stSt010IOvenA.iConfirmPosition,
											  stSt030IHandling.Pallet.Data);
		ELSE
			stSt020IOvenB.Trolley.SetCarrierAt(stSt020IOvenB.iConfirmPosition,
											  stSt030IHandling.Pallet.Data);
		END_IF
		//TODO: Daten am Handling löschen
		stSt030IHandling.Pallet.RemoveCarrier();
		stSt030IHandling.Source := E_Station.eStation_none;
		sqAuto.Step := 368;
		
	368: sqAuto.Info.Set("Übernehme Teiledaten HG -> Ofen");
		sqAuto.SetStep(370);
		
	370: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Achse Z in Pos.");
		fbAxisZ.MoveAbsExVel(PosHomeZ, WorkSpeedZ);
		sqAuto.Step := 375;
	
	375: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Achse Z in Pos.");
		IF fbAxisZ.TargetReached() THEN
			sqAuto.SetStep(380);
		ELSIF fbAxisZ.TargetWindowReached(2) THEN
			stSt030IHandling.bReqestOvenA := 
			stSt030IHandling.bReqestOvenB := FALSE; // cls segment as soon as possible
		END_IF
		
	380: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Segment geschlossen.");
		IF IsOvenCmdA THEN
			stSt030IHandling.bReqestOvenA := FALSE;
			IF stSt010IOvenA.bResponseOpn THEN RETURN; END_IF
		ELSE
			stSt030IHandling.bReqestOvenB := FALSE;
			IF stSt020IOvenB.bResponseOpn THEN RETURN; END_IF
		END_IF
		sqAuto.Step := 800; // step done
			  
		
	// get/put storage
	500: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("Achse X positionieren");
		fbAxisX.MoveAbsExVel(PosWorkStorageX, WorkSpeedX);
		sqAuto.Step := 505;
		
	505: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Achse X in Pos.");
		IF fbAxisX.TargetReached() THEN
			sqAuto.SetStep(510);
		END_IF
					
	510: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("Achse Y positionieren");
					
		fbAxisY.MoveAbsExVel(SEL(IsGetCmdActive, PosWorkStorageY_OffsUp, PosWorkStorageY_OffsDn),
							 WorkSpeedY);
		sqAuto.Step := 515;
		
	515: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Achse Y in Pos.");
		IF fbAxisY.TargetReached() THEN
			sqAuto.SetStep(520);
		END_IF
		
	520: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("Achse Z positionieren");
		fbAxisZ.MoveAbsExVel(PosHomeZ, WorkSpeedZ);
		sqAuto.Step := 525;
		
	525: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Achse Z in Pos.");
		IF fbAxisZ.TargetReached() THEN
			sqAuto.Step := 530;
		END_IF
		
	530: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("prüfe Status: Index, ");
		stSt030IHandling.bReqestStorage_ChkIndex := TRUE;
		IF NOT stSt040IStorage.bResponseChkIndex THEN RETURN; END_IF
		sqAuto.Info.Append("Position, ");
		IF stSt040IStorage.iConfirmPosition <> stSt030IHandling.ActiveCommand.Position THEN RETURN; END_IF
		sqAuto.Info.Append("Pallet");
		IF stSt040IStorage.bResponseEmptyAtIndex OR stSt030IHandling.ActiveCommand.Command = E_St030_Command.eSt030_Command_Storage_Get THEN 
			sqAuto.Step := 540;
		END_IF		
		
	540: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Storage offen.");
		stSt030IHandling.bReqestStorage := TRUE;
		IF NOT stSt040IStorage.bResponseOpn THEN RETURN; END_IF
		sqAuto.SetStep(550);
		
	550: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("Achse Z positionieren");
		fbAxisZ.MoveAbsExVel(PosWorkStorageZ, WorkSpeedZ);
		sqAuto.Step := 555;
		
	555: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Achse Z in Pos.");
		IF fbAxisZ.TargetReached() THEN
			sqAuto.SetStep(560);
		END_IF
		
	560: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("Achse Y positionieren");
					
		fbAxisY.MoveAbsExVel(SEL(IsGetCmdActive, PosWorkStorageY_OffsDn, PosWorkStorageY_OffsUp),
							 WorkSpeedY);
		sqAuto.Step := 565;
		
	565: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Achse Y in Pos.");
		IF fbAxisY.TargetReached() THEN
			sqAuto.SetStep(SEL(IsGetCmdActive, 567, 566));
		END_IF
		
	566: sqAuto.Info.Set("Übernehme Teiledaten Storage -> HG");
		IF stSt030IHandling.ActiveCommand.Position = 1 THEN
			stSt030IHandling.Pallet.SetCarrier(
				stSt040IStorage.Pallet1.Data);
			stSt030IHandling.Source := stSt040IStorage.Source1;
			//TODO Storagedaten löschen	
			stSt040IStorage.Pallet1.RemoveCarrier();
			stSt040IStorage.Source1 := E_Station.eStation_none;
		
		ELSIF stSt030IHandling.ActiveCommand.Position = 2 THEN
			stSt030IHandling.Pallet.SetCarrier(
				stSt040IStorage.Pallet2.Data);
			stSt030IHandling.Source := stSt040IStorage.Source2;
			//TODO Storagedaten löschen	
			stSt040IStorage.Pallet2.RemoveCarrier();
			stSt040IStorage.Source2 := E_Station.eStation_none;
		END_IF
		
		sqAuto.Step := 568;
		
	567: sqAuto.Info.Set("Übernehme Teiledaten HG -> Storage");
		IF  stSt030IHandling.ActiveCommand.Position = 1 THEN
			stSt040IStorage.Pallet1.SetCarrier(
				stSt030IHandling.Pallet.Data);
			stSt040IStorage.Source1 := stSt030IHandling.Source;
		ELSIF stSt030IHandling.ActiveCommand.Position = 2 THEN
			stSt040IStorage.Pallet2.SetCarrier(
				stSt030IHandling.Pallet.Data);
			stSt040IStorage.Source2 := stSt030IHandling.Source; 
		END_IF
		sqAuto.Step := 568;
		
	568: sqAuto.Info.Set("Übernehme Teiledaten");
		sqAuto.SetStep(570);
		
	570: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Achse Z in Pos.");
		fbAxisZ.MoveAbsExVel(PosHomeZ, WorkSpeedZ);
		sqAuto.Step := 575;
	
	575: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Achse Z in Pos.");
		IF fbAxisZ.TargetReached() THEN
			sqAuto.SetStep(580);
		ELSIF fbAxisZ.TargetWindowReached(2) THEN
			stSt030IHandling.bReqestStorage := FALSE; // cls stoarge as soon as possible
		END_IF
		
	580: sqAuto.Info.Set("Job: ")
					.Append(wsCurJob).Append(", ")
					.Append("warte auf Storage geschlossen.");
		stSt030IHandling.bReqestStorage := FALSE;
		IF stSt040IStorage.bResponseOpn THEN RETURN; END_IF
		sqAuto.Step := 800; // step done
		
	// job done
	800: sqAuto.Info.Set("Job fertig, warte Handshake reset");
		IF stSt030IHandling.CommandRequest.Command = E_St030_Command.eSt030_Command_none OR
		   stSt030IHandling.CommandRequest.Command <> stSt030IHandling.ActiveCommand.Command THEN
			sqAuto.SetStep(900);
		END_IF
		
	// rdy	
	900: sqAuto.Info.Set("Zyklus beendet");
		CycleEnd();
		sqAuto.Step := 0;

	// error
	1000: sqAuto.Info.Set("Error");
		bStopped := TRUE;
		sqHome.InHome := FALSE;
		bRunHoming := FALSE;

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SequenceSearch" Id="{dfc00729-5576-4802-a796-4e38cdac1427}">
      <Declaration><![CDATA[METHOD INTERNAL M_SequenceSearch : ST_Text
VAR_INST
	rfTrigS1,
	rfTrigS2 	: FB_RtrigFtrig;
	fPos 		: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF sqSearch.Step < 10 THEN RETURN; END_IF
rfTrigS1(bIn := MeasurementA >= fThreshMesMin AND MeasurementA <= fThreshMesMax);
rfTrigS2(bIn := MeasurementB >= fThreshMesMin AND MeasurementB <= fThreshMesMax);
sqSearch.EnableStep := RunStep;

// search sequence
CASE sqSearch.Step OF
		
	0:	sqSearch.Info.Set("Warte auf Start Suche");
		
	10:	sqSearch.Info.Set("Start Suche, Backup HG-Position");
		fPosSearchCorr := 0;
		eEmptyChk := E_St030_EmptySlotChk.eSt030_EmptySlotChk_none;
		HgPosBackup.x := fbAxisX.Position;
		HgPosBackup.y := fbAxisY.Position;
		HgPosBackup.z := fbAxisZ.Position;
		sqSearch.SetStep(20);
		
	// hg to start search position
	20: sqSearch.Info.Set("Suche aktiv Achse Z");
		fbAxisZ.MoveAbsExVel(PosHomeZ, WorkSpeedZ);
		sqSearch.Step := 25;
	
	25: sqSearch.Info.Set("Warte auf Achse Z in Such-Pos. 1");
		IF fbAxisZ.TargetReached() THEN
			sqSearch.SetStep(30);	
		END_IF
		
	30: sqSearch.Info.Set("Suche aktiv Achse X");
		fbAxisX.MoveAbsExVel(PosWorkOvenX - 25, WorkSpeedX);
		sqSearch.Step := 35;
		
	35: sqSearch.Info.Set("Warte auf Achse X in Such-Pos. 1");
		IF fbAxisX.TargetReached() THEN
			sqSearch.SetStep(40);
		END_IF	
		
	40: sqSearch.Info.Set("Suche aktiv Achse Y");
		fbAxisY.MoveAbsExVel(PosWorkOvenY_OffsDn, WorkSpeedY);
		sqSearch.Step := 45;

	45: sqSearch.Info.Set("Warte auf Achse Y in Such-Pos. 1");
		IF fbAxisY.TargetReached() THEN
			sqSearch.SetStep(50);
		END_IF
		
	// chk sensor start condition, start search..
	50: sqSearch.Info.Set("Check Startbedingungen Suchfahrt 1");
		IF rfTrigS1.bIn THEN
			StationError.ArgSbAppendRaise('Signal Sensor S1 steht noch an');
		ELSIF rfTrigS2.bIn THEN
			StationError.ArgSbAppendRaise('Signal Sensor S2 steht noch an');
		ELSE
			fbAxisX.MoveAbsExVel(PosWorkOvenX, HomeSpeedX);
			MEMSET(ADR(SearchTrig), 0, SIZEOF(SearchTrig));
			sqSearch.Step := 60;
		END_IF
	
	60: sqSearch.Info.Set("Suchfahrt 1 aktiv (Achse X)");
		IF rfTrigS1.bRq THEN 
			SearchTrig[0, 0].X := fbAxisX.Position;
			SearchTrig[0, 0].Z := MeasurementA;
		END_IF
		IF rfTrigS2.bRq THEN 
			SearchTrig[1, 0].X := fbAxisX.Position;
			SearchTrig[1, 0].Z := MeasurementB;
		END_IF
		IF SearchTrig[0, 0].X <> 0 AND SearchTrig[1, 0].X <> 0 THEN
			sqSearch.SetStep(80);
		ELSIF sqSearch.SeqTime > T#10S THEN
			StationError.ArgSbAppendRaise('Timeout Suchfahrt 1');
		END_IF
		
	80: sqSearch.Info.Set("Check Startbedingungen Suchfahrt 2");
		IF NOT rfTrigS1.bIn THEN
			StationError.ArgSbAppendRaise('Signal Sensor S1 fehlt');
		ELSIF NOT rfTrigS2.bIn THEN
			StationError.ArgSbAppendRaise('Signal Sensor S2 fehlt');
		ELSE
			fbAxisX.MoveAbsExVel(PosWorkOvenX + 25, HomeSpeedX);
			sqSearch.Step := 90;
		END_IF
	
	90: sqSearch.Info.Set("Suchfahrt 2 aktiv (Achse X)");
		IF rfTrigS1.bFq THEN 
			SearchTrig[0, 1].X := fbAxisX.Position;
			SearchTrig[0, 1].Z := MeasurementA;
		END_IF
		IF rfTrigS2.bFq THEN 
			SearchTrig[1, 1].X := fbAxisX.Position;
			SearchTrig[1, 1].Z := MeasurementB;
		END_IF
		IF SearchTrig[0, 1].X <> 0 AND SearchTrig[1, 1].X <> 0 THEN
			sqSearch.Step := 300;
		ELSIF sqSearch.SeqTime > T#100S THEN
			StationError.ArgSbAppendRaise('Timeout Suchfahrt 2');
		END_IF
		
	100: sqSearch.Info.Set("Auswertung Suchfahrt..");
		//IF ABS(SearchTrig[0, 0] - SearchTrig[0, 1]) > 2 THEN
		//	INotiHdl.M_SetNotiDefaultErr(stTextlistGlobal.stText_NG_Stations, Name, F_CreateDynTextDefault("Trigger-Signale Sensor S1 unplausibel"), stEmptyText);
		//ELSIF ABS(SearchTrig[1, 0] - SearchTrig[1, 1]) > 2 THEN
		//	INotiHdl.M_SetNotiDefaultErr(stTextlistGlobal.stText_NG_Stations, Name, F_CreateDynTextDefault("Trigger-Signale Sensor S2 unplausibel"), stEmptyText);
		//ELSE
			//fPosSearchCorr := ((SearchTrig[0, 0] - SearchTrig[0, 1]) + (SearchTrig[1, 0] - SearchTrig[1, 1]))/2;
			sqSearch.SetStep(200);
		//END_IF
	
	// hg to chk empty slot position
	200: sqSearch.Info.Set("Suche aktiv Achse X");
		fbAxisX.MoveAbsExVel(PosWorkOvenX + 50, WorkSpeedX);
		fbAxisY.MoveAbsExVel(PosWorkOvenY - 25, WorkSpeedY); //ToDo: chk pos!
		sqSearch.Step := 205;
		
	205: sqSearch.Info.Set("Warte auf Achse X in Slot-Check-Pos.");
		IF NOT fbAxisX.TargetReached() THEN RETURN; END_IF
		sqSearch.Info.Set("Warte auf Achse Y in Slot-Check-Pos.");
		IF NOT fbAxisY.TargetReached() THEN RETURN; END_IF
		sqSearch.Step := 210;
		
	210: sqSearch.Info.Set("Suche aktiv Achse Y");
		eEmptyChk := SEL(rfTrigS1.bIn, E_St030_EmptySlotChk.eSt030_EmptySlotChk_Empty, E_St030_EmptySlotChk.eSt030_EmptySlotChk_NotEmpty);
		sqSearch.SetStep(300);		
	
	// hg to backup position
	300: sqSearch.Info.Set("Wiederherstellung HG aktiv Achse Z");
		fbAxisZ.MoveAbsExVel(HgPosBackup.z, WorkSpeedZ);
		sqSearch.Step := 305;
	
	305: sqSearch.Info.Set("Warte auf Achse Z in Backupposition");
		IF fbAxisZ.TargetReached() THEN
			sqSearch.SetStep(310);	
		END_IF
		
	310: sqSearch.Info.Set("Wiederherstellung aktiv Achse Y");
		fbAxisY.MoveAbsExVel(HgPosBackup.y, WorkSpeedY);
		sqSearch.Step := 315;

	315: sqSearch.Info.Set("Warte auf Achse Y in Backupposition");
		IF fbAxisY.TargetReached() THEN
			sqSearch.SetStep(320);	
		END_IF
		
	320: sqSearch.Info.Set("Wiederherstellung aktiv Achse X");
		fbAxisX.MoveAbsExVel(HgPosBackup.x, WorkSpeedX);
		sqSearch.Step := 325;
		
	325: sqSearch.Info.Set("Warte auf Achse X in Backupposition");
		IF fbAxisX.TargetReached() AND fbAxisY.TargetReached() AND fbAxisZ.TargetReached() THEN
			sqSearch.Step := 0;
		END_IF
	
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SetReferences" Id="{ec39714d-05b8-4f36-9b6c-7aedc533ab76}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD INTERNAL M_SetReferences : BOOL
VAR_IN_OUT
	stIoRef : ST_St030_IO;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIO REF= stIoRef;
M_SetReferences := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Supervision" Id="{b2d354a4-c778-435d-aafc-442574e0b819}">
      <Declaration><![CDATA[METHOD PROTECTED M_Supervision : BOOL
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// chk stopped
IF NOT bRunCycle OR P_Safety.bMachineRequestStop THEN
	IF P_Safety.bMachineRequestStop THEN
		fbAxisX.Stop();
		fbAxisY.Stop();
		fbAxisZ.Stop();
	END_IF
	IF sqAuto.StepTime > T#20S THEN
		bStopped := TRUE;
	END_IF
END_IF

// axis x
IF fbAxisX.bError THEN
	ReactToComponentError(fbAxisXUi, E_EventReaction.Stop);

// y
ELSIF fbAxisY.bError THEN
	ReactToComponentError(fbAxisYUi, E_EventReaction.Stop);
	
// z
ELSIF fbAxisZ.bError THEN
	ReactToComponentError(fbAxisZUi, E_EventReaction.Stop);
	
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="MeasurementA" Id="{899a57d8-b7d2-4ab2-b37e-332fc9929814}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY INTERNAL MeasurementA : LREAL]]></Declaration>
      <Get Name="Get" Id="{2d832e32-38f1-4001-b5e9-cfa8fe6c8be1}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MeasurementA := TO_LREAL(stIO.stIn.fMeasurementA)/1E3;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="MeasurementB" Id="{d417ea57-4b5e-4a8d-aab2-a6c4ab81b605}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY INTERNAL MeasurementB : LREAL]]></Declaration>
      <Get Name="Get" Id="{0919dff0-601e-4d27-b77e-af0bad6398da}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MeasurementB := TO_LREAL(stIO.stIn.fMeasurementB)/1E3;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PosHomeX" Id="{a508ceb9-26d3-430e-8f32-d11536d39d9c}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PRIVATE PosHomeX : LREAL]]></Declaration>
      <Get Name="Get" Id="{e72d95ca-84e8-4bee-8a03-271cccfa1684}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PosHomeX := stLocalSettings.stDynStationSettings[E_St030_Settings.eSt030_Settings_XPosHome].fValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PosHomeY" Id="{c040afa1-7271-4515-9567-fc9786f5038d}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PRIVATE PosHomeY : LREAL]]></Declaration>
      <Get Name="Get" Id="{ebddc258-bf66-4bdd-8226-0d3bd95579d9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PosHomeY := stLocalSettings.stDynStationSettings[E_St030_Settings.eSt030_Settings_YPosHome].fValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PosHomeZ" Id="{3c1f711e-e0bf-41a3-b292-568c8c405b89}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PRIVATE PosHomeZ : LREAL]]></Declaration>
      <Get Name="Get" Id="{e193009c-f7ea-4051-b37e-83945062e1e3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PosHomeZ := stLocalSettings.stDynStationSettings[E_St030_Settings.eSt030_Settings_ZPosHome].fValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PosWorkOvenX" Id="{9f659901-01f5-4b7b-b151-109d97cac3ce}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PRIVATE PosWorkOvenX : LREAL]]></Declaration>
      <Get Name="Get" Id="{ccc04400-0e8f-4563-abb2-2467e6d5ca27}">
        <Declaration><![CDATA[VAR
	iOven 		: INT;
	fDeltaX, fDeltaY,
	fRp1, fRp2,
	fApprox,
	fDevision 	: LREAL;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[// set oven (A/B --> 1/2)
iOven := 	SEL(stSt030IHandling.ActiveCommand.Command = E_St030_Command.eSt030_Command_OvenA_Get OR
				stSt030IHandling.ActiveCommand.Command = E_St030_Command.eSt030_Command_OvenA_Put, 2, 1);
				
// calc x-approximation
fRp1 := GetPosOvRp(iOven, 1, 'Y');
fRp2 := GetPosOvRp(iOven, 2, 'Y');
fDeltaY := fRp2 - fRp1;


fRp1 := GetPosOvRp(iOven, 1, 'X');
fRp2 := GetPosOvRp(iOven, 2, 'X');
fDeltaX := fRp2 - fRp1;	

IF ABS(fDeltaY) > fEpsilon THEN
	fApprox := fDeltaX/fDeltaY * (PosWorkOvenY - fRp1);
END_IF

// ..IndexX = 1 => - Teilung, ..IndexX = 2 => + Teilung
fDevision := P_Plant.TrolleyRackDivision * SEL(stSt030IHandling.ActiveCommand.Position = 1, -0.5, 0.5);

PosWorkOvenX := SEL(iOven = 2, Plant.fbSt010OvenA.OvenMiddlePointX, Plant.fbSt020OvenB.OvenMiddlePointX) +
				fDevision + fApprox;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PosWorkOvenY" Id="{eb1aff29-091e-498f-8354-d7d28fdc7304}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PRIVATE PosWorkOvenY : LREAL]]></Declaration>
      <Get Name="Get" Id="{a6de27b1-6255-4852-81d9-522287b76fcb}">
        <Declaration><![CDATA[VAR
	iOven 		: INT;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[// set oven (A/B --> 1/2)
iOven := 	SEL(stSt030IHandling.ActiveCommand.Command = E_St030_Command.eSt030_Command_OvenA_Get OR
				stSt030IHandling.ActiveCommand.Command = E_St030_Command.eSt030_Command_OvenA_Put, 2, 1);

PosWorkOvenY := (P_Plant.TrolleyCarrierDistance * stSt030IHandling.ActiveCommand.Position) + 
					P_Plant.TrolleyRackOriginY + 
					SEL(iOven = 2, Plant.fbSt010OvenA.OvenOffsetY, Plant.fbSt020OvenB.OvenOffsetY);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PosWorkOvenY_OffsDn" Id="{4b6378aa-e35d-4a7b-93b1-349cea608b09}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PRIVATE PosWorkOvenY_OffsDn : LREAL]]></Declaration>
      <Get Name="Get" Id="{fcf74f90-8309-4557-83f8-d038e67998fa}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PosWorkOvenY_OffsDn := PosWorkOvenY - 15;// P_Plant.TrolleyOffsetDnY; //15]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PosWorkOvenY_OffsUp" Id="{1acab3be-38ac-4e25-81ea-667f157b41a9}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PRIVATE PosWorkOvenY_OffsUp : LREAL]]></Declaration>
      <Get Name="Get" Id="{dae5c196-f7f8-46f5-b9d9-1e136146aa20}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PosWorkOvenY_OffsUp := PosWorkOvenY + 20;//P_Plant.TrolleyOffsetUpY; //20]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PosWorkOvenZ" Id="{d7bbe515-2969-4c65-a278-23c6e0093de8}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PRIVATE PosWorkOvenZ : LREAL]]></Declaration>
      <Get Name="Get" Id="{62f06c8c-c144-4e2d-b1f0-c798a13c9dc3}">
        <Declaration><![CDATA[VAR
	iOven 		: INT;
	fDeltaZ, fDeltaY,
	fRp1, fRp2,
	fApprox		: LREAL;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[// set oven (A/B --> 1/2)
iOven := 	SEL(stSt030IHandling.ActiveCommand.Command = E_St030_Command.eSt030_Command_OvenA_Get OR
				stSt030IHandling.ActiveCommand.Command = E_St030_Command.eSt030_Command_OvenA_Put, 2, 1);
				
// calc x-approximation
fRp1 := GetPosOvRp(iOven, 1, 'Y');
fRp2 := GetPosOvRp(iOven, 2, 'Y');
fDeltaY := fRp2 - fRp1;

fRp1 := GetPosOvRp(iOven, 1, 'Z');
fRp2 := GetPosOvRp(iOven, 2, 'Z');
fDeltaZ := fRp2 - fRp1;

IF ABS(fDeltaY) > fEpsilon THEN
	fApprox := fDeltaZ/fDeltaY * (PosWorkOvenY - fRp1);
END_IF

PosWorkOvenZ := SEL(iOven = 2, Plant.fbSt010OvenA.OvenPickUpDepthZ, Plant.fbSt020OvenB.OvenPickUpDepthZ)
				+ fApprox;
]]></ST>
        </Implementation>
      </Get>
    </Property>
