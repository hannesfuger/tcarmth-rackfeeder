    <Method Name="SetReferences" Id="{4d1e0e41-5586-454f-8003-39af9c1cbe89}" FolderPath="Factory\">
      <Declaration><![CDATA[/// Set IO reference
{attribute 'object_name' := 'SetReferences'}
METHOD SetReferences
VAR_IN_OUT
	/// IO structure
	stRefIO 	: ST_FurnaceIO;
END_VAR

VAR
	ptIn 	: POINTER TO ST_FurnaceIn;
	ptOut 	: POINTER TO ST_FurnaceOut;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ptIn := ADR(stRefIO.stIn);
ptOut := ADR(stRefIO.stOut);

stIn REF= ptIn^;
stOut REF= ptOut^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetupTempSensor" Id="{e3929ce6-6e18-44ee-a5da-cafc30b8160d}" FolderPath="Factory\">
      <Declaration><![CDATA[METHOD SetupTempSensor
VAR_INPUT	
	nAnalogIn1		: INT;
	nValue1			: LREAL;

	nAnalogIn2		: INT;
	nValue2			: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fSlope:= (nValue1 - nValue2) / (nAnalogIn1 - nAnalogIn2);
fInitial := nValue1 - (fSlope * nAnalogIn1);]]></ST>
      </Implementation>
    </Method>
    <Property Name="Temperature" Id="{9ffaff0d-0c3b-4d0e-bd62-52049f80f2a7}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY Temperature : LREAL]]></Declaration>
      <Get Name="Get" Id="{0704244b-30ca-41c7-ad44-82fd824fe461}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Temperature := fTemperature;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>