    <Method Name="CycleEnd" Id="{42e03c24-27ed-48e3-8ed0-281947e6589c}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PROTECTED CycleEnd
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[diCycles := diCycles + 1;
diTotalCycles := diTotalCycles + 1;
diLastCycleTime := TIME_TO_UDINT(sqAuto.SeqTime);
sqAuto.StopSequence();
bBusy := FALSE;
bStopped := TRUE;]]></ST>
      </Implementation>
    </Method>
