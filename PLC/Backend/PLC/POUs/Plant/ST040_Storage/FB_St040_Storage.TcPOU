//END_IF
//
//IF stHmiInOut.stSt040.Command = E_HMI_PL_CMD.eHmiPlCmd_none THEN
//	RETURN;
//END_IF

//IF stHmiInOut.stSt040.Idx = 1 THEN
//	fbPL REF= stSt040IStorage.Pallet1;
//ELSIF stHmiInOut.stSt040.Idx = 2 THEN
//	fbPL REF= stSt040IStorage.Pallet2;
//ELSE
//	StationError.ArgSbAppendRaise('Index not set on HMI Pallet Command');
//	//stHmiInOut.stSt040.Command := E_HMI_PL_CMD.eHmiPlCmd_none;
//	RETURN;
//END_IF

//fbPL.PerformHmiCmd(stHmiInOut.stSt040);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_OpModeChanged" Id="{134dcb41-3085-4f55-bc2f-ee9f310a1218}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PROTECTED M_OpModeChanged : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*bBusy := FALSE;

IF (eOpMode <> eOpMode_step AND eOpMode <> eOpMode_auto) THEN
	sqAuto.Set(0);
END_IF

fbAxis1.Stop();
fbAxis2.Stop();*)
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Run" Id="{64f79493-15a4-46c4-8841-accc0c3d7839}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC M_Run : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// check refs valid
IF NOT __ISVALIDREF(stIO) THEN
	RETURN;
END_IF

M_RUN := SUPER^.M_Run();

M_DynSettings();
M_DynManual();
M_DynMonitoring();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Sequence" Id="{53b57e7b-6d5c-4e48-9eef-64f6c7d19891}">
      <Declaration><![CDATA[METHOD PROTECTED M_Sequence
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// signal mapping (e.g.: enable)
// stSt040Interface.bEnable := (sqAuto.Step = 100 AND fbAxis1.Operational AND fbAxis1.Operational) OR
// 								bStationDeaktiv;

// automatic sequence
CASE sqAuto.Step OF
	
	0:	sqAuto.Info.Set("Warte auf Auto Start");
		IF RunCycle AND RunStep THEN
			//sqAuto.Info.Set("Warte auf GRST");
			//IF sqHome.InHome AND bInHome THEN
				sqHome.InHome := FALSE;
				sqAuto.Step := 5;
			//ELSE
			//	StationError.ArgSbAppendWsRaise(stTextlistGlobal.stText_station_not_in_hp);
			//END_IF
		END_IF
		
	5:	IF bStationDeaktiv THEN
			sqAuto.Info.Set("Station deaktiv");
		ELSE
			sqAuto.Step := 10;
		END_IF
		
	10:	sqAuto.Info.Set("Prüfe Startbedingungen");
		IF NOT fbAxis1.Operational THEN
			StationError.ArgSbAppendRaise('Bereitsignal Achse 1 fehlt');
		ELSIF NOT fbAxis2.Operational THEN
			StationError.ArgSbAppendRaise('Bereitsignal Achse 2 fehlt');
		ELSE
			CycleStart();
			sqAuto.SetStep(20);
		END_IF
		
	20:
		sqAuto.Info.Set("Automatik, Achse 1/2 auf Homepos.");
		fbAxis1.MoveAbsExVel(PosHome, WorkSpeed);
		fbAxis2.MoveAbsExVel(PosHome, WorkSpeed);
		sqAuto.Step := 25;
		
	25:
		sqAuto.Info.Set("Warte auf Achse 1 in Homeposition");
		IF NOT fbAxis1.TargetWindowReached(chAxisPosTol + 4) THEN RETURN; END_IF //ToDo: set pos tol
		sqAuto.Info.Set("Warte auf Achse 2 in Homeposition");
		IF NOT fbAxis2.TargetWindowReached(chAxisPosTol + 4) THEN RETURN; END_IF //ToDo: set pos tol
		sqAuto.Step := 100;

	// work
	100: sqAuto.Info.Set("Automatik, warte auf Anforderung vom HG");
		IF stSt030IHandling.bReqestStorage_ChkIndex THEN
			sqAuto.Info.Append(", Index-Check");
			stSt040IStorage.iConfirmPosition := stSt030IHandling.ActiveCommand.Position;
			//stSt040IStorage.iConfirmOpnIdxY := stSt030IHandling.ActiveCommand.IndexY;
			stSt040IStorage.bResponseEmptyAtIndex := (stSt030IHandling.ActiveCommand.Position = 1 AND NOT stSt040IStorage.Pallet1.CarrierPresent) OR
													 (stSt030IHandling.ActiveCommand.Position = 2 AND NOT stSt040IStorage.Pallet2.CarrierPresent);
			stSt040IStorage.bResponseChkIndex := TRUE;
			IF stSt030IHandling.bReqestStorage AND stSt040IStorage.iConfirmPosition = 1 THEN sqAuto.SetStep(110); END_IF
			IF stSt030IHandling.bReqestStorage AND stSt040IStorage.iConfirmPosition = 2 THEN sqAuto.SetStep(120); END_IF
		END_IF
	
		IF RunCycle THEN RETURN; END_IF
		sqAuto.Info.Set("Stop - warte auf Ablauf gestoppt");
		sqAuto.Step := 900;
		
	110:
		sqAuto.Info.Set("Automatik, Achse 1 öffnen");
		fbAxis1.MoveAbsExVel(PosHome, WorkSpeed);
		sqAuto.Step := 115;
		
	115:
		sqAuto.Info.Set("Warte auf Achse 1 Offenpos.");
		IF NOT fbAxis1.TargetWindowReached(chAxisPosTol + 4) THEN RETURN; END_IF //ToDo: set pos tol
		sqAuto.Step := 150;
		
	120:
		sqAuto.Info.Set("Automatik, Achse 2 öffnen");
		fbAxis2.MoveAbsExVel(PosHome, WorkSpeed);
		sqAuto.Step := 125;
		
	125:
		sqAuto.Info.Set("Warte auf Achse 2 in Offenpos.");
		IF NOT fbAxis2.TargetWindowReached(chAxisPosTol + 4) THEN RETURN; END_IF //ToDo: set pos tol
		sqAuto.Step := 150;
		
	150: sqAuto.Info.Set("Storage offen, warte auf Anforderung vom HG");
		stSt040IStorage.bResponseOpn := TRUE;
		IF NOT stSt030IHandling.bReqestStorage THEN
			stSt040IStorage.bResponseOpn := FALSE;
			sqAuto.SetStep(900);
		END_IF
		
	// rdy	
	900: sqAuto.Info.Set("Zyklus beendet");
		CycleEnd();
		sqAuto.Step := 0;

	// error
	1000: sqAuto.Info.Set("Error");
		bStopped := TRUE;
		sqHome.InHome := FALSE;
		bRunHoming := FALSE;

END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SetReferences" Id="{d65dc30d-6939-4102-85d6-aba894307df6}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD INTERNAL M_SetReferences : BOOL
VAR_IN_OUT
	stIoRef : ST_St040_IO;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIO REF= stIoRef;
M_SetReferences := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Supervision" Id="{4bc23b69-8b41-475b-9dba-be28ed25f35a}">
      <Declaration><![CDATA[METHOD PROTECTED M_Supervision : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// chk stopped
IF NOT bRunCycle OR P_Safety.bMachineRequestStop THEN
	IF sqAuto.StepTime > T#20S THEN
		bStopped := TRUE;
	END_IF
END_IF

// chk requested index
IF stSt030IHandling.bReqestStorage_ChkIndex THEN
	;// --> confirm chk implemented in M_Sequence, step 100
	//stSt040IStorage.iConfirmOpnIdx := stSt030IHandling.ActiveCommand.IndexX;
	////stSt040IStorage.iConfirmOpnIdxY := stSt030IHandling.ActiveCommand.IndexY;
	//stSt040IStorage.bResponseEmptyAtIndex := (stSt030IHandling.ActiveCommand.IndexX = 1 AND NOT stSt040IStorage.Pallet1.PalletExists) OR
	//										 (stSt030IHandling.ActiveCommand.IndexX = 2 AND NOT stSt040IStorage.Pallet2.PalletExists);
	//stSt040IStorage.bResponseChkIndex := TRUE;
ELSE
	stSt040IStorage.iConfirmPosition := -1;
	//stSt040IStorage.iConfirmOpnIdxY := -1;
	stSt040IStorage.bResponseEmptyAtIndex := FALSE;
	stSt040IStorage.bResponseChkIndex := FALSE;
END_IF

// axis x
IF fbAxis1.bError THEN
	ReactToComponentError(fbAxis1Ui, E_EventReaction.Stop);

// y
ELSIF fbAxis2.bError THEN
	ReactToComponentError(fbAxis2Ui, E_EventReaction.Stop);
	
END_IF
]]></ST>
      </Implementation>
    </Method>
