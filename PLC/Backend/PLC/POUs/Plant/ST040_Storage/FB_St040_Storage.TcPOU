          <ST><![CDATA[WorkSpeed := stLocalSettings.stDynStationSettings[E_St040_Settings.eSt040_Settings_WorkSpeed].fValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>