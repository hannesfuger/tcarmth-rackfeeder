	arrStStation	: ARRAY[0..E_Station.eStation_nMaxIdx] OF ST_HMI_BASE_STATION_OUT;
	
	stRecipe		: ST_HMI_RECIPE_OUT; 	// Recipe Management structure
	stSettings 		: ST_HMI_CONTROL_SETTING_OUT;
	stMonitoring	: ST_Monitoring;		// monitoring to hmi or data bench
	stSafety		: ST_HMI_SAFETY_OUT;	// Safety info
	stUserMgmt		: ST_HMI_USER_MGMT_OUT;
	stTrafficLight	: ST_HMI_TRAFFIC_LIGHT_OUT;
	
	aSystemInfos	: ARRAY[0..CONST.iMaxIdxSystemInfo] OF ST_NameValue;
END_STRUCT
END_TYPE
]]></Declaration>
