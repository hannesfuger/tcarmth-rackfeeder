    <Method Name="M_SetLocalErrorS" Id="{1a123926-d7f5-4ee3-bbd5-444d3181f983}" FolderPath="PrivateMethods\">
      <Declaration><![CDATA[METHOD PRIVATE M_SetLocalErrorS : BOOL
VAR_INPUT
	sErrorText1		: STRING;
	sErrorText2		: STRING;
END_VAR
VAR
	stErrorText		: ST_Text;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[eState := E_ComponentState.eComponentState_error;

stErrorText := F_CreateDynText(TO_WSTRING(CONCAT(sErrorText1, sErrorText2)), 0);
sLastError := TO_STRING(stErrorText.wsName);]]></ST>
      </Implementation>
    </Method>
