    <Property Name="EnableManual" Id="{94bc03c1-c1c5-49bf-a2b7-cf6f0f61c0c7}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
//{attribute 'monitoring' := 'variable'}
PROPERTY PUBLIC EnableManual : BOOL]]></Declaration>
      <Get Name="Get" Id="{a50db3e9-109a-4814-a3ca-6b9f7ee02a81}">
        <Declaration><![CDATA[
VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnableManual := EnableSummary AND (eOpMode = eOpMode_manual);
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EnableSummary" Id="{d38cad44-3c6b-473e-9228-06674de6bb5c}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
//{attribute 'monitoring' := 'variable'}
PROPERTY INTERNAL EnableSummary : BOOL]]></Declaration>
      <Get Name="Get" Id="{b84f63c5-1a72-4487-a1fa-3c5260569776}">
        <Declaration><![CDATA[PUBLIC 
VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnableSummary := bEnable 
				AND bSafetyOk 
				AND (bRunHoming OR (eOpMode = eOpMode_manual) OR (eOpMode = eOpMode_step) OR (eOpMode = eOpMode_auto));]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="GetComponentError" Id="{e291252f-0029-41c9-9cac-3999e02b4e3d}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED GetComponentError : I_StringBuilder
VAR_IN_OUT
	fbUi	: FB_ManualUiBase;
END_VAR
VAR
	tmp		: ST_Text;
	name,
	err, 
	bmk		: STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[WSTRING_TO_STRING2(ADR(name), ADR(fbUi.stName.wsName), SIZEOF(name));		//ToDo: get rid of wstring?
WSTRING_TO_STRING2(ADR(err), ADR(fbUi.stErrorText.wsName), SIZEOF(err));
WSTRING_TO_STRING2(ADR(bmk), ADR(fbUi.stBmk.wsName), SIZEOF(bmk));

GetComponentError := sb.Set(name)
  .Append(' | ')  
  .Append(err)
  .Append(' | ')
  .Append(bmk);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetStepChainTest" Id="{6b5c222a-2357-4c9b-9bbd-ad1c2653fe0f}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC GetStepChainTest : ST_Text
VAR_INPUT
	Index : INT; // step chain index
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// step chain index is ignored in the default implementation -> if multiple step chains are needed, use derived base and override this method. 
GetStepChainTest.nNameId := sqAuto.InfoTextId;
GetStepChainTest.wsName := sqAuto.Info.ToWString();
GetStepChainTest.wsNameId := sqAuto.InfoTextWsId;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Homing" Id="{ff9f0f9c-0627-4634-97ff-526f2aca4a5e}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
PROPERTY PUBLIC Homing : BOOL]]></Declaration>
      <Get Name="Get" Id="{992234dc-a116-4c9a-9cb6-2d39c89e14a3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
