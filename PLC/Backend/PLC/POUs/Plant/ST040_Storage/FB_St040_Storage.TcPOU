    <Method Name="Reset" Id="{45aa774f-521c-4125-a02f-a9857134d028}" FolderPath="Internal\">
      <Declaration><![CDATA[/// Reset station logic
{attribute 'object_name' := 'Reset'}
METHOD Reset
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// base logic run
SUPER^.Reset();

// reset objects

IF fbAxis1.bError OR NOT RunCycle THEN
	fbAxis1.Reset();
END_IF
IF fbAxis2.bError OR NOT RunCycle THEN
	fbAxis2.Reset();
END_IF]]></ST>
      </Implementation>
    </Method>
