STRUCT
	fVelocity: LREAL;
	fAcceleration: LREAL;
	fDeceleration: LREAL;
	fJerk: LREAL;
	fGap: LREAL;
	eBufferMode: MC_BufferMode := MC_Aborting;
	stOptions: ST_MoveOptions;
END_STRUCT
END_TYPE
]]></Declaration>
