<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Diagnosis_History" Id="{c2dd2a01-5a60-44a1-b181-1026d00edeaa}" SpecialFunc="None">
    <Declaration><![CDATA[/// provides ELM safety device diagnostic functions
FUNCTION_BLOCK FB_Diagnosis_History
VAR_INPUT
	/// EtherCAT adress of the slave
	nSlaveAddress: UINT;
	/// ADS NET adress of the slave
	stAdsAddr: AMSADDR;
	/// current system time
	dtNow: DT;
END_VAR
VAR_OUTPUT
	/// slave and link state
	stSlaveState: ST_EcSlaveStateBitsEx;
	/// PAI info data: CPU usage, temperature, aso.
	stPAIInfoData: ST_ELM3xxxPAIInfoData;
	/// diag history data
	stDiagHistory: ST_DiagHistory;
	/// device time stamp in [ns] since power on
	nDevieTimeStamp: ULINT;
	/// device time stamp [DT]
	dtUpTimeStamp: DT;
	/// busy flag
	bBusy: BOOL;
	/// error flag
	bError: BOOL;
	nErrorId: UDINT;
END_VAR
VAR CONSTANT
	/// CoE index PAI Info
	nIdxPAIInfo: WORD := 16#F900;
	/// Actual Time Stamp
	nIdxActTimeStamp: WORD := 16#10F8;
	/// Diag History
	nIdxDiagHistory: WORD := 16#10F3;
END_VAR
VAR
	/// CoE - Slave state
	fbGetSlaveState: FB_EcGetSlaveState;
	nStepGetState: INT;
	tAutoUpdateSlaveState: TIME;
	tonAutoUpdateSlaveState: TON;
	/// CoE - PAI Info
	fbCoeReadPAIInfo: FB_EcCoeSdoReadEx;
	nStepGetPAIInfo: INT;
	tAutoUpdatePAIInfo: TIME;
	tonAutoUpdatePAIInfo: TON;
	/// CoE - Diag History
	fbEcCoeSdoReadEx: FB_EcCoeSdoReadEx;
	nStepGetDiagHistory: INT;
	tAutoUpdateDiagHistory: TIME;
	tonAutoUpdateDiagHistory: TON;
	/// auto update all
	tAutoUpdateAll: TIME;
	tonAutoUpdateAll: TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// CoE - Slave state
tonAutoUpdateSlaveState(IN := tAutoUpdateSlaveState > T#0S, PT := tAutoUpdateSlaveState);
IF tonAutoUpdateSlaveState.Q THEN
	tonAutoUpdateSlaveState(IN := FALSE);
	nStepGetState := SEL(nStepGetState = 0, nStepGetState, 10);
END_IF

// CoE - PAI Info
tonAutoUpdatePAIInfo(IN := tAutoUpdatePAIInfo > T#0S, PT := tAutoUpdatePAIInfo);
IF tonAutoUpdatePAIInfo.Q THEN
	tonAutoUpdatePAIInfo(IN := FALSE);
	nStepGetPAIInfo := SEL(nStepGetPAIInfo = 0, nStepGetPAIInfo, 10);
END_IF

// CoE - Diag History
tonAutoUpdateDiagHistory(IN := tAutoUpdateDiagHistory > T#0S, PT := tAutoUpdateDiagHistory);
IF tonAutoUpdateDiagHistory.Q THEN
	tonAutoUpdateDiagHistory(IN := FALSE);
	nStepGetDiagHistory := SEL(nStepGetDiagHistory = 0, nStepGetDiagHistory, 10);
END_IF

// auto update all
tonAutoUpdateAll(IN := tAutoUpdateAll > T#0S, PT := tAutoUpdateAll);
IF tonAutoUpdateAll.Q THEN
	tonAutoUpdateAll(IN := FALSE);
	M_GetSlaveState();
	M_GetPAIInfoData();
	M_GetDiagHistory();
END_IF

// workflows
M_WfGetSlaveState();
M_WfGetPAIInfoData();
M_WfGetDiagHistory();

bBusy := nStepGetState > 0 OR nStepGetPAIInfo > 0 OR nStepGetDiagHistory > 0;]]></ST>
    </Implementation>
    <Method Name="M_DecodeDiagMessage" Id="{91fba068-19e1-479d-8978-5fac1eba01d7}">
      <Declaration><![CDATA[/// decodes a ethercat device diag message
/// 	return value: success state
METHOD M_DecodeDiagMessage : BOOL
VAR_INPUT
	/// device type specification (for specific text ID mapping)
	eDeviceType: E_HistoryDiagDevices := E_HistoryDiagDevices.EL19xx;
	/// device up time stamp
	dtUpTimeStamp: DT;
END_VAR
VAR_IN_OUT
	/// device diag message (source)
	stDm: ST_DiagMessage;
	/// human readable message item (destination)
	stMi: ST_MessageItem;
END_VAR
VAR
	tTs: TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// message time stamp
tTs := F_EcDeviceTimeStampToTime(stDm.nTimeStamp);
stMi.dtTimeStamp := dtUpTimeStamp + tTs;

// msg prio
stMi.nPriority.0 := stDm.nFlags.bInfo;
stMi.nPriority.1 := stDm.nFlags.bWarning;
stMi.nPriority.2 := stDm.nFlags.bError;
stMi.nPriority.3 := stDm.nFlags.bReserved1;

// msg text
CASE eDeviceType OF
	E_HistoryDiagDevices.EL19xx:
		 M_ResolveEL19xxText(stDm.nTextID, stDm.aParameter, stMi.sMessage);
	E_HistoryDiagDevices.EL29xx:
		 M_ResolveEL29xxText(stDm.nTextID, stDm.aParameter, stMi.sMessage);
	ELSE
		stMi.sMessage := UINT_TO_STRING(stDm.nTextID);
END_CASE

M_DecodeDiagMessage := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GetDiagHistory" Id="{d540f364-dd8a-4ff2-97be-4f9df2972190}">
      <Declaration><![CDATA[/// triggers reading device diag history once
/// 	return value: success state
METHOD INTERNAL M_GetDiagHistory : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_GetDiagHistory := M_GetDiagHistoryEx(T#0S);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GetDiagHistoryChanges" Id="{4b1c6d94-f384-4503-941a-6b56f948dca9}">
      <Declaration><![CDATA[/// gets new or changed messages from diag history since last call of this method
/// 	return value: success state
METHOD M_GetDiagHistoryChanges : BOOL
VAR_INPUT
	/// device type specification (for specific text ID mapping)
	eDeviceType: E_HistoryDiagDevices;
END_VAR
VAR_IN_OUT
	/// diag history mirror (from last call)
	stDiagHistMir: ST_DiagHistory;
	/// diag history changes (result)
	stMi: ARRAY[1..64] OF ST_MessageItem;
END_VAR
VAR
	ii: INT;
	jj: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// clear
MEMSET(ADR(stMi), 0, SIZEOF(stMi));

// detect new diag
IF MEMCMP(ADR(stDiagHistMir), ADR(stDiagHistory), SIZEOF(stDiagHistMir)) = 0 THEN
	RETURN;
END_IF

jj := 1;
FOR ii := 1 TO 64 DO
	IF stDiagHistory.DiagMessages[ii].nTextID > 0 THEN
		IF MEMCMP(ADR(stDiagHistMir.DiagMessages[ii]), ADR(stDiagHistory.DiagMessages[ii]), SIZEOF(stDiagHistMir.DiagMessages[ii])) <> 0 THEN
			M_DecodeDiagMessage(eDeviceType, dtUpTimeStamp, stDiagHistory.DiagMessages[ii], stMi[jj]);
			jj := jj + 1;
		END_IF
	END_IF
END_FOR

MEMCPY(ADR(stDiagHistMir), ADR(stDiagHistory), SIZEOF(stDiagHistMir));
M_GetDiagHistoryChanges := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GetDiagHistoryEx" Id="{f68e2523-cbcb-4d7d-bd53-74296e54f7ab}">
      <Declaration><![CDATA[/// triggers reading device diag history once or cyclic (if tAutoUpdate time > 0 specified)
/// 	return value: success state
METHOD INTERNAL M_GetDiagHistoryEx : BOOL
VAR_INPUT
	/// time for internal auto update (T#0S...auto update is off)
	tAutoUpdate: TIME := TIME#0ms;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_GetDiagHistoryEx := (nStepGetDiagHistory = 0); // if idle..
IF NOT M_GetDiagHistoryEx THEN
	RETURN;
END_IF

tAutoUpdateDiagHistory := tAutoUpdate;
nStepGetDiagHistory := 10;]]></ST>
      </Implementation>
    </Method>
