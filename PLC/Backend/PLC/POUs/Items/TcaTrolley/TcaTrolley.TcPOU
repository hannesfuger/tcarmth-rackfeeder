<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TcaTrolley" Id="{f529d72a-4dd4-4b6b-8f26-524d47f7e88a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK TcaTrolley //EXTENDS TcoCore.TcoComponent
VAR CONSTANT
	MAX_CARRIERPLACES : INT := 39;
END_VAR

VAR PERSISTENT
	_data : TcaTrolleyData;
	_config : TcaTrolleyConfig;
	_service : TcaTrolleyService;
END_VAR

VAR	
	_CarriersCoordinate : ARRAY[0..TcaCarrier.MAX_WORKPIECEPLACES] OF ST_Coordinate;
	_TemplateCarrier : TcaCarrier;//(THIS^);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Config" Id="{5a4589fb-3b68-4b18-8071-9f07b699de18}" />
    <Folder Name="Functions" Id="{a6dc591d-0dc2-4664-ba06-622ca7866e24}" />
    <Folder Name="Operations" Id="{fa82ac21-9eb7-488d-bbf1-2a52c018438f}" />
    <Folder Name="Properties" Id="{e7ab958f-53a6-41b6-b8ce-89cc16b2ca25}" />
    <Method Name="ApplyConfig" Id="{da1fb131-5c3d-497d-bc38-3725ffaa59d2}" FolderPath="Config\">
      <Declaration><![CDATA[METHOD ApplyConfig
VAR
	_i : INT;
	_Coordinate 		: ST_Coordinate;	
	_CarrierPerSide		: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MEMSET(ADR(_CarriersCoordinate),0,SIZEOF(_CarriersCoordinate));
MEMSET(ADR(_data.CarriersEnabled),0,SIZEOF(_data.CarriersEnabled));

_CarrierPerSide := _config.NumberOfCarriers/2;

FOR _i:=0 TO _config.NumberOfCarriers-1 DO
 	_Coordinate.fY  := _config.RackOrigin.fY +_config.CarrierDistance*(_i MOD(_CarrierPerSide));
 	_Coordinate.fX  := _config.RackOrigin.fX +_config.RackDivision/2*SEL(_i >= _CarrierPerSide, -1,  1);
	_CarriersCoordinate[_i] := _Coordinate;
	_data.CarriersEnabled[_i] := TRUE;
	_data.CarriersData[_i].Enabled := TRUE;
END_FOR

_TemplateCarrier.Config := _config.CarrierConfig;
_TemplateCarrier.ApplyConfig();]]></ST>
      </Implementation>
    </Method>
