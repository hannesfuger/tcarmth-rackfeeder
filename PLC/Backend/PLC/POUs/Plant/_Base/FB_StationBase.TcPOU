    <Method Name="M_DynMonitoring" Id="{dfe69796-4aec-4952-ad4d-ff3543df6a88}" FolderPath="DynSetMonMan\">
      <Declaration><![CDATA[METHOD PROTECTED M_DynMonitoring : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// station base signals
stLocalMonitoring.bInHome := bInHome;
stLocalMonitoring.bAuto := bRunStep;
stLocalMonitoring.bBusy := bBusy;
stLocalMonitoring.bError := (eState = E_ComponentState.eComponentState_error);
stLocalMonitoring.bManual := (eOpMode = E_OpMode.eOpMode_manual);
stLocalMonitoring.bTransferEnable := bTransferEnable;
stLocalMonitoring.bWarning := (eState = E_ComponentState.eComponentState_warning);

M_DynMonitoring := TRUE;]]></ST>
      </Implementation>
    </Method>
