    </Property>
    <Property Name="PosHome" Id="{95a12ec4-71b9-4838-bcc5-80484d9397c0}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY INTERNAL PosHome : LREAL]]></Declaration>
      <Get Name="Get" Id="{49f6a45e-aefe-4571-9654-96ee194905fc}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PosHome := stLocalSettings.stDynStationSettings[E_St020_Settings.eSt020_Settings_PosHome].fValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PosHomeCh" Id="{4337af28-c352-428d-8ab1-f4a9829766db}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY INTERNAL PosHomeCh : LREAL]]></Declaration>
      <Get Name="Get" Id="{1f87c825-85f2-45f3-b93f-2f1426c1580f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PosHomeCh := stLocalSettings.stDynStationSettings[E_St020_Settings.eSt020_Settings_PosHomeCh].fValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PosWork" Id="{c2279bfc-dc2e-42ca-8ad7-5ed97f0c84c9}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY INTERNAL PosWork : LREAL]]></Declaration>
      <Get Name="Get" Id="{89bc33e5-a21c-4969-a680-cb8d620a2efb}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PosWork := stLocalSettings.stDynStationSettings[E_St020_Settings.eSt020_Settings_PosWork].fValue + // 1. Mitnehmerpos.
	  (OvenSegmentHeight * 
		TRUNC(((P_Plant.TrolleyRackDivision * stSt020IOvenB.iConfirmPosition) + (P_Plant.TrolleyRackOriginX - OvenFixPartHeight - 50))/OvenSegmentHeight));]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PosWorkCh" Id="{4a6d159e-a738-4b05-a911-0bad6fae6361}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY INTERNAL PosWorkCh : LREAL]]></Declaration>
      <Get Name="Get" Id="{84c45396-bfd3-4610-bfda-5df52df76353}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PosWorkCh := stLocalSettings.stDynStationSettings[E_St020_Settings.eSt020_Settings_PosWorkCh].fValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PosWorkOpn" Id="{7a216aa7-9e8b-4ddd-8da3-2bc3528e0958}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY INTERNAL PosWorkOpn : LREAL]]></Declaration>
      <Get Name="Get" Id="{f25cff58-6dae-4bf4-87d4-e5b028d75f28}">
        <Declaration><![CDATA[VAR
	_pos : ST_Coordinate;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_pos := stSt020IOvenB.Trolley.GetCoordinateAt(stSt020IOvenB.iConfirmPosition) ;

PosWorkOpn := PosWork + 
			  LMOD(_pos.fY - OvenFixPartHeight - 50, OvenSegmentHeight) + 					
			  50 + // -50 => height axis z
			  P_Plant.TrolleyRackDivision; // ( + TrolleyDevisionY --> safety distance)


//			  LMOD(((P_Plant.TrolleyDevisionY * stSt020IOvenB.iConfirmOpnIdxY) + (P_Plant.TrolleyFirstPosY - OvenFixPartHeight - 50)), 
//					P_Plant.OvenSegmHeight) + 
//					50 + // -50 => height axis z
//			  P_Plant.TrolleyDevisionY; // ( + TrolleyDevisionY --> safety distance)]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{69b9bbc3-c88b-4f68-8abb-5a0faef4238f}" FolderPath="Internal\">
      <Declaration><![CDATA[/// Reset station logic
{attribute 'object_name' := 'Reset'}
METHOD Reset
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// base logic run
SUPER^.Reset();

// reset objects
//diContinuesNok := 0;

IF fbAxis.bError OR NOT RunCycle THEN
	fbAxis.Reset();
END_IF
IF fbAxisCh1.bError OR NOT RunCycle THEN
	fbAxisCh1.Reset();
END_IF
IF fbAxisCh2.bError OR NOT RunCycle THEN
	fbAxisCh2.Reset();
END_IF
]]></ST>
      </Implementation>
    </Method>
