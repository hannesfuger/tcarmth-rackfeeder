  <DUT Name="E_JogDirection" Id="{cec7526b-6cd1-431b-a799-0bde271ff6ce}">
    <Declaration><![CDATA[/// Enumeration of possible jog directions.
TYPE E_JogDirection :
(
	/// Jog direction not set
	eJogDirection_none := 0,
	/// Jog direction positive
	eJogDirection_pos,
	/// Jog direction negative
	eJogDirection_neg
);
END_TYPE
]]></Declaration>
  </DUT>
