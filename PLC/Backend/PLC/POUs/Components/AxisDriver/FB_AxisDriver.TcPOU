    <Method Name="ModuloReached" Id="{ed8a97a8-c8d2-4f2e-b3a6-15eb7f8215a1}" FolderPath="Methods\">
      <Declaration><![CDATA[/// Get's a value, indicating whether axis position is within motulo target position window and not moving.
/// Position window: default epsilon (1E-3).
/// Valid for previous MOD movement's.
METHOD PUBLIC ModuloReached : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ModuloReached := ModuloWindowReached(fEpsilon);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ModuloWindowReached" Id="{f99a5e46-cc09-442e-bc40-274c0f35de93}" FolderPath="Methods\">
      <Declaration><![CDATA[/// Get's a value, indicating whether axis position is within modulo target position window and not moving.
/// Valid for previous MOD movement's. 
METHOD PUBLIC ModuloWindowReached : BOOL
VAR_INPUT
	fWindow : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ModuloWindowReached := ModuloPosition >= (stMovModPrm.fPosition - fWindow) AND ModuloPosition <= (stMovModPrm.fPosition + fWindow) AND NotMoving;]]></ST>
      </Implementation>
    </Method>
    <Property Name="MotorTemp" Id="{3f75802a-fb7b-4946-8435-c27d13bb44d6}" FolderPath="Properties\">
      <Declaration><![CDATA[/// Actual motor temp. [°C]
{attribute 'monitoring' := 'call'}
PROPERTY MotorTemp : LREAL
]]></Declaration>
      <Get Name="Get" Id="{7815aabb-a5f7-42d7-88f4-070876b56a30}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[/// Actual motor temp. [°C]
MotorTemp := INT_TO_LREAL(stIn.iMotorTemperature) / 10;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="MoveAbs" Id="{d5d65a28-06de-400a-9174-f0480abc560b}" FolderPath="AxisCmdMethods\">
      <Declaration><![CDATA[/// Performs an absolute axis positioning using default parameter set.
/// This motion is capable to overlay (max. 2 parallel at one time)
{attribute 'object_name' := 'MoveAbs'}
METHOD MoveAbs : E_OperationResult
VAR_INPUT
	/// Position to move to
	fPosition: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// move axis abs

// init result pessimistic
MoveAbs := E_OperationResult.eOperationResult_NOk;

// if stopping or resetting is active return --> higher prio
IF eCommandExecute = E_MotionCommand.eMotionCommand_reset OR eCommandExecute = E_MotionCommand.eMotionCommand_stop THEN
	RETURN;
END_IF

stMovAbsPrm := stDefaultPrm.stMovAbsPrm;
stMovAbsPrm.fPosition := fPosition;

eCommandRequest := E_MotionCommand.eMotionCommand_moveAbs;
MoveAbs := E_OperationResult.eOperationResult_Ok;]]></ST>
      </Implementation>
    </Method>
