    </Method>
    <Method Name="M_ResolveDiagPrmArgs" Id="{28970538-6a87-466f-9b14-e02f9de57568}">
      <Declaration><![CDATA[/// resolves EC device diag parameter into T_Arg types for string formatting purposes
/// 	return value: success state
METHOD M_ResolveDiagPrmArgs : BOOL
VAR_IN_OUT
	aParameter: ARRAY[1..16] OF BYTE;
	arArg: ARRAY[1..10] OF T_Arg;
END_VAR
VAR
	ii: INT := 1;
	jj: INT := 1;
	nType: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// resolve diag param
WHILE (ii + 3) < 16 DO
	MEMCPY(ADR(nType), ADR(aParameter[ii]), 2); // ii points to type, bit 0…11 = prm type (12..15 = 0)
	ii := ii + 2; // now ii points to value
	arArg[jj].pData := ADR(aParameter[ii]);
	CASE nType OF
		16#0001: // bool
			arArg[jj].cbLen := 1;
			arArg[jj].eType := E_ArgType.ARGTYPE_BOOL;
		16#0002: // int8
			arArg[jj].cbLen := 1;
			arArg[jj].eType := E_ArgType.ARGTYPE_SINT;
		16#0003: // int16
			arArg[jj].cbLen := 2;
			arArg[jj].eType := E_ArgType.ARGTYPE_INT;
		16#0004: // int32
			arArg[jj].cbLen := 4;
			arArg[jj].eType := E_ArgType.ARGTYPE_DINT;
		16#0005: // uint8
			arArg[jj].cbLen := 1;
			arArg[jj].eType := E_ArgType.ARGTYPE_USINT;
		16#0006: // uint16
			arArg[jj].cbLen := 2;
			arArg[jj].eType := E_ArgType.ARGTYPE_UINT;
		16#0007: // uint32
			arArg[jj].cbLen := 4;
			arArg[jj].eType := E_ArgType.ARGTYPE_UDINT;
		16#0008: // real32
			arArg[jj].cbLen := 4;
			arArg[jj].eType := E_ArgType.ARGTYPE_REAL;
		16#0011: // real64
			arArg[jj].cbLen := 8;
			arArg[jj].eType := E_ArgType.ARGTYPE_LREAL;
		16#0015: // int64
			arArg[jj].cbLen := 8;
			arArg[jj].eType := E_ArgType.ARGTYPE_LARGE;
		16#001B: // uint64
			arArg[jj].cbLen := 8;
			arArg[jj].eType := E_ArgType.ARGTYPE_ULARGE;
	ELSE
		EXIT; // no more prm
	END_CASE
	
	ii := ii + UDINT_TO_INT(arArg[jj].cbLen); // now ii points to next type
	jj := jj + 1; // next arg
END_WHILE

M_ResolveDiagPrmArgs := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ResolveEL19xxText" Id="{155fa8af-19d6-4f09-b749-b95e21390ff7}">
      <Declaration><![CDATA[/// resolves EL19xx device text ID to clear text
/// 	return value: success state
METHOD M_ResolveEL19xxText : BOOL
VAR_INPUT
	nTextID: UINT;
END_VAR
VAR_IN_OUT
	aParameter: ARRAY[1..16] OF BYTE;
	sResult: T_MAXSTRING;
END_VAR
VAR
	arArg: ARRAY[1..10] OF T_Arg;
	fbFormat: FB_FormatString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[/// Messages extracted from Beckhoff EL19xx.xml (C:\TwinCAT\3.1\Config\Io\EtherCAT)
/// FileVersion="2", EtherCAT device description update: 8.11.2021

M_ResolveDiagPrmArgs(aParameter, arArg);

// map text id
CASE nTextID OF
	16#0001: sResult := 'Primary MC: GLOBAL_Fault with Code 0x%x and Additional Code 0x%x';
	16#0002: sResult := 'Primary MC: GLOBAL_Shutdown with Code 0x%x and Additional Code 0x%x';
	16#0003: sResult := 'Secondary MC: GLOBAL_Fault with Code 0x%x and Additional Code 0x%x';
	16#0004: sResult := 'Secondary MC: GLOBAL_Shutdown with Code 0x%x and Additional Code 0x%x';
	16#0005: sResult := 'Primary MC: Stored GLOBAL_Fault with Code 0x%x and Additional Code 0x%x';
	16#0006: sResult := 'Secondary MC: Stored GLOBAL_Fault with Code 0x%x and Additional Code 0x%x';
	16#0007: sResult := 'Diag-Message-Overflow: %d messages got lost';
	16#0008: sResult := 'Primary MC: the CRC of the FRAM Data was wrong (Diag-Code=%d)';
	16#0009: sResult := 'Secondary MC: the CRC of the FRAM Data was wrong (Diag-Code=%d)';
	16#0010: sResult := 'Reserved CfgData has to be zero st offset %d';
	16#0011: sResult := 'The password is wrong';
	16#0012: sResult := 'The user was not found';
	16#0013: sResult := 'The CRC of the login data does not match';
	16#0014: sResult := 'The serial number of the login data does not match';
	16#0015: sResult := 'The login watchdog has been expired';
	16#0016: sResult := 'The user was logged out before';
	16#0017: sResult := 'The user has not sufficient access rights';
	16#0018: sResult := 'The reserved area of the CfgData was not 0';
	16#0019: sResult := 'The CRC of the CfgData was wrong';
	16#001A: sResult := 'The user name is wrong at word offset 0x%x when changing the password';
	16#001B: sResult := 'The requested number of users is too big';
	16#001D: sResult := 'The user update flags are wrong at word offset 0x%x when changing the password';
	16#001E: sResult := 'The wrong user (user %d) is logged in when changing the password (user %d found in the received data)';
	16#0021: sResult := 'the maximum Global-Shutdown counter was exceeded in the Vendor Data (maximu value: %d, actual value: %d)';
	16#0030: sResult := 'Sync Manager 2 Address (0x%x) is invalid, minimum value = 0x%x, maximum value = 0x%x';
	16#0031: sResult := 'Sync Manager 3 Address (0x%x) is invalid, minimum value = 0x%x, maximum value = 0x%x';
	16#0032: sResult := 'Sync Manager 4 Address (0x%x) is invalid, minimum value = 0x%x, maximum value = 0x%x';
	16#0033: sResult := 'Sync Manager 5 Address (0x%x) is invalid, minimum value = 0x%x, maximum value = 0x%x';
	16#0034: sResult := 'Sync Manager 2 Size (%d) is invalid, minimum value = %d, maximum value = %d';
	16#0035: sResult := 'Sync Manager 3 Size (%d) is invalid, minimum value = %d, maximum value = %d';
	16#0036: sResult := 'Sync Manager 4 Size (%d) is invalid, minimum value = %d, maximum value = %d';
	16#0037: sResult := 'Sync Manager 5 Size (%d) is invalid, minimum value = %d, maximum value = %d';
	16#0038: sResult := 'Sync Manager %d Settings (Offset 4-7) are invalid, expected values = 0x%x, 0x%x';
	16#0044: sResult := 'Sync Manager 6 Address (0x%x) is invalid, minimum value = 0x%x, maximum value = 0x%x';
	16#0045: sResult := 'Sync Manager 7 Address (0x%x) is invalid, minimum value = 0x%x, maximum value = 0x%x';
	16#0048: sResult := 'Sync Manager 6 Size (%d) is invalid, minimum value = %d, maximum value = %d';
	16#0049: sResult := 'Sync Manager 7 Size (%d) is invalid, minimum value = %d, maximum value = %d';
	16#0101: sResult := 'Primary MC: Completed RAM TEST: Starttime: 0x%x and Stoptime: 0x%x . The calculated timediff is 0x%x.';
	16#0102: sResult := 'Secondary MC: Completed RAM TEST: Starttime: 0x%x and Stoptime: 0x%x . The calculated timediff is 0x%x.';
	16#0103: sResult := 'C1 MCTEST Info: Arg1: 0x%x, Arg2: 0x%x, Arg3: 0x%x.';
	16#0104: sResult := 'C2 MCTEST Info: Arg1: 0x%x, Arg2: 0x%x, Arg3: 0x%x.';
	16#0115: sResult := 'Controller %d:  Maximum temperature exceeded. Temperature is 0x%x, should be &lt;= 0x%x.';
	16#0116: sResult := 'Controller %d:  Minimum temperature alert. Temperature is 0x%x, should be &gt;= 0x%x.';
	16#0117: sResult := 'Controller %d: Temperautre difference too high. Difference is %d, should be &lt;= %d.';
	16#0118: sResult := 'Controller %d:  Maximum voltage alert (Partner_VCC). Voltage is 0x%x, should be &lt;= 0x%x.';
	16#0119: sResult := 'Controller %d:  Minimum voltage alert (Partner_VCC). Voltage is 0x%x, should be &gt;= 0x%x.';
	16#011A: sResult := 'Controller %d:  Maximum voltage alert (ECAT_VCC). Voltage is 0x%x, should be &lt;= 0x%x.';
	16#011B: sResult := 'Controller %d:  Minimum voltage alert (ECAT_VCC). Voltage is 0x%x, should be &gt;= 0x%x.';
	16#011E: sResult := 'Controller %d:  Timer Tick Difference is too high. Difference is 0x%x, should be &gt;= 0x%x.';
	16#011F: sResult := 'Controller %d:  Minimum value alert (Individual ADC Check). Channel parameter = %d. Actual value is 0x%x.';
	16#0120: sResult := 'Controller %d:  Maximum value alert (Individual ADC Check). Channel parameter = %d. Actual value is 0x%x.';
	16#0121: sResult := 'Module Shutdown due to minimum  value alert (Individual ADC Check). Channel parameter = %d.';
	16#1000: sResult := 'The size of the safe User Parameter is too small (%d), the expected size is %d';
	16#1001: sResult := 'The Vendor-ID (%d) is unequal the expected value of %d';
	16#1002: sResult := 'The Product-Code (%d) is unequal the expected value of %d';
	16#1003: sResult := 'The reserved data of the SafeOut User Parameter of module %d at byte offset 0x%x has to be 0';
	16#1004: sResult := 'The reserved data of the SafeIn User Parameter of module %d at byte offset 0x%x has to be 0';
	16#1005: sResult := 'The standard outputs of module %d should be enabled but the Sync-Manager 6 is not configured or enabled correctly';
	16#1006: sResult := 'The FASTSTDOUT mode of the standard outputs of module %d is not supported';
	16#1007: sResult := 'The SAFEOUT-Module-Number (%d) for the ExternalPulseDetection of the SAFEIN-Module %d is wrong, the allowed range is 1-%d';
	16#1008: sResult := 'The SAFEOUT-Channel-Number (%d) for the ExternalPulseDetection of the SAFEIN-Module %d is wrong, the allowed range is 1-%d';
	16#1009: sResult := 'The Bumper-Mode %d is not supported for SAFEIN-Module %d';
	16#100A: sResult := 'The version of the Product-Code (0x%x) is unequal the expected value of 0x%x';
	16#1010: sResult := 'The default Project CRC is wrong, the received value is 0x%x';
	16#1020: sResult := 'The watchdog for the Standard Outputs was expired';
	16#1030: sResult := 'The size of the safe User Parameter is too big (%d), the expected size is %d';
	16#15C1: sResult := 'SAFEIN-Module %d: Module Fault due to Fault Link';
	16#2001: sResult := 'The %d. connection has received an invalid FSoE-Cmd in state CONNECTION';
	16#2002: sResult := 'The %d. connection has received an unknown FSoE-Cmd in state CONNECTION';
	16#2003: sResult := 'The %d. connection has received an invalid FSoE-ConnID in state CONNECTION';
	16#2004: sResult := 'The %d. connection has received an invalid FSoE-CRC in state CONNECTION';
	16#2005: sResult := 'The FSoE-Watchdog of the %d. connection has been expired in state CONNECTION';
	16#2006: sResult := 'On the %d. connection the received  FSoE-Address (0x%x) does not match with the expected FSoE-Address (0x%x)';
	16#2007: sResult := 'On the %d. connection the received connection data do not match with the sent values';
	16#200E: sResult := 'A Module fault was detected on the %d. connection in state CONNECTION';
	16#2011: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 1 was received which means that the communication partner has received an invalid FSoE-Cmd';
	16#2012: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 2 was received which means that the communication partner has received an unknown FSoE-Cmd';
	16#2013: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 3 was received which means that the communication partner has received an invalid FSoE-ConnID';
	16#2014: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 4 was received which means that the communication partner has received an invalid FSoE-CRC';
	16#2015: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 5 was received which means that the FSoE-Watchdog has been expired in  the communication partner';
	16#2016: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 6 was received which means that the communication partner has received an invalid FSoE-Address';
	16#2017: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 7 was received which means that the communication partner has received connection data do not match with the sent values';
	16#2018: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 8 was received which means that the communication partner has received an invalid communication parameter length';
	16#2019: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 9 was received which means that the communication partner has received an invalid FSoE Watchdog';
	16#201A: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 10 was received which means that the communication partner has received an invalid application parameter length';
	16#201B: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 11 was received which means that the communication partner has received invalid application parameter data';
	16#201C: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 12 was received';
	16#201D: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 13 was received';
	16#201E: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 14 was received which means that the communication partner has detected a module fault';
	16#201F: sResult := 'On the %d. connection in state CONNECTION a FSoE-Reset with Error-Code 0x%x was received';
	16#2041: sResult := 'The %d. connection has received an invalid FSoE-Cmd in state PARAMETER';
