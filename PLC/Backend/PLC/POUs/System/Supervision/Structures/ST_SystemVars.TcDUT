<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <DUT Name="ST_SystemVars" Id="{6f9bc2f0-a0c0-476c-a469-1618d69110a6}">
    <Declaration><![CDATA[TYPE ST_SystemVars :
STRUCT
	/// global program cycle counter
	nStepCounter				:UDINT;
	
	/// path of the actual method
	wsActualMethod				:WSTRING(255);
	
	/// current system time
	dtNow						:DT;
	stNow						:TIMESTRUCT;
	
	/// current system time in string format	
	sTimeString					:STRING;
	
	/// PLC system informations
	stPlcSystemInfo				:ST_PlcSystemInfo;
	
	/// default pulse struct
	stPulse						:ST_DefaultPulse;
		
	/// Default epsilon (e.g.: positioning window)
	fEpsilon					:LREAL := 1E-5;
	/// Empty string value
	sEmpty						:STRING(1);

END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>