END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Position < 0 OR Position > MAX_CARRIERPLACES OR NOT _data.CarriersEnabled[Position] THEN
   RETURN;
END_IF

GetCarrierRefAt REF= _data.CarriersData[Position];
]]></ST>
      </Implementation>
    </Method>
