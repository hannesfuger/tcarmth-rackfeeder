    <Method Name="M_StartPolling" Id="{29843b7c-f816-4618-bdc0-fe722b21d1b0}">
      <Declaration><![CDATA[/// start auto updating all
/// 	return value: success state
METHOD M_StartPolling : BOOL
VAR_INPUT
	/// time for internal auto update (T#0S...auto update is off)
	tAutoUpdate: TIME := TIME#0ms;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_StopPolling();
tAutoUpdateAll := tAutoUpdate;
M_StartPolling := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_StopPolling" Id="{dc25d589-6952-49e5-b1d7-ffe731e8253f}">
      <Declaration><![CDATA[/// stop auto updating all
/// 	return value: success state
METHOD M_StopPolling : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tAutoUpdateAll := T#0S;
tAutoUpdateSlaveState := T#0S;
tAutoUpdatePAIInfo := T#0S;
tAutoUpdateDiagHistory := T#0S;
M_StopPolling := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateError" Id="{a8f9fcee-7f59-4d05-ac32-01438ddff87e}">
      <Declaration><![CDATA[/// updates the error flag and id
/// 	return value: summary error
METHOD PRIVATE M_UpdateError : BOOL
VAR_INPUT
	bErr: BOOL;
	nId: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bErr THEN
	bError := TRUE;
	nErrorId := nId;
END_IF

M_UpdateError := bError;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_WfGetDiagHistory" Id="{ee413f30-788f-4dff-8fbf-4d4719293334}">
      <Declaration><![CDATA[METHOD PRIVATE M_WfGetDiagHistory : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// workflow read diag
CASE nStepGetDiagHistory OF
	0: // idle
	
	10: // start reading actual time stamp
		fbEcCoeSdoReadEx.nIndex := nIdxActTimeStamp;
		fbEcCoeSdoReadEx.nSubIndex := 0;
		fbEcCoeSdoReadEx.pDstBuf := ADR(nDevieTimeStamp);
		fbEcCoeSdoReadEx.cbBufLen := SIZEOF(nDevieTimeStamp);
		fbEcCoeSdoReadEx.bExecute := TRUE;
		nStepGetDiagHistory := 20;
		
	20: // wait reading actual time stamp completed
		fbEcCoeSdoReadEx.bExecute := FALSE;
		IF NOT fbEcCoeSdoReadEx.bBusy THEN
			IF NOT fbEcCoeSdoReadEx.bError THEN
				dtUpTimeStamp := dtNow - F_EcDeviceTimeStampToTime(nDevieTimeStamp);
			END_IF			
			M_UpdateError(fbEcCoeSdoReadEx.bError, fbEcCoeSdoReadEx.nErrId);
			nStepGetDiagHistory := 30;
		END_IF
		
	30:  // start reading diag
		fbEcCoeSdoReadEx.nIndex := nIdxDiagHistory;
		fbEcCoeSdoReadEx.nSubIndex := 1;
		fbEcCoeSdoReadEx.pDstBuf := ADR(stDiagHistory);
		fbEcCoeSdoReadEx.cbBufLen := SIZEOF(stDiagHistory);
		fbEcCoeSdoReadEx.bExecute := TRUE;
		nStepGetDiagHistory := 40;
		
	40: // wait reading diag completed
		fbEcCoeSdoReadEx.bExecute := FALSE;
		IF NOT fbEcCoeSdoReadEx.bBusy THEN
			M_UpdateError(fbEcCoeSdoReadEx.bError, fbEcCoeSdoReadEx.nErrId);
			nStepGetDiagHistory := 0;
		END_IF
END_CASE

fbEcCoeSdoReadEx(
	sNetId := F_CreateAmsNetId(stAdsAddr.netId), 
	nSlaveAddr := nSlaveAddress,
	bCompleteAccess := TRUE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_WfGetPAIInfoData" Id="{7b5079dc-3156-4c17-9efb-310e10f5cf19}">
      <Declaration><![CDATA[METHOD PRIVATE M_WfGetPAIInfoData : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// workflow read PAI info
CASE nStepGetPAIInfo OF
	0: // idle
	
	10: // start reading PAI info
		fbCoeReadPAIInfo.bExecute := TRUE;
		nStepGetPAIInfo:=20;
		
	20: // wait reading PAI info completed
		fbCoeReadPAIInfo.bExecute := FALSE;
		IF NOT fbCoeReadPAIInfo.bBusy THEN
			M_UpdateError(fbCoeReadPAIInfo.bError, fbCoeReadPAIInfo.nErrId);
			nStepGetPAIInfo := 0;
		END_IF
END_CASE

fbCoeReadPAIInfo(
	sNetId:= F_CreateAmsNetId(stAdsAddr.netId), 
	nSlaveAddr:= nSlaveAddress, 
	nSubIndex:= 1, 
	nIndex:= nIdxPAIInfo, 
	pDstBuf:= ADR(stPAIInfoData), 
	cbBufLen:= SIZEOF(stPAIInfoData),
	bCompleteAccess:= TRUE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_WfGetSlaveState" Id="{79c36f20-b180-4508-b3a2-829d8999e6b1}">
      <Declaration><![CDATA[METHOD PRIVATE M_WfGetSlaveState : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// workflow read slave state
CASE nStepGetState OF
	0: // idle
	
	10: // start reading actual slave state
		fbGetSlaveState.bExecute := TRUE;
		nStepGetState := 20;
		
	20: // wait reading actual slave state completed
		fbGetSlaveState.bExecute := FALSE;
		IF NOT fbGetSlaveState.bBusy THEN
			M_UpdateError(fbGetSlaveState.bError, fbGetSlaveState.nErrId);
			IF NOT fbGetSlaveState.bError THEN
				stSlaveState := F_ConvSlaveStateToBitsEx(fbGetSlaveState.state);
			END_IF			
			nStepGetState := 0;				
		END_IF
END_CASE

fbGetSlaveState(
	sNetId := F_CreateAmsNetId(stAdsAddr.netId), 
	nSlaveAddr := nSlaveAddress);]]></ST>
      </Implementation>
    </Method>
