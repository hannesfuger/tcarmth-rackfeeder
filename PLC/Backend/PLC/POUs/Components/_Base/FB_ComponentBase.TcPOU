      </Get>
    </Property>
    <Property Name="Logger" Id="{a0145483-d535-4972-887d-7acf62e3e91b}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY Logger : I_Logger
]]></Declaration>
      <Set Name="Set" Id="{d2c457c0-a0fd-4903-ad9e-bc9cdf318121}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ILog := Logger;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="M_InitComponentBase" Id="{08a1113d-250e-48ea-9ee2-595e5c1dfb97}">
      <Declaration><![CDATA[METHOD M_InitComponentBase : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// set up default logger and event handler
ILog := Services.ILog;
IEvent := Services.fbEventHandler;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_InitComponentBaseEx" Id="{d65de655-88e1-4cce-aad2-28b5a41d4593}">
      <Declaration><![CDATA[METHOD M_InitComponentBaseEx : BOOL
VAR_INPUT
	ILogger			: I_Logger;
	IEventHandler	: I_EventHandler;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ILog := ILogger;
IEvent := IEventHandler;

]]></ST>
      </Implementation>
    </Method>
    <Property Name="Name" Id="{97507556-cbd6-4656-a4b4-7ef03ea2ff1e}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY Name : ST_Text
]]></Declaration>
      <Get Name="Get" Id="{0e45fe35-49fc-47f1-97fe-c7f0eb7a6261}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
