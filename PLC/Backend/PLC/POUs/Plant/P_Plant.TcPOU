<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="P_Plant" Id="{865ed7b7-2f90-4264-9297-540b9e5cb01c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Plant
VAR_INPUT	
	/// - stations, modules and components -
	aIStaton			: ARRAY[0..E_Station.eStation_nMaxIdx] OF IStation;
	aIModule			: ARRAY[0..E_Module.eModule_nMaxIdx] OF IModule;
	aIComponent			: ARRAY[0..E_Component.eComponent_nMaxIdx] OF ITFComponent;
END_VAR
VAR
	bInitSettingPlant		: BOOL;
	bInitSettingProduct		: BOOL;
	bInitSettingProduction	: BOOL;
	
	// plant empty... 
	bPlantEmptyActiv	: BOOL;
	bPlantEmpty			: BOOL;
	// logger, notification handler
	ILog				: I_Logger;
	IEvent				: I_EventHandler;
	
	/// private var's
	ii					: INT;
	b1stShot			: BOOL;
	tonDelay			: TON;
	
	/// clear text info
	aSClearText			: ARRAY[0..eLanguage_maxIdx] OF T_MaxString;
	bInitCounter		: BOOL;
	
	stSettingsPlantBackup		: ARRAY[0..E_PlantSettings.ePlantSetting_nMaxIdx] OF ST_Data_Item;
	stSettingsProductBackup		: ARRAY[0..E_ProductSettings.eProductSettings_nMaxIdx] OF ST_Data_Item;
	stSettingsProductionBackup	: ARRAY[0..E_ProductionSettings.eProductionSettings_nMaxIdx] OF ST_Data_Item;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[///
/// Plant
///

// run 
aSClearText[EN] := 'Manage settings for plant, product and production';
M_SettingsPlant();
M_SettingsProduct();
M_SettingsProduction();

aSClearText[EN] := 'Calling modules...';
FOR ii := 0 TO E_Module.eModule_nMaxIdx DO
	IF aIModule[ii] = 0 THEN
		CONTINUE;
	END_IF
	
	aIModule[ii].EmergencyStopOk := P_Safety.EmergencyStopOk;
	aIModule[ii].M_Run(); // station run is called by its module
END_FOR

aSClearText[EN] := 'Calling stations, collect infos...';
b1stShot := TRUE;
FOR ii := 0 TO E_Station.eStation_nMaxIdx DO
	IF aIStaton[ii] = 0 THEN
		CONTINUE;
	END_IF
	
	F_AND_REF_EX(stGlobalModuleInfo.bStation_All_Auto, aIStaton[ii].OpMode = E_OpMode.eOpMode_auto, b1stShot);
	F_OR_REF_EX(stGlobalModuleInfo.bStation_Any_Step, aIStaton[ii].OpMode = E_OpMode.eOpMode_step, b1stShot);
	F_OR_REF_EX(stGlobalModuleInfo.bStation_Any_Manual, aIStaton[ii].OpMode = E_OpMode.eOpMode_manual, b1stShot);
	
	F_OR_REF_EX(stGlobalModuleInfo.bStation_Any_Error, aIStaton[ii].State = E_ComponentState.eComponentState_error, b1stShot);
	F_OR_REF_EX(stGlobalModuleInfo.bStation_Any_Warning, aIStaton[ii].State = E_ComponentState.eComponentState_warning, b1stShot);
	F_OR_REF_EX(stGlobalModuleInfo.bStation_Any_Info, aIStaton[ii].State = E_ComponentState.eComponentState_info, b1stShot);
	
	F_AND_REF_EX(stGlobalModuleInfo.bStation_All_Started, (aIStaton[ii].OpMode = E_OpMode.eOpMode_auto OR aIStaton[ii].OpMode = E_OpMode.eOpMode_step) AND aIStaton[ii].RunCycle, b1stShot);
	F_AND_REF_EX(stGlobalModuleInfo.bStation_All_Stopped, aIStaton[ii].Stopped, b1stShot);
	F_AND_REF_EX(stGlobalModuleInfo.bStation_All_InHome, aIStaton[ii].InHome, b1stShot);
	F_OR_REF_EX(stGlobalModuleInfo.bStation_Any_Homing, aIStaton[ii].Homing, b1stShot);
	
	b1stShot := FALSE;
END_FOR

aSClearText[EN] := 'Calling stations, plant components...';
FOR ii := 0 TO E_Component.eComponent_nMaxIdx DO
	IF aIComponent[ii] = 0 THEN
		CONTINUE;
	END_IF
	
	aIComponent[ii].Run();
END_FOR

aSClearText[EN] := 'Calling counter, check reset...';
IF HMI.stHmi.stIn.stMain.stButton_Reset.bClick THEN
	M_Reset();
END_IF

M_Counter();

IF bPlantEmptyActiv THEN
	IEvent.Select(Tc_Events.PlantEventClass.InfoEvent)
		  .ArgSetWString(CONST.stTextListGlobal.stText_emptymodeactive.wsName)
		  .Raise();
END_IF]]></ST>
    </Implementation>
