IF fbMovVel1.Execute AND NOT fbMovVel1.Busy THEN
	IF fbMovVel1.Error AND (fbMovVel1.ErrorID <> 17022) THEN
		nErrorId := fbMovVel1.ErrorID;
		M_SetLocalErrorS('engine constant velocity (FB1): ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbMovVel1.Execute := FALSE;
END_IF
IF fbMovVel2.Execute AND NOT fbMovVel2.Busy THEN
	IF fbMovVel2.Error AND (fbMovVel2.ErrorID <> 17022) THEN
		nErrorId := fbMovVel2.ErrorID;
		M_SetLocalErrorS('engine constant velocity (FB2): ErrId: ', TO_STRING(nErrorId));
	END_IF
	fbMovVel2.Execute := FALSE;
END_IF

// return if other command active
