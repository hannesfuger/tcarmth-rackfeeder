        </Implementation>
      </Get>
      <Set Name="Set" Id="{a9351200-a99a-4427-b7f4-b8a36d069494}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[stOut.fValue := Value;]]></ST>
        </Implementation>
      </Set>
    </Property>
