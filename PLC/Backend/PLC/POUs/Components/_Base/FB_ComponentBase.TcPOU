<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ComponentBase" Id="{c18f24bd-a664-4b00-87c6-35388a9e2c13}" SpecialFunc="None">
    <Declaration><![CDATA[/// Abstract base FB for components
{attribute 'enable_dynamic_creation' := ''}
{attribute 'reflection' := ''}
FUNCTION_BLOCK FB_ComponentBase IMPLEMENTS ITFComponent
VAR
	ii				: INT;
	/// Unique ID of this instance (cam be used as index: P_ComponentPool.aComponents[iID]...)
	iId				: INT;
	/// component type
	eTyp			: E_ComponentType;
	/// component active flag
	bActive			: BOOL;
	/// component state
	eState			: E_ComponentState;
	// Logger
	ILog			: I_Logger;
	/// path of this FB (e.g. for log: P_ComponentPool.fbVirtualMaster)	
    {attribute 'instance-path'} 
    {attribute 'noinit'}
    {attribute 'hide'} 
	sPath			: STRING;
	// object id
	wsObjectId		: WSTRING;

	/// component name
	stName			: ST_Text;
	/// component name
	sBMK			: STRING;
	/// clear text info
	//aSClearText		: ARRAY[0..eLanguage_maxIdx] OF T_MaxString;
	aSClearText		: ST_Text;//T_MaxString;
	
	/// last error debug info
	sLastError		: T_MaxString;
	
	// event handler & source info
	IEvent			: I_EventHandler;
	TcSourceInfo	: FB_TcSourceInfo;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[///
/// Abstract base FB for components
/// TP/www.rmth.at/11.2014
/// ]]></ST>
    </Implementation>
    <Folder Name="Log" Id="{d60d0229-345b-4f21-a527-897b071ec85e}" />
    <Folder Name="Properties" Id="{d39cf9c1-a479-4c65-8832-30628ef67dbc}" />
    <Property Name="Active" Id="{ad08f73b-d076-4ffc-a47f-109b9002f3f0}" FolderPath="Properties\">
      <Declaration><![CDATA[/// Get's or set's a value indicating whether this component is active or not.
{attribute 'monitoring':='call'}
PROPERTY Active : BOOL
]]></Declaration>
      <Get Name="Get" Id="{36bc5417-a1df-428f-8558-ccd48ad6e7b2}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Active := bActive;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{91a00653-11d6-478d-b972-77e3e4eb2ccf}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[bActive := Active;
aSClearText := F_CreateDynTextDefaultS(SEL(bActive, 'INACTIVE!', 'ACTIVE!'));]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="AddLogErr" Id="{1fa04579-53a4-4bf7-9485-fed4b63a80f6}" FolderPath="Log\">
      <Declaration><![CDATA[METHOD PROTECTED AddLogErr
VAR_INPUT
	sLog : T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// chk
IF ILog = 0 THEN
	RETURN;
END_IF

ILog.AddLog(sLog, WSTRING_TO_STRING(stName.wsName), E_LogLevel.eLogLevel_err);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddLogInf" Id="{8f5dc2d6-63af-4a66-8788-1150161b9ec3}" FolderPath="Log\">
      <Declaration><![CDATA[METHOD PROTECTED AddLogInf
VAR_INPUT
	sLog : T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// chk
IF ILog = 0 THEN
	RETURN;
END_IF

ILog.AddLog(sLog, WSTRING_TO_STRING(stName.wsName), E_LogLevel.eLogLevel_info);]]></ST>
      </Implementation>
    </Method>
    <Method Name="AddLogWrn" Id="{c5dba76f-883c-47df-a4a3-7f425d74ab1f}" FolderPath="Log\">
      <Declaration><![CDATA[METHOD PROTECTED AddLogWrn
VAR_INPUT
	sLog : T_MaxString;
END_VAR
VAR

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// chk
IF ILog = 0 THEN
	RETURN;
END_IF

ILog.AddLog(sLog, WSTRING_TO_STRING(stName.wsName), E_LogLevel.eLogLevel_warn);]]></ST>
      </Implementation>
    </Method>
    <Property Name="BMK" Id="{3e8ee465-5189-4f2f-9d15-0d6a660f5497}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
PROPERTY BMK : STRING
]]></Declaration>
      <Get Name="Get" Id="{40debf0c-a597-4287-8751-5255603a498d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[BMK := sBMK;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{522db787-61e2-4748-b40e-ae4b76e7df74}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[sBMK := BMK;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ClearText" Id="{56ead6a6-eff4-4858-8e9e-da8349489d0c}" FolderPath="Properties\">
      <Declaration><![CDATA[/// Get's value representing the component state.
{attribute 'monitoring':='call'}
PROPERTY ClearText : WSTRING(255)
]]></Declaration>
      <Get Name="Get" Id="{b9a876a4-0bf3-4831-bd3b-742033eed1fc}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ClearText := aSClearText.wsName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ID" Id="{7adf225e-7442-4f77-874e-8de91565912f}" FolderPath="Properties\">
      <Declaration><![CDATA[/// Unique component ID (cam be used as index: P_ComponentPool.aComponents[eID]...)
{attribute 'monitoring':='call'}
PROPERTY ID : INT
]]></Declaration>
      <Get Name="Get" Id="{eb2f488e-56f2-446e-be23-411ca4a9afe8}">
        <Declaration><![CDATA[]]></Declaration>
