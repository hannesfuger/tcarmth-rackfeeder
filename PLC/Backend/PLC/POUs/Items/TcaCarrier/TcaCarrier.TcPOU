    <Method Name="RefreshStatus" Id="{45b28ecb-4270-41ad-aa1b-7502953923ca}">
      <Declaration><![CDATA[METHOD RefreshStatus : BOOL
VAR
	ni			: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[MEMSET(ADR(_WorkpiecesStatus), 0, SIZEOF(_WorkpiecesStatus));

_PrimaryStatus := eTcaWorkpieceStatus.undefined;
_SecondaryStatus := eTcaWorkpieceStatus.undefined;
_AllFinished := _data.Enabled;
_UnFinished := FALSE;

FOR ni := 0 TO MAX_WORKPIECEPLACES DO
	
	IF NOT _data.WorkpiecesEnabled[ni] THEN
		CONTINUE;
	END_IF
	
	IF _data.WorkpiecesData[ni].Exist AND
	   NOT _data.WorkpiecesData[ni].Error AND
       NOT _data.WorkpiecesData[ni].CurrentStatus <> _data.WorkpiecesData[ni].RequestStatus THEN
		_AllFinished := FALSE;
		_UnFinished := TRUE;
	END_IF
	
	_WorkpiecesStatus[_data.WorkpiecesData[ni].CurrentStatus] := _WorkpiecesStatus[_data.WorkpiecesData[ni].CurrentStatus] + 1;
	
	IF _WorkpiecesStatus[_data.WorkpiecesData[ni].CurrentStatus] >= _WorkpiecesStatus[_PrimaryStatus] THEN
		_SecondaryStatus := _PrimaryStatus;
		_PrimaryStatus := _data.WorkpiecesData[ni].CurrentStatus;
	END_IF

END_FOR


IF _PrimaryStatus = _SecondaryStatus THEN
	_SecondaryStatus := eTcaWorkpieceStatus.undefined;
END_IF
]]></ST>
      </Implementation>
    </Method>
