	16#80F4: sResult := 'SAFEIN: Wrong parameters detected for Module:0x%x / Channel:0x%x. Please check parameters!';		
	ELSE 
		sResult := UINT_TO_STRING(nTextID);
END_CASE

fbFormat(sFormat := sResult, 
		arg1 := arArg[1],
		arg2 := arArg[2], 
		arg3 := arArg[3], 
		arg4 := arArg[4], 
		arg5 := arArg[5], 
		arg6 := arArg[6], 
		arg7 := arArg[7], 
		arg8 := arArg[8], 
		arg9 := arArg[9], 
		arg10 := arArg[10], 
		sOut => sResult);

M_ResolveEL19xxText := TRUE;]]></ST>
