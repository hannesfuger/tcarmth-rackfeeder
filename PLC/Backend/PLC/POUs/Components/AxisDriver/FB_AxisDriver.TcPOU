{attribute 'object_name' := 'HaltEx'}
METHOD HaltEx : E_OperationResult
VAR_INPUT
	/// Parameter set to use
	stHaltParameter: ST_AxisHaltParameter;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// halt axis

HaltEx := THIS^.Halt();

IF HaltEx = E_OperationResult.eOperationResult_Ok THEN
	stHaltPrm := stHaltParameter;
END_IF]]></ST>
      </Implementation>
    </Method>
