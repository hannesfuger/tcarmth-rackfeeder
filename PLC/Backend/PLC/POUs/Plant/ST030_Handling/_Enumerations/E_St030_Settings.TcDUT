<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_St030_Settings" Id="{5a44ee9d-0401-45eb-b4e0-71a5e545eba4}">
    <Declaration><![CDATA[//{attribute 'qualified_only'}
//{attribute 'strict'}
{attribute 'to_string'}
{attribute 'to_wstring'}
TYPE E_St030_Settings :
(
	//eSt030_Settings_none := 0,
	
	eSt030_Settings_Station_Deaktiv,	// Station deaktivieren
	eSt030_Settings_Autohome,			// automatic home with start button
	
	eSt030_Settings_XHomeSpeed,			// Homing-Geschwindigkeit X [mm/s]
	eSt030_Settings_XJogSpeed,			// Tippgeschwindigkeit X [mm/s]
	eSt030_Settings_XWorkSpeed,			// Automatik-Geschwindigkeit X [mm/s]
	
	eSt030_Settings_YHomeSpeed,			// Homing-Geschwindigkeit Y [mm/s]
	eSt030_Settings_YJogSpeed,			// Tippgeschwindigkeit Y [mm/s]
	eSt030_Settings_YWorkSpeed,			// Automatik-Geschwindigkeit Y [mm/s]
	
	eSt030_Settings_ZHomeSpeed,			// Homing-Geschwindigkeit Z [mm/s]
	eSt030_Settings_ZJogSpeed,			// Tippgeschwindigkeit Z [mm/s]
	eSt030_Settings_ZWorkSpeed,			// Automatik-Geschwindigkeit Z [mm/s]
	
	eSt030_Settings_AxisRefPosX,		// reference pos axis HG X
	eSt030_Settings_AxisRefPosY,		// reference pos axis HG Y
	eSt030_Settings_AxisRefPosZ,		// reference pos axis HG Z
	
	eSt030_Settings_XPosHome,			// Homeposition X [mm]
	eSt030_Settings_YPosHome,			// Homeposition Y [mm]
	eSt030_Settings_ZPosHome,			// Homeposition Z [mm]

	
	eSt030_Settings_XPosOv2Rp1,			// Teach-Position, Ofen 2, RP 1 X [mm]
	eSt030_Settings_YPosOv2Rp1,			// Teach-Position, Ofen 2, RP 1 Y [mm]
	eSt030_Settings_ZPosOv2Rp1,			// Teach-Position, Ofen 2, RP 1 Z [mm]

	eSt030_Settings_XPosOv2Rp2,			// Teach-Position, Ofen 2, RP 2 X [mm]
	eSt030_Settings_YPosOv2Rp2,			// Teach-Position, Ofen 2, RP 2 Y [mm]
	eSt030_Settings_ZPosOv2Rp2,			// Teach-Position, Ofen 2, RP 2 Z [mm]
	
	
	/// has to be set to last index for array bounds!
	eSt030_Settings_nMaxIdx
);
END_TYPE
]]></Declaration>
  </DUT>
