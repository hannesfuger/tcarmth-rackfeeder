PROPERTY PRIVATE OvenSegmentHeight : LREAL]]></Declaration>
      <Get Name="Get" Id="{97c32d4a-2502-405c-b4ff-1907d30eaa5c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
