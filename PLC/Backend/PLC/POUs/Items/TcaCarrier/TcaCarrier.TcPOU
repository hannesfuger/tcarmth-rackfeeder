    <Method Name="EmptyCarrier" Id="{85f448f9-c36a-410e-97a9-55abbf900e50}" FolderPath="Operations\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable'}
METHOD EmptyCarrier : TcaCarrierData
VAR
	_i			: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_data.Enabled := TRUE;
	
FOR _i := 0 TO MAX_WORKPIECEPLACES DO	
	
	IF NOT _data.WorkpiecesEnabled[_i] THEN
		RETURN;
	END_IF	

	_data.WorkpiecesData[_i].Error := FALSE;
	_data.WorkpiecesData[_i].Logging := "";	// TIMESTAMP WIT MESSAGE
	_data.WorkpiecesData[_i].SerialNumber := '';
	_data.WorkpiecesData[_i].CurrentStatus := eTcaWorkpieceStatus.undefined;	
	_data.WorkpiecesData[_i].InitialStatus := _config.InitialStatus;
	_data.WorkpiecesData[_i].RequestStatus := _config.RequestStatus;
	
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FindPlace" Id="{6021ca1e-a1ef-4ea5-9e46-c898a3806339}" FolderPath="Functions\">
      <Declaration><![CDATA[METHOD FindPlace : REFERENCE TO TcaWorkpieceData //-1..no Position found

VAR_INPUT
	Status		: eTcaWorkpieceStatus;
END_VAR

VAR
	ni				: INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FindPlace REF= 0;
FOR ni := 0 TO MAX_WORKPIECEPLACES DO
	
	IF NOT _data.WorkpiecesEnabled[ni] THEN
		CONTINUE;
	END_IF	
	
	IF _data.WorkpiecesData[ni].Error THEN
		CONTINUE;
	END_IF	

	IF _data.WorkpiecesData[ni].CurrentStatus = Status OR Status < eTcaWorkpieceStatus.undefined THEN	   
		FindPlace REF= _data.WorkpiecesData[ni];		
	END_IF	
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="FinishCarrier" Id="{ecbb6cac-2de8-4011-a307-b011b9d38b1b}" FolderPath="Operations\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable'}
METHOD FinishCarrier : TcaCarrierData
VAR
	_i			: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_data.Enabled := TRUE;
	
FOR _i := 0 TO MAX_WORKPIECEPLACES DO	
	
	IF NOT _data.WorkpiecesEnabled[_i] THEN
		RETURN;
	END_IF	

	_data.WorkpiecesData[_i].Error := FALSE;
	_data.WorkpiecesData[_i].Logging := "";	// TIMESTAMP WIT MESSAGE
	_data.WorkpiecesData[_i].SerialNumber := '';
	_data.WorkpiecesData[_i].CurrentStatus := config.RequestStatus;	
	_data.WorkpiecesData[_i].InitialStatus := _config.InitialStatus;
	_data.WorkpiecesData[_i].RequestStatus := _config.RequestStatus;
	
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetPlaceReference" Id="{c781c58b-59de-49f8-ac75-8ffb97aab0ac}" FolderPath="Functions\">
      <Declaration><![CDATA[METHOD GetPlaceReference : REFERENCE TO TcaWorkpieceData
VAR_INPUT
	IndexNr		: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF IndexNr < 0 OR IndexNr > MAX_WORKPIECEPLACES THEN
	RETURN;
END_IF

GetPlaceReference REF= _data.WorkpiecesData[IndexNr];]]></ST>
      </Implementation>
    </Method>
