      <LineId Id="409" Count="0" />
    </LineIds>
    <LineIds Name="FB_Device_Ui.A_StateMapping">
      <LineId Id="4" Count="0" />
      <LineId Id="6" Count="1" />
      <LineId Id="5" Count="0" />
      <LineId Id="2" Count="1" />
      <LineId Id="1" Count="0" />
    </LineIds>
  </POU>
