    <Method Name="DisableCarriers" Id="{545a5fe0-56c1-4d98-8aa8-0aca9941c854}" FolderPath="Operations\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable'}
METHOD DisableCarriers
VAR
	_i :INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//MEMSET(ADR(_data.CarriersData),0,SIZEOF(_data.CarriersData));
FOR _i:=0 TO _config.NumberOfCarriers-1 DO
	//_data.CarriersEnabled[_i]:= FALSE;
	_data.CarriersData[_i].Enabled := FALSE;
END_FOR

//FOR _config.NumberOfCarriers:=0 TO MAX_CARRIERPLACES DO
//	_data.CarriersData[_i].Enabled := FALSE;
//END_FOR

]]></ST>
      </Implementation>
    </Method>
    <Property Name="EmptySlot" Id="{fb8cca45-2bfc-4347-8b47-8acdaca5611c}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC EmptySlot : INT]]></Declaration>
      <Get Name="Get" Id="{7e98d8eb-50d5-4a59-8902-3ae4aba80f37}">
        <Declaration><![CDATA[VAR
	_i : INT;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EmptySlot:= -1;
	
FOR _i:= 0 TO MAX_CARRIERPLACES DO
	
	IF  _data.CarriersData[_i].Enabled THEN
		EmptySlot:= _i;
		RETURN;
	END_IF	

END_FOR]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="EnableCarriers" Id="{4c9d346b-b2c9-4a21-9f67-2f9b230e8eda}" FolderPath="Operations\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable'}
METHOD EnableCarriers
VAR
	_i :INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//MEMSET(ADR(_data.CarriersData),0,SIZEOF(_data.CarriersData));
FOR _i:=0 TO _config.NumberOfCarriers-1 DO
	//_data.CarriersEnabled[_i]:= TRUE;
	_data.CarriersData[_i].Enabled := TRUE;
END_FOR

//FOR _config.NumberOfCarriers:=0 TO MAX_CARRIERPLACES DO
//	_data.CarriersData[_i].Enabled := FALSE;
//END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FillWithEmptyCarriers" Id="{bd17e009-a3dc-475f-92dc-0077b9f398a5}" FolderPath="Operations\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable'}
METHOD FillWithEmptyCarriers
VAR
	_i :INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_TemplateCarrier.Config := _config.CarrierConfig;
_TemplateCarrier.EmptyCarrier();

MEMSET(ADR(_data.CarriersData),0,SIZEOF(_data.CarriersData));
FOR _i:=0 TO _config.NumberOfCarriers-1 DO
	//_data.CarriersEnabled[_i]:= TRUE;
	_data.CarriersData[_i] := _TemplateCarrier.Data;
	_data.CarriersData[_i].Enabled := TRUE;
END_FOR

//FOR _config.NumberOfCarriers:=0 TO MAX_CARRIERPLACES DO
//	_data.CarriersData[_i].Enabled := FALSE;
//END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FIllWithFinishedCarriers" Id="{329ff86e-d9ca-4b91-b7be-e72a0ecb70fe}" FolderPath="Operations\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable'}
METHOD FIllWithFinishedCarriers
VAR
	_i :INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_TemplateCarrier.Config := _config.CarrierConfig;
_TemplateCarrier.FinishCarrier();

MEMSET(ADR(_data.CarriersData),0,SIZEOF(_data.CarriersData));
FOR _i:=0 TO _config.NumberOfCarriers-1 DO
	//_data.CarriersEnabled[_i]:= TRUE;
	_data.CarriersData[_i] := _TemplateCarrier.Data;
	_data.CarriersData[_i].Enabled := TRUE;
END_FOR

//FOR _config.NumberOfCarriers:=0 TO MAX_CARRIERPLACES DO
//	_data.CarriersData[_i].Enabled := FALSE;
//END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FillWithInitialCarriers" Id="{a8230319-fbe2-4cc6-84b4-d146c169332d}" FolderPath="Operations\">
      <Declaration><![CDATA[{attribute 'TcRpcEnable'}
METHOD FillWithInitialCarriers 
VAR
	_i :INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_TemplateCarrier.Config := _config.CarrierConfig;
_TemplateCarrier.InitialCarrier();

MEMSET(ADR(_data.CarriersData),0,SIZEOF(_data.CarriersData));
FOR _i:=0 TO _config.NumberOfCarriers-1 DO
	//_data.CarriersEnabled[_i]:= TRUE;
	_data.CarriersData[_i] := _TemplateCarrier.Data;
	_data.CarriersData[_i].Enabled := TRUE;
END_FOR

//FOR _config.NumberOfCarriers:=0 TO MAX_CARRIERPLACES DO
//	_data.CarriersData[_i].Enabled := FALSE;
//END_FOR

]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetCarrierAt" Id="{92745bd7-57b8-4931-accd-78015b7b6f0a}" FolderPath="Functions\">
      <Declaration><![CDATA[METHOD PUBLIC GetCarrierAt : TcaCarrierData
VAR_INPUT
	Position : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Position < 0 OR Position > MAX_CARRIERPLACES OR NOT _data.CarriersEnabled[Position] THEN
   RETURN;
END_IF

GetCarrierAt := _data.CarriersData[Position];
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetCarrierRefAt" Id="{52e90ba7-7d09-42dd-9017-d28f1a0de18f}" FolderPath="Functions\">
      <Declaration><![CDATA[METHOD PUBLIC GetCarrierRefAt : Reference TO TcaCarrierData
