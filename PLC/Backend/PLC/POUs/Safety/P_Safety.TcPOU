    <Method Name="M_Mapping" Id="{53f9afab-f156-4623-a313-4ed699666d69}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PRIVATE M_Mapping : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIO.stIn.bSAFE_DRIVES_STO := stIO.stIn.bSAFE_DRIVE_A_STO OR
								stIO.stIn.bSAFE_DRIVE_B_STO OR
								stIO.stIn.bSAFE_DRIVES_HG_STO;
								
//IO.stSafetyIO.stIn.bSAFE_Areas_Ok := IO.stSafetyIO.stIn. AND 
//									 IO.stSafetyIO.stIn.bSAFE_Area_Ok_ST20;
									 
									 
// machine stop from safety (ES/Door stop ramp)
bMachineRequestStop := NOT (stIO.stIn.bSAFE_ES_Ok AND
							IO.stSafetyIO.stIn.bSAFE_Areas_Ok );// AND
							//IO.stSafetyIO.stIn.bSAFE_Area_Ok_ST20);]]></ST>
      </Implementation>
    </Method>
