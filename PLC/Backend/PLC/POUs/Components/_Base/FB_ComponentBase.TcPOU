      <Set Name="Set" Id="{46008dd6-890e-4fe4-a735-05ed8de2d0f7}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[stName := Name;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="NameString" Id="{dd0a9030-a1e1-4242-b530-80defac285f6}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY PUBLIC NameString : WSTRING(255)]]></Declaration>
      <Get Name="Get" Id="{1b227500-9a9a-4849-b566-94665e2acf34}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[NameString := stName.wsName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ObjectId" Id="{6151cd1a-ec0a-4780-962a-396a138c611b}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY ObjectId : WSTRING]]></Declaration>
      <Get Name="Get" Id="{99d3fba7-71a7-4d81-9b75-f46e5870f58d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ObjectId := wsObjectId;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Path" Id="{f15c3da9-69b6-42be-b750-91438e4fc191}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
PROPERTY Path : String]]></Declaration>
      <Get Name="Get" Id="{54b2c794-d6e0-472b-8241-5b86ba340b29}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Path := sPath;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="RefsValid" Id="{89a3ca2b-9a2f-4d2d-a33a-74f607804482}" FolderPath="Properties\">
      <Declaration><![CDATA[PROPERTY RefsValid : BOOL]]></Declaration>
      <Get Name="Get" Id="{a66b32cb-c14f-48dc-873e-71a5d161ca8b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[RefsValid := IEvent <> 0;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{7800391a-478c-4265-bd45-1c25f898c8f4}">
      <Declaration><![CDATA[/// Reset component logic
{attribute 'object_name' := 'Reset'}
METHOD Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[/// abstract base logic reset

sLastError := sEmpty;

// default: set state to ready
eState := E_ComponentState.eComponentState_ready;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Run" Id="{04530f9f-040a-4517-8bda-6e0d48f73e41}">
      <Declaration><![CDATA[/// Run component logic
{attribute 'object_name' := 'Run'}
METHOD Run : E_ComponentState
VAR
	ii : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[/// abstract base logic run

wsObjectId := TO_WSTRING( F_CutInstancePath(sPath) );

// only rdy state may lead to run
IF eState = E_ComponentState.eComponentState_ready THEN
	eState := E_ComponentState.eComponentState_running;
END_IF

Run := eState;]]></ST>
      </Implementation>
    </Method>
    <Property Name="State" Id="{d68fb6ae-0af8-44c3-bb4d-32b1388481b9}" FolderPath="Properties\">
      <Declaration><![CDATA[/// Get's value representing the component state.
{attribute 'monitoring':='call'}
PROPERTY State : E_ComponentState
]]></Declaration>
      <Get Name="Get" Id="{f34831ab-8558-4954-8527-8fd474b2d71e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[State := eState;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StateToString" Id="{bffb55f1-1ef3-4369-ab66-e92ce785efbd}" FolderPath="Properties\">
      <Declaration><![CDATA[/// Get's value representing the component state.
{attribute 'monitoring':='call'}
PROPERTY StateToString : STRING
]]></Declaration>
      <Get Name="Get" Id="{a3e43248-1732-4fcc-9614-52c3ff99ce09}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[CASE eState OF

	eComponentState_none :
		StateToString := 'undefiniert';
	/// Component is resetting
	eComponentState_resetting:
		StateToString := 'wird zurückgesetzt';
	/// Component is ready
	eComponentState_ready:
		StateToString := 'ist bereit';
	/// Component is running
	eComponentState_running:
		StateToString := 'wird ausgeführt';
	/// Component has error
	eComponentState_error:
		StateToString := 'ist fehlerhaft';

END_CASE]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Typ" Id="{987dd2cf-7ace-4cc4-856e-8b41f907e2c3}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
PROPERTY Typ : E_ComponentType]]></Declaration>
      <Get Name="Get" Id="{4aca47e7-510b-43f6-9b4f-e58faabf961a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Typ := eTyp;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>