    <Property Name="WorkpiecePlaces" Id="{4743c045-c7f1-4ea2-877a-78415e57eca8}">
      <Declaration><![CDATA[PROPERTY WorkpiecePlaces : INT]]></Declaration>
      <Get Name="Get" Id="{1b62398e-be48-4c80-8efa-d02ec467eb4d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CASE _config.Layout OF	
	eTcaCarrierLayout.Layout1 : WorkpiecePlaces := _config.PositionsInRow*_config.PositionsInColumn;		
    eTcaCarrierLayout.Layout2 : WorkpiecePlaces := _config.PositionsInRow*_config.PositionsInColumn;		 
    eTcaCarrierLayout.Layout3 : WorkpiecePlaces := _config.PositionsInRow*_config.PositionsInColumn;		 
	eTcaCarrierLayout.Layout4 : WorkpiecePlaces := _config.PositionsInRow*_config.PositionsInColumn + _config.PositionsInColumn/2;		
	eTcaCarrierLayout.Layout5 : WorkpiecePlaces := _config.PositionsInRow*_config.PositionsInColumn - _config.PositionsInColumn/2;		
	ELSE
		 WorkpiecePlaces := 0;
END_CASE]]></ST>
        </Implementation>
      </Get>
    </Property>
