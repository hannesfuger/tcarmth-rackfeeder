END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ManualMode := eManualMode;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{26ae4312-0d94-4d03-94ab-ef53363e1b83}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[eManualMode := ManualMode;]]></ST>
        </Implementation>
      </Set>
    </Property>
  </POU>
</TcPlcObject>