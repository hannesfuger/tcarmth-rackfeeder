    <Method Name="ReactToComponentError" Id="{1e078b5b-c346-4292-b9cd-2516432a2b86}" FolderPath="Events\">
      <Declaration><![CDATA[METHOD PROTECTED ReactToComponentError
VAR_IN_OUT
	fbUi	: FB_ManualUiBase;
END_VAR
VAR_INPUT
	mode 	: E_EventReaction;
END_VAR
VAR
	msg		: I_StringBuilder;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[msg := GetComponentError(fbUi);
ReactToEvent(mode, TcEventSeverity.Error)
			.ArgSetSbRaise(msg);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReactToError" Id="{070a1f6d-05e9-4ac5-b65c-0cb42b813665}" FolderPath="Events\">
      <Declaration><![CDATA[METHOD PROTECTED ReactToError : I_EventHandler
VAR_INPUT
	mode : E_EventReaction;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ReactToError := ReactToEvent(mode, TcEventSeverity.Error); ]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReactToEvent" Id="{101b3096-47b5-4e81-bda7-e9ab65e8f446}" FolderPath="Events\">
      <Declaration><![CDATA[METHOD PROTECTED ReactToEvent : I_EventHandler
VAR_INPUT
	mode		: E_EventReaction;
	severity	: TcEventSeverity;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// switch event reaction mode
CASE mode OF
	E_EventReaction.Init:
		M_InitSequences();
		
	E_EventReaction.Stop:
		bRunCycle := FALSE;
		bAutoStop_Error := TRUE;
		
	E_EventReaction.CycleStop:
		bRunCycle := FALSE;
		
END_CASE

// set the component state &
//  return value (info, warning or error - event handler)
CASE severity OF
	TcEventSeverity.Info:
		eState := E_ComponentState.eComponentState_info;
		ReactToEvent := StationInfo;
		
	TcEventSeverity.Warning:
		eState := E_ComponentState.eComponentState_warning;
		ReactToEvent := StationWarning;
		
	ELSE
		eState := E_ComponentState.eComponentState_error;
		ReactToEvent := StationError;
		
END_CASE
]]></ST>
      </Implementation>
    </Method>
