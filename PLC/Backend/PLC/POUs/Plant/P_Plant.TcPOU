    <Method Name="M_Init" Id="{397cde99-40f4-48fa-88b5-e393731dcab2}">
      <Declaration><![CDATA[METHOD INTERNAL M_Init : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// init components stuff here...
ILog := Services.ILog;
IEvent := Services.fbEventHandler;

bInitSettingPlant := FALSE;
bInitSettingProduct := FALSE;
bInitSettingProduction := FALSE;

aSClearText[EN] := 'Plant init done.';
M_Init := TRUE;]]></ST>
      </Implementation>
    </Method>
