VAR_IN_OUT
	IEventHndler : FB_EventHandler;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[HMI.stHmi.stOut.stCommon REF= stHmiBaseOut;
IEvent := IEventHndler;
M_SetReferences := TRUE;]]></ST>
      </Implementation>
    </Method>
