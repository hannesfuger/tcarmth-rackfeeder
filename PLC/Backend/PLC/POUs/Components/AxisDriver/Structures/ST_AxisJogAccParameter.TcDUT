<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4020.12">
  <DUT Name="ST_AxisJogAccParameter" Id="{8072df0a-3a0b-45a6-ad4f-3dbd5d3cd441}">
    <Declaration><![CDATA[/// Accelerating jog parameter strucure
TYPE ST_AxisJogAccParameter EXTENDS ST_AxisMoveParameter :
STRUCT
	/// Jog axis backward
	bJogBackwards: BOOL;
	/// Jog axis forward
	bJogForward: BOOL;
	/// Slow (starting) speed
	fSlowSpeed: LREAL;
	/// Fast end-speed
	fFastSpeed: LREAL;
	/// Time for ramp from slow to fast speed 
	tAccTime: TIME;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>