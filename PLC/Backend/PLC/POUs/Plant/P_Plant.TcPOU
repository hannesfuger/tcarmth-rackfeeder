    <Method Name="M_Reset" Id="{494d04a0-846f-4b8a-9555-c2a2d638da5a}">
      <Declaration><![CDATA[/// resets all additional components
METHOD M_Reset
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// reset all additional components

//reset serial fault counter
FOR ii := 0 TO CONST.iMaxIdxCounter DO
	IF (stCounter[ii].eCurrentReactionNokLevel1 = E_CounterReaction.eCounterReaction_SerialFault_Warning) 
		OR (stCounter[ii].eCurrentReactionNokLevel1 = E_CounterReaction.eCounterReaction_SerialFault_Error)
		OR (stCounter[ii].eCurrentReactionNokLevel2 = E_CounterReaction.eCounterReaction_SerialFault_Warning) 
		OR (stCounter[ii].eCurrentReactionNokLevel2 = E_CounterReaction.eCounterReaction_SerialFault_Error)  
	THEN
		F_Counter(E_CounterMode.eCounterMode_SerialError_Clear, stCounter[ii]);
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SettingsPlant" Id="{10161c05-8b40-4fa6-9c04-f097d93f7708}">
      <Declaration><![CDATA[METHOD M_SettingsPlant : BOOL
VAR_INPUT
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[// plant settings
IF NOT bInitSettingPlant THEN
	bInitSettingPlant := TRUE;
	stSettingsPlantBackup := stSettings.stPlant_Settings; // backup
	MEMSET(ADR(stSettings.stPlant_Settings), 0, SIZEOF(stSettings.stPlant_Settings)); // reset
	
	F_InitDynDataItem(E_PlantSettings.ePlantSetting_RecipeName, 		// settings index
		TO_WSTRING(E_PlantSettings.ePlantSetting_RecipeName),			// settings wsIndex
		CONST.stEmptyText,												// group
		stTextListGlobal.stText_RecipeName,								// name
		stTextListGlobal.stText_name, E_DataType.eDataType_wstring,		// unit & data type
		0, 0, 6,														// min, max & user level
		E_RecipeMode.eRecipeMode_ToFrom,														
		stSettings.stPlant_Settings);
		
	F_InitDynDataItem(E_PlantSettings.ePlantSetting_RecipeComment,
		TO_WSTRING(E_PlantSettings.ePlantSetting_RecipeComment),
		CONST.stEmptyText,
		stTextListGlobal.stText_RecipeComment,
		stTextListGlobal.stText_name, E_DataType.eDataType_wstring,
		0, 0, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stPlant_Settings);
		
	F_InitDynDataItem(E_PlantSettings.ePlantSetting_PlantName,
		TO_WSTRING(E_PlantSettings.ePlantSetting_PlantName),
		CONST.stEmptyText,
		stTextListGlobal.stText_PlantName,
		stTextListGlobal.stText_name, E_DataType.eDataType_wstring,
		0, 0, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stPlant_Settings);

	F_InitDynDataItem(E_PlantSettings.ePlantSetting_PlantNumber,
		TO_WSTRING(E_PlantSettings.ePlantSetting_PlantNumber),
		CONST.stEmptyText,
		stTextListGlobal.stText_PlantNumber,
		stTextListGlobal.stText_n, E_DataType.eDataType_int,
		0, 100000, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stPlant_Settings);

	F_RestoreSettingValues(stSettings.stPlant_Settings, stSettingsPlantBackup); // restore values
END_IF

// settings management
//F_Settings_Management(stSettings.stPlant_Settings);

]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SettingsProduct" Id="{9bb898fe-26eb-40d8-9e72-b50327ba4da9}">
      <Declaration><![CDATA[METHOD M_SettingsProduct : BOOL
VAR_INPUT
END_VAR
	]]></Declaration>
      <Implementation>
        <ST><![CDATA[//init product settings
IF NOT bInitSettingProduct THEN
	bInitSettingProduct:=TRUE;
	stSettingsProductBackup := stSettings.stProduct_Settings; // backup
	MEMSET(ADR(stSettings.stProduct_Settings), 0, SIZEOF(stSettings.stProduct_Settings)); // reset

	F_InitDynDataItem(E_ProductSettings.eProductSettings_ProductNumber,	// settings index
		TO_WSTRING(E_ProductSettings.eProductSettings_ProductNumber),	// settings wsIndex
		F_CreateDynTextDefault("settingsproduct"),						// group
		stTextListGlobal.stText_RecipeName,								// name
		stTextListGlobal.stText_text, E_DataType.eDataType_wstring,		// unit & data type
		0, 100000000, 6,												// min, max & user level
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);		
	F_InitDynDataItem(E_ProductSettings.eProductSettings_ProductName,
		TO_WSTRING(E_ProductSettings.eProductSettings_ProductName),
		F_CreateDynTextDefault("settingsproduct"),
		F_CreateDynTextDefault("name"),
		stTextListGlobal.stText_text, E_DataType.eDataType_wstring,
		0, 0, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);		
	F_InitDynDataItem(E_ProductSettings.eProductSettings_ProductType,
		TO_WSTRING(E_ProductSettings.eProductSettings_ProductType),
		F_CreateDynTextDefault("settingsproduct"),
		F_CreateDynTextDefault("type"),
		stTextListGlobal.stText_n, E_DataType.eDataType_int,
		0, 10, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);		

	F_InitDynDataItem(E_ProductSettings.eProductSettings_TrolleyNumberOfCarriers,
		TO_WSTRING(E_ProductSettings.eProductSettings_TrolleyNumberOfCarriers),
		F_CreateDynTextDefault("settingsTrolley"),
		F_CreateDynTextDefault("Palettenanzahl"),
		stTextListGlobal.stText_n, E_DataType.eDataType_int,
		0, 50, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);		
	F_InitDynDataItem(E_ProductSettings.eProductSettings_TrolleyRackOriginX,
		TO_WSTRING(E_ProductSettings.eProductSettings_TrolleyRackOriginX),
		F_CreateDynTextDefault("settingsTrolley"),
		F_CreateDynTextDefault("Origin_X"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 1000, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);
	F_InitDynDataItem(E_ProductSettings.eProductSettings_TrolleyRackOriginY,
		TO_WSTRING(E_ProductSettings.eProductSettings_TrolleyRackOriginY),
		F_CreateDynTextDefault("settingsTrolley"),
		F_CreateDynTextDefault("Origin_Y"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 2000, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);		
	F_InitDynDataItem(E_ProductSettings.eProductSettings_TrolleyRackDivision,
		TO_WSTRING(E_ProductSettings.eProductSettings_TrolleyRackDivision),
		F_CreateDynTextDefault("settingsTrolley"),
		F_CreateDynTextDefault("Division"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 500, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);		
	F_InitDynDataItem(E_ProductSettings.eProductSettings_TrolleyCarrierDistance,
		TO_WSTRING(E_ProductSettings.eProductSettings_TrolleyCarrierDistance),
		F_CreateDynTextDefault("settingsTrolley"),
		F_CreateDynTextDefault("CarrierDistance"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 200, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);				
	
	F_InitDynDataItem(E_ProductSettings.eProductSettings_CarrierLayout,
		TO_WSTRING(E_ProductSettings.eProductSettings_CarrierLayout),
		F_CreateDynTextDefault("settingsCarrier"),
		F_CreateDynTextDefault("Layout"),
		stTextListGlobal.stText_n, E_DataType.eDataType_int,
		0, 6, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);		
	F_InitDynDataItem(E_ProductSettings.eProductSettings_CarrierDimensionX,
		TO_WSTRING(E_ProductSettings.eProductSettings_CarrierDimensionX),
		F_CreateDynTextDefault("settingsCarrier"),
		F_CreateDynTextDefault("DimensionX"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 600, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);	
	F_InitDynDataItem(E_ProductSettings.eProductSettings_CarrierDimensionY,
		TO_WSTRING(E_ProductSettings.eProductSettings_CarrierDimensionY),
		F_CreateDynTextDefault("settingsCarrier"),
		F_CreateDynTextDefault("DimensionY"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 600, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);	
	F_InitDynDataItem(E_ProductSettings.eProductSettings_CarrierRowDistance,
		TO_WSTRING(E_ProductSettings.eProductSettings_CarrierRowDistance),
		F_CreateDynTextDefault("settingsCarrier"),
		F_CreateDynTextDefault("RowDistance"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 600, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);	
	F_InitDynDataItem(E_ProductSettings.eProductSettings_CarrierColumnDistance,
		TO_WSTRING(E_ProductSettings.eProductSettings_CarrierColumnDistance),
		F_CreateDynTextDefault("settingsCarrier"),
		F_CreateDynTextDefault("ColumnDistance"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 600, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);	
	F_InitDynDataItem(E_ProductSettings.eProductSettings_CarrierPositionsInRow,
		TO_WSTRING(E_ProductSettings.eProductSettings_CarrierPositionsInRow),
		F_CreateDynTextDefault("settingsCarrier"),
		F_CreateDynTextDefault("PositionsInRow"),
		stTextListGlobal.stText_n, E_DataType.eDataType_int,
		0, 17, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);		
	F_InitDynDataItem(E_ProductSettings.eProductSettings_CarrierPositionsInColumn,
		TO_WSTRING(E_ProductSettings.eProductSettings_CarrierPositionsInColumn),
		F_CreateDynTextDefault("settingsCarrier"),
		F_CreateDynTextDefault("PositionsInColumn"),
		stTextListGlobal.stText_n, E_DataType.eDataType_int,
		0, 17, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);		
	F_InitDynDataItem(E_ProductSettings.eProductSettings_CarrierCoordinateFirstWorkpieceX,
		TO_WSTRING(E_ProductSettings.eProductSettings_CarrierCoordinateFirstWorkpieceX),
		F_CreateDynTextDefault("settingsCarrier"),
		F_CreateDynTextDefault("CoordinateFirstWorkpieceX"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 600, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);	
	F_InitDynDataItem(E_ProductSettings.eProductSettings_CarrierCoordinateFirstWorkpieceY,
		TO_WSTRING(E_ProductSettings.eProductSettings_CarrierCoordinateFirstWorkpieceY),
		F_CreateDynTextDefault("settingsCarrier"),
		F_CreateDynTextDefault("CoordinateFirstWorkpieceY"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 600, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);	
	F_InitDynDataItem(E_ProductSettings.eProductSettings_CarrierRequestStatus,
		TO_WSTRING(E_ProductSettings.eProductSettings_CarrierRequestStatus),
		F_CreateDynTextDefault("settingsCarrier"),
		F_CreateDynTextDefault("RequestStatus"),
		stTextListGlobal.stText_n, E_DataType.eDataType_int,
		0, 5, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);		
	F_InitDynDataItem(E_ProductSettings.eProductSettings_CarrierInitialStatus,
		TO_WSTRING(E_ProductSettings.eProductSettings_CarrierInitialStatus),
		F_CreateDynTextDefault("settingsCarrier"),
		F_CreateDynTextDefault("InitialStatus"),
		stTextListGlobal.stText_n, E_DataType.eDataType_int,
		0, 5, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);		
		
	F_InitDynDataItem(E_ProductSettings.eProductSettings_HeatingPlateEnable,
		TO_WSTRING(E_ProductSettings.eProductSettings_HeatingPlateEnable),
		F_CreateDynTextDefault("settingsHeatingPlate"),
		F_CreateDynTextDefault("Enable"),
		stTextListGlobal.stText_n, E_DataType.eDataType_bool,
		0, 5, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);		
	F_InitDynDataItem(E_ProductSettings.eProductSettings_HeatingPlateTemperatur,
		TO_WSTRING(E_ProductSettings.eProductSettings_HeatingPlateTemperatur),
		F_CreateDynTextDefault("settingsHeatingPlate"),
		F_CreateDynTextDefault("Temperature"),
		stTextListGlobal.stText_n, E_DataType.eDataType_int,
		0, 5, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduct_Settings);		



F_RestoreSettingValues(stSettings.stProduct_Settings, stSettingsProductBackup); // restore values
END_IF

// settings management
F_Settings_Management(stSettings.stProduct_Settings);

stSettings.stCarrier.ColumnDistance := CarrierColumnDistance;
stSettings.stCarrier.CoordinateFirstWorkpiece.fX := CarrierCoordinateFirstWorkpieceX;
stSettings.stCarrier.CoordinateFirstWorkpiece.fY := CarrierCoordinateFirstWorkpieceY;
stSettings.stCarrier.Dimension.fX := CarrierDimensionX;
stSettings.stCarrier.Dimension.fY := CarrierDimensionY;
stSettings.stCarrier.InitialStatus := CarrierInitialStatus;
stSettings.stCarrier.Layout := CarrierLayout;
stSettings.stCarrier.PositionsInColumn := CarrierPositionsInColumn;
stSettings.stCarrier.PositionsInRow := CarrierPositionsInRow;
stSettings.stCarrier.RequestStatus := CarrierRequestStatus;
stSettings.stCarrier.RowDistance := CarrierRowDistance;

stSettings.stTrolley.CarrierConfig := stSettings.stCarrier;
stSettings.stTrolley.CarrierDistance := TrolleyCarrierDistance;
stSettings.stTrolley.NumberOfCarriers := TrolleyNumberOfCarriers;
stSettings.stTrolley.RackDivision := TrolleyRackDivision;
stSettings.stTrolley.RackOrigin.fX := TrolleyRackOriginX;
stSettings.stTrolley.RackOrigin.fY := TrolleyRackOriginY;
stSettings.stTrolley.RackOrigin.fZ := TrolleyRackOriginZ;












]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SettingsProduction" Id="{82d4771d-d863-478d-a017-59ffd22755d4}">
      <Declaration><![CDATA[METHOD M_SettingsProduction : BOOL
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// init  production settings
IF NOT bInitSettingProduction THEN
	bInitSettingProduction := TRUE;
	stSettingsProductionBackup := stSettings.stProduction_Settings; // backup
	MEMSET(ADR(stSettings.stProduction_Settings), 0, SIZEOF(stSettings.stProduction_Settings));		// reset

	F_InitDynDataItem(E_ProductionSettings.eProductionSettings_Override,	// settings index
		TO_WSTRING(E_ProductionSettings.eProductionSettings_Override),		// settings wsIndex
		F_CreateDynText("settingsproduction", 0),							// group
		stTextListGlobal.stText_PlantSpeedOverride,							// name
		stTextListGlobal.stText_percent, E_DataType.eDataType_int,			// unit & data type
		0, 1500, 6,															// min, max & user level
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduction_Settings);
		
	F_InitDynDataItem(E_ProductionSettings.eProductionSettings_OrderNumber,
		TO_WSTRING(E_ProductionSettings.eProductionSettings_OrderNumber),
		F_CreateDynText("settingsproduction", 0),
		stTextListGlobal.stText_OrderNumber,
		stTextListGlobal.stText_text, E_DataType.eDataType_wstring,
		0, 40, 6,
		E_RecipeMode.eRecipeMode_ToFrom,
		stSettings.stProduction_Settings);
		
	F_RestoreSettingValues(stSettings.stProduction_Settings, stSettingsProductionBackup); // restore values
END_IF

// settings management
F_Settings_Management(stSettings.stProduction_Settings);]]></ST>
      </Implementation>
    </Method>
