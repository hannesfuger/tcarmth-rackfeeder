<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_FurnaceDriver" Id="{df4cfe96-c890-474a-ab02-1af8259d790a}" SpecialFunc="None">
    <Declaration><![CDATA[/// Exhaustion driver.
FUNCTION_BLOCK FB_FurnaceDriver EXTENDS FB_ComponentBase

VAR CONSTANT
	nFurnanceScheduleItems		: INT := 7;
END_VAR

VAR
	/// IO structure
	stIn 				: REFERENCE TO ST_FurnaceIn;
	stOut 				: REFERENCE TO ST_FurnaceOut;
	
	/// fb
	fbTmpCtrl			: FB_CTRL_TempController;
	
	/// Sequences
	eSequenceId			: E_FurnaceSeq;
	
	nStep				: INT;
	
	// private var's
	stCTRLParameter		: ST_CTRL_TempCtrlParameter;
	stPIDParameter		: ST_CTRL_ParaController;
	
	fTemperature		: LREAL;
	fSlope				: LREAL;
	fInitial			: LREAL;
	bkpAlarmSupp		: DWORD;	
	eCTRL_Mode 			: E_CTRL_MODE := E_CTRL_MODE.eCTRL_MODE_IDLE; 	(*   eCTRL_MODE_TUNE  ;*)
	bTuned				: BOOL;	
	rtOverheat			: R_TRIG;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[///
/// Furnace driver.
/// Hannes Fuger / asma.at / 12.2015
///]]></ST>
    </Implementation>
    <Folder Name="_Sequences" Id="{15e43052-4e1c-4d49-9a2c-7574bd8d971f}" />
    <Folder Name="Factory" Id="{5f5aba3e-a1f3-4194-b0a2-97d9992f8fc6}" />
    <Folder Name="Properties" Id="{3fcf4e10-8afd-4e61-8c01-6f6c0bb2d2ff}" />
    <Method Name="_AUTO" Id="{ab0a856b-f237-41f2-90a5-37ebdc922f92}" FolderPath="_Sequences\">
      <Declaration><![CDATA[METHOD PRIVATE _AUTO 
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nStep OF
	
0	:	// switch to Active mode
		eCTRL_Mode := E_CTRL_MODE.eCTRL_MODE_ACTIVE;
		stCtrlParameter.bSelCtrlParameterSet := TRUE;
						
		IF fbTmpCtrl.eCtrlState = e_Ctrl_state.eCTRL_STATE_ACTIVE THEN
			nStep := 99;
		END_IF			


END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="_HAND" Id="{93473d4b-fa71-4766-b2fb-caf5a289959a}" FolderPath="_Sequences\">
      <Declaration><![CDATA[METHOD _HAND
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nStep OF
	
0	:	// switch to Active mode
		eCTRL_Mode := E_CTRL_MODE.eCTRL_MODE_MANUAL;
		stCtrlParameter.bSelCtrlParameterSet := TRUE;
							
		IF fbTmpCtrl.eCtrlState = e_Ctrl_state.eCTRL_STATE_MANUAL THEN
			nStep := 99;
		END_IF	
		
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="_OFF" Id="{70411660-9978-45d2-8761-3acd9077b52d}" FolderPath="_Sequences\">
      <Declaration><![CDATA[METHOD _OFF
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nStep OF
	
0	:	// switch to Active mode
		eCTRL_Mode := E_CTRL_MODE.eCTRL_MODE_IDLE;
							
		IF fbTmpCtrl.eCtrlState = e_Ctrl_state.eCTRL_STATE_IDLE THEN
			nStep := 99;
		END_IF	
			
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="_TUNE" Id="{72a47a8a-78bf-4933-9c29-e0ae8e12a6d4}" FolderPath="_Sequences\">
      <Declaration><![CDATA[METHOD _TUNE
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nStep OF
	
0	:	// switch to Tune mode
		eCTRL_Mode := E_CTRL_MODE.eCTRL_MODE_TUNE;
		// Alarme ausstellen
		bkpAlarmSupp := stCTRLParameter.dwAlarmSupp;
		stCtrlParameter.bSelCtrlParameterSet := FALSE;
		
		IF fbTmpCtrl.eCtrlState = e_Ctrl_state.eCTRL_STATE_TUNING THEN
			nStep := 10;
		END_IF

10	:	IF fbTmpCtrl.eCtrlState = e_Ctrl_state.eCTRL_STATE_TUNED THEN
			nStep := 20;
		END_IF
			
20	:	stPIDParameter := fbTmpCtrl.sParaControllerInternal;
		stCtrlParameter.bSelCtrlParameterSet := TRUE;
		fbTmpCtrl.eCtrlMode := E_CTRL_MODE.eCTRL_MODE_PASSIVE;
		eSequenceId := eFurnaceSeq_none;
		

END_CASE]]></ST>
      </Implementation>
    </Method>
