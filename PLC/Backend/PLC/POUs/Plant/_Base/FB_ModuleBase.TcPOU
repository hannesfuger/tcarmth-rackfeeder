    <Property Name="EnableManual" Id="{db6fa8a8-45a9-4479-93b8-7e802eb97f0d}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
//{attribute 'monitoring' := 'variable'}
PROPERTY PUBLIC EnableManual : BOOL]]></Declaration>
      <Get Name="Get" Id="{b55b5421-b1a8-4134-80c6-bdda88c59679}">
        <Declaration><![CDATA[
VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnableManual := EnableSummary AND (eOpMode = eOpMode_manual);
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EnableSummary" Id="{5b05b0ad-48a2-4621-814d-75be1c50c9ea}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
//{attribute 'monitoring' := 'variable'}
PROPERTY INTERNAL EnableSummary : BOOL]]></Declaration>
      <Get Name="Get" Id="{3687db34-443a-4a84-8bc4-04749c475c00}">
        <Declaration><![CDATA[PUBLIC 
VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[EnableSummary := bEnable 
				AND bSafetyOk 
				AND (eOpMode = eOpMode_manual) OR (eOpMode = eOpMode_step) OR (eOpMode = eOpMode_auto);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="GetStepChainTest" Id="{c18b19dc-8077-49d2-a762-8c7f9a154fbc}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC GetStepChainTest : ST_Text
VAR_INPUT
	Index : INT; // step chain index
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// step chain index is ignored in the default implementation -> if multiple step chains are needed, use derived base and override this method. 
GetStepChainTest.nNameId := sqAuto.InfoTextId;
GetStepChainTest.wsName := sqAuto.Info.ToWString();
GetStepChainTest.wsNameId := sqAuto.InfoTextWsId;]]></ST>
      </Implementation>
    </Method>
    <Property Name="InHome" Id="{db83cf62-2102-4685-b70f-87a5b4d9fd36}" FolderPath="Properties\">
      <Declaration><![CDATA[/// Station in Home flag
{attribute 'monitoring':='call'}
PROPERTY InHome : BOOL
]]></Declaration>
      <Get Name="Get" Id="{7c33e96f-b3c3-4ce0-8cfa-b84efdedd18b}">
        <Declaration><![CDATA[VAR

END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[InHome := TRUE;
//FOR ii := 0 TO iNumberOfStepChains - 1 DO
	IF NOT sqHome.InHome THEN
		InHome := FALSE;
	END_IF
//END_FOR

bInHome := InHome;
