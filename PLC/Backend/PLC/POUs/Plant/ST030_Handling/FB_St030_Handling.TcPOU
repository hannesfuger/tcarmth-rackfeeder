    <Method Name="M_CallObjects" Id="{fb0b4041-c168-4840-a7d3-bd6d36ee9782}">
      <Declaration><![CDATA[METHOD PROTECTED M_CallObjects : BOOL
VAR
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[// axis + UI
fbAxisX.TorqueLimit := 600;
fbAxisX(
	bEnable := SafetyOk AND NOT fbAxisXUi.stAxisManager.bDisable AND stSt050IMould.bEnableHG,
	bEnablePos := fbAxisZ.PositionReachedWindow(PosHomeZ, 10) OR fbAxisXUi.stAxisManager.bDisableSoftLimits,
	bEnableNeg := fbAxisZ.PositionReachedWindow(PosHomeZ, 10) OR fbAxisXUi.stAxisManager.bDisableSoftLimits
);
fbAxisXUi(
	bInHome := bInHome,
	fbAxis := fbAxisX,
	fVelocity := JogSpeedX,
	diSelectedObjectIndex := stHmiManualIn.diSelectedObjectIndex,
	stHMIControlIn := stHmiManualIn.stManualAxis,
	stHMIControlOut := stHmiManualOut.stManualAxis,
	bJogP := stHmi.stIn.stSt030.bJogXP,
	bJogN := stHmi.stIn.stSt030.bJogXN,
	bEnableManual := EnableManual);

// axis CH1 + UI
fbAxisY.TorqueLimit := 600;
fbAxisY(
	bEnable := SafetyOk AND NOT fbAxisYUi.stAxisManager.bDisable AND stSt050IMould.bEnableHG,
	bEnablePos := TRUE,
	bEnableNeg := TRUE,
);
fbAxisYUi(
	bInHome := bInHome,
	fbAxis := fbAxisY,
	fVelocity := JogSpeedY,
	diSelectedObjectIndex := stHmiManualIn.diSelectedObjectIndex,
	stHMIControlIn := stHmiManualIn.stManualAxis,
	stHMIControlOut := stHmiManualOut.stManualAxis,
	bJogP := stHmi.stIn.stSt030.bJogYP,
	bJogN := stHmi.stIn.stSt030.bJogYN,
	bEnableManual := EnableManual);
	
// axis CH2 + UI
fbAxisZ.TorqueLimit := 300;
fbAxisZ(
	bEnable := SafetyOk AND NOT fbAxisZUi.stAxisManager.bDisable AND stSt050IMould.bEnableHG,
	bEnablePos := TRUE,
	bEnableNeg := TRUE,
);
fbAxisZUi(
	bInHome := bInHome,
	fbAxis := fbAxisZ,
	fVelocity := JogSpeedZ,
	diSelectedObjectIndex := stHmiManualIn.diSelectedObjectIndex,
	stHMIControlIn := stHmiManualIn.stManualAxis,
	stHMIControlOut := stHmiManualOut.stManualAxis,
	bJogP := stHmi.stIn.stSt030.bJogZP,
	bJogN := stHmi.stIn.stSt030.bJogZN,
	bEnableManual := EnableManual);
	

	
// run pallet logic
//Plant.stSt030IHandling.Pallet.Update();]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_CheckHskRst" Id="{47479f39-4365-4980-bcba-37552d4e2456}" FolderPath="Hsk\">
      <Declaration><![CDATA[METHOD PRIVATE M_CheckHskRst : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// chk all hand shake signals are reseted
M_CheckHskRst := FALSE;

// oven A
IF stSt010IOvenA.bResponseOpn OR stSt010IOvenA.bResponseChkIndex OR stSt010IOvenA.bResponseIsEmptySlot THEN
	sqAuto.Info.Set("warte auf Handshake reset Ofen A"); RETURN;
ELSIF stSt010IOvenA.iConfirmPosition <> -1 THEN
	sqAuto.Info.Set("warte auf Handshake Index-X reset Ofen A"); RETURN;
	
// oven B
ELSIF stSt020IOvenB.bResponseOpn OR stSt020IOvenB.bResponseChkIndex OR stSt020IOvenB.bResponseIsEmptySlot THEN
	sqAuto.Info.Set("warte auf Handshake reset Ofen B"); RETURN;
ELSIF stSt020IOvenB.iConfirmPosition <> -1 THEN
	sqAuto.Info.Set("warte auf Handshake Index-X reset Ofen B"); RETURN;
	
// storage
ELSIF stSt040IStorage.bResponseOpn OR stSt040IStorage.bResponseChkIndex OR stSt040IStorage.bResponseEmptyAtIndex THEN
	sqAuto.Info.Set("warte auf Handshake reset Storage"); RETURN;
ELSIF stSt040IStorage.iConfirmPosition <> -1 THEN
	sqAuto.Info.Set("warte auf Handshake Index reset Storage"); RETURN;
	
END_IF

M_CheckHskRst := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_DynManual" Id="{f90ebe3f-5129-4e19-a7df-5b0a3a72de4c}" FolderPath="DynSetMonObj\">
      <Declaration><![CDATA[METHOD INTERNAL M_DynManual : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInitManual THEN
	bInitManual := TRUE;
	MEMSET(ADR(stHmiManualOut.stObjects), 0, SIZEOF(stHmiManualOut.stObjects)); // reset
	
	M_InitDynManualUi(fbAxisXUi);
	M_InitDynManualUi(fbAxisYUi);
	M_InitDynManualUi(fbAxisZUi);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_DynMonitoring" Id="{d4f0eb08-2220-4ffd-a49d-52dc27838bb3}" FolderPath="DynSetMonObj\">
      <Declaration><![CDATA[METHOD PROTECTED M_DynMonitoring : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_DynMonitoring := SUPER^.M_DynMonitoring();

// init
IF NOT bInitMonitoring THEN
	bInitMonitoring := TRUE;
	MEMSET(ADR(stLocalMonitoring), 0, SIZEOF(stLocalMonitoring)); // reset
	
	M_InitDynMonitoringItem(0, 								// monitoring index 
							"Achse X Position",				// name
							Name, 							// group (station name)
							E_DataType.eDataType_lreal, 	// data type							
							stTextListGlobal.stText_mm);	// unit	

	M_InitDynMonitoringItem(1, "Achse X Geschwindigkeit", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_mms);
	M_InitDynMonitoringItem(2, "Achse X Drehmoment", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_percent);
	
	M_InitDynMonitoringItem(4, "Achse Y Position", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_mm);
	M_InitDynMonitoringItem(5, "Achse Y Geschwindigkeit", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_mms);
	M_InitDynMonitoringItem(6, "Achse Y Drehmoment", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_percent);
	
	M_InitDynMonitoringItem(8, "Achse Z Position", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_mm);
	M_InitDynMonitoringItem(9, "Achse Z Geschwindigkeit", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_mms);
	M_InitDynMonitoringItem(10, "Achse Z Drehmoment", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_percent);
END_IF

// live value mapping 

// axis x
stLocalMonitoring.astMonitoring[0].fValue := fbAxisX.Position;
stLocalMonitoring.astMonitoring[1].fValue := fbAxisX.Velocity;
stLocalMonitoring.astMonitoring[2].fValue := fbAxisX.Torque;

// axis y
stLocalMonitoring.astMonitoring[4].fValue := fbAxisY.Position;
stLocalMonitoring.astMonitoring[5].fValue := fbAxisY.Velocity;
stLocalMonitoring.astMonitoring[6].fValue := fbAxisY.Torque;

// axis z
stLocalMonitoring.astMonitoring[8].fValue := fbAxisZ.Position;
stLocalMonitoring.astMonitoring[9].fValue := fbAxisZ.Velocity;
stLocalMonitoring.astMonitoring[10].fValue := fbAxisZ.Torque;

// hmi value mapping
//HMI.stHmi.stOut.stSt030.Pallet := stSt030IHandling.Pallet.stPallet;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_DynSettings" Id="{146134ce-78b1-476b-ab52-dd760d1195c6}" FolderPath="DynSetMonObj\">
      <Declaration><![CDATA[METHOD INTERNAL M_DynSettings : BOOL
VAR
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[// init station settings
IF NOT bInitSettings THEN
	bInitSettings := TRUE;
	stLocalSettingsBackup := stLocalSettings; // backup
	MEMSET(ADR(stLocalSettings), 0, SIZEOF(stLocalSettings)); // reset
	
	stSt030IHandling.Pallet.Config := Services.stSettings.stCarrier;
	stSt030IHandling.Pallet.InitialStatus := eTcaWorkpieceStatus.laserProcessDone;
	stSt030IHandling.Pallet.RequestStatus := eTcaWorkpieceStatus.castingProcessDone;
	stSt030IHandling.Pallet.ApplyConfig();
	
	
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_Station_Deaktiv,	// settings index
		TO_WSTRING(E_St030_Settings.eSt030_Settings_Station_Deaktiv),		// settings wsIndex
		Name,																// group
		stTextListGlobal.stText_DeactivateStation,							// name
		stTextListGlobal.stText_bool, E_DataType.eDataType_bool,			// unit & data type
		0, 1, 3);															// min, max & user level
    
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_Autohome,
		TO_WSTRING(E_St030_Settings.eSt030_Settings_Autohome),
		Name,
		stTextListGlobal.stText_AutoHome,
		stTextListGlobal.stText_bool, E_DataType.eDataType_bool,
		0, 1, 3);
		
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_XHomeSpeed,
		TO_WSTRING(E_St030_Settings.eSt030_Settings_XHomeSpeed),
		Name,
		F_CreateDynTextDefault("Homegeschwindigkeit Servoachse X"),
		stTextListGlobal.stText_mms, E_DataType.eDataType_lreal,
		0, 50, 3);
		
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_XJogSpeed,
		TO_WSTRING(E_St030_Settings.eSt030_Settings_XJogSpeed),
		Name,
		F_CreateDynTextDefault("Tippgeschwindigkeit Servoachse X"),
		stTextListGlobal.stText_mms, E_DataType.eDataType_lreal,
		0, 50, 3);
		
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_XWorkSpeed,
		TO_WSTRING(E_St030_Settings.eSt030_Settings_XWorkSpeed),
		Name,
		F_CreateDynTextDefault("Automatik-Geschwindigkeit Servoachse X"),
		stTextListGlobal.stText_mms, E_DataType.eDataType_lreal,
		0, 500, 3);
		
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_YHomeSpeed,
		TO_WSTRING(E_St030_Settings.eSt030_Settings_YHomeSpeed),
		Name,
		F_CreateDynTextDefault("Homegeschwindigkeit Servoachse Y"),
		stTextListGlobal.stText_mms, E_DataType.eDataType_lreal,
		0, 50, 3);
		
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_YJogSpeed,
		TO_WSTRING(E_St030_Settings.eSt030_Settings_YJogSpeed),
		Name,
		F_CreateDynTextDefault("Tippgeschwindigkeit Servoachse Y"),
		stTextListGlobal.stText_mms, E_DataType.eDataType_lreal,
		0, 50, 3);
		
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_YWorkSpeed,
		TO_WSTRING(E_St030_Settings.eSt030_Settings_YWorkSpeed),
		Name,
		F_CreateDynTextDefault("Automatik-Geschwindigkeit Servoachse Y"),
		stTextListGlobal.stText_mms, E_DataType.eDataType_lreal,
		0, 500, 3);
		
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_ZHomeSpeed,
		TO_WSTRING(E_St030_Settings.eSt030_Settings_ZHomeSpeed),
		Name,
		F_CreateDynTextDefault("Homegeschwindigkeit Servoachse Z"),
		stTextListGlobal.stText_mms, E_DataType.eDataType_lreal,
		0, 50, 3);
		
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_ZJogSpeed,
		TO_WSTRING(E_St030_Settings.eSt030_Settings_ZJogSpeed),
		Name,
		F_CreateDynTextDefault("Tippgeschwindigkeit Servoachse Z"),
		stTextListGlobal.stText_mms, E_DataType.eDataType_lreal,
		0, 50, 3);
		
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_ZWorkSpeed,
		TO_WSTRING(E_St030_Settings.eSt030_Settings_ZWorkSpeed),
		Name,
		F_CreateDynTextDefault("Automatik-Geschwindigkeit Servoachse Z"),
		stTextListGlobal.stText_mms, E_DataType.eDataType_lreal,
		0, 500, 3);
		
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_AxisRefPosX,	// ref pos
		TO_WSTRING(E_St030_Settings.eSt030_Settings_AxisRefPosX),
		Name,
		F_CreateDynTextDefault("Referenzposition Achse X Handling"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 1000, 6);
		
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_AxisRefPosY,
		TO_WSTRING(E_St030_Settings.eSt030_Settings_AxisRefPosY),
		Name,
		F_CreateDynTextDefault("Referenzposition Achse Y Handling"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 1000, 6);
		
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_AxisRefPosZ,
		TO_WSTRING(E_St030_Settings.eSt030_Settings_AxisRefPosZ),
		Name,
		F_CreateDynTextDefault("Referenzposition Achse Z Handling"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 1000, 6);
		
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_XPosHome,	// home pos
		TO_WSTRING(E_St030_Settings.eSt030_Settings_XPosHome),
		Name,
		F_CreateDynTextDefault("Homeposition Servoachse X"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 5000, 3);
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_YPosHome,
		TO_WSTRING(E_St030_Settings.eSt030_Settings_YPosHome),
		Name,
		F_CreateDynTextDefault("Homeposition Servoachse Y"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 3000, 3);
	M_InitDynSettingsItem(E_St030_Settings.eSt030_Settings_ZPosHome,
		TO_WSTRING(E_St030_Settings.eSt030_Settings_ZPosHome),
		Name,
		F_CreateDynTextDefault("Homeposition Servoachse Z"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 1000, 3);	

		
	// restore values
	F_RestoreSettingValues(stLocalSettings.stDynStationSettings, stLocalSettingsBackup.stDynStationSettings);
END_IF

// map current settings values to shortcuts
bStationDeaktiv := stLocalSettings.stDynStationSettings[E_St030_Settings.eSt030_Settings_Station_Deaktiv].bValue;
bAutoHome := stLocalSettings.stDynStationSettings[E_St030_Settings.eSt030_Settings_Autohome].bValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Homing" Id="{cc641223-cbd2-49a6-b610-07aebb1382f5}">
      <Declaration><![CDATA[METHOD PROTECTED M_Homing
VAR
	stHomPrm : ST_AxisHomingParameter;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Homing sequence
CASE sqHome.Step OF
	
	0:	
		sqHome.Info.Set("Warte auf GRST Start");
		IF RunStep AND NOT sqHome.InHome AND bRunHoming THEN
			bBusy := TRUE;
			sqAuto.Step := 0;
			sqSearch.Step := 0;
			sqHome.StartSequence()
				  .Step := 10;
		END_IF	

	10:
		sqHome.Info.Set("Grundstellungsfahrt aktiv");
		IF P_Safety.bMachineRequestStop THEN
			sqHome.Info.Set("Anforderung Stop aktiv");
		ELSIF NOT SafetyOk THEN
			sqHome.Info.Set("Sicherheit nicht ok");
			
		ELSIF NOT fbAxisX.Operational THEN
			sqHome.Info.Set("Antrieb X nicht bereit");
		ELSIF fbAxisX.Moving THEN
			fbAxisX.Halt();
			sqHome.Info.Set("Antrieb X nicht gestoppt");
			
		ELSIF NOT fbAxisY.Operational THEN
			sqHome.Info.Set("Antrieb Y nicht bereit");
		ELSIF fbAxisY.Moving THEN
			fbAxisY.Halt();
			sqHome.Info.Set("Antrieb Y nicht gestoppt");
			
		ELSIF NOT fbAxisZ.Operational THEN
			sqHome.Info.Set("Antrieb Z nicht bereit");
		ELSIF fbAxisZ.Moving THEN
			fbAxisZ.Halt();
			sqHome.Info.Set("Antrieb Z nicht gestoppt");

		ELSIF bRunHoming THEN
			sqHome.Step := 20;
		END_IF
		
	20:	// axis Z homing
		sqHome.Info.Set("Prüfe Z-Achskalibrierung");
		IF fbAxisZ.Homed THEN
			sqHome.Step := 25;
		ELSE
			sqHome.Step := 21;
		END_IF
		
	21: 
		sqHome.Info.Set("Warte auf Referenzschalter");
		IF stIO.stIn.bRefposZ THEN
			sqHome.Step := 22;
		ELSE
			StationError.ArgSbAppendRaise('Referenzsignal Achse Z fehlt bei Referenzfahrt');
			bRunHoming := FALSE;
			sqHome.Step := 0;
		END_IF
		
	22:
		sqHome.Info.Set("Starte Z-Achskalibrierung");
		IF RunStep THEN
			stHomPrm.stOptions.SearchDirection := MC_Direction.MC_Negative_Direction;
			stHomPrm.stOptions.SyncDirection := MC_Direction.MC_Positive_Direction;
			stHomPrm.stOptions.SearchVelocity := 8;
			stHomPrm.stOptions.SyncVelocity := 4;
			stHomPrm.fPosition := HgRefPosZ;
			fbAxisZ.HomeEx(stHomPrm);
			sqHome.Step := 24;
		END_IF
		
	24:
		sqHome.Info.Set("Warte auf Z-Achskalibrierung fertig");
		fbAxisZ.bCalibrationCam := stIO.stIn.bRefposZ;
		IF fbAxisZ.Homed THEN
			sqHome.Step := 25;	
		END_IF
		
	25:
		sqHome.Info.Set("Grundstellungsfahrt aktiv Achse Z Homepos.");
		fbAxisZ.MoveAbsExVel(PosHomeZ, HomeSpeedZ);
		sqHome.Step := 26;
		
	26:
		sqHome.Info.Set("Warte auf Achse Z in Homeposition");
		IF fbAxisZ.TargetReached() THEN
			sqHome.Step := 30;	
		END_IF
		
	30:	// axis Y homing
		sqHome.Info.Set("Prüfe Y-Achskalibrierung");
		IF fbAxisY.Homed THEN
			sqHome.Step := 40;
		ELSE
			sqHome.Step := 32;
		END_IF
		
	32:
		sqHome.Info.Set("Starte Y-Achskalibrierung");
		IF RunStep THEN
			stHomPrm.stOptions.SearchDirection := MC_Direction.MC_Negative_Direction;
			stHomPrm.stOptions.SyncDirection := MC_Direction.MC_Positive_Direction;
			stHomPrm.stOptions.SearchVelocity := 8;
			stHomPrm.stOptions.SyncVelocity := 4;
			stHomPrm.fPosition := HgRefPosY;
			fbAxisY.HomeEx(stHomPrm);
			sqHome.Step := 34;
		END_IF
		
	34:
		sqHome.Info.Set("Warte auf Y-Achskalibrierung fertig");
		fbAxisY.bCalibrationCam := stIO.stIn.bRefposY;
		IF fbAxisY.Homed THEN
			sqHome.Step := 40;	
		END_IF
	
	40:	// axis X homing
		sqHome.Info.Set("Prüfe X-Achskalibrierung");
		IF fbAxisX.Homed THEN
			sqHome.Step := 50;
		ELSE
			sqHome.Step := 42;
		END_IF
		
	42:
		sqHome.Info.Set("Starte X-Achskalibrierung");
		IF RunStep THEN
			stHomPrm.stOptions.SearchDirection := MC_Direction.MC_Negative_Direction;
			stHomPrm.stOptions.SyncDirection := MC_Direction.MC_Positive_Direction;
			stHomPrm.stOptions.SearchVelocity := 8;
			stHomPrm.stOptions.SyncVelocity := 4;
			stHomPrm.fPosition := HgRefPosX;
			fbAxisX.HomeEx(stHomPrm);
			sqHome.Step := 44;
		END_IF
		
	44:
		sqHome.Info.Set("Warte auf X-Achskalibrierung fertig");
		fbAxisX.bCalibrationCam := stIO.stIn.bRefposX;
		IF fbAxisX.Homed THEN
			sqHome.Step := 50;	
		END_IF
		
	50:
		sqHome.Info.Set("Grundstellungsfahrt aktiv Achse Y Homepos.");
		fbAxisY.MoveAbsExVel(PosHomeY, HomeSpeedY);
		sqHome.Step := 55;

	55:
		sqHome.Info.Set("Warte auf Achse Y in Homeposition");
		IF fbAxisY.TargetReached() THEN
			sqHome.Step := 60;	
		END_IF
		
	60:
		sqHome.Info.Set("Grundstellungsfahrt aktiv Achse X Homepos.");
		fbAxisX.MoveAbsExVel(PosHomeX, HomeSpeedX);
		sqHome.Step := 65;
		
	65:
		sqHome.Info.Set("Warte auf Achse X in Homeposition");
		IF fbAxisX.TargetReached() AND fbAxisY.TargetReached() AND fbAxisZ.TargetReached() THEN
			M_RestActHgCmd();
			sqHome.Step := 100;	
		END_IF
		
	100:
		sqHome.Info.Set("Grundstellungsfahrt aktiv");
		sqHome.Step := 1000;

	//	homing done			
	1000:
		sqHome.Info.Set("Grundstellung erreicht");
		IF sqHome.StepTime > T#1S THEN
			bBusy:=FALSE;
			sqHome.InHome := TRUE;
			bStopped := TRUE;
			bRunHoming := FALSE;
			sqAuto.Step := 0;
			sqHome.StopSequence()
				  .Step := 0;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Init" Id="{61659db2-4b62-416d-9ebf-871290f4451e}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC M_Init : IStation
VAR_INPUT
END_VAR
VAR
	Ist : IStation;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// set up station
StationNb := 30;
Station := E_Station.eStation_ST030_Handling; // ID & name 1st!
Name := F_CreateDynTextEx(1, "ST030_Handling", "ST030 Handling");

Ist := SUPER^.M_Init()
			 .InitEvents(TC_Events.ST030EventClass.InfoEvent,
	  		       		 TC_Events.ST030EventClass.WarningEvent,
	  				  	 TC_Events.ST030EventClass.ErrorEvent);

// set up default IO references
M_SetReferences(IO.st030_Handling_IO);

// init components

// Axis X
fbAxisXUi.stBmk := F_CreateDynTextDefault("BMK=A03.ST30.M01-");
fbAxisXUi.stUnit := F_CreateDynTextDefault("mm");
fbAxisXUi.stAxisManager.bEnablePosSet := TRUE;
fbAxisXUi.stAxisManager.bResetCalibrationVisible := TRUE;
fbAxisXUi.stAxisManager.bSetCalibrationVisible := TRUE;
fbAxisX.AxisId := TO_INT(E_Axis.eAxis_Handling_X);
fbAxisX.Active := TRUE;
fbAxisX.Name := F_CreateDynTextEx(1, "ServoHgX", "Servoachse X");
fbAxisX.AxisType := E_AxisType.AX5xxx;
//fbAxisX.DefaultParameter := F_GetDefaultMotionParameter(eMainState_setup);
fbAxisX.SetAxisReference(NcIO.stAxis_ST030_AxisX, NcIO.stAxis_ST030_AxisX_IO.stIn, NCIO.stAxis_ST030_AxisX_IO.stOut);

// Axis CH1
fbAxisYUi.stBmk := F_CreateDynTextDefault("BMK=A03.ST30.M02-");
fbAxisYUi.stUnit := F_CreateDynTextDefault("mm");
fbAxisYUi.stAxisManager.bEnablePosSet := TRUE;
fbAxisYUi.stAxisManager.bResetCalibrationVisible := TRUE;
fbAxisYUi.stAxisManager.bSetCalibrationVisible := TRUE;
fbAxisY.AxisId := TO_INT(E_Axis.eAxis_Handling_Y);
fbAxisY.Active := TRUE;
fbAxisY.Name := F_CreateDynTextEx(1, "ServoHgY", "Servoachse Y");
fbAxisY.AxisType := E_AxisType.AX5xxx;
//fbAxisY.DefaultParameter := F_GetDefaultMotionParameter(eMainState_setup);
fbAxisY.SetAxisReference(NcIO.stAxis_ST030_AxisY, NcIO.stAxis_ST030_AxisY_IO.stIn, NCIO.stAxis_ST030_AxisY_IO.stOut);

// Axis CH2
fbAxisZUi.stBmk := F_CreateDynTextDefault("BMK=A03.ST30.M03-");
fbAxisZUi.stUnit := F_CreateDynTextDefault("mm");
fbAxisZUi.stAxisManager.bEnablePosSet := TRUE;
fbAxisZUi.stAxisManager.bResetCalibrationVisible := TRUE;
fbAxisZUi.stAxisManager.bSetCalibrationVisible := TRUE;
fbAxisZ.AxisId := TO_INT(E_Axis.eAxis_Handling_Z);
fbAxisZ.Active := TRUE;
fbAxisZ.Name := F_CreateDynTextEx(1, "ServoHgZ", "Servoachse Z");
fbAxisZ.AxisType := E_AxisType.AX5xxx;
//fbAxisZ.DefaultParameter := F_GetDefaultMotionParameter(eMainState_setup);
fbAxisZ.SetAxisReference(NcIO.stAxis_ST030_AxisZ, NcIO.stAxis_ST030_AxisZ_IO.stIn, NCIO.stAxis_ST030_AxisZ_IO.stOut);

// register station in it's module
eParent := fbModul001.M_RegisterStation(Ist);

bInitSettings	:= FALSE;
bInitMonitoring := FALSE;
bInitManual  	:= FALSE;

//aSClearText[EN] := 'Station init done.';
M_Init := Ist;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Manual" Id="{696ac44c-875f-493f-b9bf-ccfafc9e4e19}">
      <Declaration><![CDATA[METHOD PROTECTED M_Manual
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// station must be stopped!			manual mode
IF RunCycle OR NOT bStopped THEN //(OpMode <> E_OpMode.eOpMode_manual) THEN
	RETURN;
END_IF

//IF stHmiInOut.stSt030.Command = E_HMI_PL_CMD.eHmiPlCmd_none AND_THEN 
//   stHmiInOut.stSt030.WpCmd.Command <> E_HMI_WP_CMD.eHmiWpCmd_none THEN
//	stHmiInOut.stSt030.Command := E_HMI_PL_CMD.eHmiPlCmd_performWtCmd;
//END_IF
//
//IF stHmiInOut.stSt030.Command = E_HMI_PL_CMD.eHmiPlCmd_none THEN
//	RETURN;
//END_IF
//
//stSt030IHandling.Pallet.PerformHmiCmd(stHmiInOut.stSt030);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_OpModeChanged" Id="{e802a3bb-2066-476b-9c3e-817dd632fa98}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PROTECTED M_OpModeChanged : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*bBusy := FALSE;

IF (eOpMode <> eOpMode_step AND eOpMode <> eOpMode_auto) THEN
	sqAuto.Set(0);
END_IF

fbAxisX.Stop();
fbAxisY.Stop();
fbAxisZ.Stop();*)
]]></ST>
      </Implementation>
