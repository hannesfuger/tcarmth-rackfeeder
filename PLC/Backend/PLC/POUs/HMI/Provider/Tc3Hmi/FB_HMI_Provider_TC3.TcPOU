    <Method Name="M_SpecificInit" Id="{bdde9759-a04d-4cbf-acdf-b85a5284be5e}" FolderPath="ProjectSpecific\">
      <Declaration><![CDATA[METHOD INTERNAL M_SpecificInit : BOOL
VAR_INPUT
END_VAR
VAR
	nn : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// init project specific HMI provider stuff here

(* stTc3HmiOut.stSetupPlant[1].stStation := stTextListGlobal.stText_ST005_NameId;
stTc3HmiOut.stSetupPlant[1].stName := stTextListGlobal.stText_Drehwerkzeug;
stTc3HmiOut.stSetupPlant[2].stStation := stTextListGlobal.stText_ST005_NameId;
stTc3HmiOut.stSetupPlant[2].stName := stTextListGlobal.stText_Kontaktwerkzeug1;
stTc3HmiOut.stSetupPlant[3].stStation := stTextListGlobal.stText_ST005_NameId;
stTc3HmiOut.stSetupPlant[3].stName := stTextListGlobal.stText_Kontaktwerkzeug2; *)


nn:=1;
stOut.stEmergencyStop[nn].stName := stTextListGlobal.stText_Emergencystop_A1P1;
stOut.stEmergencyStop[nn].stItem.wsName := stOut.stEmergencyStop[nn].stItem.wsNameId := "++A1+P1-6S2";
nn:=nn+1;
stOut.stEmergencyStop[nn].stName := stTextListGlobal.stText_Emergencystop_M1P1;
stOut.stEmergencyStop[nn].stItem.wsName := stOut.stEmergencyStop[nn].stItem.wsNameId := "++M1+P1-2S1";
nn:=nn+1;
stOut.stEmergencyStop[nn].stName := stTextListGlobal.stText_Emergencystop_M1P2;
stOut.stEmergencyStop[nn].stItem.wsName := stOut.stEmergencyStop[nn].stItem.wsNameId := "++M1+P2-2S1";


nn:=1;
stOut.stDoor[nn].stName := stTextListGlobal.stText_Modul1_Schott1;
stOut.stDoor[nn].stItem.wsName := stOut.stDoor[nn].stItem.wsNameId := "++M1+PSEN_001-2S2";
nn:=nn+1;
stOut.stDoor[nn].stName := stTextListGlobal.stText_Modul1_Door1;
stOut.stDoor[nn].stItem.wsName := stOut.stDoor[nn].stItem.wsNameId := "++M1+PSEN_002-2S2";
nn:=nn+1;
stOut.stDoor[nn].stName := stTextListGlobal.stText_Modul1_Door2;
stOut.stDoor[nn].stItem.wsName := stOut.stDoor[nn].stItem.wsNameId := "++M1+PSEN_003-2S2";
nn:=nn+1;
stOut.stDoor[nn].stName := stTextListGlobal.stText_Modul1_Door3;
stOut.stDoor[nn].stItem.wsName := stOut.stDoor[nn].stItem.wsNameId := "++M1+PSEN_004-2S2";
nn:=nn+1;
stOut.stDoor[nn].stName := stTextListGlobal.stText_Modul1_Door4;
stOut.stDoor[nn].stItem.wsName := stOut.stDoor[nn].stItem.wsNameId := "++M1+PSEN_005-2S2";
nn:=nn+1;
stOut.stDoor[nn].stName := stTextListGlobal.stText_Modul1_Schott2;
stOut.stDoor[nn].stItem.wsName := stOut.stDoor[nn].stItem.wsNameId := "++M1+E2-73BG7";

// stations, e.g.:
//stTc3HmiOut.astStation[E_Station.eStation_ST010_OvenA].astButton[1] := stItfHmiOut.stSt010.stButtonOvenAxx1;
//stTc3HmiOut.astStation[E_Station.eStation_ST010_OvenA].stEingabeStatusColor := stItfHmiOut.stSt010.stOvenAStatusColor;
//stTc3HmiOut.astStation[E_Station.eStation_ST010_OvenA].stEingabeStatus := stItfHmiOut.stSt010.stOvenAStatus;
//stTc3HmiOut.astStation[E_Station.eStation_ST010_OvenA].astButton[2] := stItfHmiOut.stSt010.stButtonOvenAxx2;


//aSClearText[EN] := 'HMI init done.';
M_SpecificInit := TRUE;]]></ST>
      </Implementation>
    </Method>
