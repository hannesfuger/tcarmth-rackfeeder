    <Property Name="HasCarrierWithEmptyWorkpieceplace" Id="{92c2908c-9c5d-4749-be76-a091b0bf6c1c}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC HasCarrierWithEmptyWorkpieceplace : BOOL]]></Declaration>
      <Get Name="Get" Id="{06a2011b-0b47-4946-a62c-298b96480f67}">
        <Declaration><![CDATA[VAR
	_i : INT;
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasCarrierWithEmptyWorkpieceplace:= FALSE;
	
FOR _i:= 0 TO MAX_CARRIERPLACES DO

	THIS^._TemplateCarrier.Data := _data.CarriersData[_i];
	
	IF _TemplateCarrier.HasEmptyWorkpieceplaces THEN
		HasCarrierWithEmptyWorkpieceplace:= TRUE;
		RETURN;
	END_IF

END_FOR]]></ST>
        </Implementation>
      </Get>
    </Property>
