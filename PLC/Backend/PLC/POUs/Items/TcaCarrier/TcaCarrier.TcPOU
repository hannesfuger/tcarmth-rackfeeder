<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TcaCarrier" Id="{cb4cb05c-8cc6-4c4e-b4d4-2bd8871ee7cb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK TcaCarrier //EXTENDS TcoCore.TcoComponent  
VAR CONSTANT
	MAX_WORKPIECEPLACES : INT := 127;
END_VAR

VAR PERSISTENT
	_data : TcaCarrierData;
	_config : TcaCarrierConfig;
END_VAR

VAR	
	_WorkpiecesStatus : ARRAY[0..eTcaWorkpieceStatus.MAXSIZE] OF INT;
	_PrimaryStatus : eTcaWorkpieceStatus;
	_SecondaryStatus : eTcaWorkpieceStatus;
	_AllFinished : BOOL;
	_Unfinished : BOOL;
		
	_WorkpiecesCoordinate : ARRAY[0..TcaCarrier.MAX_WORKPIECEPLACES] OF ST_Coordinate;
	
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[RefreshStatus();]]></ST>
    </Implementation>
    <Folder Name="Config" Id="{5b12d6a7-75e3-4cf0-aa63-45d3948de01c}" />
    <Folder Name="Functions" Id="{e179f35a-15b1-4e1d-a2be-a3074b0e5c68}" />
    <Folder Name="Operations" Id="{56bebb71-64cc-4645-900b-db953e179838}" />
    <Folder Name="Properties" Id="{65638760-06ce-4b00-b632-cc3d44b13331}" />
    <Method Name="ApplyConfig" Id="{ec2ab732-0b05-4cd8-9ee3-ccd0e42fc7dd}" FolderPath="Config\">
      <Declaration><![CDATA[METHOD ApplyConfig
VAR
	tmpData				: TcaCarrierConfig;
	
	tmpOffset 			: REAL;
	tmpOddRow			: INT;
	tmpEvenRow			: INT;
	tmpWorkpieceCount	: INT;
	
	tmpPos		 		: INT;
	tmpLoc		 		: INT;		
	tmpRow 				: INT;
	//tmpLvl				: INT;
	
	nRowNumber			: INT;
	nLocationNumber		: INT; 
	
	ni					: INT;
	
	tmpCoordinate 		: ST_Coordinate;		
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tmpData := _config;

//todo Error
//_ConfigError


CASE tmpData.Layout OF
	eTcaCarrierLayout.Layout1 : 
		tmpOffset := 0;
		tmpOddRow := tmpData.PositionsInRow;
	tmpEvenRow := tmpData.PositionsInRow;
        tmpWorkpieceCount := tmpData.PositionsInRow*tmpData.PositionsInColumn;
		
    eTcaCarrierLayout.Layout2 :
		tmpOffset := 0.5;
		tmpOddRow := tmpData.PositionsInRow;
		tmpEvenRow :=tmpData.PositionsInRow;
        tmpWorkpieceCount := tmpData.PositionsInRow*tmpData.PositionsInColumn;
		 
    eTcaCarrierLayout.Layout3 :
		 tmpOffset := -0.5;
		 tmpOddRow := tmpData.PositionsInRow;
         tmpEvenRow := tmpData.PositionsInRow;
         tmpWorkpieceCount := tmpData.PositionsInRow*tmpData.PositionsInColumn;	
		 
	eTcaCarrierLayout.Layout4 :
		 tmpOffset := -0.5;
		 tmpOddRow := tmpData.PositionsInRow;
         tmpEvenRow := tmpData.PositionsInRow + 1;
         tmpWorkpieceCount := tmpData.PositionsInRow*tmpData.PositionsInColumn + tmpData.PositionsInColumn/2;
		
	eTcaCarrierLayout.Layout5 :
		 tmpOffset := 0.5;
		 tmpOddRow := tmpData.PositionsInRow;
         tmpEvenRow := tmpData.PositionsInRow - 1;
         tmpWorkpieceCount := tmpData.PositionsInRow*tmpData.PositionsInColumn - tmpData.PositionsInColumn/2 - 1;
		 
END_CASE


MEMSET(ADR(_WorkpiecesCoordinate),0,SIZEOF(_WorkpiecesCoordinate));
MEMSET(ADR(_data.WorkpiecesEnabled),0,SIZEOF(_data.WorkpiecesEnabled));
//MEMSET(ADR(_data.WorkpiecesData),0,SIZEOF(_data.WorkpiecesData));


FOR ni:= 0 TO tmpWorkpieceCount-1 DO
	
	// Bestimmen des Reihen und Spaltenndex und der x und y-Koordinate
	tmpPos := ni MOD tmpWorkpieceCount;
	tmpRow := tmpPos/(tmpOddRow + tmpEvenRow);	
	tmpLoc := tmpPos MOD (tmpOddRow + tmpEvenRow);
	
	IF tmpLoc >= tmpOddRow THEN
	    // gerade Reihe
	    nRowNumber := tmpRow*2 + 1;
	    nLocationNumber := tmpLoc - tmpOddRow;
	    tmpCoordinate.fX := tmpData.ColumnDistance*(nLocationNumber + tmpOffset)+tmpData.CoordinateFirstWorkpiece.fX;
	    tmpCoordinate.fY := tmpData.RowDistance*nRowNumber+tmpData.CoordinateFirstWorkpiece.fY;
	ELSE
	    // ungerade Reihe
	    nRowNumber := tmpRow*2;
	    nLocationNumber := tmpLoc;
	    tmpCoordinate.fX := tmpData.ColumnDistance*nLocationNumber+tmpData.CoordinateFirstWorkpiece.fX;
	    tmpCoordinate.fY := tmpData.RowDistance*nRowNumber+tmpData.CoordinateFirstWorkpiece.fY;
	END_IF
	
	//tmpCoordinate.nOriginId := 0;
		
	_WorkpiecesCoordinate[ni] := tmpCoordinate;
	_data.WorkpiecesEnabled[ni] := TRUE;
	_data.Error := FALSE;

END_FOR]]></ST>
      </Implementation>
    </Method>
