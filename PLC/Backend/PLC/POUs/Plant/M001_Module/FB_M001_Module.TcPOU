    <Method Name="M_Homing" Id="{60e36e84-58af-4f3a-aa69-04d07c1e6124}">
      <Declaration><![CDATA[METHOD PROTECTED M_Homing
VAR
	bTmp : BOOL;
	stTmpTxt : ST_Text;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Homing sequence
CASE sqHome.Step OF
	
	0:	
		sqHome.Info.Set("Warte auf GRST Start");
		IF RunStep AND NOT sqHome.InHome AND bRunHoming THEN
			bBusy := TRUE;
			sqAuto.Step := 0;
			sqHome.StartSequence()
				  .Step := 10;
		END_IF

	10:
		sqHome.Info.Set("Grundstellungsfahrt aktiv");
		IF P_Safety.bMachineRequestStop THEN
			sqHome.Info.Set("Anforderung Stop aktiv");
		ELSIF NOT P_Safety.SafetyOk THEN
			sqHome.Info.Set("Sicherheit nicht ok");
		ELSIF bRunHoming THEN
			sqHome.Step := 20;
		END_IF	
	
	20:
		sqHome.Info.Set("Warte auf Stationen in GRST");
		bTmp := TRUE;
		//FOR ii := 0 TO E_Station.eStation_nMaxIdx DO
		//	IF aIStaton[ii] = 0 THEN
		//		CONTINUE;
		//	END_IF
		//	IF NOT aIStaton[ii].InHome THEN
		//		stTmpTxt := aIStaton[ii].Name;
		//		sqHome.Info.Set("Warte auf Station in GRST: ")
		//				   .Append(stTmpTxt.wsName);
		//		bTmp := FALSE;
		//		EXIT;
		//	END_IF
		//END_FOR
		IF bTmp THEN			
			sqHome.Step := 100;
		END_IF
		
	100:
		sqHome.Info.Set("Grundstellungsfahrt aktiv");
		sqHome.Step := 1000;

	//	homing done			
	1000:
		sqHome.Info.Set("Grundstellung erreicht");
		IF sqHome.StepTime > T#1S THEN			
			bBusy := FALSE;
			sqHome.InHome := TRUE;
			bStopped := TRUE;
			bRunHoming := FALSE;
			sqAuto.Step := 0;
			sqHome.StopSequence()
				  .Step := 0;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Init" Id="{bcc2e5b5-a4e2-49ee-90e6-764c4d49a3af}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC M_Init : IModule
VAR_INPUT
END_VAR
VAR
	IMod : IModule;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// set up station
ModuleNb := 1;
Module := E_Module.eModule_M001;
Name := stTextListGlobal.stText_M001_Name;

IMod := SUPER^.M_Init()
			  .M_InitEvents(TC_Events.ModuleM010EventClass.InfoEvent,
	  				  		TC_Events.ModuleM010EventClass.WarningEvent,
	  				  		TC_Events.ModuleM010EventClass.ErrorEvent);

// set up default IO references
M_SetReferences(IO.stM001_Module_IO);

// init components


P_Plant.M_RegisterModule(IMod);

bInitSettings	:= FALSE;
bInitMonitoring := FALSE;
bInitManual  	:= FALSE;

//aSClearText[EN] := 'Module init done.';
M_Init := IMod;
]]></ST>
      </Implementation>
    </Method>
