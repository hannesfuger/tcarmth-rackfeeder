<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_St010_OvenA" Id="{bf49c22f-4a11-4f5d-ade4-fd58e9b3c270}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_St010_OvenA EXTENDS FB_StationBase
VAR_INPUT
END_VAR
VAR	
	// IO ref
	stIO			: REFERENCE TO ST_St010_IO;
	
	// station components
	fbAxis 			: FB_AxisDriver;
	fbAxisCh1 		: FB_AxisDriver;
	fbAxisCh2 		: FB_AxisDriver;
	
	// actor UIs, access to: iStatus, fPosition, iVisibleState, ..
	fbAxisUi		: FB_Axis_Ui;
	fbAxisCh1Ui		: FB_Axis_Ui;
	fbAxisCh2Ui		: FB_Axis_Ui;
	
	fbHeatingPlate	: FB_FurnaceDriver;
	
	// instance var's
	bStationDeaktiv	: BOOL;
END_VAR
VAR PERSISTENT
	fPickupPos		: LREAL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[/// 
/// Station 010 function block - Oven A
/// 
]]></ST>
    </Implementation>
    <Folder Name="DynSetMonObj" Id="{b91cd1b5-564e-4f3b-91c7-1762efe2b3e4}" />
    <Folder Name="Internal" Id="{ec624cc6-1b0a-4c52-823f-5432cbb138d6}" />
    <Folder Name="Properties" Id="{f10ea7ae-622e-4d69-ada0-9321ce7691c9}" />
    <Property Name="HomeSpeed" Id="{eb380c0f-5704-43df-81fc-f4704bd8d449}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PRIVATE HomeSpeed : LREAL]]></Declaration>
      <Get Name="Get" Id="{7774391f-f3e6-427c-8ad7-d0ac10954c31}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HomeSpeed := stLocalSettings.stDynStationSettings[E_St010_Settings.eSt010_Settings_HomeSpeed].fValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="JogSpeed" Id="{ac3e57e2-a24f-4071-bb69-0265dfdb0aa9}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PRIVATE JogSpeed : LREAL]]></Declaration>
      <Get Name="Get" Id="{a67c1d89-82c0-4556-9d95-2f338c982db4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[JogSpeed := stLocalSettings.stDynStationSettings[E_St010_Settings.eSt010_Settings_JogSpeed].fValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="JogSpeedCh" Id="{b4897f13-48c9-49f0-884e-8b5fc2b59684}" FolderPath="Properties\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PRIVATE JogSpeedCh : LREAL]]></Declaration>
      <Get Name="Get" Id="{491e58ed-b548-4a72-8b35-2f62b2207bfb}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[JogSpeedCh := stLocalSettings.stDynStationSettings[E_St010_Settings.eSt010_Settings_JogSpeedCh].fValue;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="M_CallObjects" Id="{223e0ba1-c872-480a-8d3c-c241468dc55a}">
      <Declaration><![CDATA[METHOD PROTECTED M_CallObjects : BOOL
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Heating Plate
fbHeatingPlate.Run();

// axis + UI
fbAxis.TorqueLimit := 1000;
fbAxis(
	bEnable := SafetyOk AND NOT fbAxisUi.stAxisManager.bDisable,
	bEnablePos := stSt030IHandling.bEnableOvenAxis OR fbAxisUi.stAxisManager.bDisableSoftLimits,
	bEnableNeg := stSt030IHandling.bEnableOvenAxis OR fbAxisUi.stAxisManager.bDisableSoftLimits
);
fbAxisUi(
	bInHome := bInHome,
	fbAxis := fbAxis,
	fVelocity := JogSpeed,
	diSelectedObjectIndex := stHmiManualIn.diSelectedObjectIndex,
	stHMIControlIn := stHmiManualIn.stManualAxis,
	stHMIControlOut := stHmiManualOut.stManualAxis,
	bJogP := stHmi.stIn.stSt010.bJogUp,
	bJogN := stHmi.stIn.stSt010.bJogDown,
	bEnableManual := EnableManual);	

// axis CH1 + UI
fbAxisCh1(
	bEnable := SafetyOk AND NOT fbAxisCh1Ui.stAxisManager.bDisable,
	bEnablePos := TRUE,
	bEnableNeg := TRUE,
);
fbAxisCh1Ui(
	bInHome := bInHome,
	fbAxis := fbAxisCh1,
	fVelocity := JogSpeedCh,
	diSelectedObjectIndex := stHmiManualIn.diSelectedObjectIndex,
	stHMIControlIn := stHmiManualIn.stManualAxis,
	stHMIControlOut := stHmiManualOut.stManualAxis,
	bJogP := stHmi.stIn.stSt010.bJogCh1Inside,
	bJogN := stHmi.stIn.stSt010.bJogCh1Ouside,
	bEnableManual := EnableManual);
	
// axis CH2 + UI
fbAxisCh2(
	bEnable := SafetyOk AND NOT fbAxisCh2Ui.stAxisManager.bDisable,
	bEnablePos := TRUE,
	bEnableNeg := TRUE,
);
fbAxisCh2Ui(
	bInHome := bInHome,
	fbAxis := fbAxisCh2,
	fVelocity := JogSpeedCh,
	diSelectedObjectIndex := stHmiManualIn.diSelectedObjectIndex,
	stHMIControlIn := stHmiManualIn.stManualAxis,
	stHMIControlOut := stHmiManualOut.stManualAxis,
	bJogP := stHmi.stIn.stSt010.bJogCh2Inside,
	bJogN := stHmi.stIn.stSt010.bJogCh2Ouside,
	bEnableManual := EnableManual);

// HMI : switch between jo modes
//(IF stHmi.stIn.stSt010.bJog THEN
//(	fbAxisUi.ManualMode :=  SEL(stHmi.stIn.stSt010.bSpeed, E_ManualMode.eManualMode_Jog01, E_ManualMode.eManualMode_Jog1);
//(	fbAxisCh1Ui.ManualMode :=  SEL(stHmi.stIn.stSt010.bSpeed, E_ManualMode.eManualMode_Jog01, E_ManualMode.eManualMode_Jog1);
//(	fbAxisCh2Ui.ManualMode :=  SEL(stHmi.stIn.stSt010.bSpeed, E_ManualMode.eManualMode_Jog01, E_ManualMode.eManualMode_Jog1);
//(ELSE
//(	fbAxisUi.ManualMode :=    eManualMode_Tippen ;// SEL(stHmi.stIn.stSt010.bSpeed, E_ManualMode.eManualMode_Tippen, E_ManualMode.eManualMode_TippFast);
//(	fbAxisCh1Ui.ManualMode := eManualMode_Tippen;//	SEL(stHmi.stIn.stSt010.bSpeed, E_ManualMode.eManualMode_TippSlow, E_ManualMode.eManualMode_TippFast);
//(	fbAxisCh2Ui.ManualMode := eManualMode_Tippen;//	SEL(stHmi.stIn.stSt010.bSpeed, E_ManualMode.eManualMode_TippSlow, E_ManualMode.eManualMode_TippFast);
//(END_IF	
	
	
// run trolley logic
//Plant.stSt010IOvenA.Trolley.Update();]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_DynManual" Id="{b99c07ee-cb0c-49c5-9c93-b686e36ef859}" FolderPath="DynSetMonObj\">
      <Declaration><![CDATA[METHOD INTERNAL M_DynManual : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInitManual THEN
	bInitManual := TRUE;
	MEMSET(ADR(stHmiManualOut.stObjects), 0, SIZEOF(stHmiManualOut.stObjects)); // reset
	
	M_InitDynManualUi(fbAxisUi);
	M_InitDynManualUi(fbAxisCh1Ui);
	M_InitDynManualUi(fbAxisCh2Ui);
	
	fbAxisUi.M_TargetListClear();
	fbAxisUi.M_TargetListAddItem(F_CreateDynText("Home pos", 0), 15);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_DynMonitoring" Id="{9c831586-f15a-46b8-bfd4-2f17dd72e73a}" FolderPath="DynSetMonObj\">
      <Declaration><![CDATA[METHOD PROTECTED M_DynMonitoring : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_DynMonitoring := SUPER^.M_DynMonitoring();

// init
IF NOT bInitMonitoring THEN
	bInitMonitoring := TRUE;
	MEMSET(ADR(stLocalMonitoring), 0, SIZEOF(stLocalMonitoring)); // reset
	
	M_InitDynMonitoringItem(0, 								// monitoring index 
							"Achse Position", 				// name
							Name, 							// group (station name)
							E_DataType.eDataType_lreal, 	// data type							
							stTextListGlobal.stText_mm);	// unit	

	M_InitDynMonitoringItem(1, "Achse Geschwindigkeit", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_mms);
	M_InitDynMonitoringItem(2, "Achse Drehmoment", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_percent);
	
	M_InitDynMonitoringItem(4, "Achse CH1 Position", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_mm);
	M_InitDynMonitoringItem(5, "Achse CH1 Geschwindigkeit", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_mms);
	M_InitDynMonitoringItem(6, "Achse CH1 Drehmoment", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_percent);
	
	M_InitDynMonitoringItem(8, "Achse CH2 Position", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_mm);
	M_InitDynMonitoringItem(9, "Achse CH2 Geschwindigkeit", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_mms);
	M_InitDynMonitoringItem(10, "Achse CH2 Drehmoment", Name, E_DataType.eDataType_lreal, stTextListGlobal.stText_percent);
END_IF

// live value mapping 

// axis
stLocalMonitoring.astMonitoring[0].fValue := fbAxis.Position;
stLocalMonitoring.astMonitoring[1].fValue := fbAxis.Velocity;
stLocalMonitoring.astMonitoring[2].fValue := fbAxis.Torque;

// axis ch1
stLocalMonitoring.astMonitoring[4].fValue := fbAxisCh1.Position;
stLocalMonitoring.astMonitoring[5].fValue := fbAxisCh1.Velocity;
stLocalMonitoring.astMonitoring[6].fValue := fbAxisCh1.Torque;

// axis ch2
stLocalMonitoring.astMonitoring[8].fValue := fbAxisCh2.Position;
stLocalMonitoring.astMonitoring[9].fValue := fbAxisCh2.Velocity;
stLocalMonitoring.astMonitoring[10].fValue := fbAxisCh2.Torque;

// hmi value mapping
//HMI.stHmi.stOut.stSt010.Trolley := stSt010IOvenA.Trolley.stTrolley;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_DynSettings" Id="{962a529a-d50a-4978-9584-149829683698}" FolderPath="DynSetMonObj\">
      <Declaration><![CDATA[METHOD INTERNAL M_DynSettings : BOOL
VAR_INPUT
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[// init station settings
IF NOT bInitSettings THEN
	bInitSettings := TRUE;
	stLocalSettingsBackup := stLocalSettings; // backup
	MEMSET(ADR(stLocalSettings), 0, SIZEOF(stLocalSettings)); // reset
	
	Services.stSettings.stTrolley.CarrierConfig := Services.stSettings.stCarrier;
	stSt010IOvenA.Trolley.Config := Services.stSettings.stTrolley;
	stSt010IOvenA.Trolley.InitialStatus := eTcaWorkpieceStatus.laserProcessDone;
	stSt010IOvenA.Trolley.RequestStatus := eTcaWorkpieceStatus.castingProcessDone;
	stSt010IOvenA.Trolley.ApplyConfig();
	stSt010IOvenA.Trolley.FillWithInitialCarriers();
			
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_Station_Deaktiv,	// settings index
		TO_WSTRING(E_St010_Settings.eSt010_Settings_Station_Deaktiv),		// settings wsIndex
		Name,																// group
		stTextListGlobal.stText_DeactivateStation,							// name
		stTextListGlobal.stText_bool, E_DataType.eDataType_bool,			// unit & data type
		0, 1, 6);															// min, max & user level

	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_Autohome,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_Autohome),
		Name,
		stTextListGlobal.stText_AutoHome,
		stTextListGlobal.stText_bool, E_DataType.eDataType_bool,
		0, 1, 3);
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_HomeSpeed,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_HomeSpeed),
		Name,
		F_CreateDynTextDefault("Homegeschwindigkeit Servoachse"),
		stTextListGlobal.stText_mms, E_DataType.eDataType_lreal,
		0, 50, 3);
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_JogSpeed,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_JogSpeed),
		Name,
		F_CreateDynTextDefault("Tippgeschwindigkeit Servoachse"),
		stTextListGlobal.stText_mms, E_DataType.eDataType_lreal,
		0, 50, 3);
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_WorkSpeed,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_WorkSpeed),
		Name,
		F_CreateDynTextDefault("Automatik-Geschwindigkeit Servoachse"),
		stTextListGlobal.stText_mms, E_DataType.eDataType_lreal,
		0, 500, 3);
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_JogSpeedCh,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_JogSpeedCh),
		Name,
		F_CreateDynTextDefault("Tippgeschwindigkeit Servoachse CH"),
		stTextListGlobal.stText_mms, E_DataType.eDataType_lreal,
		0, 50, 3);
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_WorkSpeedCh,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_WorkSpeedCh),
		Name,
		F_CreateDynTextDefault("Automatik-Geschwindigkeit Servoachse CH"),
		stTextListGlobal.stText_mms, E_DataType.eDataType_lreal,
		0, 500, 3);

	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_AxisRefPos,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_AxisRefPos),
		Name,
		F_CreateDynTextDefault("Referenzposition Achse Ofen"),
		stTextListGlobal.stText_m, E_DataType.eDataType_lreal,
		0, 3000, 6);
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_PosHome,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_PosHome),
		Name,
		F_CreateDynTextDefault("Homeposition Servoachse"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 5000, 3);
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_PosWork,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_PosWork),
		Name,
		F_CreateDynTextDefault("Mitnehmerposition unteres Segment"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 5000, 3);
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_PosHomeCh,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_PosHomeCh),
		Name,
		F_CreateDynTextDefault("Homeposition Servoachse CH"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 500, 3);
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_PosWorkCh,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_PosWorkCh),
		Name,
		F_CreateDynTextDefault("Arbeitsposition Servoachse CH"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 500, 3);
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_OvenFixPartHeight,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_OvenFixPartHeight),
		Name,
		F_CreateDynTextDefault("Festteilhöhe"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 500, 3);
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_OvenSegmentHeight,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_OvenSegmentHeight),
		Name,
		F_CreateDynTextDefault("Segmenthöhe"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 500, 3);		
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_OvenMiddlePointX,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_OvenMiddlePointX),
		Name,
		F_CreateDynTextDefault("Mittelpunnkt in X-Richtung"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 500, 3);
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_OvenOffsetY,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_OvenOffsetY),
		Name,
		F_CreateDynTextDefault("Y-Offset Ofen"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 500, 3);

	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_OvenPickUpDepthZ,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_OvenPickUpDepthZ),
		Name,
		F_CreateDynTextDefault("Oven Pick up Depth Z"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 5000, 3);
		
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_XPosRp1,	// Teach-Position, Ofen 2, RP 1
		TO_WSTRING(E_St010_Settings.eSt010_Settings_XPosRp1),
		Name,
		F_CreateDynTextDefault("Teach-Position, Ofen 2, RP 1 X"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 5000, 3);
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_YPosRp1,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_YPosRp1),
		Name,
		F_CreateDynTextDefault("Teach-Position, Ofen 2, RP 1 Y"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 3000, 3);
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_ZPosRp1,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_ZPosRp1),
		Name,
		F_CreateDynTextDefault("Teach-Position, Ofen 2, RP 1 Z"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 1000, 3);
		
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_XPosRp2,	// Teach-Position, Ofen 2, RP 2
		TO_WSTRING(E_St010_Settings.eSt010_Settings_XPosRp2),
		Name,
		F_CreateDynTextDefault("Teach-Position, Ofen 2, RP 2 X"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 5000, 3);
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_YPosRp2,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_YPosRp2),
		Name,
		F_CreateDynTextDefault("Teach-Position, Ofen 2, RP 2 Y"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 3000, 3);
	M_InitDynSettingsItem(E_St010_Settings.eSt010_Settings_ZPosRp2,
		TO_WSTRING(E_St010_Settings.eSt010_Settings_ZPosRp2),
		Name,
		F_CreateDynTextDefault("Teach-Position, Ofen 2, RP 2 Z"),
		stTextListGlobal.stText_mm, E_DataType.eDataType_lreal,
		0, 1000, 3);
		
	// restore values
	F_RestoreSettingValues(stLocalSettings.stDynStationSettings, stLocalSettingsBackup.stDynStationSettings);
END_IF

// map current settings values
bStationDeaktiv := stLocalSettings.stDynStationSettings[E_St010_Settings.eSt010_Settings_Station_Deaktiv].bValue;
bAutoHome := stLocalSettings.stDynStationSettings[E_St010_Settings.eSt010_Settings_Autohome].bValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Homing" Id="{9e837cfa-c4b6-4838-a580-0f3c83069d75}">
      <Declaration><![CDATA[METHOD PROTECTED M_Homing
VAR
	stHomPrm : ST_AxisHomingParameter;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Homing sequence
CASE sqHome.Step OF
	
	0:	
		sqHome.Info.Set("Warte auf GRST Start");
			
		IF RunStep AND NOT sqHome.InHome AND bRunHoming THEN
			stSt010IOvenA.bResponseOpn := FALSE;
			bBusy := TRUE;
			sqAuto.Step := 0;
			sqHome.StartSequence()
				  .Step := 10;
		END_IF

	10:
		sqHome.Info.Set("Grundstellungsfahrt aktiv");
		IF P_Safety.bMachineRequestStop THEN
			sqHome.Info.Set("Anforderung Stop aktiv");
		ELSIF NOT SafetyOk THEN
			sqHome.Info.Set("Sicherheit nicht ok");
			
		ELSIF NOT fbAxis.Operational THEN
			sqHome.Info.Set("Antrieb Ofen nicht bereit");			
		ELSIF fbAxis.Moving THEN
			fbAxis.Halt();
			sqHome.Info.Set("Antrieb Ofen nicht gestoppt");
		ELSIF NOT stSt030IHandling.bEnableOvenAxis THEN
			sqHome.Info.Set("Warte auf Fahrfreigabe vom HG");
			
		ELSIF NOT fbAxisCh1.Operational THEN
			sqHome.Info.Set("Antrieb Ofen CH1 nicht bereit");
		ELSIF fbAxisCh1.Moving THEN
			fbAxisCh1.Halt();
			sqHome.Info.Set("Antrieb Ofen CH1 nicht gestoppt");
			
		ELSIF NOT fbAxisCh2.Operational THEN
			sqHome.Info.Set("Antrieb Ofen CH2 nicht bereit");
		ELSIF fbAxisCh2.Moving THEN
			fbAxisCh2.Halt();
			sqHome.Info.Set("Antrieb Ofen CH2 nicht gestoppt");

		ELSIF bRunHoming THEN
			sqHome.Step := 15;
		END_IF
		
	15:	sqHome.Info.Set("Prüfe Status");
		IF F_TargetWindowReached(fbAxisCh1.Position, PosHomeCh, chAxisPosTol) AND 
		   F_TargetWindowReached(fbAxisCh2.Position, PosHomeCh, chAxisPosTol) THEN
			sqHome.SetStep(20);
		ELSIF fbAxis.Homed THEN
			sqHome.SetStep(16); // close segment
		ELSE
			StationError.ArgSbAppendRaise('Segmenttor manuell schließen!');
		END_IF
		
	16: sqHome.Info.Set("Start Achse zu Arbeitspos.");
		fbAxis.MoveAbsExVel(fPickupPos, WorkSpeed);
		sqHome.Step := 17;
		
	17: sqHome.Info.Set("Warte auf Achse in Arbeitspos");
		IF fbAxis.TargetReached() THEN
			sqHome.SetStep(20); // ch axis back
		END_IF
		
	20:
		sqHome.Info.Set("Grundstellungsfahrt aktiv Achse CH1 auf Homepos.");
		fbAxisCh1.MoveAbsExVel(PosHomeCh, WorkSpeedCh);
		sqHome.Step := 25;
		
	25:
		sqHome.Info.Set("Warte auf Achse CH1 in Homeposition");
		IF fbAxisCh1.TargetWindowReached(chAxisPosTol) THEN
			sqHome.Step := 30;
		END_IF
		
	30:
		sqHome.Info.Set("Grundstellungsfahrt aktiv Achse CH2 auf Homepos.");
		fbAxisCh2.MoveAbsExVel(PosHomeCh, WorkSpeedCh);
		sqHome.Step := 35;
		
	35:
		sqHome.Info.Set("Warte auf Achse CH2 in Homeposition");
		IF fbAxisCh2.TargetWindowReached(chAxisPosTol) THEN
			sqHome.Step := 40;
		END_IF
	
	40:
		sqHome.Info.Set("Prüfe Achskalibrierung");
		IF fbAxis.Homed THEN
			sqHome.Step := 50;
		ELSE
			sqHome.Step := 42;
		END_IF
		
	42:
		sqHome.Info.Set("Starte Achskalibrierung");
		IF RunStep THEN
			stHomPrm.fPosition := OvenRefPos;
			stHomPrm.stOptions.SearchDirection := MC_Direction.MC_Negative_Direction;
			stHomPrm.stOptions.SyncDirection := MC_Direction.MC_Positive_Direction;
			stHomPrm.stOptions.SearchVelocity := 8;
			stHomPrm.stOptions.SyncVelocity := 4;
			fbAxis.HomeEx(stHomPrm);
			sqHome.Step := 44;
		END_IF
		
	44:
		sqHome.Info.Set("Warte auf Achskalibrierung fertig");
		fbAxis.bCalibrationCam := stIO.stIn.bRefpos;
		IF fbAxis.Homed THEN
			sqHome.Step := 50;
		END_IF
		
	50:
		sqHome.Info.Set("Grundstellungsfahrt aktiv Achse auf Homepos.");
		fbAxis.MoveAbsExVel(PosHome, HomeSpeed);
		sqHome.Step := 60;
		
	60:
		sqHome.Info.Set("Warte auf Achse in Homeposition");
		IF fbAxis.TargetReached() THEN
			sqHome.Step := 100;
		END_IF
		
	100:
		sqHome.Info.Set("Grundstellungsfahrt aktiv");
		sqHome.Step := 1000;

	//	homing done			
	1000:
		sqHome.Info.Set("Grundstellung erreicht");
		IF sqHome.StepTime > T#1S THEN
			bBusy:=FALSE;
			sqHome.InHome := TRUE;
			bStopped := TRUE;
			bRunHoming := FALSE;
			sqAuto.Step := 0;
			sqHome.StopSequence()
				  .Step := 0;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Init" Id="{2ff80697-5f77-47a7-9cff-afc125578d07}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PUBLIC M_Init : IStation
VAR_INPUT
END_VAR
VAR
	Ist : IStation;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// set up station
StationNb := 10;
Station := E_Station.eStation_ST010_OvenA; // ID & name 1st!
Name := F_CreateDynTextEx(1, "ST010_OvenA", "ST010 Ofen A");

Ist := SUPER^.M_Init()
			 .InitEvents(TC_Events.ST010EventClass.InfoEvent,
	  		       		 TC_Events.ST010EventClass.WarningEvent,
	  				  	 TC_Events.ST010EventClass.ErrorEvent);

// set up default IO references
M_SetReferences(IO.st010_OvenA_IO);

// init components

// Axis
fbAxisUi.stBmk := F_CreateDynTextDefault("BMK=A03.ST10.M01-");
fbAxisUi.stUnit := F_CreateDynTextDefault("mm");
fbAxisUi.stAxisManager.bEnablePosSet := TRUE;
fbAxisUi.stAxisManager.bSetCalibrationVisible := TRUE;
fbAxisUi.stAxisManager.bResetCalibrationVisible := TRUE;
fbAxis.AxisId := TO_INT(E_Axis.eAxis_OvenA);
fbAxis.Active := TRUE;
fbAxis.Name := F_CreateDynTextEx(1, "ServoOvenA", "Servoachse Ofen A");
fbAxis.AxisType := E_AxisType.AX5xxx;
//fbAxis.DefaultParameter := F_GetDefaultMotionParameter(eMainState_setup);
fbAxis.SetAxisReference(NcIO.stAxis_ST010_OvenA, NcIO.stAxis_ST010_OvenA_IO.stIn, NCIO.stAxis_ST010_OvenA_IO.stOut);

// Axis CH1
fbAxisCh1Ui.stBmk := F_CreateDynTextDefault("BMK=A03.ST10.M02-");
fbAxisCh1Ui.stUnit := F_CreateDynTextDefault("mm");
fbAxisCh1Ui.stAxisManager.bEnablePosSet := TRUE;
fbAxisCh1.AxisId := TO_INT(E_Axis.eAxis_OvenA_CH1);
fbAxisCh1.Active := TRUE;
fbAxisCh1.Name := F_CreateDynTextEx(1, "ServoOvenACh1", "Servoachse Ofen A CH1");
fbAxisCh1.AxisType := E_AxisType.AX5xxx;
//fbAxisCh1.DefaultParameter := F_GetDefaultMotionParameter(eMainState_setup);
fbAxisCh1.SetAxisReference(NcIO.stAxis_ST010_OvenACh1, NcIO.stAxis_ST010_OvenACh1_IO.stIn, NCIO.stAxis_ST010_OvenACh1_IO.stOut);

// Axis CH2
fbAxisCh2Ui.stBmk := F_CreateDynTextDefault("BMK=A03.ST10.M03-");
fbAxisCh2Ui.stUnit := F_CreateDynTextDefault("mm");
fbAxisCh2Ui.stAxisManager.bEnablePosSet := TRUE;
fbAxisCh2.AxisId := TO_INT(E_Axis.eAxis_OvenA_CH2);
fbAxisCh2.Active := TRUE;
fbAxisCh2.Name := F_CreateDynTextEx(1, "ServoOvenACh2", "Servoachse Ofen A CH2");
fbAxisCh2.AxisType := E_AxisType.AX5xxx;
//fbAxisCh2.DefaultParameter := F_GetDefaultMotionParameter(eMainState_setup);
fbAxisCh2.SetAxisReference(NcIO.stAxis_ST010_OvenACh2, NcIO.stAxis_ST010_OvenACh2_IO.stIn, NCIO.stAxis_ST010_OvenACh2_IO.stOut);

// register station in it's module
eParent := fbModul001.M_RegisterStation(Ist);

bInitSettings	:= FALSE;
bInitMonitoring := FALSE;
bInitManual  	:= FALSE;

//aSClearText[EN] := 'Station init done.';
M_Init := Ist;

//IF Firstrun THEN
//	Firstrun := FALSE;
//	
//	// init Settings
//	GlobalSetting.Carrier.CoordinateFirstWorkpiece.fX := 32;
//	GlobalSetting.Carrier.CoordinateFirstWorkpiece.fY := 60;
//	GlobalSetting.Carrier.Dimension.fX := 400;
//	GlobalSetting.Carrier.Dimension.fY := 600;
//	GlobalSetting.Carrier.Layout := eTcaCarrierLayout.Layout1;
//	GlobalSetting.Carrier.PositionsInColumn := 9;
//	GlobalSetting.Carrier.PositionsInRow := 7;
//	GlobalSetting.Carrier.ColumnDistance := 56;		// X Direction
//	GlobalSetting.Carrier.RowDistance := 60;		// Y Direction
//	
//	GlobalSetting.Trolley.CarrierDistance := 80;
//	GlobalSetting.Trolley.NumberOfCarriers := 40;
//	GlobalSetting.Trolley.RackOrigin.fX := 0;
//	GlobalSetting.Trolley.RackOrigin.fY := 278;
//	GlobalSetting.Trolley.RackDivision := 443;
//
//END_IF
//
//IF apply THEN
//	apply := FALSE;
//	
//	GlobalSetting.Trolley.CarrierConfig := GlobalSetting.Carrier;
//	// Init Items
//	_Trolley.Config := GlobalSetting.Trolley;
//	//_Trolley.Config.CarrierConfig := GlobalSetting.Carrier;
//	_Trolley.InitialStatus := eTcaWorkpieceStatus.laserProcessDone;
//	_Trolley.RequestStatus := eTcaWorkpieceStatus.castingProcessDone;
//	_Trolley.ApplyConfig();
//	_Trolley.FillWithInitialCarriers();
//	
//	_Trolley2.Config := GlobalSetting.Trolley;
//	//_Trolley2.Config.CarrierConfig := GlobalSetting.Carrier;	
//	_Trolley2.InitialStatus := eTcaWorkpieceStatus.laserProcessDone;
//	_Trolley2.RequestStatus := eTcaWorkpieceStatus.castingProcessDone;
//	_Trolley2.ApplyConfig();
//	_Trolley2.FillWithEmptyCarriers();
//	
//	
//	_Carrier.Config := GlobalSetting.Carrier;
//	_Carrier.ApplyConfig();
//	        
//	_Carrier2.Config := GlobalSetting.Carrier;
//	_Carrier2.ApplyConfig();
//	
//END_IF

]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Manual" Id="{09fa5168-223e-4120-931d-0c46f46fc548}">
      <Declaration><![CDATA[METHOD PROTECTED M_Manual
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// station must be stopped!			manual mode
IF RunCycle OR NOT bStopped THEN //(OpMode <> E_OpMode.eOpMode_manual) THEN
	RETURN;
END_IF

stSt010IOvenA.Trolley.ServiceMode();



//IF stHmiInOut.stSt010.Command = E_HMI_TR_CMD.eHmiTrCmd_none AND_THEN 
//   stHmiInOut.stSt010.PlCmd.Command <> E_HMI_PL_CMD.eHmiPlCmd_none THEN
//	stHmiInOut.stSt010.Command := E_HMI_TR_CMD.eHmiTrCmd_performPlCmd;
//END_IF
//
//IF stHmiInOut.stSt010.Command = E_HMI_TR_CMD.eHmiTrCmd_performPlCmd THEN
//	RETURN;
//END_IF
//
//stSt010IOvenA.Trolley.PerformHmiCmd(stHmiInOut.stSt010);]]></ST>
