<div id="conStation040_Main" data-tchmi-type="TcHmi.Controls.System.TcHmiContent" data-tchmi-top="0" data-tchmi-left="0" data-tchmi-width="100" data-tchmi-height="100" data-tchmi-creator-viewport-width="1024" data-tchmi-creator-viewport-height="768" data-tchmi-creator-locked="True" data-tchmi-width-unit="%" data-tchmi-height-unit="%" data-tchmi-top-unit="%" data-tchmi-left-unit="%" data-tchmi-right-unit="px" data-tchmi-bottom-unit="px">
<div id="Station040_ucMainPage" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControlHost" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-left="0.0" data-tchmi-left-unit="%" data-tchmi-top="0" data-tchmi-top-unit="%" data-tchmi-width="100.0" data-tchmi-width-unit="%" data-tchmi-creator-locked="True" data-tchmi-right-unit="px" data-tchmi-bottom-unit="px" data-tchmi-target-user-control="Base_HMI/Base/Station/Station_MainPage.usercontrol" data-tchmi-ststationbasetohmi="%s%PLC1.HMI.stHmiTc3::stOut::stCommon::arrStStation[4]%/s%" data-tchmi-ststationbasefromhmi="%s%PLC1.HMI.stHmiTc3::stIn::arrStStation[4]%/s%" data-tchmi-specialvisibility="Shown">
</div>

<div id="Station040_regSpecial" data-tchmi-type="TcHmi.Controls.System.TcHmiRegion" data-tchmi-height="70" data-tchmi-height-unit="%" data-tchmi-left="80" data-tchmi-left-unit="%" data-tchmi-top="15" data-tchmi-top-unit="%" data-tchmi-width="5" data-tchmi-width-unit="%" data-tchmi-right-unit="px" data-tchmi-bottom-unit="px" data-tchmi-creator-locked="True" data-tchmi-background-image-width-unit="px" data-tchmi-background-image-height-unit="px">


<script data-tchmi-target-attribute="data-tchmi-border-width" type="application/json">
{
  "left": 2,
  "right": 2,
  "top": 2,
  "bottom": 2,
  "leftUnit": "px",
  "rightUnit": "px",
  "topUnit": "px",
  "bottomUnit": "px"
}
</script>


</div>

<div id="Station040_regMainview" data-tchmi-type="TcHmi.Controls.System.TcHmiRegion" data-tchmi-height="70" data-tchmi-height-unit="%" data-tchmi-left="0" data-tchmi-left-unit="%" data-tchmi-top="15" data-tchmi-top-unit="%" data-tchmi-width="80" data-tchmi-width-unit="%" data-tchmi-right-unit="px" data-tchmi-bottom-unit="px" data-tchmi-background-image-width-unit="px" data-tchmi-background-image-height-unit="px" data-tchmi-zindex="1" data-tchmi-target-content="Pages/Stations/Station040/conStation040_Mainview.content">
</div>

<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onAttached",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%NavTargetLocalSettings%/i%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/String",
          "value": "Pages/Stations/Station040/conStation040_Settings.content"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%NavTargetLocalMonitoring%/i%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/String",
          "value": "Pages/Stations/Station040/conStation040_Monitoring.content"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%i%NavTargetLocalManual%/i%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/String",
          "value": "Pages/Stations/Station040/conStation040_Manual.content"
        },
        "asyncWait": true
      }
    ]
  }
]</script>
</div>