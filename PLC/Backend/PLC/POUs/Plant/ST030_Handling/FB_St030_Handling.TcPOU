<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_St030_Handling" Id="{47eeec44-f861-4b73-ae69-8ae87ae9dbd4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_St030_Handling EXTENDS FB_StationBase
VAR_INPUT
END_VAR
VAR	
	// IO ref
	stIO			: REFERENCE TO ST_St030_IO;
	
	// station components
	fbAxisX 		: FB_AxisDriver;
	fbAxisY 		: FB_AxisDriver;
	fbAxisZ 		: FB_AxisDriver;
	
	// actor UIs, access to: iStatus, fPosition, iVisibleState, ..
	fbAxisXUi		: FB_Axis_Ui;
	fbAxisYUi		: FB_Axis_Ui;
	fbAxisZUi		: FB_Axis_Ui;
	
	// instance var's
	bStationDeaktiv	: BOOL;
	
	eEmptyChk		: E_St030_EmptySlotChk;
	sqSearch		: FB_SequenceHelperSb;
	fPosSearchCorr	: LREAL;
	SearchTrig		: ARRAY[0..1, 0..1] OF ST_XZ_Point; // S1/S2 - Trig 1/2
	fThreshMesMin	: LREAL := 320;
	fThreshMesMax	: LREAL := 350;
END_VAR
VAR PERSISTENT
	HgPosBackup		: ST_3DPoint;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[/// 
/// Station 030 function block - Handling
/// 
]]></ST>
    </Implementation>
    <Folder Name="DynSetMonObj" Id="{c8123d6f-3419-4c60-a26c-3cbacf953c97}" />
    <Folder Name="Hsk" Id="{3f8cb9f7-2fa3-4f7f-8a43-e7bdc6c31644}" />
    <Folder Name="Internal" Id="{795c7aad-6694-432d-b235-4dbc782ae5d8}" />
    <Folder Name="Properties" Id="{e6ec2e0f-d3b3-468f-9eda-5c419fe926cf}" />
    <Method Name="GetPosOvRp" Id="{dbaf51e9-b5b2-488e-a09b-5bf476c0d348}" FolderPath="Internal\">
      <Declaration><![CDATA[METHOD PRIVATE GetPosOvRp : LREAL
VAR_INPUT
	iOven,					// oven 1/2 (A/B)
	iRp		: INT;			// ref point 1/2
	sAxis	: STRING(1); 	// axis X/Y/Z
END_VAR
VAR
	ovRp	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// get reference point value for specified oven, point and axis

ovRp := (iOven * 10) + iRp;
CASE ovRp OF
	 11:
		IF sAxis = 'X' THEN
			GetPosOvRp := stSettings.stStationSettings[E_Station.eStation_ST010_OvenA].stDynStationSettings[E_St010_Settings.eSt010_Settings_XPosRp1].fValue;
		ELSIF sAxis = 'Y' THEN                                                                      
			GetPosOvRp := stSettings.stStationSettings[E_Station.eStation_ST010_OvenA].stDynStationSettings[E_St010_Settings.eSt010_Settings_YPosRp1].fValue;
		ELSIF sAxis = 'Z' THEN                                                                      
			GetPosOvRp := stSettings.stStationSettings[E_Station.eStation_ST010_OvenA].stDynStationSettings[E_St010_Settings.eSt010_Settings_ZPosRp1].fValue;
		END_IF                                                                                      
		                                                                                            
	12:                                                                                             
		IF sAxis = 'X' THEN                                                                         
			GetPosOvRp := stSettings.stStationSettings[E_Station.eStation_ST010_OvenA].stDynStationSettings[E_St010_Settings.eSt010_Settings_XPosRp2].fValue;
		ELSIF sAxis = 'Y' THEN                                                                      
			GetPosOvRp := stSettings.stStationSettings[E_Station.eStation_ST010_OvenA].stDynStationSettings[E_St010_Settings.eSt010_Settings_YPosRp2].fValue;
		ELSIF sAxis = 'Z' THEN                                                                      
			GetPosOvRp := stSettings.stStationSettings[E_Station.eStation_ST010_OvenA].stDynStationSettings[E_St010_Settings.eSt010_Settings_ZPosRp2].fValue;
		END_IF                                                                                      
		                                                                                            
	21:                                                                                             
		IF sAxis = 'X' THEN                                                                         
			GetPosOvRp := stSettings.stStationSettings[E_Station.eStation_ST020_OvenB].stDynStationSettings[E_St020_Settings.eSt020_Settings_XPosRp1].fValue;
		ELSIF sAxis = 'Y' THEN                                                                      
			GetPosOvRp := stSettings.stStationSettings[E_Station.eStation_ST020_OvenB].stDynStationSettings[E_St020_Settings.eSt020_Settings_YPosRp1].fValue;
		ELSIF sAxis = 'Z' THEN                                                                      
			GetPosOvRp := stSettings.stStationSettings[E_Station.eStation_ST020_OvenB].stDynStationSettings[E_St020_Settings.eSt020_Settings_ZPosRp1].fValue;
		END_IF                                                                                      
		                                                                                            
	22:                                                                                             
		IF sAxis = 'X' THEN                                                                         
			GetPosOvRp := stSettings.stStationSettings[E_Station.eStation_ST020_OvenB].stDynStationSettings[E_St020_Settings.eSt020_Settings_XPosRp2].fValue;
		ELSIF sAxis = 'Y' THEN                                                                      
			GetPosOvRp := stSettings.stStationSettings[E_Station.eStation_ST020_OvenB].stDynStationSettings[E_St020_Settings.eSt020_Settings_YPosRp2].fValue;
		ELSIF sAxis = 'Z' THEN                                                                      
			GetPosOvRp := stSettings.stStationSettings[E_Station.eStation_ST020_OvenB].stDynStationSettings[E_St020_Settings.eSt020_Settings_ZPosRp2].fValue;
		END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
