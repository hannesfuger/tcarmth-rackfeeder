    <Method Name="M_SpecificProviderIn" Id="{10fe7cec-fa3f-4a2f-82ec-ec0331ecb94d}" FolderPath="ProjectSpecific\">
      <Declaration><![CDATA[METHOD PRIVATE M_SpecificProviderIn : BOOL
VAR_IN_OUT
	IPrv		: ITF_HMI_PROVIDER;
	stHmiInPr	: ST_HMI_IN;
END_VAR

VAR
	
	//stHmiInPr 	: REFERENCE TO ST_HMI_IN;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
//stHmiInPr REF= IPrv.ItfHmiIn;

// additional, project specific IN
F_OR_REF(stHmi.stIn.stSafety.bQuitSafety, stHmiInPr.stSafety.bQuitSafety);
F_OR_REF(stHmi.stIn.stSafety.bQuitAreaST10, stHmiInPr.stSafety.bQuitAreaST10);
F_OR_REF(stHmi.stIn.stSafety.bUnlockDoorST33, stHmiInPr.stSafety.bUnlockDoorST33);

F_OR_REF(stHmi.stIn.arrStModule[E_Module.eModule_M001].stButton_Reset.bClick, stHmiInPr.stM001.bQuit);

F_OR_REF(stHmi.stIn.stSt010.bJogCh1Inside, stHmiInPr.stSt010.bJogCh1Inside);
F_OR_REF(stHmi.stIn.stSt010.bJogCh2Inside, stHmiInPr.stSt010.bJogCh2Inside);
F_OR_REF(stHmi.stIn.stSt010.bJogCh1Ouside, stHmiInPr.stSt010.bJogCh1Ouside);
F_OR_REF(stHmi.stIn.stSt010.bJogCh2Ouside, stHmiInPr.stSt010.bJogCh2Ouside);
F_OR_REF(stHmi.stIn.stSt010.bJogDown, stHmiInPr.stSt010.bJogDown);
F_OR_REF(stHmi.stIn.stSt010.bJogUp, stHmiInPr.stSt010.bJogUp);
F_OR_REF(stHmi.stIn.stSt010.bSpeed, stHmiInPr.stSt010.bSpeed);
F_OR_REF(stHmi.stIn.stSt010.bJog, stHmiInPr.stSt010.bJog);

F_OR_REF(stHmi.stIn.arrStStation[E_Station.eStation_ST010_OvenA].stButton_OPM_Manual.bClick, stHmiInPr.stSt010.bManual);
F_OR_REF(stHmi.stIn.arrStStation[E_Station.eStation_ST010_OvenA].stButton_Reset.bClick, stHmiInPr.stSt010.bQuit);

stHmiInPr.arrStStation[E_Station.eStation_ST010_OvenA].stManual.stManualAxis.eJogMode := stHmi.stIn.arrStStation[E_Station.eStation_ST010_OvenA].stManual.stManualAxis.eJogMode;
IF stHmiInPr.stSt010.bJog THEN

	IF 	stHmi.stIn.arrStStation[E_Station.eStation_ST010_OvenA].stManual.stManualAxis.eJogMode <> E_Axis_JogMode.eJogMode_0 THEN
		stHmi.stIn.arrStStation[E_Station.eStation_ST010_OvenA].stManual.stManualAxis.eJogMode := E_Axis_JogMode.eJogMode_0;
	ELSE
		stHmi.stIn.arrStStation[E_Station.eStation_ST010_OvenA].stManual.stManualAxis.eJogMode :=  SEL(stHmiInPr.stSt010.bSpeed, E_Axis_JogMode.eJogMode_1, E_Axis_JogMode.eJogMode_2);
	END_IF

END_IF
	
	
F_OR_REF(stHmi.stIn.stSt020.bJogCh1Inside, stHmiInPr.stSt020.bJogCh1Inside);
F_OR_REF(stHmi.stIn.stSt020.bJogCh2Inside, stHmiInPr.stSt020.bJogCh2Inside);
F_OR_REF(stHmi.stIn.stSt020.bJogCh1Ouside, stHmiInPr.stSt020.bJogCh1Ouside);
F_OR_REF(stHmi.stIn.stSt020.bJogCh2Ouside, stHmiInPr.stSt020.bJogCh2Ouside);
F_OR_REF(stHmi.stIn.stSt020.bJogDown, stHmiInPr.stSt020.bJogDown);
F_OR_REF(stHmi.stIn.stSt020.bJogUp, stHmiInPr.stSt020.bJogUp);
F_OR_REF(stHmi.stIn.stSt020.bSpeed, stHmiInPr.stSt020.bSpeed);
F_OR_REF(stHmi.stIn.stSt020.bJog, stHmiInPr.stSt020.bJog);

F_OR_REF(stHmi.stIn.arrStStation[E_Station.eStation_ST020_OvenB].stButton_OPM_Manual.bClick, stHmiInPr.stSt020.bManual);
F_OR_REF(stHmi.stIn.arrStStation[E_Station.eStation_ST020_OvenB].stButton_Reset.bClick, stHmiInPr.stSt020.bQuit);


stHmiInPr.arrStStation[E_Station.eStation_ST020_OvenB].stManual.stManualAxis.eJogMode := stHmi.stIn.arrStStation[E_Station.eStation_ST020_OvenB].stManual.stManualAxis.eJogMode;
IF stHmiInPr.stSt020.bJog THEN

	IF 	stHmi.stIn.arrStStation[E_Station.eStation_ST020_OvenB].stManual.stManualAxis.eJogMode <> E_Axis_JogMode.eJogMode_0 THEN
		stHmi.stIn.arrStStation[E_Station.eStation_ST020_OvenB].stManual.stManualAxis.eJogMode := E_Axis_JogMode.eJogMode_0;
	ELSE
		stHmi.stIn.arrStStation[E_Station.eStation_ST020_OvenB].stManual.stManualAxis.eJogMode :=  SEL(stHmiInPr.stSt020.bSpeed, E_Axis_JogMode.eJogMode_1, E_Axis_JogMode.eJogMode_2);
	END_IF

END_IF


F_OR_REF(stHmi.stIn.stSt030.bJogXN, stHmiInPr.stSt030.bJogXN);
F_OR_REF(stHmi.stIn.stSt030.bJogXP, stHmiInPr.stSt030.bJogXP);
F_OR_REF(stHmi.stIn.stSt030.bJogYN, stHmiInPr.stSt030.bJogYN);
F_OR_REF(stHmi.stIn.stSt030.bJogYP, stHmiInPr.stSt030.bJogYP);
F_OR_REF(stHmi.stIn.stSt030.bJogZN, stHmiInPr.stSt030.bJogZN);
F_OR_REF(stHmi.stIn.stSt030.bJogZP, stHmiInPr.stSt030.bJogZP);
F_OR_REF(stHmi.stIn.stSt030.bSpeed, stHmiInPr.stSt030.bSpeed);
F_OR_REF(stHmi.stIn.stSt030.bJog, stHmiInPr.stSt030.bJog);

F_OR_REF(stHmi.stIn.arrStStation[E_Station.eStation_ST030_Handling].stButton_OPM_Manual.bClick, stHmiInPr.stSt030.bManual);
F_OR_REF(stHmi.stIn.arrStStation[E_Station.eStation_ST030_Handling].stButton_Reset.bClick, stHmiInPr.stSt030.bQuit);

stHmiInPr.arrStStation[E_Station.eStation_ST030_Handling].stManual.stManualAxis.eJogMode := stHmi.stIn.arrStStation[E_Station.eStation_ST030_Handling].stManual.stManualAxis.eJogMode;
IF stHmiInPr.stSt030.bJog THEN

	IF 	stHmi.stIn.arrStStation[E_Station.eStation_ST030_Handling].stManual.stManualAxis.eJogMode <> E_Axis_JogMode.eJogMode_0 THEN
		stHmi.stIn.arrStStation[E_Station.eStation_ST030_Handling].stManual.stManualAxis.eJogMode := E_Axis_JogMode.eJogMode_0;
	ELSE
		stHmi.stIn.arrStStation[E_Station.eStation_ST030_Handling].stManual.stManualAxis.eJogMode :=  SEL(stHmiInPr.stSt030.bSpeed, E_Axis_JogMode.eJogMode_1, E_Axis_JogMode.eJogMode_2);
	END_IF

END_IF

F_OR_REF(stHmi.stIn.stSt040.bJog01Down, stHmiInPr.stSt040.bJog01Down);
F_OR_REF(stHmi.stIn.stSt040.bJog01Up, stHmiInPr.stSt040.bJog01Up);
F_OR_REF(stHmi.stIn.stSt040.bJog02Down, stHmiInPr.stSt040.bJog02Down);
F_OR_REF(stHmi.stIn.stSt040.bJog02Up, stHmiInPr.stSt040.bJog02Up);
F_OR_REF(stHmi.stIn.stSt040.bSpeed, stHmiInPr.stSt010.bSpeed);
F_OR_REF(stHmi.stIn.stSt040.bJog, stHmiInPr.stSt010.bJog);

F_OR_REF(stHmi.stIn.stSt040.bJog, stHmiInPr.stSt040.bJog);F_OR_REF(stHmi.stIn.arrStStation[E_Station.eStation_ST040_Storage].stButton_OPM_Manual.bClick, stHmiInPr.stSt040.bManual);
F_OR_REF(stHmi.stIn.arrStStation[E_Station.eStation_ST040_Storage].stButton_Reset.bClick, stHmiInPr.stSt040.bQuit);

stHmiInPr.arrStStation[E_Station.eStation_ST040_Storage].stManual.stManualAxis.eJogMode := stHmi.stIn.arrStStation[E_Station.eStation_ST040_Storage].stManual.stManualAxis.eJogMode;
IF stHmiInPr.stSt040.bJog THEN

	IF 	stHmi.stIn.arrStStation[E_Station.eStation_ST040_Storage].stManual.stManualAxis.eJogMode <> E_Axis_JogMode.eJogMode_0 THEN
		stHmi.stIn.arrStStation[E_Station.eStation_ST040_Storage].stManual.stManualAxis.eJogMode := E_Axis_JogMode.eJogMode_0;
	ELSE
		stHmi.stIn.arrStStation[E_Station.eStation_ST040_Storage].stManual.stManualAxis.eJogMode :=  SEL(stHmiInPr.stSt040.bSpeed, E_Axis_JogMode.eJogMode_1, E_Axis_JogMode.eJogMode_2);
	END_IF

END_IF


// map override only from HW-provider (Poti)
IF IPrv.Provider = E_HMI_PROVIDER.eHmiProvider_HW THEN
	stHmi.stIn.iOverride := TO_INT(stHmiInPr.iOverride * 3.051851E-3);
END_IF

M_SpecificProviderIn := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SpecificProviderOut" Id="{03e80cfa-25f1-48e9-bc72-8f1fedb8300c}" FolderPath="ProjectSpecific\">
      <Declaration><![CDATA[METHOD PRIVATE M_SpecificProviderOut : BOOL
VAR_IN_OUT
	stHmiOutPr : ST_HMI_OUT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// additional, project specific OUT to provider
stHmiOutPr.stM001 := stHmi.stOut.stM001;

stHmiOutPr.stSt010 := stHmi.stOut.stSt010;
stHmiOutPr.stSt020 := stHmi.stOut.stSt020;
stHmiOutPr.stSt030 := stHmi.stOut.stSt030;
stHmiOutPr.stSt040 := stHmi.stOut.stSt040;

M_SpecificProviderOut := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateSystemInfo" Id="{35e50d10-4d55-4c1d-b712-f344df5b8865}" FolderPath="Internal\SystemInfo\">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdateSystemInfo : BOOL
VAR_INPUT
	sName 	: STRING(31);
	sValue 	: STRING;
END_VAR
VAR_IN_OUT
	idx 	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF idx < 0 OR idx > CONST.iMaxIdxSystemInfo THEN
	M_UpdateSystemInfo := FALSE;
	RETURN;
END_IF

stHmi.stOut.stCommon.aSystemInfos[idx].sName := sName;
stHmi.stOut.stCommon.aSystemInfos[idx].sValue := sValue;
idx := idx + 1;
M_UpdateSystemInfo := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UserManagement" Id="{11d4fd22-14bf-40a2-b82c-493d0f2e7819}">
      <Declaration><![CDATA[METHOD M_UserManagement : INT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tonUserLevelLogOut.IN:= (iUserLevel >= E_User_Level.eUser_Level_Maintenance);
tonUserLevelLogOut.PT:=T#15M;
tonUserLevelLogOut();

rTrigUserManagmentSubmit.CLK := stHmi.stIn.stUserMgmt.stButton_Submit.bClick;
rTrigUserManagmentSubmit();
rTrigUserManagmentLogIn.CLK := stHmi.stIn.stUserMgmt.stButton_LogIn.bClick;
rTrigUserManagmentLogIn();
rTrigUserManagmentLogOut.CLK := stHmi.stIn.stUserMgmt.stButton_LogOut.bClick;
rTrigUserManagmentLogOut();

IF rTrigUserManagmentLogIn.Q THEN
	IF (stHmi.stIn.stUserMgmt.sUserManagment_InputPassword = stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].sPassword) THEN
		stHmi.stIn.stUserMgmt.sUserManagment_InputPassword := '';
		//sPasswort := stHmi.stIn.stUserManagment.sUserManagment_InputPassword;
		iUserLevel := stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].iUserLevel;
		sUserLevelLastUser := stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].sName;
		sUserLevelLastUser := CONCAT(sUserLevelLastUser,'  Level: ');
		sUserLevelLastUser := CONCAT(sUserLevelLastUser,TO_STRING(iUserLevel));	
	ELSE
		;
	END_IF	
	//stHmi.stIn.stUserManagment.sUserManagment_InputPassword := '';
ELSIF tonUserLevelLogOut.Q OR rTrigUserManagmentLogOut.Q THEN
	iUserLevel := E_User_Level.eUser_Level_none;
	//stHmi.stIn.stUserManagment.sUserManagment_InputPassword := '';
END_IF

IF iIBN > 0 THEN
	iUserLevel := 6;
END_IF

IF tonUserLevelLogOut.Q THEN
	iUserLevel:= E_User_Level.eUser_Level_none;
END_IF

FOR ii:=0 TO (E_User_Level.eUser_Level_nMaxIdx-1) DO
	stHmi.stOut.stCommon.stUserMgmt.bUserLevel[ii]:=FALSE;
END_FOR

CASE iUserLevel OF

	E_User_Level.eUser_Level_none:
		stHmi.stOut.stCommon.stUserMgmt.sUserState:='Kein Benutzer';
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[0]:=TRUE;
		
	E_User_Level.eUser_Level_Operator:
		stHmi.stOut.stCommon.stUserMgmt.sUserState:=sUserLevelLastUser;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[0]:=TRUE;		
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[1]:=TRUE;
		
	E_User_Level.eUser_Level_Manager:
		stHmi.stOut.stCommon.stUserMgmt.sUserState:=sUserLevelLastUser;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[0]:=TRUE;		
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[1]:=TRUE;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[2]:=TRUE;	
		
	E_User_Level.eUser_Level_Maintenance:
		stHmi.stOut.stCommon.stUserMgmt.sUserState:=sUserLevelLastUser;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[0]:=TRUE;		
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[1]:=TRUE;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[2]:=TRUE;		
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[3]:=TRUE;
		
	E_User_Level.eUser_Level_Level4:
		stHmi.stOut.stCommon.stUserMgmt.sUserState:=sUserLevelLastUser;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[0]:=TRUE;		
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[1]:=TRUE;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[2]:=TRUE;		
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[3]:=TRUE;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[4]:=TRUE;		
	
	E_User_Level.eUser_Level_Admin:
		stHmi.stOut.stCommon.stUserMgmt.sUserState:=sUserLevelLastUser;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[0]:=TRUE;		
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[1]:=TRUE;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[2]:=TRUE;		
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[3]:=TRUE;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[4]:=TRUE;		
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[5]:=TRUE;	
		
	E_User_Level.eUser_Level_Programmer:
		stHmi.stOut.stCommon.stUserMgmt.sUserState:=sUserLevelLastUser;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[0]:=TRUE;		
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[1]:=TRUE;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[2]:=TRUE;		
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[3]:=TRUE;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[4]:=TRUE;		
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[5]:=TRUE;	
		stHmi.stOut.stCommon.stUserMgmt.bUserLevel[6]:=TRUE;			
ELSE
	stHmi.stOut.stCommon.stUserMgmt.sUserState:='Benutzer unbekannt';
END_CASE

iUserLevel:=LIMIT(0, iUserLevel, (E_User_Level.eUser_Level_nMaxIdx - 1));

stHmi.stOut.stCommon.stUserMgmt.bPasswordInputVisible := bPasswordSave;
stHmi.stOut.stCommon.stUserMgmt.bCreateDeleteUserVisible := iUserLevel >= E_User_Level.eUser_Level_Admin; // only Admin or programmer can delete a user


FOR ii:=0 TO (E_User.eUser_nMaxIdx-1) DO
	stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].sName := stUserLevel[ii].sName;		
	stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].iUserLevel := stUserLevel[ii].iUserLevel;
	stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].iUserLevelMin := stUserLevel[ii].iUserLevelMin;
	stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].iUserLevelMax := stUserLevel[ii].iUserLevelMax;
	IF (iUserLevel < E_User_Level.eUser_Level_Admin) AND (stUserLevel[ii].sName <> '')
	THEN
		stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].sPassword:='*****';
	ELSIF (iUserLevel >= stUserLevel[ii].iUserLevel(* E_User_Level.eUser_Level_Admin*)) AND (stUserLevel[ii].sName <> '') THEN
		stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].sPassword:=stUserLevel[ii].sPassword;
	ELSIF NOT (iUserLevel >= stUserLevel[ii].iUserLevel (*E_User_Level.eUser_Level_Admin*)) AND (stUserLevel[ii].sName <> '')  
	THEN
		stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].sPassword:='*****';
	ELSE
		stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].sPassword:='';
	END_IF
	IF (stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].sName <> '') THEN
		CASE stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].iUserLevel OF
			0:
				stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].stUserLevelName := stTextListGlobal.stText_UserLevel_None;

			1:
				stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].stUserLevelName := stTextListGlobal.stText_UserLevel_Operator;

			2:
				stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].stUserLevelName := stTextListGlobal.stText_UserLevel_Manager;

			3:
				stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].stUserLevelName := stTextListGlobal.stText_UserLevel_Maintenance;

			4:
				stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].stUserLevelName := stTextListGlobal.stText_UserLevel_None;

			5:
				stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].stUserLevelName := stTextListGlobal.stText_UserLevel_Admin;

			6:
				stHmi.stOut.stCommon.stUserMgmt.stUserLevel[ii].stUserLevelName := stTextListGlobal.stText_UserLevel_Programmer;		

		END_CASE
	END_IF
END_FOR

stHmi.stOut.stCommon.stUserMgmt.aUserLevelList[0] := stTextListGlobal.stText_UserLevel_None;
stHmi.stOut.stCommon.stUserMgmt.aUserLevelList[1] := stTextListGlobal.stText_UserLevel_Operator;
stHmi.stOut.stCommon.stUserMgmt.aUserLevelList[2] := stTextListGlobal.stText_UserLevel_Manager;
stHmi.stOut.stCommon.stUserMgmt.aUserLevelList[3] := stTextListGlobal.stText_UserLevel_Maintenance;
stHmi.stOut.stCommon.stUserMgmt.aUserLevelList[4] := stTextListGlobal.stText_UserLevel_None;
stHmi.stOut.stCommon.stUserMgmt.aUserLevelList[5] := stTextListGlobal.stText_UserLevel_Admin;
stHmi.stOut.stCommon.stUserMgmt.aUserLevelList[6] := stTextListGlobal.stText_UserLevel_Programmer;

IF fTrigUserManagmentSubmit.Q THEN
	stHmi.stIn.stUserMgmt.sUserManagment_InputString := '';
	stHmi.stIn.stUserMgmt.nUserManagment_InputUserLevel := 0;
END_IF

// Column of the grid
CASE stHmi.stIn.stUserMgmt.stControlObject.nSelectedColumIndex OF 
	// Name
	0:
		// selected col/row changed
		IF nUserManagemenetColumnIdx_Old <> stHmi.stIn.stUserMgmt.stControlObject.nSelectedColumIndex OR
		nUserManagemenetRowIdx_Old <> stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex THEN
			nUserManagemenetColumnIdx_Old := stHmi.stIn.stUserMgmt.stControlObject.nSelectedColumIndex;
			nUserManagemenetRowIdx_Old := stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex;
			stHmi.stIn.stUserMgmt.sUserManagment_InputString := stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].sName;
		END_IF
		stHmi.stOut.stCommon.stUserMgmt.stInputDisplayText := F_CreateDynText("Name", 0);
		stHmi.stOut.stCommon.stUserMgmt.bKeyboardInputVisible := stHmi.stOut.stCommon.stUserMgmt.bUserLevel[E_User_Level.eUser_Level_Admin] 
																	OR stHmi.stOut.stCommon.stUserMgmt.bUserLevel[E_User_Level.eUser_Level_Programmer];
		stHmi.stOut.stCommon.stUserMgmt.bNumpadInputVisible := FALSE;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevelInputVisible := FALSE;
		//Reihe 1 - Name des Benutzers nur übernehmen wenn Admin
		IF stHmi.stOut.stCommon.stUserMgmt.bUserLevel[E_User_Level.eUser_Level_Admin] 
			OR stHmi.stOut.stCommon.stUserMgmt.bUserLevel[E_User_Level.eUser_Level_Programmer] 
		THEN
			IF rTrigUserManagmentSubmit.Q THEN
				IF ((iUserLevel = E_User_Level.eUser_Level_Admin)
					AND (stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].iUserLevel <= E_User_Level.eUser_Level_Admin))
					OR stHmi.stOut.stCommon.stUserMgmt.bUserLevel[E_User_Level.eUser_Level_Programmer]
				THEN	
					stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].sName := stHmi.stIn.stUserMgmt.sUserManagment_InputString;
				ELSE
					stHmi.stOut.stCommon.stUserMgmt.sUserState:='Benutzer level incorrect';
				END_IF
			END_IF
		END_IF

	// Passwort
	1:
		// selected col/row changed
		IF nUserManagemenetColumnIdx_Old <> stHmi.stIn.stUserMgmt.stControlObject.nSelectedColumIndex OR
		nUserManagemenetRowIdx_Old <> stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex THEN
			nUserManagemenetColumnIdx_Old := stHmi.stIn.stUserMgmt.stControlObject.nSelectedColumIndex;
			nUserManagemenetRowIdx_Old := stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex;
			stHmi.stIn.stUserMgmt.sUserManagment_InputString := '*****';
		END_IF
		stHmi.stOut.stCommon.stUserMgmt.stInputDisplayText := F_CreateDynText("Passwort", 0);
		stHmi.stOut.stCommon.stUserMgmt.bKeyboardInputVisible := stHmi.stOut.stCommon.stUserMgmt.bUserLevel[E_User_Level.eUser_Level_Admin] OR stHmi.stOut.stCommon.stUserMgmt.bUserLevel[E_User_Level.eUser_Level_Programmer];
		stHmi.stOut.stCommon.stUserMgmt.bNumpadInputVisible := FALSE;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevelInputVisible := FALSE;
		//Reihe 2 - Passwort der Eingabe gleich hinterlegtem Passwort dann User aktivieren
		IF (stHmi.stOut.stCommon.stUserMgmt.bUserLevel[E_User_Level.eUser_Level_Admin] AND (stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].iUserLevel < E_User_Level.eUser_Level_Programmer)) 
			OR stHmi.stOut.stCommon.stUserMgmt.bUserLevel[E_User_Level.eUser_Level_Programmer] 
		THEN
			IF rTrigUserManagmentSubmit.Q  
				AND (stHmi.stIn.stUserMgmt.sUserManagment_InputString <> '') 
				AND (stHmi.stIn.stUserMgmt.sUserManagment_InputString <> '*****') THEN
				stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].sPassword := stHmi.stIn.stUserMgmt.sUserManagment_InputString;
			END_IF
		END_IF

	// Stufe
	2:
		// selected col/row changed
		IF nUserManagemenetColumnIdx_Old <> stHmi.stIn.stUserMgmt.stControlObject.nSelectedColumIndex OR
		nUserManagemenetRowIdx_Old <> stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex THEN
			nUserManagemenetColumnIdx_Old := stHmi.stIn.stUserMgmt.stControlObject.nSelectedColumIndex;
			nUserManagemenetRowIdx_Old := stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex;
			stHmi.stIn.stUserMgmt.nUserManagment_InputUserLevel := stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].iUserLevel;
		END_IF
		stHmi.stOut.stCommon.stUserMgmt.stInputDisplayText := F_CreateDynText("Stufe", 0);
		stHmi.stOut.stCommon.stUserMgmt.bKeyboardInputVisible := FALSE;
		stHmi.stOut.stCommon.stUserMgmt.bNumpadInputVisible := FALSE;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevelInputVisible := stHmi.stOut.stCommon.stUserMgmt.bUserLevel[E_User_Level.eUser_Level_Admin];
		IF (stHmi.stOut.stCommon.stUserMgmt.bUserLevel[E_User_Level.eUser_Level_Admin] 
				AND (stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].iUserLevel < E_User_Level.eUser_Level_Programmer)
				AND (stHmi.stIn.stUserMgmt.nUserManagment_InputUserLevel < E_User_Level.eUser_Level_Programmer)) 
			OR stHmi.stOut.stCommon.stUserMgmt.bUserLevel[E_User_Level.eUser_Level_Programmer] 
		THEN
			IF rTrigUserManagmentSubmit.Q THEN
				stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].iUserLevel := stHmi.stIn.stUserMgmt.nUserManagment_InputUserLevel;
			END_IF
		END_IF

	ELSE
		//ELSE Alle Visible Rücksetzen
		stHmi.stOut.stCommon.stUserMgmt.bKeyboardInputVisible := FALSE;
		stHmi.stOut.stCommon.stUserMgmt.bNumpadInputVisible := FALSE;
		stHmi.stOut.stCommon.stUserMgmt.bUserLevelInputVisible := FALSE;
		
END_CASE

// Delete user
rTrigUserManagmentDelete( CLK := stHmi.stIn.stUserMgmt.bDeleteUser );
IF rTrigUserManagmentDelete.Q THEN
	IF ((iUserLevel >= E_User_Level.eUser_Level_Admin) AND (stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].iUserLevel < E_User_Level.eUser_Level_Programmer) ) 
		OR stHmi.stOut.stCommon.stUserMgmt.bUserLevel[E_User_Level.eUser_Level_Programmer]
	THEN
		stHmi.stOut.stCommon.stUserMgmt.stUserManagementMessage := F_CreateDynText("", 0);
		
		stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].sName  := '';
		stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].sPassword  := '';
		stUserLevel[stHmi.stIn.stUserMgmt.stControlObject.nSelectedRowIndex].iUserLevel := TO_INT( E_User_Level.eUser_Level_none );
		// message
		stHmi.stOut.stCommon.stUserMgmt.stUserManagementMessage := F_CreateDynText("Benutzer gelöscht!", 0);
	
	ELSIF stHmi.stIn.stUserMgmt.sCreateDeleteUserName = '' THEN
		stHmi.stOut.stCommon.stUserMgmt.stUserManagementMessage := F_CreateDynText("Benutzername ist leer!", 0);
	ELSIF stHmi.stIn.stUserMgmt.sCreateDeleteUserName <> stHmi.stIn.stUserMgmt.sCreateDeleteUserNameConfirm THEN
		stHmi.stOut.stCommon.stUserMgmt.stUserManagementMessage := F_CreateDynText("Benutzername bitte bestätigen!", 0);
	END_IF	
END_IF

HMI.eUserLevel := iUserLevel;

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>